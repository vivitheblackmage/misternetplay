@@ -53,6 +53,8 @@ module cart_top (
 	input  [15:0] joystick_analog_0,
 
 	input         ce_32k,
+	input         rtc_emu,   // netplay: the RTC counts emulated time only
+	input         rtc_clr,   // netplay: clear the RTC (one cycle)
 	input  [32:0] RTC_time,
 	output [31:0] RTC_timestampOut,
 	output [47:0] RTC_savedtimeOut,
@@ -135,6 +137,8 @@ mappers mappers (
 	.joystick_analog_0 ( joystick_analog_0 ),
 
