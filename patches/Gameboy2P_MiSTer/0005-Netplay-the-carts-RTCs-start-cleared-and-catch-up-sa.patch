diff --git a/npsim/make_rtctest.py b/npsim/make_rtctest.py
new file mode 100644
index 0000000..34da62e
--- /dev/null
+++ b/npsim/make_rtctest.py
@@ -0,0 +1,65 @@
+#!/usr/bin/env python3
+"""Builds the MBC3 real-time-clock test ROMs for the netplay simulation.
+
+Every frame, at the start of VBlank, the program latches the MBC3 clock, reads
+seconds, minutes and days (low), mixes them into one byte and writes it to
+BGP (the picture) and sends it over the link cable (the link lines are in the
+netplay CRC). The frame where the seconds tick shows the clock's sub-second
+phase, so two MiSTers whose clocks did not start alike give different CRCs.
+
+rtcdirty.gb first sets the clock to 37 s and 200 days, as a game played before
+the session would leave it; rtctest.gb has NOPs there. With --dirty
+rtcdirty.gb the netplay session must still match (SPEC.md 11.2).
+The boot ROM requires the Nintendo logo in the header. It is not part of this
+file: it is copied from another ROM given on the command line.
+usage: make_rtctest.py logo_source.gb rtctest.gb rtcdirty.gb"""
+import sys
+
+def build(logo, dirty):
+	rom = bytearray(0x8000)
+	rom[0x100:0x104] = bytes([0x00, 0xC3, 0x50, 0x01])     # nop; jp $0150
+	rom[0x104:0x134] = logo
+	rom[0x134:0x13F] = b"RTCTEST\0\0\0\0"
+	rom[0x147] = 0x10                                      # MBC3+TIMER+RAM+BATTERY
+	rom[0x148] = 0x00                                      # 32 KB ROM
+	rom[0x149] = 0x02                                      # 8 KB RAM
+	setclock = bytes([
+		0x3E, 0x08, 0xEA, 0x00, 0x40,    # ld a,$08; ld ($4000),a   RTC seconds
+		0x3E, 0x25, 0xEA, 0x00, 0xA0,    # ld a,37;  ld ($A000),a
+		0x3E, 0x0B, 0xEA, 0x00, 0x40,    # ld a,$0B; ld ($4000),a   days, low
+		0x3E, 0xC8, 0xEA, 0x00, 0xA0,    # ld a,200; ld ($A000),a
+		0x3E, 0x0C, 0xEA, 0x00, 0x40,    # ld a,$0C; ld ($4000),a   days high, halt
+		0xAF, 0xEA, 0x00, 0xA0,          # xor a;    ld ($A000),a   running
+	])
+	head = bytes([
+		0xF3,                            # di
+		0x31, 0xFE, 0xFF,                # ld sp,$FFFE
+		0x3E, 0x0A, 0xEA, 0x00, 0x00,    # ld a,$0A; ld ($0000),a   RAM and RTC on
+	]) + (setclock if dirty else bytes(len(setclock)))
+	loop = bytes([
+		0xF0, 0x44, 0xFE, 0x90, 0x20, 0xFA,    # wait for LY = 144
+		0xF0, 0x44, 0xFE, 0x90, 0x28, 0xFA,    # and until it leaves 144
+		0xAF, 0xEA, 0x00, 0x60,                # xor a; ld ($6000),a     latch 0
+		0x3C, 0xEA, 0x00, 0x60,                # inc a; ld ($6000),a     latch 1
+		0x3E, 0x08, 0xEA, 0x00, 0x40, 0xFA, 0x00, 0xA0, 0x47,   # b = seconds
+		0x3E, 0x09, 0xEA, 0x00, 0x40, 0xFA, 0x00, 0xA0, 0x4F,   # c = minutes
+		0x3E, 0x0B, 0xEA, 0x00, 0x40, 0xFA, 0x00, 0xA0, 0x5F,   # e = days, low
+		0x79, 0x07, 0x07, 0xA8, 0xAB,          # a = rlc2(c) ^ b ^ e
+		0xE0, 0x47,                            # ldh ($47),a   BGP
+		0xE0, 0x01,                            # ldh ($01),a   SB
+		0x3E, 0x81, 0xE0, 0x02,                # ldh ($02),$81 start, internal clock
+		0xF0, 0x02, 0xCB, 0x7F, 0x20, 0xFA,    # until the byte is sent
+	])
+	back = -(len(loop) + 2)
+	code = head + loop + bytes([0x18, back & 0xFF])   # jr loop
+	rom[0x150:0x150 + len(code)] = code
+	x = 0
+	for b in rom[0x134:0x14D]:
+		x = (x - b - 1) & 0xFF
+	rom[0x14D] = x
+	return rom
+
+src, clean, dirty = sys.argv[1:4]
+logo = open(src, "rb").read()[0x104:0x134]
+open(clean, "wb").write(build(logo, False))
+open(dirty, "wb").write(build(logo, True))
