diff --git a/rtl/mappers/mbc3.v b/rtl/mappers/mbc3.v
index 65000c8..d57daaa 100644
--- a/rtl/mappers/mbc3.v
+++ b/rtl/mappers/mbc3.v
@@ -11,6 +11,8 @@ module mbc3 (
 	inout      [15:0] savestate_back_b,
 
 	input             ce_32k,
+	input             rtc_emu,   // netplay: catch up saved time per emulated cycle
+	input             rtc_clr,   // netplay: clear the RTC (one cycle)
 	input      [32:0] RTC_time,
 	inout      [31:0] RTC_timestampOut_b,
 	inout      [47:0] RTC_savedtimeOut_b,
@@ -171,7 +173,8 @@ reg rtc_latch;
 reg RTC_saveLoaded_1;
 reg RTC_timestampNew_1; 
 reg [31:0] diffSeconds;
-wire       diffSeconds_fast_count = (diffSeconds > 0 && ~rtc_change);
+// netplay (rtc_emu): one second per emulated cycle, so both sides catch up alike
+wire       diffSeconds_fast_count = (diffSeconds > 0 && ~rtc_change && (~rtc_emu || ce_cpu));
 
 reg reset_1;
 
@@ -290,6 +293,23 @@ always @(posedge clk_sys) begin
 		end
 
 	end
+
+	if (rtc_clr) begin
+		rtc_subseconds     <= 0;
+		rtc_seconds        <= 0;
+		rtc_minutes        <= 0;
+		rtc_hours          <= 0;
+		rtc_days           <= 0;
+		rtc_overflow       <= 0;
+		rtc_halt           <= 0;
+		rtc_seconds_latch  <= 0;
+		rtc_minutes_latch  <= 0;
+		rtc_hours_latch    <= 0;
+		rtc_days_latch     <= 0;
+		rtc_overflow_latch <= 0;
+		rtc_latch          <= 0;
+		diffSeconds        <= 0;
+	end
 end
 
 assign rtc_return = 
