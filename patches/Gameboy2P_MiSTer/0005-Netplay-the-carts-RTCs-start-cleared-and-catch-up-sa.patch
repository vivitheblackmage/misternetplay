diff --git a/rtl/gb2p_machine.sv b/rtl/gb2p_machine.sv
index a1eeafd..317fcc8 100644
--- a/rtl/gb2p_machine.sv
+++ b/rtl/gb2p_machine.sv
@@ -198,6 +198,15 @@ always @(posedge clk_sys) begin
 		ce_32k <= !ce_32k_div;
 end
 
+// Netplay: the carts' RTCs start from a known state (SPEC.md 11.2). One pulse
+// when reset rises with rtc_emu; a .sav loaded during that reset then sets the
+// RTC registers as usual.
+reg rtc_hold_r = 0, rtc_clr = 0;
+always @(posedge clk_sys) begin
+	rtc_hold_r <= rtc_emu & reset;
+	rtc_clr    <= rtc_emu & reset & ~rtc_hold_r;
+end
+
 /////////////////////////////  Serial link  ///////////////////////////////
 
 wire sc1_int_clock_out;
@@ -274,6 +283,8 @@ cart_top cart1 (
 	.joystick_analog_0 ( joystick_analog_0 ),
 
 	.ce_32k           ( ce_32k           ),
+	.rtc_emu          ( rtc_emu          ),
+	.rtc_clr          ( rtc_clr          ),
 	.RTC_time         ( RTC_time         ),
 	.RTC_timestampOut ( RTC_timestampOut ),
 	.RTC_savedtimeOut ( RTC_savedtimeOut ),
@@ -462,6 +473,8 @@ cart_top cart2 (
 	.joystick_analog_0 ( joystick_analog_1 ),
 
 	.ce_32k           ( ce_32k           ),
+	.rtc_emu          ( rtc_emu          ),
+	.rtc_clr          ( rtc_clr          ),
 	.RTC_time         ( RTC_time         ),
 	.RTC_timestampOut (  ),
 	.RTC_savedtimeOut (  ),
diff --git a/rtl/mappers/huc3.v b/rtl/mappers/huc3.v
index 3f525ca..556077e 100644
--- a/rtl/mappers/huc3.v
+++ b/rtl/mappers/huc3.v
@@ -9,6 +9,8 @@ module huc3 (
 	inout [63:0]  savestate_back_b,
 
 	input         ce_32k,
+	input         rtc_emu,   // netplay: catch up saved time per emulated cycle
+	input         rtc_clr,   // netplay: clear the RTC (one cycle)
 	input [32:0]  RTC_time,
 	inout [31:0]  RTC_timestampOut_b,
 	inout [47:0]  RTC_savedtimeOut_b,
@@ -117,7 +119,8 @@ reg        RTC_saveLoaded;
 
 wire       rtc_subseconds_end = &rtc_subseconds;
 reg [31:0] diffSeconds;
-wire       diffSeconds_fast_count = (diffSeconds > 0);
+// netplay (rtc_emu): one second per emulated cycle, so both sides catch up alike
+wire       diffSeconds_fast_count = (diffSeconds > 0) && (~rtc_emu || ce_cpu);
 
 always @(posedge clk_sys) begin
 	if (ce_32k) rtc_subseconds <= rtc_subseconds + 1'b1;
@@ -216,6 +219,17 @@ always @(posedge clk_sys) begin
 		RTC_timestampOut <= RTC_time[31:0];
 	end
 
+	if (rtc_clr) begin
+		rtc_subseconds <= 0;
+		rtc_seconds    <= 0;
+		rtc_minutes    <= 0;
+		rtc_days       <= 0;
+		rtc_index      <= 0;
+		rtc_flags      <= 0;
+		rtc_out        <= 0;
+		diffSeconds    <= 0;
+	end
+
 end
 
 wire [1:0] ram_bank = ram_bank_reg & ram_mask[1:0];
