diff --git a/rtl/speedcontrol_shared.sv b/rtl/speedcontrol_shared.sv
new file mode 100644
index 0000000..1d46106
--- /dev/null
+++ b/rtl/speedcontrol_shared.sv
@@ -0,0 +1,80 @@
+// One clock-enable generator for both Game Boys (netplay, SPEC 11.1).
+//
+// Same enables and the same stall rule as speedcontrol.vhd, but one divider
+// for both cores: the enables are skipped while a ROM read of either core
+// waits for the SDRAM, while `hold` is 1 (the netplay freeze), and while either
+// pausevideo is 1. Both cores therefore see the same ce, ce_n and ce_2x on
+// every clk_sys, and SDRAM latency only changes wall-clock time, never the
+// order of events between the two cores. The divider restarts when reset
+// falls (the first clock after reset is a `ce`), so the phase after reset
+// does not depend on when reset was released. During reset it runs as
+// upstream (the ROM download's write handshake uses ce_2x).
+module speedcontrol_shared
+(
+	input      clk_sys,
+	input      reset,
+	input      romread1,
+	input      romack1,
+	input      romread2,
+	input      romack2,
+	input      pausevideo,
+	input      hold,
+	output reg ce    = 0,
+	output reg ce_n  = 0,
+	output reg ce_2x = 0
+);
+
+reg [2:0] clkdiv = 0;
+reg       wait1  = 0;
+reg       wait2  = 0;
+reg       reset_r = 1;
+
+always @(negedge clk_sys) begin
+	reg skip;
+
+	// a freeze right after reset keeps the restart pending
+	reset_r <= reset | (reset_r & (pausevideo | hold));
+
+	ce    <= 0;
+	ce_n  <= 0;
+	ce_2x <= 0;
+	skip   = 0;
+
+	clkdiv <= clkdiv + 3'd1;
+	if (clkdiv == 3'b000)     ce    <= 1;
+	if (clkdiv == 3'b100)     ce_n  <= 1;
+	if (clkdiv[1:0] == 2'b00) ce_2x <= 1;
+
+	if (reset) begin
+		wait1  <= 0;
+		wait2  <= 0;
+	end else if (reset_r) begin
+		// first clock after reset: phase 0, as clkdiv == 000
+		ce     <= 1;
+		ce_n   <= 0;
+		ce_2x  <= 1;
+		clkdiv <= 3'b001;
+	end else begin
+		if (!wait1) begin
+			if (romread1) wait1 <= 1;
+		end else if (romack1) wait1 <= 0;
+		else skip = 1;
+
+		if (!wait2) begin
+			if (romread2) wait2 <= 1;
+		end else if (romack2) wait2 <= 0;
+		else skip = 1;
+	end
+
+	if (pausevideo | hold) skip = 1;
+
+	if (skip) begin
+		ce    <= 0;
+		ce_n  <= 0;
+		ce_2x <= 0;
+		if (!reset && !reset_r && clkdiv == 3'b100) clkdiv <= 3'b001;
+		if (!reset && !reset_r && clkdiv == 3'b000) clkdiv <= 3'b101;
+	end
+end
+
+endmodule
