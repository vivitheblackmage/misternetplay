diff --git a/rtl/netplay.sv b/rtl/netplay.sv
new file mode 100644
index 0000000..628dc8e
--- /dev/null
+++ b/rtl/netplay.sv
@@ -0,0 +1,411 @@
+// netplay.sv
+//
+// Delay-based lockstep netplay for the Game Boy 2P core (SPEC.md, section 11).
+//
+// Each MiSTer runs both Game Boys; the network carries only input. The FPGA
+// side never touches the network. It exchanges per-frame input with
+// Main_MiSTer through a mailbox in DDR3 (SPEC.md 4 and 11.3):
+//
+//   - A frame is 70224 emulated `ce` (SPEC.md 11.2), counted from the first
+//     `ce` after hold_reset falls. On the `ce` that starts frame k it applies
+//     INPUT[k], samples the local pad and posts LOCAL[k], and posts CRC[k-1].
+//   - It keeps a two-entry lookahead of INPUT[] read back from the mailbox.
+//     If INPUT[k] is not in hand when frame k is due, `hold` stops the shared
+//     clock enable (rtl/speedcontrol_shared.sv) before that `ce` until it is.
+//
+// clk is clk_sys. `ce` is the shared 4 MHz enable of both Game Boys (gb2p_machine
+// ce1_cpu): everything that must follow emulated time changes only on it.
+//
+// This program is GPL licensed. See COPYING for the full license.
+
+module netplay #(
+	parameter int          POLL_INTERVAL  = 256,          // clocks between INPUT polls
+	parameter int          CTRL_INTERVAL  = 4096,         // clocks between CTRL reads
+	parameter int          CE_PER_FRAME   = 70224,        // 154 lines x 456 dots
+	parameter logic [31:0] BASE           = 32'h3C000000  // physical byte address of the mailbox
+)
+(
+	input             clk,
+	input             reset,          // power-on only, never on ROM load
+	input             downloading,    // a ROM or boot ROM load is in progress
+
+	// the emulated machine
+	input             ce,             // the shared clock enable of both Game Boys
+	input             lcd1_clkena,
+	input      [14:0] lcd1_data,
+	input             lcd2_clkena,
+	input      [14:0] lcd2_data,
+	input       [3:0] link,           // {ser2_data, ser2_clk, ser1_data, ser1_clk} out of the cores
+
+	input       [7:0] local_joy,      // joystick_0[7:0] as the framework delivers it
+
+	output            active,
+	output            hold_reset,
+	output            hold,           // skip the clock enables (speedcontrol_shared)
+	output reg        is_join,        // CTRL[2]: this side plays gb2 (rumble goes to the local pad)
+	output reg  [7:0] joy_p1,
+	output reg  [7:0] joy_p2,
+
+	// DDR3 channel (rtl/np_ddram.sv, toggle handshake: req != ack = busy)
+	output reg [31:3] ddr_addr,
+	output reg [63:0] ddr_din,
+	input      [63:0] ddr_dout,
+	output reg        ddr_we,
+	output reg        ddr_req,
+	input             ddr_ack,
+
+	// observation
+	output      [2:0] state_o,
+	output     [31:0] frame_o,
+	output      [7:0] error_o
+);
+
+// ---------------------------------------------------------------------------
+// Mailbox layout (byte offsets from BASE), SPEC.md 4 and 11.3
+localparam logic [15:0] OFF_MAGIC  = 16'h0000;
+localparam logic [15:0] OFF_STATUS = 16'h0008;
+localparam logic [15:0] OFF_CTRL   = 16'h0010;
+localparam logic [15:0] OFF_LOCAL  = 16'h1000;
+localparam logic [15:0] OFF_CRC    = 16'h1800;
+localparam logic [15:0] OFF_INPUT  = 16'h2000;
+
+localparam logic [63:0] MAGIC = 64'h3130504E50324247; // "GB2PNP01"
+// CTRL is only believed with this in its upper half. DDR3 is not cleared when
+// cores change, so a stray word left by another core must never arm netplay.
+localparam logic [31:0] CTRL_MAGIC = 32'h4C525443;      // "CTRL"
+
+localparam logic [2:0] S_IDLE  = 3'd0;
+localparam logic [2:0] S_ARMED = 3'd1;
+localparam logic [2:0] S_PRIME = 3'd2;
+localparam logic [2:0] S_RUN   = 3'd3;
+localparam logic [2:0] S_ERROR = 3'd4;
+
+localparam int ERR_CTRL_DROP = 1;
+localparam int ERR_RELOAD    = 2;
+
+localparam logic [31:0] CRC_INIT = 32'hFFFFFFFF;
+localparam logic [16:0] CE_LAST  = 17'(CE_PER_FRAME);
+
+function automatic logic [31:0] crc_byte(input logic [31:0] c, input logic [7:0] d);
+	logic [31:0] x;
+	x = c ^ {24'd0, d};
+	for (int i = 0; i < 8; i++)
+		x = x[0] ? ((x >> 1) ^ 32'hEDB88320) : (x >> 1);
+	return x;
+endfunction
+
+function automatic logic [31:0] crc_joy(input logic [7:0] p1, input logic [7:0] p2);
+	return crc_byte(crc_byte(CRC_INIT, p1), p2);
+endfunction
+
+function automatic logic [31:3] waddr(input logic [15:3] off);
+	return BASE[31:3] + {16'd0, off};
+endfunction
+
+function automatic logic [15:3] ring(input logic [15:3] base_off, input logic [7:0] slot);
+	return base_off + {5'd0, slot};
+endfunction
+
+// ---------------------------------------------------------------------------
+// State
+
+logic [2:0]  state;
+logic [31:0] frame;
+logic [7:0]  error;
+logic [15:0] stalls;
+logic [7:0]  sess;
+
+// Lookahead: slot 0 holds INPUT[base], slot 1 INPUT[base+1], where base is
+// the first frame not started yet (0 in PRIME, frame+1 in RUN).
+logic        have0, have1;
+logic [7:0]  a_p1, a_p2;      // slot 0
+logic [7:0]  b_p1, b_p2;      // slot 1
+logic [31:0] crc;
+
+// Emulated time: ce seen in the current frame (1..CE_PER_FRAME)
+logic [16:0] ce_cnt;
+logic  [3:0] link_prev;
+
+wire         at_tick  = (state == S_RUN) && (ce_cnt == CE_LAST);   // the next ce starts a frame
+assign hold           = (at_tick && !have0) || (state == S_ERROR && !downloading);
+wire         consume  = at_tick && have0 && ce;                     // frame k starts on this ce
+
+assign active     = (state != S_IDLE);
+assign hold_reset = (state == S_ARMED) || (state == S_PRIME);
+
+assign state_o = state;
+assign frame_o = frame;
+assign error_o = error;
+
+// What this ce adds to the CRC: gb1's pixel, gb2's pixel, the link lines
+// when they changed (they cover frames with both LCDs off).
+function automatic logic [31:0] crc_ce(input logic [31:0] c);
+	logic [31:0] x;
+	x = c;
+	if (lcd1_clkena) x = crc_byte(crc_byte(x, lcd1_data[7:0]), {1'b0, lcd1_data[14:8]});
+	if (lcd2_clkena) x = crc_byte(crc_byte(x, lcd2_data[7:0]), {1'b0, lcd2_data[14:8]});
+	if (link != link_prev) x = crc_byte(x, {4'd0, link});
+	return x;
+endfunction
+
+// Pending mailbox work
+logic        p_ctrl_clr, p_magic, p_status, p_local, p_crc;
+logic [15:0] local_frame;
+logic [7:0]  local_val;
+logic [15:0] crc_frame;
+logic [31:0] crc_val;
+logic        hold_prev;
+
+// Poll timers
+logic [15:0] poll_cnt, ctrl_cnt;
+logic        poll_due, ctrl_due;
+
+// DDR sequencer
+localparam logic [2:0] OP_NONE    = 3'd0;
+localparam logic [2:0] OP_MAGIC   = 3'd1;
+localparam logic [2:0] OP_CRC     = 3'd2;
+localparam logic [2:0] OP_LOCAL   = 3'd3;
+localparam logic [2:0] OP_STATUS  = 3'd4;
+localparam logic [2:0] OP_CTRL    = 3'd5;
+localparam logic [2:0] OP_INPUT   = 3'd6;
+localparam logic [2:0] OP_CTRLCLR = 3'd7;
+
+logic [2:0]  op;
+logic [31:0] op_frame;   // INPUT frame being fetched
+wire         ddr_done = (op != OP_NONE) && (ddr_req == ddr_ack);
+
+wire  [31:0] base       = (state == S_PRIME) ? 32'd0 : frame + 32'd1;
+wire         fetching   = (state == S_PRIME) || (state == S_RUN);
+wire         need_input = fetching && !(have0 && have1);
+wire  [31:0] want_frame = have0 ? base + 32'd1 : base;
+
+wire         ctrl_ok  = (ddr_dout[63:32] == CTRL_MAGIC);
+wire         ctrl_en  = ctrl_ok & ddr_dout[0];
+wire         ctrl_run = ctrl_ok & ddr_dout[1];
+
+wire  [63:0] status_word = {frame, 5'd0, state, error, stalls};
+
+// Tag check for INPUT entries: both halves must carry frame tag and session.
+wire  [31:0] in_hi = ddr_dout[63:32];
+wire  [31:0] in_lo = ddr_dout[31:0];
+wire         in_ok = (in_hi[31:16] == op_frame[15:0]) && (in_lo[31:16] == op_frame[15:0])
+                  && (in_hi[15:8] == sess)            && (in_lo[15:8] == sess);
+
+always_ff @(posedge clk) begin
+	hold_prev <= hold;
+
+	// timers
+	if (poll_cnt == POLL_INTERVAL[15:0] - 16'd1) begin poll_cnt <= 16'd0; poll_due <= 1'b1; end
+	else poll_cnt <= poll_cnt + 16'd1;
+	if (ctrl_cnt == CTRL_INTERVAL[15:0] - 16'd1) begin ctrl_cnt <= 16'd0; ctrl_due <= 1'b1; end
+	else ctrl_cnt <= ctrl_cnt + 16'd1;
+
+	// -----------------------------------------------------------------------
+	// Per-frame work in RUN
+	if (state == S_RUN) begin
+		if (hold && !hold_prev && stalls != 16'hFFFF) stalls <= stalls + 16'd1;
+
+		if (ce) link_prev <= link;
+
+		if (consume) begin
+			frame       <= frame + 32'd1;
+			joy_p1      <= a_p1;
+			joy_p2      <= a_p2;
+			// shift the lookahead
+			have0       <= have1;
+			a_p1        <= b_p1;
+			a_p2        <= b_p2;
+			have1       <= 1'b0;
+
+			crc_frame   <= frame[15:0];
+			crc_val     <= crc;
+			p_crc       <= 1'b1;
+
+			local_frame <= frame[15:0] + 16'd1;
+			local_val   <= local_joy;
+			p_local     <= 1'b1;
+
+			p_status    <= 1'b1;
+			// this ce is the first of the new frame
+			ce_cnt      <= 17'd1;
+			crc         <= crc_ce(crc_joy(a_p1, a_p2));
+		end
+		else if (ce) begin
+			ce_cnt      <= ce_cnt + 17'd1;
+			crc         <= crc_ce(crc);
+		end
+
+		if (downloading) begin
+			error[ERR_RELOAD] <= 1'b1;
+			state    <= S_ERROR;
+			p_status <= 1'b1;
+		end
+	end
+
+	if (state == S_PRIME && downloading) begin
+		error[ERR_RELOAD] <= 1'b1;
+		state    <= S_ERROR;
+		p_status <= 1'b1;
+	end
+
+	// PRIME -> RUN once INPUT[0] and INPUT[1] are in hand: release reset with
+	// INPUT[0] applied; frame 0 starts at the first ce after that (the shared
+	// speed control restarts its divider when reset falls). INPUT[1] is slot 0
+	// for the first tick.
+	if (state == S_PRIME && have0 && have1 && !downloading) begin
+		state       <= S_RUN;
+		frame       <= 32'd0;
+		ce_cnt      <= 17'd0;
+		link_prev   <= link;
+		joy_p1      <= a_p1;
+		joy_p2      <= a_p2;
+		have0       <= 1'b1;
+		a_p1        <= b_p1;
+		a_p2        <= b_p2;
+		have1       <= 1'b0;
+		local_frame <= 16'd0;
+		local_val   <= local_joy;
+		p_local     <= 1'b1;
+		p_status    <= 1'b1;
+		crc         <= crc_joy(a_p1, a_p2);
+	end
+
+	// -----------------------------------------------------------------------
+	// DDR sequencer: one outstanding request at a time.
+	if (op == OP_NONE) begin
+		if (p_ctrl_clr) begin
+			// Before MAGIC: once Main_MiSTer sees MAGIC, CTRL is known clean.
+			op <= OP_CTRLCLR; ddr_addr <= waddr(OFF_CTRL[15:3]);   ddr_din <= 64'd0;       ddr_we <= 1'b1; ddr_req <= ~ddr_req;
+		end
+		else if (p_magic) begin
+			op <= OP_MAGIC;   ddr_addr <= waddr(OFF_MAGIC[15:3]);  ddr_din <= MAGIC;       ddr_we <= 1'b1; ddr_req <= ~ddr_req;
+		end
+		else if (p_crc) begin
+			op <= OP_CRC;     ddr_addr <= waddr(ring(OFF_CRC[15:3], crc_frame[7:0]));
+			ddr_din <= {crc_frame, crc_val[31:16], crc_frame, crc_val[15:0]};
+			ddr_we <= 1'b1; ddr_req <= ~ddr_req;
+		end
+		else if (p_local) begin
+			op <= OP_LOCAL;   ddr_addr <= waddr(ring(OFF_LOCAL[15:3], local_frame[7:0]));
+			ddr_din <= {local_frame, sess, local_val, local_frame, sess, local_val};
+			ddr_we <= 1'b1; ddr_req <= ~ddr_req;
+		end
+		else if (p_status) begin
+			op <= OP_STATUS;  ddr_addr <= waddr(OFF_STATUS[15:3]); ddr_din <= status_word; ddr_we <= 1'b1; ddr_req <= ~ddr_req;
+		end
+		else if (ctrl_due) begin
+			op <= OP_CTRL;    ddr_addr <= waddr(OFF_CTRL[15:3]);   ddr_we <= 1'b0; ddr_req <= ~ddr_req;
+		end
+		else if (poll_due && need_input) begin
+			op <= OP_INPUT;   ddr_addr <= waddr(ring(OFF_INPUT[15:3], want_frame[7:0]));
+			op_frame <= want_frame;
+			ddr_we <= 1'b0; ddr_req <= ~ddr_req;
+		end
+	end
+	else if (ddr_done) begin
+		op <= OP_NONE;
+		case (op)
+			OP_CTRLCLR: p_ctrl_clr <= 1'b0;
+			OP_MAGIC:  p_magic  <= 1'b0;
+			OP_CRC:    p_crc    <= 1'b0;
+			OP_LOCAL:  p_local  <= 1'b0;
+			OP_STATUS: p_status <= 1'b0;
+			OP_INPUT: begin
+				poll_due <= 1'b0;
+				// A frame starting in this very cycle shifts the lookahead; drop the
+				// word and let the next poll fetch it again rather than race the
+				// shift. A start earlier in flight moves base, so match op_frame afresh.
+				if (in_ok && fetching && !consume) begin
+					if (!have0 && op_frame == base) begin
+						a_p1  <= in_lo[7:0];
+						a_p2  <= in_hi[7:0];
+						have0 <= 1'b1;
+					end
+					else if (have0 && !have1 && op_frame == base + 32'd1) begin
+						b_p1  <= in_lo[7:0];
+						b_p2  <= in_hi[7:0];
+						have1 <= 1'b1;
+					end
+				end
+			end
+			OP_CTRL: begin
+				ctrl_due <= 1'b0;
+				// without the magic the word means "disabled"
+				case (state)
+					S_IDLE: if (ctrl_en) begin
+						state     <= S_ARMED;
+						sess      <= ddr_dout[15:8];
+						is_join   <= ddr_dout[2];
+						error     <= 8'd0;
+						stalls    <= 16'd0;
+						frame     <= 32'd0;
+						have0     <= 1'b0;
+						have1     <= 1'b0;
+						p_status  <= 1'b1;
+					end
+					S_ARMED: begin
+						if (!ctrl_en)     begin state <= S_IDLE;  p_status <= 1'b1; end
+						else if (ctrl_run) begin state <= S_PRIME; p_status <= 1'b1; end
+					end
+					S_PRIME, S_ERROR: if (!ctrl_en) begin
+						state    <= S_IDLE;
+						p_status <= 1'b1;
+						p_local  <= 1'b0;
+						p_crc    <= 1'b0;
+					end
+					S_RUN: if (!ctrl_en) begin
+						error[ERR_CTRL_DROP] <= 1'b1;
+						state    <= S_IDLE;
+						p_status <= 1'b1;
+						p_local  <= 1'b0;
+						p_crc    <= 1'b0;
+					end
+					default: ;
+				endcase
+			end
+			default: ;
+		endcase
+	end
+
+	if (reset) begin
+		state     <= S_IDLE;
+		frame     <= 32'd0;
+		error     <= 8'd0;
+		stalls    <= 16'd0;
+		sess      <= 8'd0;
+		is_join   <= 1'b0;
+		have0     <= 1'b0;
+		have1     <= 1'b0;
+		a_p1      <= 8'd0;
+		a_p2      <= 8'd0;
+		b_p1      <= 8'd0;
+		b_p2      <= 8'd0;
+		joy_p1    <= 8'd0;
+		joy_p2    <= 8'd0;
+		crc       <= CRC_INIT;
+		ce_cnt    <= 17'd0;
+		link_prev <= 4'd0;
+		p_ctrl_clr <= 1'b1;
+		p_magic   <= 1'b1;
+		p_status  <= 1'b1;
+		p_local   <= 1'b0;
+		p_crc     <= 1'b0;
+		poll_cnt  <= 16'd0;
+		ctrl_cnt  <= 16'd0;
+		poll_due  <= 1'b0;
+		ctrl_due  <= 1'b1;
+		op        <= OP_NONE;
+		op_frame  <= 32'd0;
+		ddr_we    <= 1'b0;
+		ddr_addr  <= '0;
+		ddr_din   <= '0;
+		local_frame <= 16'd0;
+		local_val   <= 8'd0;
+		crc_frame   <= 16'd0;
+		crc_val     <= 32'd0;
+		hold_prev   <= 1'b0;
+		// ddr_req is not reset: it must keep matching ddr_ack across a reset
+	end
+end
+
+endmodule
diff --git a/rtl/np_ddram.sv b/rtl/np_ddram.sv
new file mode 100644
index 0000000..91b76ed
--- /dev/null
+++ b/rtl/np_ddram.sv
@@ -0,0 +1,76 @@
+// np_ddram.sv
+//
+// The netplay mailbox's DDR3 port (SPEC.md 11.3). The core does not otherwise
+// use DDR3, so this is its only master: single 64-bit words, toggle handshake
+// (req != ack = busy), no cache (the HPS writes the mailbox behind its back).
+// Read data is taken even when DDRAM_BUSY is high in the same cycle.
+//
+// This program is GPL licensed. See COPYING for the full license.
+
+module np_ddram
+(
+	input             DDRAM_CLK,
+	input             DDRAM_BUSY,
+	output      [7:0] DDRAM_BURSTCNT,
+	output     [28:0] DDRAM_ADDR,
+	input      [63:0] DDRAM_DOUT,
+	input             DDRAM_DOUT_READY,
+	output            DDRAM_RD,
+	output     [63:0] DDRAM_DIN,
+	output      [7:0] DDRAM_BE,
+	output            DDRAM_WE,
+
+	input      [31:3] addr,
+	input      [63:0] din,
+	input             we,
+	output reg [63:0] dout,
+	input             req,
+	output reg        ack = 0
+);
+
+reg [28:0] ram_address = 0;
+reg [63:0] ram_data    = 0;
+reg        ram_read    = 0;
+reg        ram_write   = 0;
+reg  [1:0] state       = 0;   // 0 idle, 1 read issued, 2 write issued
+
+assign DDRAM_BURSTCNT = 8'd1;
+assign DDRAM_ADDR     = ram_address;
+assign DDRAM_RD       = ram_read;
+assign DDRAM_WE       = ram_write;
+assign DDRAM_DIN      = ram_data;
+assign DDRAM_BE       = 8'hFF;
+
+always @(posedge DDRAM_CLK) begin
+	if (state == 1 && DDRAM_DOUT_READY) begin
+		dout  <= DDRAM_DOUT;
+		ack   <= req;
+		state <= 0;
+	end
+
+	if (!DDRAM_BUSY) begin
+		ram_read  <= 0;
+		ram_write <= 0;
+		case (state)
+			0: if (req != ack) begin
+					ram_address <= addr[31:3];
+					if (we) begin
+						ram_data  <= din;
+						ram_write <= 1;
+						state     <= 2;
+					end
+					else begin
+						ram_read  <= 1;
+						state     <= 1;
+					end
+				end
+			2: begin
+					ack   <= req;   // the write was accepted
+					state <= 0;
+				end
+			default: ;
+		endcase
+	end
+end
+
+endmodule
