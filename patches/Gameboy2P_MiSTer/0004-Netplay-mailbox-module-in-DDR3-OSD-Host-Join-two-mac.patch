+
+// ---------------------------------------------------------------------------
+// --netplay (T2n, SPEC 11.7): two MiSTers (host and join), each with the
+// netplay module, a fake HPS (SPEC 4: session start, combining LOCAL into
+// INPUT) and a network with random latency between them. Passes when both
+// post the same CRC for every frame.
+
+static const uint32_t NP_BASE = 0x3C000000;
+static const uint32_t OFF_MAGIC = 0x0000, OFF_STATUS = 0x0008, OFF_CTRL = 0x0010;
+static const uint32_t OFF_LOCAL = 0x1000, OFF_CRC = 0x1800, OFF_INPUT = 0x2000;
+static const uint64_t NP_MAGIC = 0x3130504E50324247ULL;   // "GB2PNP01"
+static const uint64_t CTRL_MAGIC = 0x4C525443ULL;         // "CTRL"
+
+struct FakeHps {
+	Side &s;
+	bool host;
+	int delay;
+	uint8_t sess;
+	int phase = 0;                      // 0 wait MAGIC, 1 reloading, 2 running
+	uint64_t arm_at = 0;                // when "the user starts the session" on this side
+	uint64_t t_loaded = 0;
+	uint64_t settle = 200000;           // after the load (Main waits for the .sav)
+	const std::vector<uint8_t> *rom;    // the session's ROM
+	uint32_t next_local = 0;
+	std::map<uint32_t, uint8_t> mine, peer;   // LOCAL by frame
+	uint32_t next_input;
+	std::map<uint32_t, uint32_t> crcs;
+	uint32_t next_crc = 0;
+
+	FakeHps(Side &ss, bool h, int d, uint8_t sid, const std::vector<uint8_t> *r)
+		: s(ss), host(h), delay(d), sess(sid), rom(r), next_input(d) {}
+
+	uint64_t rd(uint32_t off) { auto it = s.ddr.find(NP_BASE + off); return it == s.ddr.end() ? 0 : it->second; }
+	void wr(uint32_t off, uint64_t v) { s.ddr[NP_BASE + off] = v; }
+	uint32_t half(uint32_t f, uint8_t v) { return ((f & 0xFFFF) << 16) | ((uint32_t)sess << 8) | v; }
+	uint64_t input_word(uint32_t f, uint8_t p1, uint8_t p2) { return ((uint64_t)half(f, p2) << 32) | half(f, p1); }
+
+	void poll(uint64_t now, std::vector<std::pair<uint32_t, uint8_t>> &send) {
+		if (phase == 0) {
+			if (now < arm_at || rd(OFF_MAGIC) != NP_MAGIC) return;
+			for (uint32_t i = 0; i < 256; i++) {
+				wr(OFF_LOCAL + i * 8, 0xFFFF000000000000ULL);
+				wr(OFF_CRC + i * 8, 0xFFFF000000000000ULL);
+				wr(OFF_INPUT + i * 8, 0xFFFF000000000000ULL);
+			}
+			wr(OFF_CTRL, (CTRL_MAGIC << 32) | ((uint64_t)sess << 8) | (host ? 0 : 4) | 1);
+			s.rom = *rom;
+			s.reload();      // the session's ROM load (the module is ARMED by the next CTRL read or so)
+			phase = 1;
+			return;
+		}
+		if (phase == 1) {
+			if (s.dl_state != 3) return;
+			if (!t_loaded) t_loaded = now;
+			if (now - t_loaded < settle) return;
+			for (int f = 0; f < delay; f++) wr(OFF_INPUT + (f & 0xFF) * 8, input_word(f, 0, 0));
+			wr(OFF_CTRL, (CTRL_MAGIC << 32) | ((uint64_t)sess << 8) | (host ? 0 : 4) | 3);
+			phase = 2;
+			return;
+		}
+		for (;;) {
+			uint64_t w = rd(OFF_LOCAL + (next_local & 0xFF) * 8);
+			uint32_t hi = w >> 32, lo = (uint32_t)w;
+			if (hi != lo || (hi >> 16) != (next_local & 0xFFFF) || ((hi >> 8) & 0xFF) != sess) break;
+			mine[next_local] = lo & 0xFF;
+			send.push_back({next_local, (uint8_t)(lo & 0xFF)});
+			next_local++;
+		}
+		for (;;) {
+			uint32_t f = next_input - delay;
+			if (!mine.count(f) || !peer.count(f)) break;
+			uint8_t p1 = host ? mine[f] : peer[f], p2 = host ? peer[f] : mine[f];
+			wr(OFF_INPUT + (next_input & 0xFF) * 8, input_word(next_input, p1, p2));
+			next_input++;
+		}
+		for (;;) {
+			uint64_t w = rd(OFF_CRC + (next_crc & 0xFF) * 8);
+			uint32_t hi = w >> 32, lo = (uint32_t)w;
+			uint32_t tag = next_crc & 0xFFFF;
+			if ((hi >> 16) != tag || (lo >> 16) != tag) break;
+			crcs[next_crc] = ((hi & 0xFFFF) << 16) | (lo & 0xFFFF);
+			next_crc++;
+		}
+	}
+};
+
+static int run_netplay(const char *rom_path, const char *dirty_path, int dirty_frames, int frames, uint64_t seed,
+                       int delay, uint64_t max_lat, const std::map<uint64_t, std::pair<uint8_t, uint8_t>> *script)
+{
+	auto rom = load(rom_path);
+	std::vector<uint8_t> dirty = dirty_path ? load(dirty_path) : std::vector<uint8_t>();
+	auto *ctx = new VerilatedContext;
+	Side H, J;
+	H.m = new Vgb2p_side{ctx, "H"}; H.name = "host";
+	J.m = new Vgb2p_side{ctx, "J"}; J.name = "join";
+	auto ext_index = [](const char *p) {
+		std::string r = p, ext = r.size() >= 4 ? r.substr(r.size() - 4) : "";
+		for (auto &ch : ext) ch = tolower(ch);
+		return (uint8_t)(ext == ".gbc" ? 0x01 : ext == ".bin" ? 0x81 : 0x41);
+	};
+	for (Side *s : {&H, &J}) {
+		s->rom = rom; s->index = ext_index(rom_path);
+		s->np_mode = true; s->jitter = true;
+		s->m->shared_ce = 1; s->m->sys_select = 0; s->m->rom_load_gb2 = 0;
+		s->m->reset_in = 1; s->m->hold = 0; s->m->jitter = 0; s->m->np_ddr_ack = 0;
+		s->eval_half(0, 0);
+	}
+	H.rng.seed(seed * 7 + 1); J.rng.seed(seed * 13 + 2);
+	if (dirty_path) { J.rom = dirty; J.index = ext_index(dirty_path); }   // the join ran another game first
+
+	FakeHps hh(H, true, delay, 0x5A, &rom), hj(J, false, delay, 0x5A, &rom);
+	std::mt19937_64 r(seed);
+	const uint64_t FRAME_CLK = CE_PER_FRAME * 8;
+	hh.arm_at = 300000;
+	hj.arm_at = 300000 + (dirty_path ? (uint64_t)dirty_frames * FRAME_CLK : 0) + r() % (3 * FRAME_CLK);
+	hj.settle += r() % FRAME_CLK;
+	printf("join arms %llu cycles after the host%s\n", (unsigned long long)(hj.arm_at - hh.arm_at),
+	       dirty_path ? " (after running the other ROM)" : "");
+	fflush(stdout);
+
+	struct Pkt { uint64_t at; uint32_t f; uint8_t joy; };
+	std::deque<Pkt> to_j, to_h;
+	uint64_t now = 0, h_hold = 0, j_hold = 0;
+	uint64_t max_cycles = hj.arm_at + (uint64_t)(frames + 20) * FRAME_CLK * 3;
+	uint64_t pad_seed = seed * 31 + 5;
+	auto rnd = [&]() { pad_seed ^= pad_seed << 13; pad_seed ^= pad_seed >> 7; pad_seed ^= pad_seed << 17; return pad_seed; };
+	uint32_t last_report = 0;
+	while (now < max_cycles) {
+		H.step(nullptr, false); J.step(nullptr, false); now++;
+		h_hold += H.m->np_hold; j_hold += J.m->np_hold;
+		// local pads change at random wall-clock moments (and the dirty run gets some too)
+		if (script) {
+			// the script's p1 is the host's pad, p2 the join's, by each side's own frame
+			auto at = [&](uint32_t f, bool p2) -> uint8_t {
+				auto it = script->upper_bound(f);
+				if (it == script->begin()) return 0;
+				--it; return p2 ? it->second.second : it->second.first;
+			};
+			H.pad = hh.phase == 2 ? at(H.m->np_frame, false) : 0;
+			J.pad = hj.phase == 2 ? at(J.m->np_frame, true) : 0;
+		} else {
+			if (rnd() % 200000 == 0) H.pad = rnd() & 0xFF;
+			if (rnd() % 200000 == 0) J.pad = rnd() & 0xFF;
+		}
+		if (now % 64) continue;
+		std::vector<std::pair<uint32_t, uint8_t>> sh, sj;
+		hh.poll(now, sh); hj.poll(now, sj);
+		for (auto &x : sh) to_j.push_back({ now + r() % (max_lat + 1), x.first, x.second });
+		for (auto &x : sj) to_h.push_back({ now + r() % (max_lat + 1), x.first, x.second });
+		// UDP may reorder; the HPS keeps samples by frame, so delivery order does not matter
+		for (auto it = to_j.begin(); it != to_j.end();) { if (it->at <= now) { hj.peer[it->f] = it->joy; it = to_j.erase(it); } else ++it; }
+		for (auto it = to_h.begin(); it != to_h.end();) { if (it->at <= now) { hh.peer[it->f] = it->joy; it = to_h.erase(it); } else ++it; }
+		if (H.m->np_error || J.m->np_error || H.m->np_state == 4 || J.m->np_state == 4) {
+			printf("FAIL: netplay error host %02x join %02x\n", H.m->np_error, J.m->np_error);
+			return 1;
+		}
+		uint32_t n = std::min(hh.next_crc, hj.next_crc);
+		if (n && n / 60 != last_report) {
+			last_report = n / 60;
+			printf("frame %u: host stalls %llu, join stalls %llu\n", n, (unsigned long long)(hh.rd(OFF_STATUS) & 0xFFFF),
+			       (unsigned long long)(hj.rd(OFF_STATUS) & 0xFFFF));
+			fflush(stdout);
+			for (uint32_t f = 0; f < n; f++)
+				if (hh.crcs[f] != hj.crcs[f]) { printf("FAIL: CRC mismatch at frame %u: host %08x join %08x\n", f, hh.crcs[f], hj.crcs[f]); return 1; }
+		}
+		if (n > (uint32_t)frames) break;
+	}
+	int bad = 0;
+	uint32_t n = std::min(hh.next_crc, hj.next_crc);
+	for (uint32_t f = 0; f < n; f++)
+		if (hh.crcs[f] != hj.crcs[f]) { if (bad++ < 5) printf("CRC mismatch frame %u: host %08x join %08x\n", f, hh.crcs[f], hj.crcs[f]); }
+	std::set<uint32_t> distinct;
+	for (auto &x : hh.crcs) distinct.insert(x.second);
+	printf("%u frames compared, %d CRC mismatches, %zu distinct CRCs; held cycles host %llu join %llu; "
+	       "stalls host %u join %u; delay %d, latency up to %llu cycles\n",
+	       n, bad, distinct.size(), (unsigned long long)h_hold, (unsigned long long)j_hold,
+	       (unsigned)(hh.rd(OFF_STATUS) & 0xFFFF), (unsigned)(hj.rd(OFF_STATUS) & 0xFFFF), delay,
+	       (unsigned long long)max_lat);
+	bool ok = n > (uint32_t)frames && !bad && distinct.size() > 1;
+	printf("%s netplay\n", ok ? "PASS" : "FAIL");
+	return ok ? 0 : 1;
+}
+
 int main(int argc, char **argv) {
 	if (argc < 2) { fprintf(stderr, "usage: gb2p_sim ROM [options]\n"); return 2; }
 	const char *rom = argv[1];
+	// --netplay SEED [--delay D] [--latency CYCLES] [--dirty ROM2 FRAMES] [--frames N]
+	for (int i = 2; i < argc; i++) if (!strcmp(argv[i], "--netplay")) {
+		if (FILE *f = fopen("build/cgb_boot.hex", "r")) fclose(f);
+		else { fprintf(stderr, "build/cgb_boot.hex not found: run from the npsim directory\n"); return 2; }
+		uint64_t seed = i + 1 < argc ? strtoull(argv[i + 1], 0, 0) : 1;
+		int nf = 300, d = 3, df = 0; uint64_t lat = 400000; const char *dirty = nullptr;
+		std::map<uint64_t, std::pair<uint8_t, uint8_t>> scr; bool use_scr = false;
+		for (int k = 2; k < argc; k++) {
+			if (!strcmp(argv[k], "--frames") && k + 1 < argc) nf = atoi(argv[++k]);
+			else if (!strcmp(argv[k], "--delay") && k + 1 < argc) d = atoi(argv[++k]);
+			else if (!strcmp(argv[k], "--latency") && k + 1 < argc) lat = strtoull(argv[++k], 0, 0);
+			else if (!strcmp(argv[k], "--dirty") && k + 2 < argc) { dirty = argv[++k]; df = atoi(argv[++k]); }
+			else if (!strcmp(argv[k], "--script") && k + 1 < argc) {
+				FILE *f = fopen(argv[++k], "r");
+				if (!f) { perror("script"); return 2; }
+				char line[256];
+				while (fgets(line, sizeof line, f)) {
+					if (char *h = strchr(line, '#')) *h = 0;
+					unsigned long long fr; unsigned a1, a2;
+					if (sscanf(line, "%llu %x %x", &fr, &a1, &a2) == 3) scr[fr] = {(uint8_t)a1, (uint8_t)a2};
+				}
+				fclose(f);
+				use_scr = true;
+			}
+		}
+		return run_netplay(rom, dirty, df, nf, seed, d, lat, use_scr ? &scr : nullptr);
+	}
 	uint64_t frames = 60, seed = 1, offset = 12345;
 	bool shared = true, freeze = true, jitter = true, quiet = false;
 	int p1 = 0, p2 = 0, sys = 0;
