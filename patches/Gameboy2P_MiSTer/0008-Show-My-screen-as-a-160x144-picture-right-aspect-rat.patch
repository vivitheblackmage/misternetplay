From 6f265c75915285302343b083d4ff31849b20ee5e Mon Sep 17 00:00:00 2001
From: netplay <netplay@localhost>
Date: Sat, 7 Nov 2026 21:26:48 +0100
Subject: [PATCH] Show My screen as a 160x144 picture (right aspect ratio), and
 My screen zoom (middle 120 lines, 4:3)
---
 Gameboy.sv | 15 ++++++++-------
 rtl/lcd.v  | 17 +++++++----------
 2 files changed, 15 insertions(+), 17 deletions(-)

diff --git a/Gameboy.sv b/Gameboy.sv
index 8ce80e8..097d9f4 100644
--- a/Gameboy.sv
+++ b/Gameboy.sv
@@ -208,8 +208,8 @@ wire  [7:0] np_joy_p1, np_joy_p2;
 // 0         1         2         3          4         5         6
 // 01234567890123456789012345678901 23456789012345678901234567890123
 // 0123456789ABCDEFGHIJKLMNOPQRSTUV 0123456789ABCDEFGHIJKLMNOPQRSTUV
-// XXXXXXXXXXXXXXXXXXXXXXXXX     X       XXXXXXXX XX
-// 24 Show (both screens / my screen), 46-47 Netplay (read by Main_MiSTer support/netplay/netplay.cpp).
+// XXXXXXXXXXXXXXXXXXXXXXXXXX    X       XXXXXXXX XX
+// 24-25 Show (both screens / my screen / my screen zoomed), 46-47 Netplay (read by Main_MiSTer support/netplay/netplay.cpp).
 
 `include "build_id.v" 
 localparam CONF_STR = {
@@ -229,7 +229,7 @@ localparam CONF_STR = {
 	"P1-;",
 	"P1O[44],Extra sprites,No,Yes;",
 	"P1ON,Seperator Line,Off,On;",
-	"P1O[24],Show,Both screens,My screen;",
+	"P1O[25:24],Show,Both screens,My screen,My screen zoom;",
 	"P1OC,Inverted color,No,Yes;",
 	"P1O12,Custom Palette,Off,Auto,On;",
 	"h1P1FC3,GBP,Load Palette;",
@@ -682,8 +682,8 @@ lcd lcd
 
 	.isGBC  ( isGBC      ),
    
-	.seperatorLine  ( status[23] & ~status[24] ),
-	.single         ( status[24] ),
+	.seperatorLine  ( status[23] & ~|status[25:24] ),
+	.single         ( |status[25:24] ),
 	.single_sel     ( np_active & np_join ),
 
 	.tint   ( |tint       ),
@@ -743,9 +743,10 @@ video_freak video_freak
 	.VGA_DE_IN(VGA_DE),
 	.VGA_DE(),
 
-	.ARX((!ar) ? (status[24] ? 12'd10 : 12'd20) : (ar - 1'd1)),
+	// one screen is 160x144 (10:9); zoomed shows its middle 120 lines (4:3)
+	.ARX((!ar) ? (|status[25:24] ? 12'd10 : 12'd20) : (ar - 1'd1)),
 	.ARY((!ar) ? (12'd9 ) : 12'd0),
-	.CROP_SIZE(0),
+	.CROP_SIZE(status[25] ? 12'd120 : 12'd0),
 	.CROP_OFF(0),
 	.SCALE(status[22:21])
 );
diff --git a/rtl/lcd.v b/rtl/lcd.v
index f227795..bd89bf2 100644
--- a/rtl/lcd.v
+++ b/rtl/lcd.v
@@ -24,7 +24,7 @@ module lcd
 	input        isGBC,
 	input        double_buffer,
    input        seperatorLine,
-   input        single,          // show one Game Boy over the whole width (each pixel twice)
+   input        single,          // show one Game Boy only: a 160 pixel wide picture
    input        single_sel,      // which one: 0 GB 1, 1 GB 2
    
    output       pauseVideoCore1,
@@ -250,8 +250,10 @@ always @(posedge clk_vid) begin
 		end
 
 		// Hblank
-		if(h_cnt == H_START)        gb_hb <= 0;
-		if(h_cnt == H_START+H)      gb_hb <= 1;
+		// one screen: 160 visible pixels at the same pixel rate and line length, so
+		// the scaler sees 160x144 (a new size: Main reads the aspect ratio again)
+		if(h_cnt == H_START)                     gb_hb <= 0;
+		if(h_cnt == H_START + (one ? 9'd160 : H)) gb_hb <= 1;
 
 		// Vblank
 		if(v_cnt == VSTART)    gb_vb <= 0;
@@ -281,13 +283,8 @@ always @(posedge clk_vid) begin
 		// visible area?
 		if(~gb_hb & ~gb_vb) begin
          if (one) begin
-            // one screen: 160 pixels over the 320 of the line, each shown twice
-            // H_START is odd: step on even h_cnt, so pixel 0 is shown at H_START
-            // and H_START+1 and pixel 159 at the last two positions
-            if (!h_cnt[0]) begin
-               if (one_sel) vbuffer_outptr2 <= vbuffer_outptr2 + 1'd1;
-               else         vbuffer_outptr1 <= vbuffer_outptr1 + 1'd1;
-            end
+            if (one_sel) vbuffer_outptr2 <= vbuffer_outptr2 + 1'd1;
+            else         vbuffer_outptr1 <= vbuffer_outptr1 + 1'd1;
          end
          else if (h_cnt < H_START + 160)
             vbuffer_outptr1 <= vbuffer_outptr1 + 1'd1;
-- 
2.43.0

