-// clk_emu: clk_sys through Cyclone V's glitch-free clock gate (ena is latched on
+// clk_emu: clk_sys (from its own, identical PLL output, so the gate gets the
+// same short path from the PLL as clk_sys's buffer and the two clock trees
+// line up) through Cyclone V's glitch-free clock gate (ena is latched on
 // the falling edge). Everything of the emulated machine runs on it: main, the
 // joypad ports, the block RAMs, READ_PULSE and VRAM_OE_N_DELAYED. Netplay stops
 // it to freeze the machine bit-exactly (SPEC.md 10.1).
@@ -99,7 +103,7 @@ cyclonev_clkena #(
 	.ena_register_mode("falling edge")
 ) emu_clkena
 (
-	.inclk(clk_sys),
+	.inclk(clk_emu_pll),
 	.ena(~np_freeze),
 	.enaout(emu_en),
 	.outclk(clk_emu)
@@ -476,6 +480,26 @@ wire [63:0] ss_ddr_dout, ss_ddr_din;
 wire [21:3] ss_ddr_addr;
 wire [ 7:0] ss_ddr_be;
 
+// The savestate channel crosses between main (clk_emu) and ddram (clk_mem)
+// through registers on clk_sys. req and ack take one clk_sys more than the
+// data, so the data is stable before the other side sees the toggle; SNES.sdc
+// gives the data paths more than one clock.
+wire        ss_ddr_ack_d, ss_ddr_req_e, ss_ddr_we_e;
+wire [63:0] ss_ddr_dout_d, ss_ddr_din_e;
+wire [21:3] ss_ddr_addr_e;
+wire [ 7:0] ss_ddr_be_e;
+reg         ss_ddr_ack_r, ss_ddr_req_r, ss_ddr_we_r, ss_ddr_ack_r1, ss_ddr_req_r1;
+reg  [63:0] ss_ddr_dout_r, ss_ddr_din_r;
+reg  [21:3] ss_ddr_addr_r;
+reg  [ 7:0] ss_ddr_be_r;
+always @(posedge clk_sys) begin
+	{ss_ddr_addr_r, ss_ddr_din_r, ss_ddr_be_r, ss_ddr_we_r, ss_ddr_req_r1} <= {ss_ddr_addr_e, ss_ddr_din_e, ss_ddr_be_e, ss_ddr_we_e, ss_ddr_req_e};
+	ss_ddr_req_r <= ss_ddr_req_r1;
+	ss_ddr_dout_r <= ss_ddr_dout_d;
+	{ss_ddr_ack_r, ss_ddr_ack_r1} <= {ss_ddr_ack_r1, ss_ddr_ack_d};
+end
+assign {ss_ddr_addr, ss_ddr_din, ss_ddr_be, ss_ddr_we, ss_ddr_req} = {ss_ddr_addr_r, ss_ddr_din_r, ss_ddr_be_r, ss_ddr_we_r, ss_ddr_req_r};
+
 reg [15:0] main_audio_l;
 reg [15:0] main_audio_r;
 
@@ -620,13 +644,13 @@ main main
 	.SS_SLOT(ss_slot),
 	.SS_AVAIL(ss_avail),
 
-	.SS_DDR_DI(ss_ddr_dout),
-	.SS_DDR_ACK(ss_ddr_ack),
-	.SS_DDR_DO(ss_ddr_din),
-	.SS_DDR_ADDR(ss_ddr_addr),
-	.SS_DDR_WE(ss_ddr_we),
-	.SS_DDR_BE(ss_ddr_be),
-	.SS_DDR_REQ(ss_ddr_req),
+	.SS_DDR_DI(ss_ddr_dout_r),
+	.SS_DDR_ACK(ss_ddr_ack_r),
+	.SS_DDR_DO(ss_ddr_din_e),
+	.SS_DDR_ADDR(ss_ddr_addr_e),
+	.SS_DDR_WE(ss_ddr_we_e),
+	.SS_DDR_BE(ss_ddr_be_e),
+	.SS_DDR_REQ(ss_ddr_req_e),
 
 	.AUDIO_L(main_audio_l),
 	.AUDIO_R(main_audio_r)
@@ -790,7 +814,8 @@ sdram sdram
 	.din0(sdram_download_en ? sdram_download_data : ROM_D),
 	.dout0(ROM_Q),
 
-	.rd0(sdram_download_en ? 1'b0 : (!RESET_N | np_refresh) ? RESET_REFRESH : ~ROM_OE_N),
+	.rd0(sdram_download_en ? 1'b0 : !RESET_N ? RESET_REFRESH : ~ROM_OE_N),
+	.rfs_req(np_refresh & RESET_REFRESH),   // netplay freeze: refresh only (rd0 stays still)
 	.wr0(sdram_download_en ? sdram_download_wr : ~ROM_WE_N),
 	.word0(sdram_download_en | ROM_WORD),
 
@@ -801,7 +826,7 @@ sdram sdram
 
 	.rd1(clearing_ram ? 1'b0 : ~WRAM_CE_N & ~WRAM_OE_N & READ_PULSE),
 	.wr1(clearing_ram ? mem_fill_we : ~WRAM_CE_N & ~WRAM_WE_N & SNES_SYSCLKF_CE),
-	.rfs1(clearing_ram ? 1'b0 : (!RESET_N | np_refresh) ? RESET_REFRESH : SNES_REFRESH),
+	.rfs1(clearing_ram ? 1'b0 : !RESET_N ? RESET_REFRESH : SNES_REFRESH),
 	.word1(0),
 
 	.sni_addr(SDRAM_SNI_ADDR),
@@ -883,7 +908,7 @@ wire  [7:0] BSRAM_Q, BSRAM_D;
 wire [19:0] BSRAM_SNI_ADDR;
 wire        BSRAM_SNI_RD, BSRAM_SNI_WR;
 wire [7:0]  BSRAM_SNI_D;
-wire        BSRAM_SNI_READY = (BSRAM_SNI_RD | BSRAM_SNI_WR) & (BSRAM_CE_N | (BSRAM_OE_N & BSRAM_WE_N));
+wire        BSRAM_SNI_READY = (BSRAM_SNI_RD | BSRAM_SNI_WR) & (BSRAM_CE_N | (BSRAM_OE_N & BSRAM_WE_N)) & ~np_active;
 
 // port a belongs to the machine (clk_emu), port b to the SD card (clk_sys)
 dpram_difclk #(BSRAM_BITS,8,BSRAM_BITS-1,16) bsram 
@@ -989,7 +1014,8 @@ netplay netplay
 (
 	.clk         (clk_sys),
 	.reset       (~clock_locked),
-	.downloading (cart_download),
+	.downloading (cart_download | spc_download | msu_data_download | ssbin_download),
+	.machine_run (RESET_N),
 	.emu_en      (emu_en),
 	.vblank_emu  (~VBlank_out),
 	.dotclk_emu  (DOTCLK_out),
@@ -1081,7 +1107,7 @@ miraclepiano miracle(
 wire [63:0] SNI_JOY;
 sni sni(
 	.clk(clk_sys),
-	.reset(reset || uart_mode != 6),
+	.reset(reset || uart_mode != 6 || np_active),   // SNI writes memory on one side only
 	.vblank(VBlank),
 
 	.sdram_addr(SDRAM_SNI_ADDR),
@@ -1276,7 +1302,7 @@ always @(posedge clk_sys) begin
 	if(cart_download && img_mounted && !img_readonly) bk_ena <= |ram_mask;
