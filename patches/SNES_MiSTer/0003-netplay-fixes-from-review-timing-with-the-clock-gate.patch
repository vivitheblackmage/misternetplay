From 2a3ff5c49f79055fb856da95e686e5c77f296d5e Mon Sep 17 00:00:00 2001
From: netplay <netplay@localhost>
Date: Wed, 4 Nov 2026 00:40:27 +0100
Subject: [PATCH] netplay: fixes from review, timing with the clock gate

Ticks count only after RESET_N rises (the core leaves reset at the PPU's
next HVCNT_ATZERO, up to two frames after PRIME), so frame 0 starts at
the same emulated moment on both sides; snes_sim --netplay starts the
two sides apart and fails without it. SNI and Load Backup RAM are off
during netplay, any download counts as a reload, ERROR does not freeze
while a ROM loads. SDRAM refresh while frozen is a separate request in
sdram.sv, kept out of the address-to-command path.

Timing: clk_emu comes from its own PLL output (a copy of clk_sys's);
the savestate channel crosses through clk_sys registers with req/ack a
clock later than the data; SNES.sdc gives those data paths and the
rbuf -> din path more than one clock; SEED 2.
---
 SNES.qsf           |  5 +++-
 SNES.sdc           | 15 ++++++++++++
 SNES.sv            | 60 +++++++++++++++++++++++++++++++++-------------
 rtl/netplay.sv     | 11 +++++++--
 rtl/pll.v          |  2 ++
 rtl/pll/pll_0002.v | 15 +++++++-----
 rtl/sdram.sv       | 11 +++++++++
 sim/sim_top.sv     |  1 +
 sim/snes_sim.cpp   |  7 +++++-
 9 files changed, 100 insertions(+), 27 deletions(-)

diff --git a/SNES.qsf b/SNES.qsf
index a6110a1..bb897b3 100644
--- a/SNES.qsf
+++ b/SNES.qsf
@@ -13,7 +13,7 @@ set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
 set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
 set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
 
-set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Standard Edition"
+set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"
 
 set_global_assignment -name GENERATE_RBF_FILE ON
 set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
@@ -60,3 +60,6 @@ source sys/sys.tcl
 source sys/sys_analog.tcl
 source files.qip
 set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
+
+# Netplay: the fitter seed that meets timing with the clock gate (SPEC.md 10.1)
+set_global_assignment -name SEED 2
diff --git a/SNES.sdc b/SNES.sdc
index 56af2f0..24b7b47 100644
--- a/SNES.sdc
+++ b/SNES.sdc
@@ -44,3 +44,18 @@ set_false_path -from [get_registers { emu|sdram_download_* }] -to [get_registers
 #set_false_path -to [get_registers { emu|sdram|word[*] }]
 
 set_false_path -from {emu|en216p}
+
+# Netplay (SPEC.md 10.1): the savestate channel crosses through registers on
+# clk_sys (SNES.sv); its req and ack take a clk_sys more than the data, so the
+# data has more than one clock to settle.
+set_multicycle_path -setup -end 4 -from [get_registers { emu|ss_ddr_addr_r[*] emu|ss_ddr_din_r[*] emu|ss_ddr_be_r[*] emu|ss_ddr_we_r }] -to [get_registers { emu|ddram|* }]
+set_multicycle_path -hold  -end 3 -from [get_registers { emu|ss_ddr_addr_r[*] emu|ss_ddr_din_r[*] emu|ss_ddr_be_r[*] emu|ss_ddr_we_r }] -to [get_registers { emu|ddram|* }]
+set_multicycle_path -setup -end 2 -from [get_registers { emu|ddram|ram_q[*] }] -to [get_registers { emu|ss_ddr_dout_r[*] }]
+set_multicycle_path -hold  -end 1 -from [get_registers { emu|ddram|ram_q[*] }] -to [get_registers { emu|ss_ddr_dout_r[*] }]
+
+# Read data through main into the SDRAM's write data: din[] is only taken on a
+# write request, which comes on a CPU clock enable long after the read data
+# settled. Upstream has the same path; the netplay clock gate moves main's
+# placement enough to make its single clk_mem cycle fail.
+set_multicycle_path -setup -end 2 -from [get_registers { emu|sdram|rbuf[*] }] -to [get_registers { emu|sdram|din[*][*]* }]
+set_multicycle_path -hold  -end 1 -from [get_registers { emu|sdram|rbuf[*] }] -to [get_registers { emu|sdram|din[*][*]* }]
diff --git a/SNES.sv b/SNES.sv
index afe81f9..9e3e634 100644
--- a/SNES.sv
+++ b/SNES.sv
@@ -67,6 +67,7 @@ video_freak video_freak
 wire clock_locked;
 wire clk_mem;
