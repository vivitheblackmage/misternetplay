@@ -1491,12 +1517,12 @@ ddram ddram
 	.cache_rst(~RESET_N),
 
 	.rdaddr({11'b0011_1111_10, ss_ddr_addr[21:3]}), // Save states at $3F80.0000
-	.dout(ss_ddr_dout),
+	.dout(ss_ddr_dout_d),
 	.rom_din(ss_ddr_din),
 	.rom_be(ss_ddr_be),
 	.rom_we(ss_ddr_we),
 	.rom_req(ss_ddr_req),
-	.rom_ack(ss_ddr_ack),
+	.rom_ack(ss_ddr_ack_d),
 
 	.rdaddr2(msu_ram_addr), // MSU is at $2060.0000-3F7F.FFFF
 	.dout2(msu_ram_dout),
diff --git a/rtl/netplay.sv b/rtl/netplay.sv
index 08fb055..e57f55b 100644
--- a/rtl/netplay.sv
+++ b/rtl/netplay.sv
@@ -30,6 +30,7 @@ module netplay #(
 
 	// the emulated machine
 	input             emu_en,         // 1: this rising edge of clk is also one of clk_emu
+	input             machine_run,    // the machine is out of reset (SNES.sv RESET_N)
 	input             vblank_emu,     // the PPU's VBlank (main's VBLANKn inverted)
 	input             dotclk_emu,     // the PPU's DOTCLK
 	input      [14:0] color_emu,      // {B[7:3], G[7:3], R[7:3]} of the current dot
@@ -119,11 +120,17 @@ logic [31:0] crc;
 
 // Emulated-time registers (they change only when emu_en is 1)
 logic        vbl_prev, dot_prev;
-wire         tick = vblank_emu && !vbl_prev;          // a frame tick is pending
+// Ticks count only once the machine runs: after PRIME the core leaves reset at
+// the PPU's next HVCNT_ATZERO, up to two frames later, while the PPU's counters
+// (and VBlank) keep running. RESET_N rises on that emulated event, so frame 0
+// starts at the same emulated moment on both sides.
+wire         tick = vblank_emu && !vbl_prev && machine_run;   // a frame tick is pending
 wire         dot  = dotclk_emu ^ dot_prev;            // a dot edge is pending
 
 wire         run_tick = (state == S_RUN) && tick;
-assign freeze     = (run_tick && !have0) || (state == S_ERROR);
+// In ERROR the machine stays frozen, except while a new ROM loads (the load
+// clears the machine's RAMs, which needs clk_emu).
+assign freeze     = (run_tick && !have0) || (state == S_ERROR && !downloading);
 wire         consume  = run_tick && have0 && emu_en;  // frame k starts on this edge
 
 assign active     = (state != S_IDLE);
