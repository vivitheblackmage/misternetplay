diff --git a/rtl/sdram.sv b/rtl/sdram.sv
index 009c735..3a9a25a 100644
--- a/rtl/sdram.sv
+++ b/rtl/sdram.sv
@@ -22,6 +22,7 @@ module sdram
 	input             wr0,
 	input             rd0,
 	input             word0,
+	input             rfs_req,      // netplay freeze: a rising edge asks for one refresh (SPEC.md 10.1)
 	
 	input     [23: 0] addr1,
 	input     [15: 0] din1,
@@ -165,6 +166,7 @@ module sdram
 		can_start_sni;
 
 	reg old_rd0, old_rd1, old_wr0, old_wr1, old_sni_rd, old_sni_wr;
+	reg old_rfs_req;
 	always @(posedge clk) begin
 		if (!init_done) begin
 			st_num <= 4'd8;
@@ -253,6 +255,15 @@ module sdram
 				st_num <= 1;
 			end
 
+			// Netplay freeze: a refresh without an rd0 edge, so no read is issued
+			// and the latched address stays. Only while idle; the machine is
+			// frozen, so no regular request comes in meanwhile.
+			old_rfs_req <= rfs_req;
+			if (rfs_req && !old_rfs_req && st_num == 4'd8 && !read[0] && !read[1] && !write[0] && !write[1]) begin
+				rfs <= 1;
+				st_num <= 1;
+			end
+
 			// Handle regular requests. If we started a conflicting SNI request, preempt it.
 			if (wr0 && !old_wr0) begin
 				if (sni_read_ch1) begin
