+-- Simulation-only replacements for the coprocessor wrappers around Altera
+-- megafunctions (LPM_MULT, LPM_DIVIDE, scfifo, altdpram). Same ports and
+-- latency. Division by zero gives 0 here (only determinism is compared in
+-- simulation, not exact hardware results for that case).
+library ieee;
+use ieee.std_logic_1164.all;
+use ieee.numeric_std.all;
+
+entity SA1MULT is
+	port (
+		dataa  : in  std_logic_vector(15 downto 0);
+		datab  : in  std_logic_vector(15 downto 0);
+		result : out std_logic_vector(31 downto 0)
+	);
+end entity;
+architecture sim of SA1MULT is
+begin
+	result <= std_logic_vector(signed(dataa) * signed(datab));
+end architecture;
+
+library ieee;
+use ieee.std_logic_1164.all;
+use ieee.numeric_std.all;
+entity SPC7110_UMULT is
+	port (
+		dataa  : in  std_logic_vector(15 downto 0);
+		datab  : in  std_logic_vector(15 downto 0);
+		result : out std_logic_vector(31 downto 0)
+	);
+end entity;
+architecture sim of SPC7110_UMULT is
+begin
+	result <= std_logic_vector(unsigned(dataa) * unsigned(datab));
+end architecture;
+
+library ieee;
+use ieee.std_logic_1164.all;
+use ieee.numeric_std.all;
+entity SPC7110_SMULT is
+	port (
+		dataa  : in  std_logic_vector(15 downto 0);
+		datab  : in  std_logic_vector(15 downto 0);
+		result : out std_logic_vector(31 downto 0)
+	);
+end entity;
+architecture sim of SPC7110_SMULT is
+begin
+	result <= std_logic_vector(signed(dataa) * signed(datab));
+end architecture;
+
+library ieee;
+use ieee.std_logic_1164.all;
+use ieee.numeric_std.all;
+entity SPC7110_UDIV is
+	port (
+		clock    : in  std_logic;
+		denom    : in  std_logic_vector(15 downto 0);
+		numer    : in  std_logic_vector(31 downto 0);
+		quotient : out std_logic_vector(31 downto 0);
+		remain   : out std_logic_vector(15 downto 0)
+	);
+end entity;
+architecture sim of SPC7110_UDIV is
+	type q_t is array(0 to 7) of std_logic_vector(31 downto 0);
+	type r_t is array(0 to 7) of std_logic_vector(15 downto 0);
+	signal qp : q_t := (others => (others => '0'));
+	signal rp : r_t := (others => (others => '0'));
+begin
+	process(clock)
+		variable q : unsigned(31 downto 0);
+		variable r : unsigned(15 downto 0);
+	begin
+		if rising_edge(clock) then
+			if unsigned(denom) = 0 then
+				q := (others => '0'); r := (others => '0');
+			else
+				q := unsigned(numer) / unsigned(denom);
+				r := resize(unsigned(numer) mod unsigned(denom), 16);
+			end if;
+			qp(0) <= std_logic_vector(q); rp(0) <= std_logic_vector(r);
+			for i in 1 to 7 loop qp(i) <= qp(i-1); rp(i) <= rp(i-1); end loop;
+		end if;
+	end process;
+	quotient <= qp(7);
+	remain   <= rp(7);
+end architecture;
+
+library ieee;
+use ieee.std_logic_1164.all;
+use ieee.numeric_std.all;
+entity SPC7110_SDIV is
+	port (
+		clock    : in  std_logic;
+		denom    : in  std_logic_vector(15 downto 0);
+		numer    : in  std_logic_vector(31 downto 0);
+		quotient : out std_logic_vector(31 downto 0);
+		remain   : out std_logic_vector(15 downto 0)
+	);
+end entity;
+architecture sim of SPC7110_SDIV is
+	type q_t is array(0 to 7) of std_logic_vector(31 downto 0);
+	type r_t is array(0 to 7) of std_logic_vector(15 downto 0);
+	signal qp : q_t := (others => (others => '0'));
+	signal rp : r_t := (others => (others => '0'));
+begin
+	process(clock)
+		variable q : signed(31 downto 0);
+		variable r : signed(15 downto 0);
+	begin
+		if rising_edge(clock) then
+			if signed(denom) = 0 then
+				q := (others => '0'); r := (others => '0');
+			else
+				q := signed(numer) / resize(signed(denom), 32);
+				r := resize(signed(numer) rem resize(signed(denom), 32), 16);
+			end if;
+			qp(0) <= std_logic_vector(q); rp(0) <= std_logic_vector(r);
+			for i in 1 to 7 loop qp(i) <= qp(i-1); rp(i) <= rp(i-1); end loop;
+		end if;
+	end process;
+	quotient <= qp(7);
+	remain   <= rp(7);
+end architecture;
+
+library ieee;
+use ieee.std_logic_1164.all;
+use ieee.numeric_std.all;
+-- scfifo, 32 x 8, show-ahead, synchronous clear
+entity SPC7110_FIFO is
+	port (
+		clock : in  std_logic;
+		data  : in  std_logic_vector(7 downto 0);
+		rdreq : in  std_logic;
+		sclr  : in  std_logic;
+		wrreq : in  std_logic;
+		empty : out std_logic;
+		full  : out std_logic;
+		q     : out std_logic_vector(7 downto 0)
+	);
+end entity;
+architecture sim of SPC7110_FIFO is
+	type mem_t is array(0 to 31) of std_logic_vector(7 downto 0);
+	signal mem : mem_t := (others => (others => '0'));
+	signal rp, wp : unsigned(4 downto 0) := (others => '0');
+	signal cnt : unsigned(5 downto 0) := (others => '0');
+begin
+	process(clock)
+		variable do_rd, do_wr : boolean;
+	begin
+		if rising_edge(clock) then
+			if sclr = '1' then
+				rp <= (others => '0'); wp <= (others => '0'); cnt <= (others => '0');
+			else
+				do_rd := rdreq = '1' and cnt /= 0;
+				do_wr := wrreq = '1' and cnt /= 32;
+				if do_wr then mem(to_integer(wp)) <= data; wp <= wp + 1; end if;
+				if do_rd then rp <= rp + 1; end if;
+				if do_wr and not do_rd then cnt <= cnt + 1;
+				elsif do_rd and not do_wr then cnt <= cnt - 1; end if;
+			end if;
+		end if;
+	end process;
+	q     <= mem(to_integer(rp));
+	empty <= '1' when cnt = 0 else '0';
+	full  <= '1' when cnt = 32 else '0';
+end architecture;
+
+library ieee;
+use ieee.std_logic_1164.all;
+use ieee.numeric_std.all;
+-- altdpram (MLAB): registered write, asynchronous read
+entity cx4cache is
+	port (
+		clock     : in  std_logic;
+		data      : in  std_logic_vector(7 downto 0);
+		rdaddress : in  std_logic_vector(8 downto 0);
+		wraddress : in  std_logic_vector(8 downto 0);
+		wren      : in  std_logic := '0';
+		q         : out std_logic_vector(7 downto 0)
+	);
+end entity;
+architecture sim of cx4cache is
+	type mem_t is array(0 to 511) of std_logic_vector(7 downto 0);
+	signal mem : mem_t := (others => (others => '0'));
+begin
+	process(clock)
+	begin
+		if rising_edge(clock) then
+			if wren = '1' then mem(to_integer(unsigned(wraddress))) <= data; end if;
+		end if;
+	end process;
+	q <= mem(to_integer(unsigned(rdaddress)));
+end architecture;
