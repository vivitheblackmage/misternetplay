 	.PORT_P6(JOY1_P6),
 	.PORT_DO(JOY1_DO_t),
 
-	.JOYSTICK1((joy_swap ^ raw_serial) ? joy1 : joy0),
+	.JOYSTICK1(np_active ? np_joy_p1 : (joy_swap ^ raw_serial) ? joy1[11:0] : joy0[11:0]),
 	.JOYSTICK1_RUMBLE(joystick1_rumble),
 
 	.MOUSE(ps2_mouse),
@@ -1051,16 +1135,16 @@ wire       JOY2_CLK;
 wire       JOY2_P6;
 ioport port2
 (
-	.CLK(clk_sys),
+	.CLK(clk_emu),
 
-	.MULTITAP(status[17]),
+	.MULTITAP(status[17] & ~np_active),
 
 	.PORT_LATCH(JOY_STRB),
 	.PORT_CLK(JOY2_CLK),
 	.PORT_P6(JOY2_P6),
 	.PORT_DO(JOY2_DO),
 
-	.JOYSTICK1((joy_swap ^ raw_serial) ? joy0 : joy1),
+	.JOYSTICK1(np_active ? np_joy_p2 : (joy_swap ^ raw_serial) ? joy0[11:0] : joy1[11:0]),
 	.JOYSTICK2(joy2),
 	.JOYSTICK3(joy3),
 	.JOYSTICK4(joy4),
@@ -1116,7 +1200,7 @@ lightgun lightgun
 // 5  IN    P1D0        RX-
 // 6  IN    P2D0        TX+
 
-wire raw_serial = status[8];
+wire raw_serial = status[8] & ~np_active;
 reg snac_p2 = 0;
 
 assign USER_OUT[2] = 1'b1;
@@ -1417,7 +1501,14 @@ ddram ddram
 	.rdaddr2(msu_ram_addr), // MSU is at $2060.0000-3F7F.FFFF
 	.dout2(msu_ram_dout),
 	.rd_req2(msu_ram_req),
-	.rd_ack2(msu_ram_ack)
+	.rd_ack2(msu_ram_ack),
+
+	.addr3(np_ddr_addr),    // netplay mailbox at $3FC0.0000
+	.din3(np_ddr_din),
+	.we3(np_ddr_we),
+	.dout3(np_ddr_dout),
+	.req3(np_ddr_req),
+	.ack3(np_ddr_ack)
 );
 
 
