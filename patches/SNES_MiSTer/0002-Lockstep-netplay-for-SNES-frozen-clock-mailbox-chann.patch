+static const uint32_t NP_BASE = 0x3FC00000;
+static const uint32_t OFF_MAGIC = 0x0000, OFF_STATUS = 0x0008, OFF_CTRL = 0x0010;
+static const uint32_t OFF_LOCAL = 0x1000, OFF_CRC = 0x1800, OFF_INPUT = 0x2000;
+static const uint64_t NP_MAGIC = 0x3130504E53454E53ULL;   // "SNESNP01"
+static const uint64_t CTRL_MAGIC = 0x4C525443ULL;         // "CTRL"
+
+struct FakeHps {
+	Machine &m;
+	bool host;
+	int delay;
+	uint8_t sess;
+	int phase = 0;                      // 0 wait MAGIC, 1 armed, 2 running
+	uint64_t t_armed = 0;
+	uint32_t next_local = 0;            // next LOCAL frame to collect
+	std::map<uint32_t, uint16_t> mine, peer;   // LOCAL by frame
+	uint32_t next_input;                // next INPUT frame to write
+	std::map<uint32_t, uint32_t> crcs;  // CRC by frame
+	uint32_t next_crc = 0;
+
+	FakeHps(Machine &mm, bool h, int d, uint8_t s) : m(mm), host(h), delay(d), sess(s), next_input(d) {}
+
+	uint64_t rd(uint32_t off) { auto it = m.ddr.find(NP_BASE + off); return it == m.ddr.end() ? 0 : it->second; }
+	void wr(uint32_t off, uint64_t v) { m.ddr[NP_BASE + off] = v; }
+	uint64_t input_word(uint32_t f, uint16_t p1, uint16_t p2) {
+		uint64_t hi = ((uint64_t)(f & 0xFFF) << 20) | ((uint64_t)sess << 12) | (p2 & 0xFFF);
+		uint64_t lo = ((uint64_t)(f & 0xFFF) << 20) | ((uint64_t)sess << 12) | (p1 & 0xFFF);
+		return (hi << 32) | lo;
+	}
+
+	// returns LOCAL samples to send: (frame, joy)
+	void poll(uint64_t now, std::vector<std::pair<uint32_t, uint16_t>> &send) {
+		if (phase == 0) {
+			if (rd(OFF_MAGIC) != NP_MAGIC) return;
+			for (uint32_t i = 0; i < 256; i++) {
+				wr(OFF_LOCAL + i * 8, 0xFFFF000000000000ULL);
+				wr(OFF_CRC + i * 8, 0xFFFF000000000000ULL);
+				wr(OFF_INPUT + i * 8, 0xFFFF000000000000ULL);
+			}
+			wr(OFF_CTRL, (CTRL_MAGIC << 32) | ((uint64_t)sess << 8) | 1);
+			phase = 1; t_armed = now;
+			return;
+		}
+		if (phase == 1) {
+			if (now - t_armed < 20000) return;            // "the ROM load"
+			for (int f = 0; f < delay; f++) wr(OFF_INPUT + (f & 0xFF) * 8, input_word(f, 0, 0));
+			wr(OFF_CTRL, (CTRL_MAGIC << 32) | ((uint64_t)sess << 8) | 3);
+			phase = 2;
+			return;
+		}
+		// collect LOCAL[next_local]
+		for (;;) {
+			uint64_t w = rd(OFF_LOCAL + (next_local & 0xFF) * 8);
+			uint32_t hi = w >> 32, lo = (uint32_t)w;
+			uint32_t tag = next_local & 0xFFF;
+			if ((hi >> 20) != tag || (lo >> 20) != tag || ((hi >> 12) & 0xFF) != sess || ((lo >> 12) & 0xFF) != sess) break;
+			mine[next_local] = lo & 0xFFF;
+			send.push_back({next_local, (uint16_t)(lo & 0xFFF)});
+			next_local++;
+		}
+		// write INPUT[f + delay] when both LOCAL[f] are known
+		for (;;) {
+			uint32_t f = next_input - delay;
+			if (!mine.count(f) || !peer.count(f)) break;
+			uint16_t p1 = host ? mine[f] : peer[f], p2 = host ? peer[f] : mine[f];
+			wr(OFF_INPUT + (next_input & 0xFF) * 8, input_word(next_input, p1, p2));
+			next_input++;
+		}
+		// collect CRC[next_crc]
+		for (;;) {
+			uint64_t w = rd(OFF_CRC + (next_crc & 0xFF) * 8);
+			uint32_t hi = w >> 32, lo = (uint32_t)w;
+			uint32_t tag = next_crc & 0xFFFF;
+			if ((hi >> 16) != tag || (lo >> 16) != tag) break;
+			crcs[next_crc] = ((hi & 0xFFFF) << 16) | (lo & 0xFFFF);
+			next_crc++;
+		}
+	}
+};
+
+static int run_netplay(const std::vector<uint8_t> &rom, const Cart &cart, int frames, long seed, int delay, int max_lat)
+{
+	Machine h(rom, cart), j(rom, cart);
+	h.rng = 0x1234567 + seed * 7; j.rng = 0x7654321 + seed * 13;
+	for (Machine *m : { &h, &j }) { m->top->np_enable = 1; m->top->eval(); }
+	FakeHps hh(h, true, delay, 0x5A), hj(j, false, delay, 0x5A);
+	struct Pkt { uint64_t at; uint32_t f; uint16_t joy; };
+	std::deque<Pkt> to_j, to_h;
+	srand48(seed);
+	for (int i = 0; i < 2000; i++) { h.step(); j.step(); }
+	h.top->reset = 0; j.top->reset = 0;
+
+	uint64_t now = 0, h_frozen = 0, j_frozen = 0;
+	uint64_t wram_h = 0, wram_j = 0;
+	uint64_t max_cycles = (uint64_t)(frames + 10) * 357368ULL * 4;
+	while (now < max_cycles) {
+		h.step(); j.step(); now++;
+		h_frozen += h.top->np_freeze; j_frozen += j.top->np_freeze;
+		// local pads change at random wall-clock moments
+		if (drand48() < 1.0 / 60000) { h.top->joy0 = lrand48() & 0xFFF; h.top->eval(); }
+		if (drand48() < 1.0 / 60000) { j.top->joy0 = lrand48() & 0xFFF; j.top->eval(); }
+		if (now % 64) continue;
+		std::vector<std::pair<uint32_t, uint16_t>> sh, sj;
+		hh.poll(now, sh); hj.poll(now, sj);
+		for (auto &x : sh) to_j.push_back({ now + (uint64_t)(drand48() * max_lat), x.first, x.second });
+		for (auto &x : sj) to_h.push_back({ now + (uint64_t)(drand48() * max_lat), x.first, x.second });
+		// in-order delivery per direction (UDP may reorder, the HPS sorts by frame)
+		while (!to_j.empty() && to_j.front().at <= now) { hj.peer[to_j.front().f] = to_j.front().joy; to_j.pop_front(); }
+		while (!to_h.empty() && to_h.front().at <= now) { hh.peer[to_h.front().f] = to_h.front().joy; to_h.pop_front(); }
+		if (h.top->np_error || j.top->np_error || h.top->np_state == 4 || j.top->np_state == 4) {
+			printf("FAIL: netplay error host %02x join %02x\n", h.top->np_error, j.top->np_error);
+			return 1;
+		}
+		if (!wram_h && h.top->np_frame == (uint32_t)frames) wram_h = fnv(FNV0, h.wram.data(), h.wram.size());
+		if (!wram_j && j.top->np_frame == (uint32_t)frames) wram_j = fnv(FNV0, j.wram.data(), j.wram.size());
+		if (wram_h && wram_j && hh.next_crc > (uint32_t)frames && hj.next_crc > (uint32_t)frames) break;
+	}
+	int bad = 0;
+	uint32_t n = std::min(hh.next_crc, hj.next_crc);
+	for (uint32_t f = 0; f < n; f++)
+		if (hh.crcs[f] != hj.crcs[f]) { if (bad++ < 5) printf("CRC mismatch frame %u: host %08x join %08x\n", f, hh.crcs[f], hj.crcs[f]); }
+	std::set<uint32_t> distinct;
+	for (auto &x : hh.crcs) distinct.insert(x.second);
+	printf("%u frames compared, %d CRC mismatches, %zu distinct CRCs; WRAM at frame %d host %016llx join %016llx; "
+	       "frozen cycles host %llu join %llu; stalls host %u join %u\n",
+	       n, bad, distinct.size(), frames, (unsigned long long)wram_h, (unsigned long long)wram_j,
+	       (unsigned long long)h_frozen, (unsigned long long)j_frozen,
+	       (unsigned)(hh.rd(OFF_STATUS) & 0xFFFF), (unsigned)(hj.rd(OFF_STATUS) & 0xFFFF));
+	bool ok = n > (uint32_t)frames && !bad && wram_h && wram_h == wram_j && distinct.size() > 1;
+	printf("%s netplay\n", ok ? "PASS" : "FAIL");
+	return ok ? 0 : 1;
+}
