 	.refclk(CLK_50M),
@@ -80,6 +89,22 @@ pll pll
 	.locked(clock_locked)
 );
 
+// clk_emu: clk_sys through Cyclone V's glitch-free clock gate (ena is latched on
+// the falling edge). Everything of the emulated machine runs on it: main, the
+// joypad ports, the block RAMs, READ_PULSE and VRAM_OE_N_DELAYED. Netplay stops
+// it to freeze the machine bit-exactly (SPEC.md 10.1).
+wire clk_emu;
+cyclonev_clkena #(
+	.clock_type("global clock"),
+	.ena_register_mode("falling edge")
+) emu_clkena
+(
+	.inclk(clk_sys),
+	.ena(~np_freeze),
+	.enaout(emu_en),
+	.outclk(clk_emu)
