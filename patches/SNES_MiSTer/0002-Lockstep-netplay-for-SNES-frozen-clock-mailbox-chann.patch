+////////////////////////////  NETPLAY  //////////////////////////////////
+
+// Delay-based lockstep netplay, see SPEC.md 10 and rtl/netplay.sv.
+wire [31:3] np_ddr_addr;
+wire [63:0] np_ddr_din, np_ddr_dout;
+wire        np_ddr_we, np_ddr_req, np_ddr_ack;
+
+netplay netplay
+(
+	.clk         (clk_sys),
+	.reset       (~clock_locked),
+	.downloading (cart_download),
+	.emu_en      (emu_en),
+	.vblank_emu  (~VBlank_out),
+	.dotclk_emu  (DOTCLK_out),
+	.color_emu   ({B_out[7:3], G_out[7:3], R_out[7:3]}),
+	.local_joy   (joy0[11:0]),
+	.active      (np_active),
+	.hold_reset  (np_hold_reset),
+	.freeze      (np_freeze_req),
+	.joy_p1      (np_joy_p1),
+	.joy_p2      (np_joy_p2),
+	.ddr_addr    (np_ddr_addr),
+	.ddr_din     (np_ddr_din),
+	.ddr_dout    (np_ddr_dout),
+	.ddr_we      (np_ddr_we),
+	.ddr_req     (np_ddr_req),
+	.ddr_ack     (np_ddr_ack),
+	.state_o     (),
+	.frame_o     (),
+	.error_o     ()
+);
+
+// SDRAM refresh while frozen (SPEC.md 10.1): the reset path's refresh starts
+// 32 clocks into a freeze, so a read in flight completes first, and the freeze
+// is held 32 clocks after it stops, so no refresh runs into the first access.
+always @(posedge clk_sys) begin
+	if (np_freeze_req) begin
+		np_tail <= 0;
+		if (~&np_frz_cnt) np_frz_cnt <= np_frz_cnt + 1'd1;
+		if (np_frz_cnt == 31) np_refresh <= 1;
+	end
+	else if (np_refresh) begin
+		np_refresh <= 0;
+		np_tail    <= 1;
+		np_frz_cnt <= 0;
+	end
+	else if (np_tail) begin
+		np_frz_cnt <= np_frz_cnt + 1'd1;
+		if (np_frz_cnt == 31) np_tail <= 0;
+	end
+	else np_frz_cnt <= 0;
+end
+assign np_freeze = np_freeze_req | np_refresh | np_tail;
+
