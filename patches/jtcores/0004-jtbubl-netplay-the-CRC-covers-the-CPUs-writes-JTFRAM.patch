--- a/cores/bubl/cfg/macros.def
+++ b/cores/bubl/cfg/macros.def
@@ -21,3 +21,4 @@ JTFRAME_HEADER=4
 JTFRAME_ARX=5
 JTFRAME_ARY=4
 JTFRAME_NETPLAY
+JTFRAME_NP_STATE
diff --git a/cores/bubl/hdl/jtbubl_game.v b/cores/bubl/hdl/jtbubl_game.v
index 163260b49..84f66eb08 100644
--- a/cores/bubl/hdl/jtbubl_game.v
+++ b/cores/bubl/hdl/jtbubl_game.v
@@ -74,8 +74,15 @@ assign { main_rok, sub_rok, snd_rok } = { main_ok, sub_ok, snd_ok };
 assign { main_rdata, sub_rdata, snd_rdata } = { main_data, sub_data, snd_data };
 `endif
 
+`ifndef JTFRAME_NP_STATE
+wire        np_st_en;
+wire [23:0] np_st;
+`endif
+
 jtbubl_main u_main(
     .np_ram         ( np_ram        ),
+    .np_st_en       ( np_st_en      ),
+    .np_st          ( np_st         ),
     .rst            ( rst           ),
     .clk            ( clk           ),        // 24 MHz
     .cen6           ( cen6          ),
diff --git a/cores/bubl/hdl/jtbubl_main.v b/cores/bubl/hdl/jtbubl_main.v
index 72adfc52e..0887e1da4 100644
--- a/cores/bubl/hdl/jtbubl_main.v
+++ b/cores/bubl/hdl/jtbubl_main.v
@@ -63,7 +63,10 @@ module jtbubl_main(
     input               tilt,
     input      [ 7:0]   dipsw_a,
     input      [ 7:0]   dipsw_b,
-    input      [ 7:0]   debug_bus
+    input      [ 7:0]   debug_bus,
+    // netplay (SPEC 12.3): what the game state changes by, for the CRC
+    output              np_st_en,
+    output     [23:0]   np_st
 );
 
 `ifndef NOMAIN
@@ -79,6 +82,7 @@ reg  [ 7:0] cab_dout;
 reg         h1;
 wire [11:0] mcu_bus;
 wire [15:0] main_addr, sub_addr;
+reg         main_wl, sub_wl;
 wire        main_mreq_n, main_iorq_n, main_rdn, main_wrn, main_rfsh_n;
 wire        sub_mreq_n,  sub_iorq_n,  sub_rd_n,  sub_wrn, sub_rfsh_n;
 reg         main_macc_n, sub_macc_n;
@@ -597,4 +601,16 @@ initial begin
     main_rom_cs=0; sub_rom_cs=0;
 end
 `endif
+// Netplay's CRC (JTFRAME_NP_STATE): every write of the main and sub CPUs,
+// address and data, taken in its first clock. It covers the game state and
+// not the picture, whose line buffers wait for the SDRAM (the graphics).
+always @(posedge clk) begin
+    main_wl <= ~main_wrn;
+    sub_wl  <= ~sub_wrn;
+end
+wire main_wst = ~main_wrn & ~main_wl;
+wire sub_wst  = ~sub_wrn  & ~sub_wl;
+assign np_st_en = main_wst | sub_wst;
+assign np_st    = main_wst ? { main_addr, main_dout } : { sub_addr, sub_dout };
+
 endmodule
diff --git a/modules/jtframe/doc/macros.md b/modules/jtframe/doc/macros.md
index b774d0fde..c7600a8b2 100644
--- a/modules/jtframe/doc/macros.md
+++ b/modules/jtframe/doc/macros.md
@@ -68,6 +68,7 @@ JTFRAME_MOUSE_NOEMU      |         | Disables mouse emulation via joystick
 JTFRAME_MR_DDR           | MiSTer  | Defined internally when MiSTer DDR is used. Do not define manually.
 JTFRAME_MR_DDRLOAD       | MiSTer  | ROM download process uses the DDR as proxy
 JTFRAME_MR_GAME_DDR      | MiSTer  | Game module gets the DDR3 port (ddr_* signals on clk_rom, see sdram.md). Not with rotation, LF buffer or DDR load
+JTFRAME_NP_STATE         | MiSTer  | With JTFRAME_NETPLAY: the game outputs np_st_en/np_st (its CPU writes) and netplay's CRC covers them instead of the picture
 JTFRAME_NETPLAY          | MiSTer  | Lockstep netplay with Main_MiSTer (target/mister/hdl/jtframe_netplay.sv): mailbox in DDR3 at 0x3C000000, OSD option O[127:126]. Needs mem.yaml clocks; not with game DDR3 or the DDR3 LF buffer
 JTFRAME_MR_LF_BRAM       | MiSTer  | Use BRAM instead of DDR for JTFRAME_LF_BUFFER. Automatically set when JTFRAME_VERTICAL is also enabled
 JTFRAME_MR_FASTIO        | MiSTer  | 16-bit ROM load in MiSTer. Set by default if CLK96 is set
