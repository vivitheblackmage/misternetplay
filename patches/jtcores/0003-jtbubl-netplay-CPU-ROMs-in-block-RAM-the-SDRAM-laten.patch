diff --git a/cores/bubl/hdl/jtbubl_game.v b/cores/bubl/hdl/jtbubl_game.v
index a816bc704..163260b49 100644
--- a/cores/bubl/hdl/jtbubl_game.v
+++ b/cores/bubl/hdl/jtbubl_game.v
@@ -40,7 +40,42 @@ always @(posedge clk) begin
     endcase
 end
 /* verilator tracing_off */
+`ifndef JTFRAME_NETPLAY
+wire [1:0] np_ram = 2'd0;   // netplay clears the RAM at a session start (jtframe_np_ramclr)
+`endif
+
+// The CPUs' ROM buses. With netplay they read block RAM (mem.yaml mainrom,
+// subrom, sndrom): ok drops for the one clock after an address change, the
+// same on both MiSTers, and the SDRAM buses stay idle so the clock enables
+// never wait for the SDRAM.
+wire       main_rq, sub_rq, snd_rq, main_rok, sub_rok, snd_rok;
+wire [7:0] main_rdata, sub_rdata, snd_rdata;
+`ifdef JTFRAME_NETPLAY
+reg [17:0] main_aq;
+reg [14:0] sub_aq, snd_aq;
+always @(posedge clk) begin
+    main_aq <= main_addr;
+    sub_aq  <= sub_addr;
+    snd_aq  <= snd_addr;
+end
+assign mainrom_addr = main_addr;
+assign subrom_addr  = sub_addr;
+assign sndrom_addr  = snd_addr;
+assign { main_cs, sub_cs, snd_cs } = 3'd0;
+assign main_rok   = main_addr == main_aq;
+assign sub_rok    = sub_addr  == sub_aq;
+assign snd_rok    = snd_addr  == snd_aq;
+assign main_rdata = mainrom_data;
+assign sub_rdata  = subrom_data;
+assign snd_rdata  = sndrom_data;
+`else
+assign { main_cs, sub_cs, snd_cs } = { main_rq, sub_rq, snd_rq };
+assign { main_rok, sub_rok, snd_rok } = { main_ok, sub_ok, snd_ok };
+assign { main_rdata, sub_rdata, snd_rdata } = { main_data, sub_data, snd_data };
+`endif
+
 jtbubl_main u_main(
+    .np_ram         ( np_ram        ),
     .rst            ( rst           ),
     .clk            ( clk           ),        // 24 MHz
     .cen6           ( cen6          ),
@@ -51,14 +86,14 @@ jtbubl_main u_main(
     .bootleg        ( bootleg       ),
     // Main CPU ROM
     .main_rom_addr  ( main_addr     ),
-    .main_rom_cs    ( main_cs       ),
-    .main_rom_ok    ( main_ok       ),
-    .main_rom_data  ( main_data     ),
+    .main_rom_cs    ( main_rq       ),
+    .main_rom_ok    ( main_rok      ),
+    .main_rom_data  ( main_rdata    ),
     // Sub CPU ROM
     .sub_rom_addr   ( sub_addr      ),
-    .sub_rom_cs     ( sub_cs        ),
-    .sub_rom_ok     ( sub_ok        ),
-    .sub_rom_data   ( sub_data      ),
+    .sub_rom_cs     ( sub_rq        ),
+    .sub_rom_ok     ( sub_rok       ),
+    .sub_rom_data   ( sub_rdata     ),
     // MCU ROM
     .mcu_rom_addr   ( mcu_addr      ),
     .mcu_rom_cs     (               ),
@@ -100,6 +135,7 @@ jtbubl_main u_main(
 );
 /* verilator tracing_on */
 jtbubl_video u_video(
+    .np_ram         ( np_ram        ),
     .rst            ( rst           ),
     .clk            ( clk           ),
     .clk_cpu        ( clk           ),
@@ -139,6 +175,7 @@ jtbubl_video u_video(
 );
 /* verilator tracing_off */
 jtbubl_sound u_sound(
+    .np_ram         ( np_ram        ),
     .rst        ( rst           ),
     .clk        ( clk           ), // 24 MHz
     .rstn       ( snd_rstn_eff  ),
@@ -154,9 +191,9 @@ jtbubl_sound u_sound(
     .main_flag  ( main_flag     ),
     // ROM
     .rom_addr   ( snd_addr      ),
-    .rom_cs     ( snd_cs        ),
-    .rom_data   ( snd_data      ),
-    .rom_ok     ( snd_ok        ),
+    .rom_cs     ( snd_rq        ),
+    .rom_data   ( snd_rdata     ),
+    .rom_ok     ( snd_rok       ),
 
     // Sound output
     .fm03       ( fm03          ),
