     input               clk,
     input               clk_cpu,
     input               pxl_cen,
@@ -38,13 +39,21 @@ assign green    = col_out[3:0];
 assign blue     = col_out[15:12];
 assign pal_dout = !cpu_addr[0] ? pal_even : pal_odd;
 
