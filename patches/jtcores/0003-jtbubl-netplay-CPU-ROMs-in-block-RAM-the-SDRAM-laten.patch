-    .data0  ( cpu_dout     ),
-    .addr0  ( pal_addr     ),
-    .we0    ( pal0_we      ),
+    .data0  ( pal0_d       ),
+    .addr0  ( pal0_a       ),
+    .we0    ( pal0_w       ),
     .q0     ( pal_even     ),
     // Port 1
     .data1  (              ),
@@ -53,13 +62,21 @@ jtframe_dual_ram #(.AW(8),.SIMHEXFILE("pal_even.hex")) u_ram0(
     .q1     ( co_bus[7:0]  )
 );
 
+wire [7:0] pal1_a;
+wire [7:0] pal1_d;
+wire       pal1_w;
+jtframe_np_ramclr #(.AW(8)) pal1_np(
+    .clk(clk_cpu), .cen(1'b1), .mode(np_ram),
+    .addr(pal_addr), .din(cpu_dout), .we(pal1_we),
+    .addr_o(pal1_a), .din_o(pal1_d), .we_o(pal1_w) );
+
 jtframe_dual_ram #(.AW(8),.SIMHEXFILE("pal_odd.hex")) u_ram1(
     .clk0   ( clk_cpu      ),
     .clk1   ( clk          ),
     // Port 0
-    .data0  ( cpu_dout     ),
-    .addr0  ( pal_addr     ),
-    .we0    ( pal1_we      ),
+    .data0  ( pal1_d       ),
+    .addr0  ( pal1_a       ),
+    .we0    ( pal1_w       ),
