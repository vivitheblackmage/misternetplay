@@ -45,6 +45,9 @@ module jtframe_6801mcu #(
     output [ROMW-1:0]  rom_addr,    // just addr, provided as a safeguard to check AW against upper hierarchy's signals
     input      [ 7:0]  rom_data,
     output reg         rom_cs
+`ifdef JTFRAME_NETPLAY
+   ,input       [1:0]  np_ram   // jtframe_np_ramclr: the internal RAM is not cleared by rst
