From a356b20048bb5dd06476600e2f6192ca9d2c204f Mon Sep 17 00:00:00 2001
From: netplay <netplay@localhost>
Date: Sun, 8 Nov 2026 20:27:00 +0100
Subject: [PATCH 3/6] jtbubl netplay: CPU ROMs in block RAM (the SDRAM latency
 differed between MiSTers and changed the order of the clock enables), the
 game's RAM cleared at a session start, np_test checks the clock enable order
---
 cores/bubl/cfg/files.yaml                     |  1 +
 cores/bubl/cfg/mem.yaml                       | 22 +++++++
 cores/bubl/hdl/jtbubl_colmix.v                | 29 ++++++++--
 cores/bubl/hdl/jtbubl_game.v                  | 55 +++++++++++++++---
 cores/bubl/hdl/jtbubl_gfx.v                   | 57 +++++++++++++++----
 cores/bubl/hdl/jtbubl_main.v                  | 32 +++++++++--
 cores/bubl/hdl/jtbubl_sound.v                 |  4 ++
 cores/bubl/hdl/jtbubl_video.v                 |  3 +
 modules/jtframe/hdl/cpu/jtframe_6801mcu.v     | 25 ++++++--
 modules/jtframe/hdl/cpu/jtframe_z80.v         | 27 ++++++++-
 modules/jtframe/hdl/inc/game_sdram.v          |  4 ++
 .../jtframe/hdl/inc/jtframe_game_instance.v   |  1 +
 .../jtframe/hdl/inc/jtframe_game_ports.inc    |  3 +
 modules/jtframe/hdl/ram/jtframe_np_ramclr.v   | 43 ++++++++++++++
 modules/jtframe/hdl/ver/game_test.v           | 13 +++++
 .../jtframe/target/mister/hdl/jtframe_emu.sv  |  2 +
 .../target/mister/hdl/jtframe_mister.sv       |  5 +-
 .../target/mister/hdl/jtframe_np_board.sv     |  5 ++
 modules/jtframe/verilator/np_test.cpp         | 42 +++++++++++++-
 19 files changed, 330 insertions(+), 43 deletions(-)
 create mode 100644 modules/jtframe/hdl/ram/jtframe_np_ramclr.v

diff --git a/cores/bubl/cfg/files.yaml b/cores/bubl/cfg/files.yaml
index 5dfe1997c..c10a32831 100644
--- a/cores/bubl/cfg/files.yaml
+++ b/cores/bubl/cfg/files.yaml
@@ -21,6 +21,7 @@ jtframe:
       - jtframe_ram.v
       - jtframe_obj_buffer.v
       - jtframe_prom.v
+      - jtframe_np_ramclr.v
   - from: video
     get:
       - jtframe_vtimer.v
diff --git a/cores/bubl/cfg/mem.yaml b/cores/bubl/cfg/mem.yaml
index 20db9d7e3..d05897f87 100644
--- a/cores/bubl/cfg/mem.yaml
+++ b/cores/bubl/cfg/mem.yaml
@@ -37,6 +37,28 @@ sdram:
           addr_width: 19
           data_width: 32
 bram:
+  # Netplay (SPEC 12.3): the CPUs read their ROMs from block RAM, so a ROM read
+  # always takes the same time and the clock enables never wait for the SDRAM,
+  # whose latency differs between two MiSTers. The SDRAM buses above keep the
+  # ROM layout; jtbubl_game leaves them unused.
+  - name: mainrom
+    addr_width: 18
+    data_width: 8
+    when: [ JTFRAME_NETPLAY ]
+    rom:
+      offset: "0"
+  - name: subrom
+    addr_width: 15
+    data_width: 8
+    when: [ JTFRAME_NETPLAY ]
+    rom:
+      offset: "24'h01_4000"
+  - name: sndrom
+    addr_width: 15
+    data_width: 8
+    when: [ JTFRAME_NETPLAY ]
+    rom:
+      offset: "24'h40_0000"
   - name: mcu
     addr_width: 12
     data_width: 8
