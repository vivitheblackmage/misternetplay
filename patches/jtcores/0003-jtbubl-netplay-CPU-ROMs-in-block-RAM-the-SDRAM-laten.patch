diff --git a/modules/jtframe/hdl/ram/jtframe_np_ramclr.v b/modules/jtframe/hdl/ram/jtframe_np_ramclr.v
new file mode 100644
index 000000000..41174d689
--- /dev/null
+++ b/modules/jtframe/hdl/ram/jtframe_np_ramclr.v
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * jtframe_np_ramclr.v
+ *
+ * Sits in front of a RAM write port for netplay (SPEC 12.3). A session must
+ * start from the same RAM on both MiSTers, but block RAM keeps whatever the
+ * game left in it (high scores, for instance) across a reset. While mode is
+ * not 0 this takes the port over and writes every address in turn:
+ *   mode 1: zeros (netplay ARMED/PRIME: the game is held in reset meanwhile)
+ *   mode 2: a pseudo-random pattern (test bench only: a "dirty" RAM)
+ * The address advances on cen, so a RAM that only writes on its clock enable
+ * gets every address too.
+ */
+
+module jtframe_np_ramclr #(parameter AW=10, DW=8)(
+    input               clk,
+    input               cen,
+    input       [1:0]   mode,
+    // the game's port
+    input      [AW-1:0] addr,
+    input      [DW-1:0] din,
+    input               we,
+    // to the RAM
+    output     [AW-1:0] addr_o,
+    output     [DW-1:0] din_o,
+    output              we_o
+);
+
+reg [AW-1:0] cnt  = 0;
+reg [15:0]   lfsr = 16'hACE1;
+wire         busy = mode != 2'd0;
+wire [((DW+15)/16)*16-1:0] rnd = {(DW+15)/16{lfsr}};
+
+always @(posedge clk) if( busy && cen ) begin
+    cnt  <= cnt + 1'd1;
+    lfsr <= { lfsr[14:0], lfsr[15] ^ lfsr[13] ^ lfsr[12] ^ lfsr[10] };
+end
+
+assign addr_o = busy ? cnt : addr;
+assign din_o  = mode == 2'd1 ? {DW{1'b0}} : mode == 2'd2 ? rnd[DW-1:0] : din;
+assign we_o   = busy ? 1'b1 : we;
+
+endmodule
