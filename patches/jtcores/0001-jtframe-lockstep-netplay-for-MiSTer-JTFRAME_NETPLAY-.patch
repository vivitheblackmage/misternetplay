+    .bd_game_rst    ( rst           ),
+    .bd_joystick1   ( joystick1     ),
+    .bd_joystick2   ( joystick2     ),
+    .bd_coin        ( coin          ),
+    .bd_start       ( cab_1p        ),
+    .bd_service     ( service       ),
+    .bd_tilt        ( tilt          ),
+    .bd_dip_test    ( dip_test      ),
+    .bd_dip_pause   ( dip_pause     ),
+    .game_rst       ( g_rst         ),
+    .game_joystick1 ( g_joy1        ),
+    .game_joystick2 ( g_joy2        ),
+    .game_coin      ( g_coin        ),
+    .game_start     ( g_start       ),
+    .game_service   ( g_service     ),
+    .game_tilt      ( g_tilt        ),
+    .dip_test       ( g_test        ),
+    .dip_pause      ( g_pause       ),
+    .np_hold        ( np_hold       ),
+    .np_clr         ( np_clr        ),
+    .np_stall       (               ),
+    .ddr_addr       ( np_ddr_addr   ),
+    .ddr_din        ( np_ddr_din    ),
+    .ddr_dout       ( np_ddr_dout   ),
+    .ddr_we         ( np_ddr_we     ),
+    .ddr_req        ( np_ddr_req    ),
+    .ddr_ack        ( np_ddr_ack    ),
+    .np_state       ( np_state      ),
+    .np_frame       ( np_frame      ),
+    .np_error       ( np_error      )
+);
+assign np_hold_o = np_hold;
+`else
+assign { g_rst, g_service, g_tilt, g_test, g_pause, np_hold, np_clr } =
