diff --git a/modules/jtframe/hdl/clocking/jtframe_pxlcen.v b/modules/jtframe/hdl/clocking/jtframe_pxlcen.v
index 661050bde..ff728c622 100644
--- a/modules/jtframe/hdl/clocking/jtframe_pxlcen.v
+++ b/modules/jtframe/hdl/clocking/jtframe_pxlcen.v
@@ -5,6 +5,7 @@
 `ifdef JTFRAME_PXLCLK
 module jtframe_pxlcen(
     input   clk,
+    input   hold,       // netplay: freezes the pixel clock enables with the game
     output  pxl_cen,
     output  pxl2_cen
 );
@@ -22,6 +23,29 @@ module jtframe_pxlcen(
         end
     end
 
+`ifdef JTFRAME_NETPLAY
+    // Same pulses as jtframe_frac_cen with n=1 (pxl2_cen every M clocks,
+    // pxl_cen every 2M), but with a clock enable: while hold is high nothing
+    // moves, and the pulse that was due comes right after it.
+    reg [3:0] cnt=0;
+    reg       half=0, p2=0, p1=0;
+
+    always @(posedge clk) if(!hold) begin
+        p2 <= 0;
+        p1 <= 0;
+        if( cnt==M[3:0]-4'd1 ) begin
+            cnt  <= 0;
+            half <= ~half;
+            p2   <= 1;
+            p1   <= ~half;
+        end else begin
+            cnt  <= cnt+4'd1;
+        end
+    end
+
+    assign pxl2_cen = p2 & ~hold;
+    assign pxl_cen  = p1 & ~hold;
+`else
     jtframe_frac_cen #(.WC(4),.W(2)) u_cen(
         .clk    ( clk       ),    // 48 or 96 MHz
         .n      ( 4'd1      ),
@@ -29,6 +53,7 @@ module jtframe_pxlcen(
         .cen    ( { pxl_cen, pxl2_cen } ),
         .cenb   (           )
     );
+`endif
 
 endmodule
 `endif
