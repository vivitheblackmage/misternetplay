 /* verilator tracing_on */
 //////// GAME MODULE
+// Netplay (jtframe_np_board.sv): the same logic as on MiSTer, with the
+// DDR3 mailbox channel on the test bench's ports
+wire        g_rst, g_service, g_tilt, g_test, g_pause, np_hold, np_clr;
+wire [ 9:0] g_joy1, g_joy2;
