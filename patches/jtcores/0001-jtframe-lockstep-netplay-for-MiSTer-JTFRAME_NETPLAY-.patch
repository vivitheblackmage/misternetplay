--- /dev/null
+++ b/modules/jtframe/bin/np_sim.sh
@@ -0,0 +1,22 @@
+#!/bin/bash
+# Netplay test bench (T2a): builds the core with JTFRAME_NETPLAY and the
+# two-MiSTer harness verilator/np_test.cpp, and runs it.
+#
+#   np_sim.sh <setname> [np_test options] [-- jtsim options]
+#
+# Run it from a folder of its own inside the core's ver/ folder (it puts
+# test.cpp there). Example, from cores/bubl/ver/np:
+#   np_sim.sh bublbobl --frames 600 --seed 3 --dirty 100
+set -e
+if [ -z "$JTFRAME" ]; then echo "np_sim.sh: source setprj.sh first"; exit 1; fi
+SETNAME=${1:?usage: np_sim.sh <setname> [options] [-- jtsim options]}
+shift
+NP=()
+while [ $# -gt 0 ] && [ "$1" != "--" ]; do NP+=("$1"); shift; done
+[ "$1" = "--" ] && shift
+cp "$JTFRAME/verilator/np_test.cpp" test.cpp
+cp "$JTFRAME/verilator/test.cpp" jtsim_test.cpp
+
+export NP_ARGS="${NP[*]}"
+# -keepcpp keeps our test.cpp (jtsim shifts one extra argument after it)
+exec jtsim -mister -setname "$SETNAME" "$@" -keepcpp -keepcpp
