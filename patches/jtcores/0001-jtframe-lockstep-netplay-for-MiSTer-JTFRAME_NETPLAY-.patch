diff --git a/modules/jtframe/target/mister/hdl/jtframe_netplay.sv b/modules/jtframe/target/mister/hdl/jtframe_netplay.sv
new file mode 100644
index 000000000..ca7fd5ee0
--- /dev/null
+++ b/modules/jtframe/target/mister/hdl/jtframe_netplay.sv
@@ -0,0 +1,421 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * jtframe_netplay.sv
+ *
+ * Delay-based lockstep netplay for jtframe arcade cores on MiSTer.
+ *
+ * Each MiSTer runs the whole game; the network carries only input. This side
+ * never touches the network: it exchanges per-frame input with Main_MiSTer
+ * through a mailbox in DDR3 at BASE (the NES / Game Boy 2P layout):
+ *
+ *   MAGIC  +0x0000  "ARCDNP01"
+ *   STATUS +0x0008  {frame, state, error, stalls}
+ *   CTRL   +0x0010  {"CTRL", session, join, run, enable}
+ *   LOCAL  +0x1000  256 entries {f[11:0], sess, joy[11:0]} in both halves
+ *   CRC    +0x1800  256 entries {f[15:0], crc half} in both halves
+ *   INPUT  +0x2000  256 entries {f[11:0], sess, p2 / p1 joy[11:0]}
+ *
+ * Joy words (active high): 3:0 Right Left Down Up, 9:4 buttons 1-6,
+ * 10 Start, 11 Coin.
+ *
+ * Emulated time. Everything the game does advances on the clock enables made
+ * by jtframe_gated_cen (CPUs, sound) and jtframe_pxlcen (video). `hold`
+ * freezes both without losing or catching up a pulse, so a held cycle does not
+ * exist for the game. A frame starts on the first clock after the game's LVBL
+ * falls (the start of its vertical blank). That clock is always held: INPUT[k]
+ * is applied in it and HOLD_POST more clocks are held so the new input has
+ * reached the game before its next clock enable. If INPUT[k] is not in hand
+ * the hold lasts until it is.
+ *
+ * Session start. In ARMED and PRIME the game is held in reset while its video
+ * timing runs on (jtframe's video timers have no reset). Frame 0 starts at an
+ * LVBL fall once INPUT[0] and INPUT[1] are in hand: reset is released there
+ * and `clr` restarts the clock enable generators from zero, so both sides
+ * start from the same video position and the same clock enable phase. The
+ * line buffers still hold pictures from before the session for a frame, so
+ * the CRC of frames 0 and 1 covers only the input.
+ */
+
+module jtframe_netplay #(
+    parameter int          POLL_INTERVAL = 256,           // clocks between INPUT polls
+    parameter int          CTRL_INTERVAL = 4096,          // clocks between CTRL reads
+    parameter int          HOLD_POST     = 4,             // clocks held after a frame start
+    parameter logic [31:0] BASE          = 32'h3C000000   // physical byte address of the mailbox
+)(
+    input             clk,
+    input             reset,          // power-on only, never on ROM load
+    input             downloading,    // a ROM load is in progress
+    input             dip_wr,         // the DIP switches are being written (download index 254)
+
+    // the game
+    input             lvbl,           // LVBL out of the game (changes only on pxl_cen)
+    input             pix_en,         // pxl_cen & LHBL & LVBL
+    input      [23:0] pix,            // {red, green, blue}
+
+    input      [11:0] local_joy,      // this side's player 1 controls, active high
+
+    output            active,
+    output            hold_reset,     // keep the game in reset
+    output            hold,           // freeze the game's clock enables
+    output            clr,            // restart the clock enable generators
+    output            stall,          // held for missing input or an error (HDMI freeze)
+    output reg        is_join,
+    output reg [11:0] joy_p1,         // what the game sees as player 1 (the host)
+    output reg [11:0] joy_p2,         // and player 2 (the join)
+
+    // DDR3 channel (toggle handshake: req != ack = busy)
+    output reg [31:3] ddr_addr,
+    output reg [63:0] ddr_din,
+    input      [63:0] ddr_dout,
+    output reg        ddr_we,
+    output reg        ddr_req,
+    input             ddr_ack,
+
+    // observation
+    output      [2:0] state_o,
+    output     [31:0] frame_o,
+    output      [7:0] error_o
+);
+
+localparam logic [15:0] OFF_MAGIC  = 16'h0000;
+localparam logic [15:0] OFF_STATUS = 16'h0008;
+localparam logic [15:0] OFF_CTRL   = 16'h0010;
+localparam logic [15:0] OFF_LOCAL  = 16'h1000;
+localparam logic [15:0] OFF_CRC    = 16'h1800;
+localparam logic [15:0] OFF_INPUT  = 16'h2000;
+
+localparam logic [63:0] MAGIC      = 64'h3130504E44435241; // "ARCDNP01"
+// CTRL is only believed with this in its upper half. DDR3 is not cleared when
+// cores change, so a stray word left by another core must never arm netplay.
+localparam logic [31:0] CTRL_MAGIC = 32'h4C525443;          // "CTRL"
+
+localparam logic [2:0] S_IDLE  = 3'd0;
+localparam logic [2:0] S_ARMED = 3'd1;
+localparam logic [2:0] S_PRIME = 3'd2;
+localparam logic [2:0] S_RUN   = 3'd3;
+localparam logic [2:0] S_ERROR = 3'd4;
+
+localparam int ERR_CTRL_DROP = 1;
+localparam int ERR_RELOAD    = 2;
+
+localparam logic [31:0] CRC_INIT = 32'hFFFFFFFF;
+
+function automatic logic [31:0] crc_byte(input logic [31:0] c, input logic [7:0] d);
+    logic [31:0] x;
+    x = c ^ {24'd0, d};
+    for (int i = 0; i < 8; i++)
+        x = x[0] ? ((x >> 1) ^ 32'hEDB88320) : (x >> 1);
+    return x;
+endfunction
+
+function automatic logic [31:0] crc_joy(input logic [11:0] p1, input logic [11:0] p2);
+    return crc_byte(crc_byte(crc_byte(CRC_INIT, p1[7:0]), {p2[3:0], p1[11:8]}), p2[11:4]);
+endfunction
+
+function automatic logic [31:0] crc_pix(input logic [31:0] c, input logic [23:0] p);
+    return crc_byte(crc_byte(crc_byte(c, p[23:16]), p[15:8]), p[7:0]);
+endfunction
+
+function automatic logic [31:3] waddr(input logic [15:3] off);
+    return BASE[31:3] + {16'd0, off};
+endfunction
+
+function automatic logic [15:3] ring(input logic [15:3] base_off, input logic [7:0] slot);
+    return base_off + {5'd0, slot};
+endfunction
+
+// ---------------------------------------------------------------------------
+// State
+
+logic [2:0]  state;
+logic [31:0] frame;
+logic [7:0]  error;
+logic [15:0] stalls;
+logic [7:0]  sess;
+
+// Lookahead: slot 0 holds INPUT[base], slot 1 INPUT[base+1], where base is
+// the first frame not started yet (0 in PRIME, frame+1 in RUN).
+logic        have0, have1;
+logic [11:0] a_p1, a_p2;
+logic [11:0] b_p1, b_p2;
+logic [31:0] crc;
+logic        crc_live;        // pixels count from frame 2 on
+
+logic        lvbl_prev;
+logic        waiting;         // a frame start is due and its INPUT is missing
+logic  [3:0] post;            // clocks still held after a frame start
+
+wire         tick_now = lvbl_prev && !lvbl;                       // first clock of a vertical blank
+wire         run_due  = (state == S_RUN) && (tick_now || waiting); // frame k is due now
+wire         consume  = run_due && have0;                          // frame k starts in this clock
+wire         start0   = (state == S_PRIME) && tick_now && have0 && have1 && !downloading;
+
+assign hold       = run_due || start0 || (post != 4'd0) || (state == S_ERROR && !downloading);
+assign clr        = start0;
+assign stall      = waiting || (state == S_ERROR && !downloading);
+assign active     = (state != S_IDLE);
+assign hold_reset = (state == S_ARMED) || (state == S_PRIME);
+
+assign state_o = state;
+assign frame_o = frame;
+assign error_o = error;
+
+// Pending mailbox work
+logic        p_ctrl_clr, p_magic, p_status, p_local, p_crc;
+logic [15:0] local_frame;
+logic [11:0] local_val;
+logic [15:0] crc_frame;
+logic [31:0] crc_val;
+logic        hold_prev;
+
+// Poll timers
+logic [15:0] poll_cnt, ctrl_cnt;
+logic        poll_due, ctrl_due;
+
+// DDR sequencer
+localparam logic [2:0] OP_NONE    = 3'd0;
+localparam logic [2:0] OP_MAGIC   = 3'd1;
+localparam logic [2:0] OP_CRC     = 3'd2;
+localparam logic [2:0] OP_LOCAL   = 3'd3;
+localparam logic [2:0] OP_STATUS  = 3'd4;
+localparam logic [2:0] OP_CTRL    = 3'd5;
+localparam logic [2:0] OP_INPUT   = 3'd6;
+localparam logic [2:0] OP_CTRLCLR = 3'd7;
+
+logic [2:0]  op;
+logic [31:0] op_frame;
+wire         ddr_done = (op != OP_NONE) && (ddr_req == ddr_ack);
+
+wire  [31:0] base       = (state == S_PRIME) ? 32'd0 : frame + 32'd1;
+wire         fetching   = (state == S_PRIME) || (state == S_RUN);
+wire         need_input = fetching && !(have0 && have1);
+wire  [31:0] want_frame = have0 ? base + 32'd1 : base;
+
+wire         ctrl_ok  = (ddr_dout[63:32] == CTRL_MAGIC);
+wire         ctrl_en  = ctrl_ok & ddr_dout[0];
+wire         ctrl_run = ctrl_ok & ddr_dout[1];
+
+wire  [63:0] status_word = {frame, 5'd0, state, error, stalls};
+
+wire  [31:0] in_hi = ddr_dout[63:32];
+wire  [31:0] in_lo = ddr_dout[31:0];
+wire         in_ok = (in_hi[31:20] == op_frame[11:0]) && (in_lo[31:20] == op_frame[11:0])
+                  && (in_hi[19:12] == sess)           && (in_lo[19:12] == sess);
+
+wire         reload = downloading || dip_wr;
+
+always_ff @(posedge clk) begin
+    hold_prev <= hold;
+    lvbl_prev <= lvbl;
+    if (post != 4'd0) post <= post - 4'd1;
+
+    if (poll_cnt == POLL_INTERVAL[15:0] - 16'd1) begin poll_cnt <= 16'd0; poll_due <= 1'b1; end
+    else poll_cnt <= poll_cnt + 16'd1;
+    if (ctrl_cnt == CTRL_INTERVAL[15:0] - 16'd1) begin ctrl_cnt <= 16'd0; ctrl_due <= 1'b1; end
+    else ctrl_cnt <= ctrl_cnt + 16'd1;
+
+    // -----------------------------------------------------------------------
+    // Per-frame work in RUN
+    if (state == S_RUN) begin
+        if (hold && !hold_prev && !consume && stalls != 16'hFFFF) stalls <= stalls + 16'd1;
+        if (tick_now && !have0) waiting <= 1'b1;
+
+        if (consume) begin
+            waiting     <= 1'b0;
+            post        <= 4'(HOLD_POST);
+            frame       <= frame + 32'd1;
+            joy_p1      <= a_p1;
+            joy_p2      <= a_p2;
+            have0       <= have1;
+            a_p1        <= b_p1;
+            a_p2        <= b_p2;
+            have1       <= 1'b0;
+
+            crc_frame   <= frame[15:0];
+            crc_val     <= crc;
+            p_crc       <= 1'b1;
+
+            local_frame <= frame[15:0] + 16'd1;
+            local_val   <= local_joy;
+            p_local     <= 1'b1;
+
+            p_status    <= 1'b1;
+            crc         <= crc_joy(a_p1, a_p2);
+            if (frame >= 32'd1) crc_live <= 1'b1;   // frame 2 starts now
+        end
+        else if (pix_en && crc_live) begin
+            crc <= crc_pix(crc, pix);
+        end
+
+        if (reload) begin
+            error[ERR_RELOAD] <= 1'b1;
+            state    <= S_ERROR;
+            p_status <= 1'b1;
+        end
+    end
+
+    if (state == S_PRIME && reload) begin
+        error[ERR_RELOAD] <= 1'b1;
+        state    <= S_ERROR;
+        p_status <= 1'b1;
+    end
+
+    // PRIME -> RUN at a vertical blank once INPUT[0] and INPUT[1] are in hand.
+    if (start0 && !dip_wr) begin
+        state       <= S_RUN;
+        frame       <= 32'd0;
+        waiting     <= 1'b0;
+        post        <= 4'(HOLD_POST);
+        joy_p1      <= a_p1;
+        joy_p2      <= a_p2;
+        have0       <= 1'b1;
+        a_p1        <= b_p1;
+        a_p2        <= b_p2;
+        have1       <= 1'b0;
+        local_frame <= 16'd0;
+        local_val   <= local_joy;
+        p_local     <= 1'b1;
+        p_status    <= 1'b1;
+        crc         <= crc_joy(a_p1, a_p2);
+        crc_live    <= 1'b0;
+    end
+
+    // -----------------------------------------------------------------------
+    // DDR sequencer: one outstanding request at a time.
+    if (op == OP_NONE) begin
+        if (p_ctrl_clr) begin
+            op <= OP_CTRLCLR; ddr_addr <= waddr(OFF_CTRL[15:3]);   ddr_din <= 64'd0;       ddr_we <= 1'b1; ddr_req <= ~ddr_req;
+        end
+        else if (p_magic) begin
+            op <= OP_MAGIC;   ddr_addr <= waddr(OFF_MAGIC[15:3]);  ddr_din <= MAGIC;       ddr_we <= 1'b1; ddr_req <= ~ddr_req;
+        end
+        else if (p_crc) begin
+            op <= OP_CRC;     ddr_addr <= waddr(ring(OFF_CRC[15:3], crc_frame[7:0]));
+            ddr_din <= {crc_frame, crc_val[31:16], crc_frame, crc_val[15:0]};
+            ddr_we <= 1'b1; ddr_req <= ~ddr_req;
+        end
+        else if (p_local) begin
+            op <= OP_LOCAL;   ddr_addr <= waddr(ring(OFF_LOCAL[15:3], local_frame[7:0]));
+            ddr_din <= {local_frame[11:0], sess, local_val, local_frame[11:0], sess, local_val};
+            ddr_we <= 1'b1; ddr_req <= ~ddr_req;
+        end
+        else if (p_status) begin
+            op <= OP_STATUS;  ddr_addr <= waddr(OFF_STATUS[15:3]); ddr_din <= status_word; ddr_we <= 1'b1; ddr_req <= ~ddr_req;
+        end
+        else if (ctrl_due) begin
+            op <= OP_CTRL;    ddr_addr <= waddr(OFF_CTRL[15:3]);   ddr_we <= 1'b0; ddr_req <= ~ddr_req;
+        end
+        else if (poll_due && need_input) begin
+            op <= OP_INPUT;   ddr_addr <= waddr(ring(OFF_INPUT[15:3], want_frame[7:0]));
+            op_frame <= want_frame;
+            ddr_we <= 1'b0; ddr_req <= ~ddr_req;
+        end
+    end
+    else if (ddr_done) begin
+        op <= OP_NONE;
+        case (op)
+            OP_CTRLCLR: p_ctrl_clr <= 1'b0;
+            OP_MAGIC:   p_magic    <= 1'b0;
+            OP_CRC:     p_crc      <= 1'b0;
+            OP_LOCAL:   p_local    <= 1'b0;
+            OP_STATUS:  p_status   <= 1'b0;
+            OP_INPUT: begin
+                poll_due <= 1'b0;
+                // A frame starting in this very clock shifts the lookahead: drop
+                // the word and let the next poll fetch it again.
+                if (in_ok && fetching && !consume && !start0) begin
+                    if (!have0 && op_frame == base) begin
+                        a_p1  <= in_lo[11:0];
+                        a_p2  <= in_hi[11:0];
+                        have0 <= 1'b1;
+                    end
+                    else if (have0 && !have1 && op_frame == base + 32'd1) begin
+                        b_p1  <= in_lo[11:0];
+                        b_p2  <= in_hi[11:0];
+                        have1 <= 1'b1;
+                    end
+                end
+            end
+            OP_CTRL: begin
+                ctrl_due <= 1'b0;
+                case (state)
+                    S_IDLE: if (ctrl_en) begin
+                        state     <= S_ARMED;
+                        sess      <= ddr_dout[15:8];
+                        is_join   <= ddr_dout[2];
+                        error     <= 8'd0;
+                        stalls    <= 16'd0;
+                        frame     <= 32'd0;
+                        have0     <= 1'b0;
+                        have1     <= 1'b0;
+                        waiting   <= 1'b0;
+                        p_status  <= 1'b1;
+                    end
+                    S_ARMED: begin
+                        if (!ctrl_en)      begin state <= S_IDLE;  p_status <= 1'b1; end
+                        else if (ctrl_run) begin state <= S_PRIME; p_status <= 1'b1; end
+                    end
+                    S_PRIME, S_ERROR: if (!ctrl_en && !start0) begin
+                        state    <= S_IDLE;
+                        p_status <= 1'b1;
+                        p_local  <= 1'b0;
+                        p_crc    <= 1'b0;
+                    end
+                    S_RUN: if (!ctrl_en) begin
+                        error[ERR_CTRL_DROP] <= 1'b1;
+                        state    <= S_IDLE;
+                        waiting  <= 1'b0;
+                        p_status <= 1'b1;
+                        p_local  <= 1'b0;
+                        p_crc    <= 1'b0;
+                    end
+                    default: ;
+                endcase
+            end
+            default: ;
+        endcase
+    end
+
+    if (reset) begin
+        state      <= S_IDLE;
+        frame      <= 32'd0;
+        error      <= 8'd0;
+        stalls     <= 16'd0;
+        sess       <= 8'd0;
+        is_join    <= 1'b0;
+        have0      <= 1'b0;
+        have1      <= 1'b0;
+        a_p1       <= 12'd0;
+        a_p2       <= 12'd0;
+        b_p1       <= 12'd0;
+        b_p2       <= 12'd0;
+        joy_p1     <= 12'd0;
+        joy_p2     <= 12'd0;
+        crc        <= CRC_INIT;
+        crc_live   <= 1'b0;
+        waiting    <= 1'b0;
+        post       <= 4'd0;
+        p_ctrl_clr <= 1'b1;
+        p_magic    <= 1'b1;
+        p_status   <= 1'b1;
+        p_local    <= 1'b0;
+        p_crc      <= 1'b0;
+        poll_cnt   <= 16'd0;
+        ctrl_cnt   <= 16'd0;
+        poll_due   <= 1'b0;
+        ctrl_due   <= 1'b1;
+        op         <= OP_NONE;
+        op_frame   <= 32'd0;
+        ddr_we     <= 1'b0;
+        ddr_addr   <= '0;
+        ddr_din    <= '0;
+        local_frame <= 16'd0;
+        local_val   <= 12'd0;
+        crc_frame   <= 16'd0;
+        crc_val     <= 32'd0;
+        hold_prev   <= 1'b0;
+        // ddr_req is not reset: it must keep matching ddr_ack across a reset
+    end
+end
+
+endmodule
diff --git a/modules/jtframe/target/mister/hdl/jtframe_np_board.sv b/modules/jtframe/target/mister/hdl/jtframe_np_board.sv
new file mode 100644
index 000000000..3aaaeef41
--- /dev/null
+++ b/modules/jtframe/target/mister/hdl/jtframe_np_board.sv
@@ -0,0 +1,113 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * jtframe_np_board.sv
+ *
+ * Netplay between jtframe's board logic and the game (SPEC 12.3): the
+ * game-side controls, reset, pause, test, service and tilt go through here.
+ * While a session is active the game sees the session's input (the host is
+ * player 1, the join player 2), is reset only by the session, and cannot be
+ * paused. Shared by jtframe_mister.sv and the Verilator test bench
+ * (hdl/ver/game_test.v), so both run the same logic.
+ */
+
+module jtframe_np_board #(parameter
+    GAME_INPUTS_ACTIVE_LOW = 1'b1,
+    COLORW                 = 4
+)(
+    input             clk,            // clk_rom
+    input             rst,            // jtframe's power-on reset
+    input             downloading,    // ROM load
+    input             dip_wr,         // DIP switch download (index 254)
+
+    // the game's video
+    input             lvbl,
+    input             lhbl,
+    input             pxl_cen,
+    input [COLORW-1:0] red, green, blue,
+
+    // from the board
+    input             bd_game_rst,
+    input       [9:0] bd_joystick1, bd_joystick2,
+    input       [3:0] bd_coin, bd_start,
+    input             bd_service, bd_tilt, bd_dip_test, bd_dip_pause,
+
+    // to the game
+    output            game_rst,
+    output      [9:0] game_joystick1, game_joystick2,
+    output      [3:0] game_coin, game_start,
+    output            game_service, game_tilt, dip_test, dip_pause,
+
+    // clock enables
+    output            np_hold,
+    output            np_clr,
+    output            np_stall,
+
+    // DDR3 mailbox channel (toggle handshake)
+    output     [31:3] ddr_addr,
+    output     [63:0] ddr_din,
+    input      [63:0] ddr_dout,
+    output            ddr_we,
+    output            ddr_req,
+    input             ddr_ack,
+
+    // observation
+    output      [2:0] np_state,
+    output     [31:0] np_frame,
+    output      [7:0] np_error
+);
+
+localparam [0:0] INACT = GAME_INPUTS_ACTIVE_LOW[0];   // level of a released input
+
+wire        active, hold_reset, is_join;
+wire [11:0] p1, p2, local_joy;
+wire [23:0] pix;
+
+// this side's player 1, active high: {coin, start, buttons 6-1, U, D, L, R}
+assign local_joy = INACT ? ~{ bd_coin[0], bd_start[0], bd_joystick1 }
+                         :  { bd_coin[0], bd_start[0], bd_joystick1 };
+
+function [7:0] c8(input [COLORW-1:0] c);
+    c8 = 8'd0;
+    c8[7-:COLORW] = c;
+endfunction
+assign pix = { c8(red), c8(green), c8(blue) };
+
+jtframe_netplay u_netplay(
+    .clk        ( clk           ),
+    .reset      ( rst           ),
+    .downloading( downloading   ),
+    .dip_wr     ( dip_wr        ),
+    .lvbl       ( lvbl          ),
+    .pix_en     ( pxl_cen & lhbl & lvbl ),
+    .pix        ( pix           ),
+    .local_joy  ( local_joy     ),
+    .active     ( active        ),
+    .hold_reset ( hold_reset    ),
+    .hold       ( np_hold       ),
+    .clr        ( np_clr        ),
+    .stall      ( np_stall      ),
+    .is_join    ( is_join       ),
+    .joy_p1     ( p1            ),
+    .joy_p2     ( p2            ),
+    .ddr_addr   ( ddr_addr      ),
+    .ddr_din    ( ddr_din       ),
+    .ddr_dout   ( ddr_dout      ),
+    .ddr_we     ( ddr_we        ),
+    .ddr_req    ( ddr_req       ),
+    .ddr_ack    ( ddr_ack       ),
+    .state_o    ( np_state      ),
+    .frame_o    ( np_frame      ),
+    .error_o    ( np_error      )
+);
+
+assign game_rst       = active ? (rst | hold_reset) : bd_game_rst;
+assign game_joystick1 = active ? (INACT ? ~p1[9:0] : p1[9:0]) : bd_joystick1;
+assign game_joystick2 = active ? (INACT ? ~p2[9:0] : p2[9:0]) : bd_joystick2;
+assign game_start     = active ? { {2{INACT}}, INACT ^ p2[10], INACT ^ p1[10] } : bd_start;
+assign game_coin      = active ? { {2{INACT}}, INACT ^ p2[11], INACT ^ p1[11] } : bd_coin;
+assign game_service   = active ? INACT : bd_service;
+assign game_tilt      = active ? INACT : bd_tilt;
+assign dip_test       = active ? INACT : bd_dip_test;
+assign dip_pause      = active ? 1'b1  : bd_dip_pause;   // active low
+
+endmodule
diff --git a/modules/jtframe/target/mister/hdl/jtframe_np_ddrarb.sv b/modules/jtframe/target/mister/hdl/jtframe_np_ddrarb.sv
new file mode 100644
index 000000000..ebb98cd67
--- /dev/null
+++ b/modules/jtframe/target/mister/hdl/jtframe_np_ddrarb.sv
@@ -0,0 +1,83 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * jtframe_np_ddrarb.sv
+ *
+ * Puts the netplay mailbox (jtframe_netplay, one 64-bit word at a time,
+ * toggle handshake) on the video DDR3 client of jtframe_mr_ddrmux. The video
+ * client (screen rotation) keeps priority; the mailbox takes the bus only
+ * between two of its requests. Screen rotation only writes, so no read data
+ * of it can be in flight when the mailbox reads. Cores whose video client
+ * reads DDR3 (line-frame buffer in DDR3, game DDR3) are not supported.
+ */
+
+module jtframe_np_ddrarb(
+    input             rst,
+    input             clk,
+    // video client
+    input      [ 7:0] r_burstcnt,
+    input      [28:0] r_addr,
+    input             r_rd,
+    input             r_we,
+    input      [ 7:0] r_be,
+    input      [63:0] r_din,
+    output            r_busy,
+    // towards jtframe_mr_ddrmux (its rot_* port)
+    output     [ 7:0] m_burstcnt,
+    output     [28:0] m_addr,
+    output            m_rd,
+    output            m_we,
+    output     [ 7:0] m_be,
+    output     [63:0] m_din,
+    input             m_busy,
+    input      [63:0] ddr_dout,
+    input             ddr_dout_ready,
+    // netplay mailbox
+    input      [31:3] np_addr,
+    input      [63:0] np_din,
+    input             np_we,
+    input             np_req,
+    output reg        np_ack,
+    output reg [63:0] np_dout
+);
+
+localparam [1:0] ST_VIDEO = 2'd0,
+                 ST_REQ   = 2'd1,
+                 ST_READ  = 2'd2;
+
+reg [1:0] st;
+wire      np = st != ST_VIDEO;
+
+assign m_burstcnt = np ? 8'd1          : r_burstcnt;
+assign m_addr     = np ? np_addr[31:3] : r_addr;
+assign m_rd       = np ? (st == ST_REQ && !np_we) : r_rd;
+assign m_we       = np ? (st == ST_REQ &&  np_we) : r_we;
+assign m_be       = np ? 8'hff         : r_be;
+assign m_din      = np ? np_din        : r_din;
+assign r_busy     = np | m_busy;
+
+always @(posedge clk) begin
+    if( rst ) begin
+        st     <= ST_VIDEO;
+        np_ack <= np_req;
+    end else begin
+        case( st )
+            ST_VIDEO: if( np_req != np_ack && !r_we && !r_rd ) st <= ST_REQ;
+            ST_REQ: if( !m_busy ) begin
+                if( np_we ) begin
+                    np_ack <= np_req;
+                    st     <= ST_VIDEO;
+                end else begin
+                    st     <= ST_READ;
+                end
+            end
+            ST_READ: if( ddr_dout_ready ) begin
+                np_dout <= ddr_dout;
+                np_ack  <= np_req;
+                st      <= ST_VIDEO;
+            end
+            default: st <= ST_VIDEO;
+        endcase
+    end
+end
+
+endmodule
