diff --git a/modules/jtframe/verilator/np_test.cpp b/modules/jtframe/verilator/np_test.cpp
new file mode 100644
index 000000000..b3a2bb5cc
--- /dev/null
+++ b/modules/jtframe/verilator/np_test.cpp
@@ -0,0 +1,270 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * np_test.cpp: netplay test bench for jtframe cores (T2a, SPEC 12.7).
+ *
+ * Two MiSTers (host and join) in one process, each a full game_test model
+ * built with JTFRAME_NETPLAY (jtframe_np_board + jtframe_netplay), with its
+ * own SDRAM model, a fake HPS (SPEC 4: session start, combining LOCAL into
+ * INPUT) and a network with random latency between them. The mailbox port is
+ * served after a random number of clocks. The join starts its session at a
+ * random later moment (another video and SDRAM refresh phase), optionally
+ * after running the game with other input first (--dirty), so the session
+ * start must make both sides equal. Passes when both post the same CRC for
+ * every frame and the picture changes.
+ *
+ * Built by bin/np_sim.sh, which puts this file as test.cpp next to a copy of
+ * jtframe's own test.cpp (jtsim_test.cpp) and runs jtsim. Options come from
+ * the environment variable NP_ARGS:
+ *   --frames N    frames to compare (default 600)
+ *   --seed S      random seed (default 1)
+ *   --delay D     input delay in frames (default 3)
+ *   --latency C   maximum network latency in clocks (default 400000)
+ *   --dirty F     the join plays F frames with random input before its session
+ */
+
+#define main jtsim_main
+#define _JTFRAME_SIM_SKIP_FRAME_DUMP
+#include "jtsim_test.cpp"
+#undef main
+
+#include <deque>
+#include <map>
+#include <random>
+#include <set>
+
+static const uint32_t NP_BASE    = 0x3C000000;
+static const uint32_t OFF_MAGIC  = 0x0000, OFF_STATUS = 0x0008, OFF_CTRL = 0x0010;
+static const uint32_t OFF_LOCAL  = 0x1000, OFF_CRC    = 0x1800, OFF_INPUT = 0x2000;
+static const uint64_t NP_MAGIC   = 0x3130504E44435241ULL;   // "ARCDNP01"
+static const uint64_t CTRL_MAGIC = 0x4C525443ULL;           // "CTRL"
+
+struct Side {
+    const char *name;
+    UUT   *m;
+    JTSim *sim;
+    std::map<uint32_t, uint64_t> ddr;
+    std::mt19937_64 rng;
+    int   ddr_wait = -1;
+    uint64_t held = 0;
+    uint16_t pad = 0;        // this side's player 1, active high {coin, start, buttons, U, D, L, R}
+
+    void apply_pad() {
+        // game_test's inputs are active low
+        m->joystick1 = (~pad) & 0x3ff;
+        m->joystick2 = 0x3ff;
+        m->cab_1p    = 0xe | (((~pad) >> 10) & 1);
+        m->coin      = 0xe | (((~pad) >> 11) & 1);
+        m->service   = 1;
+        m->tilt      = 1;
+        m->dip_pause = 1;
+        m->np_dip_wr = 0;
+    }
+
+    void step() {
+        apply_pad();
+        sim->clock(1);
+        held += m->np_hold_o;
+        // the mailbox port (toggle handshake), served after a random 4..40 clocks
+        if (m->np_ddr_req != m->np_ddr_ack) {
+            if (ddr_wait < 0) ddr_wait = 4 + rng() % 37;
+            else if (ddr_wait-- == 0) {
+                uint32_t a = (uint32_t)m->np_ddr_addr << 3;
+                if (m->np_ddr_we) ddr[a] = m->np_ddr_din;
+                else { auto it = ddr.find(a); m->np_ddr_dout = it == ddr.end() ? 0 : it->second; }
+                m->np_ddr_ack = m->np_ddr_req;
+                ddr_wait = -1;
+            }
+        }
+    }
+    bool loaded() { return !m->rst && !m->dwnld_busy && !m->ioctl_rom; }
+};
+
+struct FakeHps {
+    Side &s;
+    bool host;
+    int delay;
+    uint8_t sess;
+    int phase = 0;                      // 0 wait, 1 armed (DIPs), 2 running
+    uint64_t arm_at = 0;
+    uint64_t t_armed = 0;
+    uint64_t settle = 200000;
+    uint32_t next_local = 0;
+    std::map<uint32_t, uint16_t> mine, peer;
+    uint32_t next_input;
+    std::map<uint32_t, uint32_t> crcs;
+    uint32_t next_crc = 0;
+
+    FakeHps(Side &ss, bool h, int d, uint8_t sid) : s(ss), host(h), delay(d), sess(sid), next_input(d) {}
+
+    uint64_t rd(uint32_t off) { auto it = s.ddr.find(NP_BASE + off); return it == s.ddr.end() ? 0 : it->second; }
+    void wr(uint32_t off, uint64_t v) { s.ddr[NP_BASE + off] = v; }
+    uint32_t half(uint32_t f, uint16_t v) { return ((f & 0xFFF) << 20) | ((uint32_t)sess << 12) | (v & 0xFFF); }
+    uint64_t input_word(uint32_t f, uint16_t p1, uint16_t p2) { return ((uint64_t)half(f, p2) << 32) | half(f, p1); }
+    int state() { return (rd(OFF_STATUS) >> 24) & 7; }
+    uint64_t ctrl(bool run) { return (CTRL_MAGIC << 32) | ((uint64_t)sess << 8) | (host ? 0 : 4) | (run ? 2 : 0) | 1; }
+
+    void poll(uint64_t now, std::vector<std::pair<uint32_t, uint16_t>> &send) {
+        if (phase == 0) {
+            if (now < arm_at || !s.loaded() || rd(OFF_MAGIC) != NP_MAGIC) return;
+            for (uint32_t i = 0; i < 256; i++) {
+                wr(OFF_LOCAL + i * 8, 0xFFF0000000000000ULL);
+                wr(OFF_CRC   + i * 8, 0xFFFF000000000000ULL);
+                wr(OFF_INPUT + i * 8, 0xFFF0000000000000ULL);
+            }
+            wr(OFF_CTRL, ctrl(false));
+            phase = 1;
+            return;
+        }
+        if (phase == 1) {
+            if (state() != 1) return;           // ARMED: the game is in reset, Main sends the DIP switches
+            if (!t_armed) t_armed = now;
+            if (now - t_armed < settle) return;
+            for (int f = 0; f < delay; f++) wr(OFF_INPUT + (f & 0xFF) * 8, input_word(f, 0, 0));
+            wr(OFF_CTRL, ctrl(true));
+            phase = 2;
+            return;
+        }
+        for (;;) {
+            uint64_t w = rd(OFF_LOCAL + (next_local & 0xFF) * 8);
+            uint32_t hi = w >> 32, lo = (uint32_t)w;
+            if (hi != lo || (hi >> 20) != (next_local & 0xFFF) || ((hi >> 12) & 0xFF) != sess) break;
+            mine[next_local] = lo & 0xFFF;
+            send.push_back({next_local, (uint16_t)(lo & 0xFFF)});
+            next_local++;
+        }
+        for (;;) {
+            uint32_t f = next_input - delay;
+            if (!mine.count(f) || !peer.count(f)) break;
+            uint16_t p1 = host ? mine[f] : peer[f], p2 = host ? peer[f] : mine[f];
+            wr(OFF_INPUT + (next_input & 0xFF) * 8, input_word(next_input, p1, p2));
+            next_input++;
+        }
+        for (;;) {
+            uint64_t w = rd(OFF_CRC + (next_crc & 0xFF) * 8);
+            uint32_t hi = w >> 32, lo = (uint32_t)w;
+            uint32_t tag = next_crc & 0xFFFF;
+            if ((hi >> 16) != tag || (lo >> 16) != tag) break;
+            crcs[next_crc] = ((hi & 0xFFFF) << 16) | (lo & 0xFFFF);
+            next_crc++;
+        }
+    }
+};
+
+// Player input: mostly the joystick and button 1/2, a coin and Start now and then
+static uint16_t random_pad(std::mt19937_64 &r, uint32_t frame) {
+    uint16_t p = 0;
+    if (frame % 600 == 60)  p |= 1 << 11;      // coin
+    if (frame % 600 == 120) p |= 1 << 10;      // start
+    p |= r() & 0x3f;                           // directions, buttons 1-2
+    if ((p & 3) == 3) p &= ~1;                 // not Right and Left together
+    if ((p & 12) == 12) p &= ~4;               // not Down and Up together
+    return p;
+}
+
+int main(int argc, char *argv[]) {
+    int frames = 600, delay = 3, dirty = 0;
+    uint64_t seed = 1, max_lat = 400000;
+    {
+        const char *e = getenv("NP_ARGS");
+        std::vector<std::string> a;
+        if (e) { std::string s = e; size_t p = 0; while (p < s.size()) { size_t q = s.find(' ', p); if (q == std::string::npos) q = s.size(); if (q > p) a.push_back(s.substr(p, q - p)); p = q + 1; } }
+        for (size_t k = 0; k < a.size(); k++) {
+            auto next = [&]() { return k + 1 < a.size() ? a[++k].c_str() : "0"; };
+            if (a[k] == "--frames") frames = atoi(next());
+            else if (a[k] == "--seed") seed = strtoull(next(), 0, 0);
+            else if (a[k] == "--delay") delay = atoi(next());
+            else if (a[k] == "--latency") max_lat = strtoull(next(), 0, 0);
+            else if (a[k] == "--dirty") dirty = atoi(next());
+            else { fprintf(stderr, "np_test: unknown option %s\n", a[k].c_str()); return 2; }
+        }
+    }
+    VerilatedContext context;
+    context.commandArgs(argc, argv);
+    makeCRCTable();
+    try {
+        UUT mh{&context, "H"}, mj{&context, "J"};
+        for (UUT *m : {&mh, &mj}) { m->np_ddr_ack = 0; m->np_ddr_dout = 0; m->np_dip_wr = 0; }
+        Side H{"host", &mh}, J{"join", &mj};
+        JTSim sh(mh, argc, argv), sj(mj, argc, argv);
+        H.sim = &sh; J.sim = &sj;
+        H.rng.seed(seed * 7 + 1); J.rng.seed(seed * 13 + 2);
+
+        FakeHps hh(H, true, delay, 0x5A), hj(J, false, delay, 0x5A);
+        std::mt19937_64 r(seed);
+        const uint64_t FRAME_CLK = 811000;   // 48 MHz / 59.19 Hz
+        hh.arm_at = 2 * FRAME_CLK;
+        hj.arm_at = 2 * FRAME_CLK + (uint64_t)dirty * FRAME_CLK + r() % (3 * FRAME_CLK);
+        hj.settle += r() % FRAME_CLK;
+        fprintf(stderr, "\nnp_test: join arms %llu clocks after the host%s; delay %d, latency up to %llu clocks, seed %llu\n",
+            (unsigned long long)(hj.arm_at - hh.arm_at), dirty ? " (after playing with other input)" : "",
+            delay, (unsigned long long)max_lat, (unsigned long long)seed);
+
+        struct Pkt { uint64_t at; uint32_t f; uint16_t joy; };
+        std::deque<Pkt> to_j, to_h;
+        std::mt19937_64 ph(seed * 31 + 5), pj(seed * 37 + 11);
+        uint64_t now = 0;
+        uint64_t loaded_at = 0;
+        uint32_t last_report = 0, h_last = ~0u, j_last = ~0u;
+        for (;;) {
+            H.step(); J.step(); now++;
+            if (!loaded_at) {
+                if (!H.loaded() || !J.loaded()) { if (now > 400ull * FRAME_CLK) { fputs("FAIL: ROM load did not finish\n", stderr); return 1; } continue; }
+                loaded_at = now;
+                hh.arm_at += now; hj.arm_at += now;
+                fprintf(stderr, "np_test: ROM loaded at clock %llu\n", (unsigned long long)now);
+            }
+            // the pads change once per frame of each side (or every ~frame before its session)
+            uint32_t hf = hh.phase == 2 ? mh.np_frame : (uint32_t)(now / FRAME_CLK);
+            uint32_t jf = hj.phase == 2 ? mj.np_frame : (uint32_t)(now / FRAME_CLK) + 1000;
+            if (hf != h_last) { h_last = hf; H.pad = random_pad(ph, hf); }
+            if (jf != j_last) { j_last = jf; J.pad = (hj.phase == 2 || dirty) ? random_pad(pj, jf) : 0; }
+            if (now % 64) continue;
+
+            std::vector<std::pair<uint32_t, uint16_t>> s_h, s_j;
+            hh.poll(now, s_h); hj.poll(now, s_j);
+            for (auto &x : s_h) to_j.push_back({ now + r() % (max_lat + 1), x.first, x.second });
+            for (auto &x : s_j) to_h.push_back({ now + r() % (max_lat + 1), x.first, x.second });
+            for (auto it = to_j.begin(); it != to_j.end();) { if (it->at <= now) { hj.peer[it->f] = it->joy; it = to_j.erase(it); } else ++it; }
+            for (auto it = to_h.begin(); it != to_h.end();) { if (it->at <= now) { hh.peer[it->f] = it->joy; it = to_h.erase(it); } else ++it; }
+            if (mh.np_error || mj.np_error || mh.np_state == 4 || mj.np_state == 4) {
+                fprintf(stderr, "\nFAIL: netplay error host %02x join %02x\n", mh.np_error, mj.np_error);
+                return 1;
+            }
+            uint32_t n = std::min(hh.next_crc, hj.next_crc);
+            if (n && n / 60 != last_report) {
+                last_report = n / 60;
+                fprintf(stderr, "\nnp_test: frame %u: stalls host %u join %u, held clocks host %llu join %llu\n", n,
+                    (unsigned)(hh.rd(OFF_STATUS) & 0xFFFF), (unsigned)(hj.rd(OFF_STATUS) & 0xFFFF),
+                    (unsigned long long)H.held, (unsigned long long)J.held);
+                for (uint32_t f = 0; f < n; f++)
+                    if (hh.crcs[f] != hj.crcs[f]) {
+                        fprintf(stderr, "FAIL: CRC mismatch at frame %u: host %08x join %08x\n", f, hh.crcs[f], hj.crcs[f]);
+                        return 1;
+                    }
+            }
+            if (n > (uint32_t)frames) break;
+            if (now > loaded_at + hj.arm_at + (uint64_t)(frames + 60) * FRAME_CLK * 3) {
+                fprintf(stderr, "\nFAIL: timeout at %u frames (host state %d, join state %d)\n", n, mh.np_state, mj.np_state);
+                return 1;
+            }
+        }
+        int bad = 0;
+        uint32_t n = std::min(hh.next_crc, hj.next_crc);
+        for (uint32_t f = 0; f < n; f++)
+            if (hh.crcs[f] != hj.crcs[f]) { if (bad++ < 5) fprintf(stderr, "CRC mismatch frame %u: host %08x join %08x\n", f, hh.crcs[f], hj.crcs[f]); }
+        std::set<uint32_t> distinct;
+        for (auto &x : hh.crcs) distinct.insert(x.second);
+        fprintf(stderr, "\nnp_test: %u frames compared, %d CRC mismatches, %zu distinct CRCs; held clocks host %llu join %llu; "
+            "stalls host %u join %u\n", n, bad, distinct.size(), (unsigned long long)H.held, (unsigned long long)J.held,
+            (unsigned)(hh.rd(OFF_STATUS) & 0xFFFF), (unsigned)(hj.rd(OFF_STATUS) & 0xFFFF));
+        bool ok = n > (uint32_t)frames && !bad && distinct.size() > 10;
+        fprintf(stderr, "%s netplay\n", ok ? "PASS" : "FAIL");
+        return ok ? 0 : 1;
+    } catch (const char *error) {
+        fprintf(stderr, "%s\n", error);
+        return 1;
+    } catch (const std::exception &error) {
+        fprintf(stderr, "ERROR: %s\n", error.what());
+        return 1;
+    }
+}
