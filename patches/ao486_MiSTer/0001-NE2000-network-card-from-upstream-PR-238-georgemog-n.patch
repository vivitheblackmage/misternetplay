+    task automatic data_port_write_word;
+        input [15:0] value;
+        integer w;
+        reg done;
+        begin
+            done = 1'b0;
+            @(negedge clk_sys);
+            cpu_addr = 15'h0620; cpu_data_in = value;   // X-Surf 16-bit data port at 0xEA0C40 (the xsurftest port, reg 0x10)
