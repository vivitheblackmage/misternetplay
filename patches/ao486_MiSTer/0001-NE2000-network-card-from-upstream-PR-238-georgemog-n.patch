diff --git a/sw/nettest/NE2KTEST.ASM b/sw/nettest/NE2KTEST.ASM
new file mode 100644
index 0000000..bd23665
--- /dev/null
+++ b/sw/nettest/NE2KTEST.ASM
@@ -0,0 +1,643 @@
+; NE2KTEST.COM - NE2000 bring-up probe for the MiSTer ao486 core.
+;
+; Hardware test T3.4 of NE2000_AO486_PLAN.md. Freestanding 16-bit DOS .COM:
+; no libc, no runtime, runs in pure DOS and in a Win9x DOS box.
+;
+; Everything it does is local to the card - no HPS transport, no driver, no
+; packet reaches the wire. It answers bring-up questions in order:
+;
+;   1. reset port        read base+0x18, ISR.RST must set
+;   2. card decoded      RTL8019 ID at base+0x0A / +0x0B = 50 70
+;   3. registers hold    BNRY write / read-back
+;   4. 8-bit data port   AA,BB written and read back (the BF-6 regression)
+;   5. 16-bit data port  words written and read back  <- DEBUG.EXE cannot do this
+;   6. station PROM      remote DMA from 0x0000, prints the MAC
+;   7. debug aperture    base+0x20..0x26 transport state
+;
+;   Usage:  NE2KTEST [base]      base in hex, default 300
+;
+;   Build:  nasm -f bin -o NE2KTEST.COM NE2KTEST.ASM
+
+BITS 16
+ORG 0x100
+
+%define DEF_BASE 0x300
+
+; ---------------------------------------------------------------------------
+start:
+        cld
+        call    parse_cmdline
+
+        mov     dx, m_banner
+        call    putstr
+        mov     ax, [base]
+        call    puthex16
+        call    crlf
+        call    crlf
+
+        call    test_reset
+        call    test_id
+        cmp     byte [card_ok], 0
+        je      .no_card
+
+        call    test_regs
+        call    test_byte_mode
+        call    test_word_mode
+        call    test_prom
+        call    dump_debug
+        jmp     .finish
+
+.no_card:
+        mov     dx, m_nocard
+        call    putstr
+.finish:
+        call    summary
+        mov     al, [fails]
+        cmp     al, 0
+        je      .exit_ok
+        mov     al, 1
+.exit_ok:
+        mov     ah, 0x4C
+        int     0x21
+
+; ---------------------------------------------------------------------------
+; Port helper: BX = offset from base  ->  DX = absolute port
+setport:
+        mov     dx, [base]
+        add     dx, bx
+        ret
+
+; Write AL to base+BX
+outb_off:
+        push    ax
+        call    setport
+        pop     ax
+        out     dx, al
+        ret
+
+; Read base+BX into AL
+inb_off:
+        call    setport
+        in      al, dx
+        ret
+
+short_delay:
+        push    cx
+        mov     cx, 0x0400
+.spin:  loop    .spin
+        pop     cx
+        ret
+
+; ---------------------------------------------------------------------------
+; 1. Reset port
+test_reset:
+        mov     bx, 0x18
+        call    inb_off                 ; read of reset port triggers reset
+        call    short_delay
+
+        mov     bx, 0x07
+        call    inb_off                 ; ISR
+        test    al, 0x80                ; ISR.RST
+        jz      .fail
+
+        mov     dx, m_reset_ok
+        call    putstr
+        jmp     .clear
+.fail:
+        mov     dx, m_reset_bad
+        call    putstr
+        call    bump_fail
+.clear:
+        mov     bx, 0x07
+        mov     al, 0xFF
+        call    outb_off                ; clear ISR
+        ret
+
+; ---------------------------------------------------------------------------
+; 2. RTL8019 ID
+test_id:
+        mov     bx, 0x00
+        mov     al, 0x21                ; CR: stop, page 0, abort DMA
+        call    outb_off
+
+        mov     bx, 0x0A
+        call    inb_off
+        mov     [id0], al
+        mov     bx, 0x0B
+        call    inb_off
+        mov     [id1], al
+
+        mov     dx, m_id
+        call    putstr
+        mov     al, [id0]
+        call    puthex8
+        mov     dl, ' '
+        call    putch
+        mov     al, [id1]
+        call    puthex8
+
+        cmp     byte [id0], 0x50
+        jne     .bad
+        cmp     byte [id1], 0x70
+        jne     .bad
+        mov     dx, m_ok
+        call    putstr
+        mov     byte [card_ok], 1
+        ret
+.bad:
+        mov     dx, m_bad
+        call    putstr
+        call    bump_fail
+        mov     byte [card_ok], 0
+        ret
+
+; ---------------------------------------------------------------------------
+; 3. Register read-back
+test_regs:
+        mov     bx, 0x00
+        mov     al, 0x21
+        call    outb_off
+        mov     bx, 0x01                ; PSTART
+        mov     al, 0x46
+        call    outb_off
+        mov     bx, 0x02                ; PSTOP
+        mov     al, 0x80
+        call    outb_off
+        mov     bx, 0x03                ; BNRY
+        mov     al, 0x46
+        call    outb_off
+
+        mov     bx, 0x03
+        call    inb_off
+        mov     ah, al
+
+        mov     dx, m_regs
+        call    putstr
+        mov     al, ah
+        push    ax
+        call    puthex8
+        pop     ax
+        cmp     al, 0x46
+        jne     .bad
+        mov     dx, m_ok
+        call    putstr
+        ret
+.bad:
+        mov     dx, m_bad
+        call    putstr
+        call    bump_fail
+        ret
+
+; ---------------------------------------------------------------------------
+; Arm remote DMA: AX = NIC address, CX = byte count, BL = 0 read / 1 write,
+; BH = DCR value
+arm_dma:
+        push    ax
+        push    cx
+        push    bx
+
+        mov     [tmp_addr], ax
+        mov     [tmp_cnt], cx
+        mov     [tmp_dir], bl
+        mov     [tmp_dcr], bh
+
+        mov     bx, 0x00                ; CR: stop, page 0, abort
+        mov     al, 0x21
+        call    outb_off
+        mov     bx, 0x0E                ; DCR
+        mov     al, [tmp_dcr]
+        call    outb_off
+        mov     bx, 0x0A                ; RBCR0
+        mov     al, [tmp_cnt]
+        call    outb_off
+        mov     bx, 0x0B                ; RBCR1
+        mov     al, [tmp_cnt+1]
+        call    outb_off
+        mov     bx, 0x08                ; RSAR0
+        mov     al, [tmp_addr]
+        call    outb_off
+        mov     bx, 0x09                ; RSAR1
+        mov     al, [tmp_addr+1]
+        call    outb_off
+
+        mov     bx, 0x00                ; CR: start + remote read/write
+        mov     al, 0x0A                ; STA | RD0 (remote read)
+        cmp     byte [tmp_dir], 0
+        je      .go
+        mov     al, 0x12                ; STA | RD1 (remote write)
+.go:
+        call    outb_off
+        call    short_delay
+
+        pop     bx
+        pop     cx
+        pop     ax
+        ret
+
+; ---------------------------------------------------------------------------
+; 4. 8-bit data port round trip (BF-6 regression)
+test_byte_mode:
+        mov     ax, 0x4000
+        mov     cx, 4
+        mov     bx, 0x0001              ; BL=1 write, BH=0x00 DCR byte mode
+        call    arm_dma
+
+        mov     bx, 0x10
+        mov     al, 0xAA
+        call    outb_off
+        mov     bx, 0x10
+        mov     al, 0xBB
+        call    outb_off
+        call    short_delay
+
+        mov     ax, 0x4000
+        mov     cx, 4
+        mov     bx, 0x0000              ; read, byte mode
+        call    arm_dma
+
+        mov     bx, 0x10
+        call    inb_off
+        mov     [got0], al
+        mov     bx, 0x10
+        call    inb_off
+        mov     [got1], al
+
+        mov     dx, m_byte
+        call    putstr
+        mov     al, [got0]
+        call    puthex8
+        mov     dl, ' '
+        call    putch
+        mov     al, [got1]
+        call    puthex8
+
+        cmp     byte [got0], 0xAA
+        jne     .bad
+        cmp     byte [got1], 0xBB
+        jne     .bad
+        mov     dx, m_ok
+        call    putstr
+        ret
+.bad:
+        mov     dx, m_bad
+        call    putstr
+        call    bump_fail
+        cmp     byte [got0], 0xBB
+        jne     .done
+        cmp     byte [got1], 0xAA
+        jne     .done
+        mov     dx, m_swapped
+        call    putstr
+.done:
+        ret
+
+; ---------------------------------------------------------------------------
+; 5. 16-bit data port round trip - the path DEBUG.EXE cannot reach
+test_word_mode:
+        mov     ax, 0x4000
+        mov     cx, 8
+        mov     bx, 0x0101              ; BL=1 write, BH=0x01 DCR WTS=1, BOS=0
+        call    arm_dma
+
+        mov     si, patterns
+        mov     cx, 4
+.wr:
+        lodsw
+        push    cx
+        push    ax
+        mov     bx, 0x10
+        call    setport
+        pop     ax
+        out     dx, ax                  ; 16-bit OUT
+        pop     cx
+        loop    .wr
+        call    short_delay
+
+        mov     ax, 0x4000
+        mov     cx, 8
+        mov     bx, 0x0100              ; read, WTS=1
+        call    arm_dma
+
+        mov     di, results
+        mov     cx, 4
+.rd:
+        push    cx
+        mov     bx, 0x10
+        call    setport
+        in      ax, dx                  ; 16-bit IN
+        stosw
+        pop     cx
+        loop    .rd
+
+        ; compare
+        mov     si, patterns
+        mov     di, results
+        mov     cx, 4
+        xor     bp, bp
+.cmp:
+        lodsw
+        mov     bx, ax
+        mov     ax, [di]
+        add     di, 2
+        cmp     ax, bx
+        je      .next
+        inc     bp
+.next:
+        loop    .cmp
+
+        mov     dx, m_word
+        call    putstr
+        mov     ax, [results]
+        call    puthex16
+        mov     dl, ' '
+        call    putch
+        mov     ax, [results+2]
+        call    puthex16
+
+        cmp     bp, 0
+        jne     .bad
+        mov     dx, m_ok
+        call    putstr
+        ret
+.bad:
+        mov     dx, m_bad
+        call    putstr
+        call    bump_fail
+        ; name the classic failure: bytes within each word swapped
+        mov     ax, [results]
+        xchg    al, ah
+        cmp     ax, [patterns]
+        jne     .done
+        mov     dx, m_swapped
+        call    putstr
+.done:
+        ret
+
+; ---------------------------------------------------------------------------
+; 6. Station PROM -> MAC
+test_prom:
+        mov     ax, 0x0000
+        mov     cx, 32
+        mov     bx, 0x0100              ; read, WTS=1
+        call    arm_dma
+
+        mov     di, prombuf
+        mov     cx, 16
+.rd:
+        push    cx
+        mov     bx, 0x10
+        call    setport
+        in      ax, dx
+        stosw
+        pop     cx
+        loop    .rd
+
+        mov     dx, m_prom
+        call    putstr
+
+        ; PROM duplicates every byte: MAC = low byte of words 0..5
+        mov     si, prombuf
+        mov     cx, 6
+.pr:
+        lodsw
+        push    cx
+        push    ax
+        call    puthex8                 ; AL = MAC byte
+        pop     ax
+        pop     cx
+        cmp     cx, 1
+        je      .nosep
+        mov     dl, ':'
+        call    putch
+.nosep:
+        loop    .pr
+
+        mov     al, [prombuf]
+        cmp     al, 0xFF
+        jne     .ok
+        mov     al, [prombuf+2]
+        cmp     al, 0xFF
+        jne     .ok
+        mov     dx, m_bad
+        call    putstr
+        call    bump_fail
+        ret
+.ok:
+        mov     dx, m_ok
+        call    putstr
+        ret
+
+; ---------------------------------------------------------------------------
+; 7. Debug aperture
+dump_debug:
+        mov     dx, m_dbg
+        call    putstr
+
+        xor     si, si
+.next:
+        mov     dx, m_dbg_pfx
+        call    putstr
+        mov     ax, si
+        add     al, '0'
+        mov     dl, al
+        call    putch
+        mov     dl, ' '
+        call    putch
+
+        ; name table entries are 6 bytes each ("xxxx " + '$'); si*6 without
+        ; using MUL, which would clobber DX
+        mov     ax, si
+        shl     ax, 1
+        mov     bx, ax
+        shl     ax, 1
+        add     ax, bx
+        add     ax, dbg_names
+        mov     dx, ax
+        call    putstr
+
+        mov     bx, si
+        add     bx, 0x20
+        call    inb_off
+        call    puthex8
+        call    crlf
+
+        inc     si
+        cmp     si, 7
+        jb      .next
+        ret
+
+; ---------------------------------------------------------------------------
+summary:
+        call    crlf
+        mov     al, [fails]
+        cmp     al, 0
+        jne     .failed
+        mov     dx, m_passed
+        call    putstr
+        ret
+.failed:
+        mov     dx, m_failed
+        call    putstr
+        mov     al, [fails]
+        call    puthex8
+        call    crlf
+        ret
+
+bump_fail:
+        inc     byte [fails]
+        ret
+
+; ---------------------------------------------------------------------------
+; Command line: optional hex base
+parse_cmdline:
+        mov     si, 0x81
+        mov     cl, [0x80]
+        xor     ch, ch
+        jcxz    .done
+        xor     bx, bx                  ; accumulator
+        xor     di, di                  ; digit count
+.scan:
+        lodsb
+        cmp     al, ' '
+        je      .cont
+        cmp     al, 9
+        je      .cont
+        cmp     al, 0x0D
+        je      .fin
+        call    hexval
+        jc      .fin
+        shl     bx, 4
+        or      bl, al
+        inc     di
+.cont:
+        loop    .scan
+.fin:
+        cmp     di, 0
+        je      .done
+        mov     [base], bx
+.done:
+        ret
+
+; AL = ascii -> AL = value, CF set if not a hex digit
+hexval:
+        cmp     al, '0'
+        jb      .no
+        cmp     al, '9'
+        ja      .alpha
+        sub     al, '0'
+        clc
+        ret
+.alpha:
+        and     al, 0xDF                ; upper-case
+        cmp     al, 'A'
+        jb      .no
+        cmp     al, 'F'
+        ja      .no
+        sub     al, 'A' - 10
+        clc
+        ret
+.no:
+        stc
+        ret
+
+; ---------------------------------------------------------------------------
+; Output helpers
+putstr:                                 ; DX = '$'-terminated string
+        push    ax
+        mov     ah, 0x09
+        int     0x21
+        pop     ax
+        ret
+
+putch:                                  ; DL = character
+        push    ax
+        mov     ah, 0x02
+        int     0x21
+        pop     ax
+        ret
+
+crlf:
+        push    dx
+        mov     dl, 0x0D
+        call    putch
+        mov     dl, 0x0A
+        call    putch
+        pop     dx
+        ret
+
+puthex8:                                ; AL = byte
+        push    ax
+        push    dx
+        push    ax
+        shr     al, 4
+        call    puthex_nib
+        pop     ax
+        and     al, 0x0F
+        call    puthex_nib
+        pop     dx
+        pop     ax
+        ret
+
+puthex16:                               ; AX = word
+        push    ax
+        mov     al, ah
+        call    puthex8
+        pop     ax
+        call    puthex8
+        ret
+
+puthex_nib:                             ; AL = 0..15
+        add     al, '0'
+        cmp     al, '9'
+        jbe     .emit
+        add     al, 7
+.emit:
+        mov     dl, al
+        call    putch
+        ret
+
+; ---------------------------------------------------------------------------
+section .data
+
+base            dw      DEF_BASE
+fails           db      0
+card_ok         db      0
+id0             db      0
+id1             db      0
+got0            db      0
+got1            db      0
+tmp_addr        dw      0
+tmp_cnt         dw      0
+tmp_dir         db      0
+tmp_dcr         db      0
+
+patterns        dw      0x1234, 0xA55A, 0xDEAD, 0xBEEF
+results         dw      0, 0, 0, 0
+prombuf         times   16 dw 0
+
+m_banner        db      'NE2KTEST - ao486 NE2000 probe, I/O base 0x$'
+m_reset_ok      db      '  [ ok ] reset port         ISR.RST set',13,10,'$'
+m_reset_bad     db      '  [FAIL] reset port         ISR.RST did not set',13,10,'$'
+m_id            db      '  ..... RTL8019 ID          $'
+m_regs          db      '  ..... BNRY read-back      $'
+m_byte          db      '  ..... 8-bit data port     $'
+m_word          db      '  ..... 16-bit data port    $'
+m_prom          db      '  ..... station PROM (MAC)  $'
+m_ok            db      '   [ ok ]',13,10,'$'
+m_bad           db      '   [FAIL]',13,10,'$'
+m_swapped       db      '         -> bytes are SWAPPED (BOS handling wrong)',13,10,'$'
+m_nocard        db      13,10,'Card not responding. Enable Network in the OSD',13,10
+                db      'and check the I/O base matches (default 300).',13,10,'$'
+m_dbg           db      13,10,'  Debug aperture (ao486-only):',13,10,'$'
+m_dbg_pfx       db      '    +$'
+m_passed        db      'PASSED',13,10,'$'
+m_failed        db      'FAILED, failure count 0x$'
+
+; 7 names, 5 chars + '$' each, indexed by the *5 arithmetic above
+dbg_names       db      'dmaL $'
+                db      'dmaH $'
+                db      'cntL $'
+                db      'cntH $'
+                db      'dpst $'
+                db      'hpsc $'
+                db      'hbLo $'
diff --git a/sw/nettest/NE2KTEST.C b/sw/nettest/NE2KTEST.C
new file mode 100644
index 0000000..6e023ce
--- /dev/null
+++ b/sw/nettest/NE2KTEST.C
@@ -0,0 +1,242 @@
+/*
+ * NE2KTEST - NE2000 bring-up probe for the MiSTer ao486 core.
+ *
+ * Hardware test T3.4 of NE2000_AO486_PLAN.md. Everything it does is local to
+ * the card: no HPS transport, no driver, no packet ever reaches the wire. It
+ * answers the questions a bring-up needs answered, in order:
+ *
+ *   1. Is the card decoded at all?          RTL8019 ID at base+0x0A/0x0B
+ *   2. Do registers hold what is written?   BNRY / PSTART / PSTOP read-back
+ *   3. Is the station PROM readable?        remote DMA from 0x0000 -> MAC
+ *   4. Does the 16-bit data port work,      remote DMA write + read-back of
+ *      with the right byte order?           packet RAM at 0x4000
+ *   5. What does the transport think?       debug aperture at base+0x20
+ *
+ * Usage:  NE2KTEST [base]        base in hex, default 300
+ *
+ * Build with Open Watcom (same as the other sw/ utilities):  wmake
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <conio.h>
+
+/* NE2000 register offsets from the I/O base (page 0 unless noted) */
+#define R_CR      0x00
+#define R_CLDA0   0x01      /* write: PSTART */
+#define R_CLDA1   0x02      /* write: PSTOP  */
+#define R_BNRY    0x03
+#define R_TSR     0x04      /* write: TPSR   */
+#define R_ISR     0x07
+#define R_RSAR0   0x08
+#define R_RSAR1   0x09
+#define R_ID0     0x0A      /* write: RBCR0  */
+#define R_ID1     0x0B      /* write: RBCR1  */
+#define R_RCR     0x0C
+#define R_DCR     0x0E
+#define R_IMR     0x0F
+#define R_DATA    0x10      /* remote DMA data port */
+#define R_RESET   0x18
+#define R_DEBUG   0x20      /* ao486-only debug aperture */
+
+/* CR bits */
+#define CR_STP    0x01
+#define CR_STA    0x02
+#define CR_RD_RD  0x08      /* remote read  */
+#define CR_RD_WR  0x10      /* remote write */
+#define CR_RD_ABT 0x20      /* abort/complete remote DMA */
+
+/* DCR bits */
+#define DCR_WTS   0x01      /* 16-bit transfers */
+#define DCR_BOS   0x02      /* byte order select; x86 leaves this CLEAR */
+
+static unsigned base = 0x300;
+static int failures = 0;
+
+static void ok(char *what, char *detail)
+{
+    printf("  [ ok ] %-34s %s\n", what, detail);
+}
+
+static void bad(char *what, char *detail)
+{
+    printf("  [FAIL] %-34s %s\n", what, detail);
+    failures++;
+}
+
+static void nic_stop(void)
+{
+    outp(base + R_CR, CR_STP | CR_RD_ABT);      /* stop, page 0, abort DMA */
+}
+
+/* Arm a remote DMA transfer of `count` bytes at NIC memory `addr`. */
+static void dma_arm(unsigned addr, unsigned count, int write)
+{
+    nic_stop();
+    outp(base + R_DCR,   DCR_WTS);              /* 16-bit, x86 byte order */
+    outp(base + R_ID0,   count & 0xFF);         /* RBCR0 */
+    outp(base + R_ID1,   count >> 8);           /* RBCR1 */
+    outp(base + R_RSAR0, addr & 0xFF);
+    outp(base + R_RSAR1, addr >> 8);
+    outp(base + R_CR, CR_STA | (write ? CR_RD_WR : CR_RD_RD));
+}
+
+static int test_id(void)
+{
+    unsigned char id0, id1;
+    char msg[64];
+
+    nic_stop();
+    id0 = inp(base + R_ID0);
+    id1 = inp(base + R_ID1);
+    sprintf(msg, "0x%02X 0x%02X", id0, id1);
+
+    if (id0 == 0x50 && id1 == 0x70) {
+        ok("RTL8019 ID at base+0x0A/0x0B", msg);
+        return 1;
+    }
+    if (id0 == 0xFF && id1 == 0xFF) {
+        bad("RTL8019 ID at base+0x0A/0x0B", "open bus - card not decoded here");
+        return 0;
+    }
+    bad("RTL8019 ID at base+0x0A/0x0B", msg);
+    return 0;
+}
+
+static void test_registers(void)
+{
+    unsigned char v;
+    char msg[64];
+
+    nic_stop();
+    outp(base + R_CLDA0, 0x46);                 /* PSTART */
+    outp(base + R_CLDA1, 0x80);                 /* PSTOP  */
+    outp(base + R_BNRY,  0x46);
+
+    v = inp(base + R_BNRY);
+    sprintf(msg, "wrote 0x46, read 0x%02X", v);
+    if (v == 0x46) ok("BNRY read-back", msg);
+    else           bad("BNRY read-back", msg);
+}
+
+static void test_prom(void)
+{
+    unsigned char prom[32];
+    char msg[80];
+    int i;
+    unsigned w;
+
+    dma_arm(0x0000, 32, 0);
+    for (i = 0; i < 32; i += 2) {
+        w = inpw(base + R_DATA);
+        prom[i]     = (unsigned char)(w & 0xFF);
+        prom[i + 1] = (unsigned char)(w >> 8);
+    }
+
+    /* A real NE2000 PROM duplicates every byte: 52 52 54 54 ... */
+    sprintf(msg, "%02X:%02X:%02X:%02X:%02X:%02X",
+            prom[0], prom[2], prom[4], prom[6], prom[8], prom[10]);
+
+    if (prom[0] == 0xFF && prom[2] == 0xFF)
+        bad("station PROM (MAC)", "all 0xFF - PROM not readable");
+    else if (prom[14] == 0x57 && prom[15] == 0x57)
+        ok("station PROM (MAC)", msg);
+    else
+        ok("station PROM (MAC, no 57 57 sig)", msg);
+}
+
+/*
+ * Write a pattern through the 16-bit data port, read it back, and check the
+ * byte order. With DCR.BOS clear an x86 host must get its low byte back in the
+ * low byte -- this is the check that catches a byte-swapped port, the failure
+ * that would otherwise show up much later as corrupted packets.
+ */
+static void test_packet_ram(void)
+{
+    static unsigned pattern[8] = {
+        0x1234, 0xA55A, 0xFFFF, 0x0000, 0xDEAD, 0xBEEF, 0x0102, 0x8000
+    };
+    unsigned got[8];
+    char msg[80];
+    int i, errs = 0;
+
+    dma_arm(0x4000, sizeof(pattern), 1);
+    for (i = 0; i < 8; i++) outpw(base + R_DATA, pattern[i]);
+
+    dma_arm(0x4000, sizeof(pattern), 0);
+    for (i = 0; i < 8; i++) got[i] = inpw(base + R_DATA);
+
+    for (i = 0; i < 8; i++) if (got[i] != pattern[i]) errs++;
+
+    if (errs == 0) {
+        ok("packet RAM via 16-bit data port", "8/8 words match");
+    } else {
+        sprintf(msg, "%d/8 words wrong, first: wrote 0x%04X read 0x%04X",
+                errs, pattern[0], got[0]);
+        bad("packet RAM via 16-bit data port", msg);
+
+        /* Name the failure mode rather than leaving it to guesswork. */
+        if (((got[0] >> 8) | (got[0] << 8)) == (pattern[0] & 0xFFFF))
+            printf("         -> bytes are SWAPPED: DCR.BOS polarity is wrong\n");
+    }
+}
+
+static void dump_debug(void)
+{
+    static char *names[7] = {
+        "remote DMA addr low ",
+        "remote DMA addr high",
+        "remote byte cnt low ",
+        "remote byte cnt high",
+        "data-port status    ",
+        "HPS comm status     ",
+        "HPS heartbeat low   "
+    };
+    int i;
+    unsigned char v;
+
+    printf("\n  Debug aperture at 0x%03X (ao486-only):\n", base + R_DEBUG);
+    for (i = 0; i < 7; i++) {
+        v = inp(base + R_DEBUG + i);
+        printf("    +%X  %s  0x%02X\n", i, names[i], v);
+    }
+    printf("    (HPS comm status stays 0 until the Phase 4 transport is wired)\n");
+}
+
+int main(int argc, char **argv)
+{
+    unsigned char isr;
+
+    if (argc > 1) {
+        base = (unsigned)strtoul(argv[1], NULL, 16);
+        if (base < 0x200 || base > 0x3E0) {
+            printf("NE2KTEST: base 0x%X is not a sane ISA I/O base\n", base);
+            return 2;
+        }
+    }
+
+    printf("NE2KTEST - ao486 NE2000 probe, I/O base 0x%03X\n\n", base);
+
+    /* Reset port: a read triggers the reset, ISR.RST should come up set. */
+    inp(base + R_RESET);
+    isr = inp(base + R_ISR);
+    if (isr & 0x80) ok("reset port", "ISR.RST set");
+    else            bad("reset port", "ISR.RST did not set");
+    outp(base + R_ISR, 0xFF);                   /* clear ISR */
+
+    if (!test_id()) {
+        printf("\nCard not responding. Check that Network is enabled in the OSD\n"
+               "and that the I/O base matches (default 300).\n");
+        return 1;
+    }
+
+    test_registers();
+    test_prom();
+    test_packet_ram();
+    dump_debug();
+
+    printf("\n%s (%d failure%s)\n",
+           failures ? "FAILED" : "PASSED", failures, failures == 1 ? "" : "s");
+    return failures ? 1 : 0;
+}
