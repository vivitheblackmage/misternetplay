+function [15:0] maybe_swap_word;
+    input [15:0] word_value;
+    input        swap_bytes;
+    begin
+        maybe_swap_word = swap_bytes ? {word_value[7:0], word_value[15:8]} : word_value;
+    end
+endfunction
