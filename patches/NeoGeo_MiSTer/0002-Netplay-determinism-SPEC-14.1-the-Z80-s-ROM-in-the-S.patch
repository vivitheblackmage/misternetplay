diff --git a/npsim/snapdiff.py b/npsim/snapdiff.py
new file mode 100644
index 0000000..e6ba019
--- /dev/null
+++ b/npsim/snapdiff.py
@@ -0,0 +1,55 @@
+#!/usr/bin/env python3
+"""Compares two snapshots of neogeo_sim --snap (the trace build): every signal
+whose value differs at the clock on which the core's reset ends.
+
+  snapdiff.py a.vcd b.vcd [-v]
+
+Prints the registers per module (how many differ, and their names); -v adds
+the values. What differs is state the reset leaves as it was: a counter that
+runs on through the reset, or a register nothing initialises. Wires are left
+out when a register in the same module already differs (they follow from it);
+memories are not in the snapshot.
+"""
+import sys, re
+
+
+def load(path):
+    names, vals, scope = {}, {}, []
+    with open(path, encoding="latin-1") as f:
+        for line in f:
+            t = line.split()
+            if not t:
+                continue
+            if t[0] == "$scope":
+                scope.append(t[2])
+            elif t[0] == "$upscope":
+                scope.pop()
+            elif t[0] == "$var":
+                names.setdefault(t[3], (".".join(scope), t[4], t[1], int(t[2])))
+            elif t[0][0] == "b":
+                vals[t[1]] = t[0][1:].lstrip("0") or "0"
+            elif t[0][0] in "01xz" and len(t) == 1:
+                vals[t[0][1:]] = t[0][0]
+    return names, vals
+
+
+a_names, a = load(sys.argv[1])
+b_names, b = load(sys.argv[2])
+verbose = "-v" in sys.argv
+skip = re.compile(r"^sim_top$|hps_io|\.chip_model")       # the bench's own signals
+# not the emulated machine: the SDRAM controller's start-up counter (unused once
+# it has started) and the framework's OSD button timer
+allow = {("TOP.sim_top.emu.ram1", "refresh_count"), ("TOP.sim_top.emu.unnamedblk3", "timeout")}
+mods = {}
+for i, (scope, name, kind, width) in a_names.items():
+    if skip.search(scope) or (scope, name) in allow or a.get(i) == b.get(i):
+        continue
+    mods.setdefault(scope, []).append((name, kind, a.get(i), b.get(i)))
+total = 0
+for scope in sorted(mods):
+    regs = [x for x in mods[scope] if x[1] == "reg"] or mods[scope]
+    total += len(regs)
+    print(f"{scope}: {len(regs)}")
+    for name, kind, x, y in sorted(regs):
+        print(f"    {name}" + (f"  {x} | {y}" if verbose else ""))
+print(f"{total} signals differ in {len(mods)} modules")
