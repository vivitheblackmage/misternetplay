From ccba5d8cd1d0949c1fb566e75558075c9a40e546 Mon Sep 17 00:00:00 2001
From: netplay <netplay@localhost>
Date: Sun, 15 Nov 2026 11:18:40 +0100
Subject: [PATCH] netplay: the trace follows the 68000 (its writes, compressed
 per part of the map, interrupt acknowledges, frame starts; NP_TRACE68), DBG
 counts the clocks the 68000 waits for the SDRAM; bench: --log68, trace68.py
---
 neogeo.sv                     | 84 +++++++++++++++++++++++++++++------
 npsim/neogeo_sim.cpp          | 10 +++++
 npsim/trace68.py              | 63 ++++++++++++++++++++++++++
 rtl/netplay/neogeo_netplay.sv | 14 +++---
 4 files changed, 152 insertions(+), 19 deletions(-)
 create mode 100644 npsim/trace68.py

diff --git a/neogeo.sv b/neogeo.sv
index dc0f206..24afd64 100644
--- a/neogeo.sv
+++ b/neogeo.sv
@@ -534,24 +534,43 @@ reg  np_w68;
 wire np_w68_now = ~M68K_RW & ~nAS & ~(nUDS & nLDS);
 always @(posedge CLK_48M) np_w68 <= np_w68_now;
 // diagnostics: every write of the Z80, in its first clock; the Z80 waiting for
-// the SDRAM, the YM2610's ADPCM data late (assigned where those are)
+// the SDRAM, the 68000 waiting for the SDRAM (assigned where those are)
 wire np_dbg_zwait, np_dbg_late;
 wire np_bk_loading;                   // the core reads the save file (assigned below)
 
-// diagnostics: the trace's events (TRACE in neogeo_netplay.sv), one per clock:
+// diagnostics: the trace's events (TRACE in neogeo_netplay.sv), one per clock,
+// as 64-bit words (the kind in bits 31:28). NP_TRACE68 picks what is traced.
+// The Z80 (0): {machine clocks since the release, kind, 4'b0, data, address}:
 // 1 Z80 port write, 2 Z80 port read (at its end, with what the Z80 read),
 // 3 Z80 interrupt acknowledge, 4 NMI to the Z80, 5 the YM2610's IRQ line
-// changes (data: its new level), 6 the 68000 writes the sound command
+// changes (data: its new level), 6 the 68000 writes the sound command.
+// The 68000 (1), with fclk the machine clocks since the frame started:
+// 7 a write of the 68000 whose data or strobes differ from the last one traced
+//   in its part of the map (8 parts: 0x0, 0x1, 0x2, 0x30, the rest of 0x3,
+//   0x3C, 0x4-0x7, the rest), so the loops that fill memory take two:
+//   {fclk[18:3], UDS, LDS, A[23:17], A[15:9], 4'd7, 4'b0, A[8:1], data}
+// 8 a frame starts (vertical blank): {frame of the session, 4'd8, 28'd0}
+// 9 the 68000 acknowledges an interrupt: {fclk[18:3], 16'd0, 4'd9, 25'd0, level}
+localparam NP_TRACE68 = 1'b1;
+wire [31:0] np_dbg_clk;
 reg        np_ev;
-reg [31:0] np_ev_w;
+reg [63:0] np_ev_w;
 reg        ev_iow, ev_ior, ev_ack, ev_nmi, ev_int, ev_cmd;
 reg [15:0] ev_ra;
 reg  [7:0] ev_rd;
+reg        ev_vbl, ev_mark, ev_iack, ev_iack_p;
+reg [31:0] ev_frame;
+reg [18:0] ev_fclk;
+reg [17:0] ev_last [8];
+reg  [7:0] ev_seen;
 always @(posedge CLK_48M) begin
-	reg iow_now, ior_now, ack_now;
+	reg iow_now, ior_now, ack_now, iack_now;
+	reg [2:0] part;
+	reg [17:0] w;
 	iow_now = ~nIORQ & ~nSDWR;
 	ior_now = ~nIORQ & ~nSDRD;
 	ack_now = ~nIORQ & nSDRD & nSDWR;
+	iack_now = &{FC2, FC1, FC0} & ~nAS;
 	ev_iow <= iow_now;
 	ev_ior <= ior_now;
 	ev_ack <= ack_now;
@@ -560,13 +579,49 @@ always @(posedge CLK_48M) begin
 	ev_cmd <= nSDW;
 	if (ior_now) begin ev_ra <= SDA; ev_rd <= SDD_IN; end
 	np_ev <= 1'b1;
-	if (iow_now & ~ev_iow)          np_ev_w <= {4'd1, 4'd0, SDD_OUT, SDA};
-	else if (~ior_now & ev_ior)     np_ev_w <= {4'd2, 4'd0, ev_rd, ev_ra};
-	else if (ack_now & ~ev_ack)     np_ev_w <= {4'd3, 4'd0, SDD_IN, SDA};
-	else if (~Z80_nNMI & ev_nmi)    np_ev_w <= {4'd4, 4'd0, 8'd0, SDA};
-	else if (Z80_nINT != ev_int)    np_ev_w <= {4'd5, 4'd0, 7'd0, Z80_nINT, SDA};
-	else if (~nSDW & ev_cmd)        np_ev_w <= {4'd6, 4'd0, M68K_DATA[15:8], M68K_ADDR[16:1]};
-	else                            np_ev <= 1'b0;
+	if (!NP_TRACE68) begin
+		if (iow_now & ~ev_iow)          np_ev_w <= {np_dbg_clk, 4'd1, 4'd0, SDD_OUT, SDA};
+		else if (~ior_now & ev_ior)     np_ev_w <= {np_dbg_clk, 4'd2, 4'd0, ev_rd, ev_ra};
+		else if (ack_now & ~ev_ack)     np_ev_w <= {np_dbg_clk, 4'd3, 4'd0, SDD_IN, SDA};
+		else if (~Z80_nNMI & ev_nmi)    np_ev_w <= {np_dbg_clk, 4'd4, 4'd0, 8'd0, SDA};
+		else if (Z80_nINT != ev_int)    np_ev_w <= {np_dbg_clk, 4'd5, 4'd0, 7'd0, Z80_nINT, SDA};
+		else if (~nSDW & ev_cmd)        np_ev_w <= {np_dbg_clk, 4'd6, 4'd0, M68K_DATA[15:8], M68K_ADDR[16:1]};
+		else                            np_ev <= 1'b0;
+	end
+	else begin
+		// the frame's clock and its start
+		ev_vbl <= ~nBNKB;
+		if (CLK_EN_24M_P) ev_fclk <= ev_fclk + 19'd1;
+		if (~nBNKB & ~ev_vbl) begin ev_fclk <= 19'd0; ev_frame <= ev_frame + 32'd1; ev_mark <= 1'b1; end
+		ev_iack <= iack_now;
+		if (iack_now & ~ev_iack) ev_iack_p <= 1'b1;
+		casez (M68K_ADDR[23:17])
+			7'b0000_???: part = 3'd0;
+			7'b0001_???: part = 3'd1;
+			7'b0010_???: part = 3'd2;
+			7'b0011_000: part = 3'd3;
+			7'b0011_110: part = 3'd5;
+			7'b0011_???: part = 3'd4;
+			7'b01??_???: part = 3'd6;
+			default:     part = 3'd7;
+		endcase
+		w = {~nUDS, ~nLDS, FX68K_DATAOUT};
+		if (np_w68_now & ~np_w68 & (~ev_seen[part] | (ev_last[part] != w))) begin
+			ev_seen[part] <= 1'b1;
+			ev_last[part] <= w;
+			np_ev_w <= {ev_fclk[18:3], ~nUDS, ~nLDS, M68K_ADDR[23:17], M68K_ADDR[15:9], 4'd7, 4'd0, M68K_ADDR[8:1], FX68K_DATAOUT};
+		end
+		else if (ev_iack_p) begin
+			ev_iack_p <= 1'b0;
+			np_ev_w <= {ev_fclk[18:3], 16'd0, 4'd9, 25'd0, M68K_ADDR[3:1]};
+		end
+		else if (ev_mark & ~(~nBNKB & ~ev_vbl)) begin
+			ev_mark <= 1'b0;
+			np_ev_w <= {ev_frame, 4'd8, 28'd0};
+		end
+		else np_ev <= 1'b0;
+		if (np_hold_reset) begin ev_frame <= 32'd0; ev_mark <= 1'b0; ev_iack_p <= 1'b0; ev_seen <= 8'd0; end
+	end
 end
 reg  np_wz80;
 wire np_wz80_now = ~nSDWR & (~nMREQ | ~nIORQ);
@@ -592,6 +647,7 @@ neogeo_netplay NETPLAY
 	.dbg_late(np_dbg_late),
 	.dbg_ev(np_ev),
 	.dbg_ev_w(np_ev_w),
+	.dbg_clk(np_dbg_clk),
 	.rfsh_req(np_rfsh),
 	.active(np_active),
 	.hold_reset(np_hold_reset),
@@ -1247,6 +1303,8 @@ wire nDTACK_ADJ = ~&{nSROMOE, nROMOE, nPORTOE, ~CD_EXT_RD, ~CD_TR_RD_FIX, ~CD_TR
                     : (CD_TR_WR_PCM) ? ~ddram_dtack | nDTACK
                     : (CD_TR_RD_PCM) ? ~ADPCMA_RD_DTACK | nDTACK
                     : nDTACK;
+// diagnostics: a machine clock in which the 68000 waits for the SDRAM (DBG)
+assign np_dbg_late = CLK_EN_24M_P & ~nAS & nDTACK_ADJ & ~nDTACK;
 
 cpu_68k M68KCPU(
 	.CLK(CLK_48M),
@@ -1820,7 +1878,7 @@ reg [7:0] ADPCMA_ACK_COUNTER;
 reg [10:0] ADPCMB_ACK_COUNTER;
 wire ADPCMA_DATA_READY = ~((ADPCMA_READ_REQ ^ ADPCMA_READ_ACK) & (ADPCMA_ACK_COUNTER == 8'd0));
 wire ADPCMB_DATA_READY = ~((ADPCMB_READ_REQ ^ ADPCMB_READ_ACK) & (ADPCMB_ACK_COUNTER == 11'd0));
-assign np_dbg_late = (CLK_EN_4M_P | CLK_EN_4M_N) & ~(ADPCMA_DATA_READY & ADPCMB_DATA_READY);
+
 
 reg OLD_CD_TR_RD_PCM;
 reg ADPCMA_RD_DTACK, ADPCMA_RD_WAIT;
diff --git a/npsim/neogeo_sim.cpp b/npsim/neogeo_sim.cpp
index bc16252..456cb40 100644
--- a/npsim/neogeo_sim.cpp
+++ b/npsim/neogeo_sim.cpp
@@ -185,6 +185,8 @@ static int frame_no = -1;        // -1: before the first vertical blanking after
 static bool quiet = false, play = false;
 static int ztrace_a = -1, ztrace_b = -1;
 static FILE *zlog = nullptr;
+static FILE *log68 = nullptr;    // --log68: every bus cycle of the 68000 in frames log68_a..log68_b
+static int log68_a = 0, log68_b = -1;
 static const char *snap_file = nullptr;
 static bool prev_rst_n = true, snap_armed = true;   // with --warm: armed after that session's reset
 static int total_frames = 0;
@@ -308,6 +310,13 @@ static void monitor()
 	if (!top->core_reset_n) fr.rst++;
 	bool as = !top->m68k_as_n;
 	if (as && !prev_as) fr.c68++;     // a bus cycle of the 68000
+	if (log68)
+	{
+		static uint32_t la = 0, ld = 0, lclk = 0; static bool lrw = false, luds = false, llds = false;
+		if (as) { la = top->m68k_addr; lrw = top->m68k_rw; ld = lrw ? top->m68k_din : top->m68k_dout; luds = !top->m68k_uds_n; llds = !top->m68k_lds_n; if (!prev_as) lclk = fr.clocks; }
+		if (!as && prev_as && frame_no >= log68_a && frame_no <= log68_b)
+			fprintf(log68, "%d %u %s %06x %04x %d%d\n", frame_no, lclk, lrw ? "rd" : "wr", la, ld, luds, llds);
+	}
 	prev_as = as;
 
 	bool w68 = !top->m68k_rw && !top->m68k_as_n && (!top->m68k_uds_n || !top->m68k_lds_n);
@@ -579,6 +588,7 @@ int main(int argc, char **argv)
 		else if (a == "--sd") { sd_lat = num(); plus.push_back("+sdlat=" + std::to_string(sd_lat)); }
 		else if (a == "--fill") { fill = num(); plus.push_back("+fill=" + std::to_string(fill)); }
 		else if (a == "--rtc") { if (i + 1 >= argc) return 2; plus.push_back(std::string("+rtc=") + argv[++i]); }
+		else if (a == "--log68") { if (i + 3 >= argc) return 2; log68 = fopen(argv[++i], "w"); log68_a = num(); log68_b = num(); }
 		else if (a == "--zlog") { if (i + 1 >= argc) return 2; zlog = fopen(argv[++i], "w"); }
 		else if (a[0] == '-') { fprintf(stderr, "unknown option %s\n", a.c_str()); return 2; }
 		else if (rom.empty()) rom = a;
diff --git a/npsim/trace68.py b/npsim/trace68.py
new file mode 100644
index 0000000..ad9fa64
--- /dev/null
+++ b/npsim/trace68.py
@@ -0,0 +1,63 @@
+#!/usr/bin/env python3
+"""Decode the 68000 trace (netplay SPEC.md 14.3, NP_TRACE68 in neogeo.sv) from
+Main_MiSTer's netplay/neogeo-dbg-<mode>.txt or neogeo_sim's output (T lines),
+and compare two of them.
+
+  trace68.py <file>            one line per event: frame, clock in the frame,
+                               what (wr address data strobes / iack level)
+  trace68.py <file a> <file b> the first events that differ, with context
+"""
+import sys
+
+
+def load(path):
+    ev = []
+    frame = 0
+    with open(path, errors="replace") as f:
+        for line in f:
+            p = line.split()
+            if len(p) != 6 or p[0] != "T":
+                continue
+            hi, kind, d8, a16 = int(p[2]), int(p[3]), int(p[4], 16), int(p[5], 16)
+            if kind == 8:
+                frame = hi
+                ev.append((frame, 0, "frame %d" % frame))
+            elif kind == 7:
+                clk = (hi >> 16) << 3
+                uds, lds = hi >> 15 & 1, hi >> 14 & 1
+                addr = (hi >> 7 & 0x7F) << 17 | (hi & 0x7F) << 9 | d8 << 1
+                ev.append((frame, clk, "wr %06x %04x %s" % (addr, a16, "UL"[0] * uds + "UL"[1] * lds)))
+            elif kind == 9:
+                ev.append((frame, (hi >> 16) << 3, "iack %d" % (a16 & 7)))
+            else:
+                ev.append((frame, hi, "kind %d %02x %04x" % (kind, d8, a16)))
+    return ev
+
+
+def fmt(e):
+    return "%3d %7d  %s" % e
+
+
+def main(argv):
+    if len(argv) == 2:
+        for e in load(argv[1]):
+            print(fmt(e))
+        return 0
+    if len(argv) == 3:
+        a, b = load(argv[1]), load(argv[2])
+        n = min(len(a), len(b))
+        i = next((k for k in range(n) if a[k] != b[k]), None)
+        if i is None:
+            print("the first %d events are the same (%d / %d in all)" % (n, len(a), len(b)))
+            return 0
+        print("event %d differs (of %d / %d):" % (i, len(a), len(b)))
+        for k in range(max(0, i - 4), min(n, i + 12)):
+            mark = "  " if a[k] == b[k] else "! "
+            print(mark + fmt(a[k]).ljust(40) + fmt(b[k]))
+        return 1
+    print(__doc__)
+    return 2
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
diff --git a/rtl/netplay/neogeo_netplay.sv b/rtl/netplay/neogeo_netplay.sv
index 6f3ff16..67a4c70 100644
--- a/rtl/netplay/neogeo_netplay.sv
+++ b/rtl/netplay/neogeo_netplay.sv
@@ -14,9 +14,9 @@
 //   INPUT  +0x2000  256 entries {f[11:0], sess, p2 / p1 joy[11:0]}
 //   DBG    +0x2800  frames 0-127 of a session, two words each (diagnostics,
 //                   not part of the protocol): {Z80 write CRC, machine clocks},
-//                   {Z80 wait samples, late ADPCM samples, Z80 writes, 68000 writes}
-//   TRACE  +0x3000  the first 512 events of a session (diagnostics): {machine
-//                   clocks since the release, kind, data, address} (dbg_ev)
+//                   {Z80 wait samples, 68000 SDRAM wait clocks, Z80 writes, 68000 writes}
+//   TRACE  +0x3000  the first 512 events of a session (diagnostics), as the
+//                   core makes them (dbg_ev_w: the kind in bits 31:28)
 //
 // Joy words (active high): 3:0 Right Left Down Up, 7:4 A B C D, 8 Start,
 // 9 Select, 10 Coin, 11 the core's bit 11 (A+B+C).
@@ -70,9 +70,10 @@ module neogeo_netplay #(
 	input             dbg_z80_en,     // a write of the Z80 (memory or port)
 	input      [24:0] dbg_z80,        // {port, address, data}
 	input             dbg_zwait,      // a Z80 clock in which it waits for the SDRAM
-	input             dbg_late,       // a YM2610 clock in which its ADPCM data is late
+	input             dbg_late,       // a machine clock in which the 68000 waits for the SDRAM
 	input             dbg_ev,         // an event for the trace (TRACE)
-	input      [31:0] dbg_ev_w,       // {kind[3:0], 4'b0, data[7:0], address[15:0]}
+	input      [63:0] dbg_ev_w,       // the event as it goes to DDR3 (kind in bits 31:28)
+	output     [31:0] dbg_clk,        // machine clocks since the release (for dbg_ev_w)
 	output reg        rfsh_req,       // toggles: sdram_mux refreshes the SDRAM (only in a hold)
 
 	output            active,
@@ -205,6 +206,7 @@ logic  [6:0] dq_frame;
 logic  [1:0] p_dbg;           // words of the last frame still to write
 // the trace: events on their way to DDR3 (a queue of 16), and where they go
 logic [31:0] t_clk;           // machine clocks since the release
+assign dbg_clk = t_clk;
 logic [63:0] tq [16];
 logic  [3:0] tq_w, tq_r;
 logic  [9:0] t_in, t_out;     // events taken, written (512: the trace is full)
@@ -310,7 +312,7 @@ always_ff @(posedge clk) begin
 		if (dbg_ev && t_in != 10'd512) begin
 			if (tq_n == 5'd16) t_in <= 10'd512;
 			else begin
-				tq[tq_w] <= {t_clk, dbg_ev_w};
+				tq[tq_w] <= dbg_ev_w;
 				tq_w     <= tq_w + 4'd1;
 				t_in     <= t_in + 10'd1;
 				t_push   <= t_push + 10'd1;
