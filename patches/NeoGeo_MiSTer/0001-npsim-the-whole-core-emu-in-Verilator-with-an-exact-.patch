diff --git a/npsim/stubs.sv b/npsim/stubs.sv
new file mode 100644
index 0000000..1b6e28f
--- /dev/null
+++ b/npsim/stubs.sv
@@ -0,0 +1,220 @@
+// stubs.sv - what stands in for the MiSTer framework and Altera's cells when
+// the whole core (module emu, neogeo.sv) runs in Verilator.
+//
+// The framework's side is driven from the test bench: the stubs take their
+// signals from sim_top's ports by hierarchical name, so the C++ side sets them
+// like any other input.
+
+// ---- block RAM (rtl/mem/dpram.v: dpram, spram, cpram) ----
+// Synchronous read (address registered, output not), both ports. Port B may be
+// narrower than port A (cpram: 64-bit words written, 16-bit words read, the
+// low word first). Starts as zeros, as "power_up_uninitialized = FALSE".
+module altsyncram #(
+	parameter widthad_a = 1, widthad_b = 1, width_a = 1, width_b = 1,
+	parameter numwords_a = 0, numwords_b = 0, width_byteena_a = 1, width_byteena_b = 1,
+	parameter init_file = "", operation_mode = "", intended_device_family = "", lpm_type = "",
+	parameter wrcontrol_wraddress_reg_b = "", address_reg_b = "", indata_reg_b = "", address_aclr_b = "",
+	parameter clock_enable_input_a = "", clock_enable_input_b = "",
+	parameter clock_enable_output_a = "", clock_enable_output_b = "",
+	parameter outdata_aclr_a = "", outdata_aclr_b = "", outdata_reg_a = "", outdata_reg_b = "",
+	parameter power_up_uninitialized = "", read_during_write_mode_mixed_ports = "",
+	parameter read_during_write_mode_port_a = "", read_during_write_mode_port_b = ""
+)
+(
+	input  [widthad_a-1:0] address_a,
+	input  [widthad_b-1:0] address_b,
+	input                  clock0, clock1,
+	input    [width_a-1:0] data_a,
+	input    [width_b-1:0] data_b,
+	input                  wren_a, wren_b,
+	output   [width_a-1:0] q_a,
+	output   [width_b-1:0] q_b,
+	input                  aclr0, aclr1, addressstall_a, addressstall_b,
+	input                  byteena_a, byteena_b,
+	input                  clocken0, clocken1, clocken2, clocken3,
+	output           [2:0] eccstatus,
+	input                  rden_a, rden_b
+);
+
+localparam RATIO = width_a / width_b;        // 1, or 4 for cpram
+localparam SUB   = widthad_b - widthad_a;    // address bits inside a port A word
+
+reg [width_a-1:0] mem [0:(1<<widthad_a)-1];
+reg [widthad_a-1:0] ra;
+reg [widthad_b-1:0] rb;
+
+// port B's clock: clock1 where the instance uses it, else clock0 (cpram)
+wire clkb = (address_reg_b == "CLOCK1") ? clock1 : clock0;
+
+integer i;
+initial begin
+	for (i = 0; i < (1<<widthad_a); i = i + 1) mem[i] = '0;
+	if (outdata_reg_a == "CLOCK0" || outdata_reg_b == "CLOCK1" || outdata_reg_b == "CLOCK0") begin
+		$display("altsyncram stub: registered outputs are not modelled");
+		$finish;
+	end
+end
+
+always @(posedge clock0) begin
+	if (wren_a) mem[address_a] <= data_a;
+	ra <= address_a;
+end
+assign q_a = mem[ra];
+
+generate
+	if (RATIO == 1) begin : same
+		always @(posedge clkb) begin
+			if (wren_b) mem[address_b] <= data_b;
+			rb <= address_b;
+		end
+		assign q_b = mem[rb];
+	end
+	else begin : narrow
+		always @(posedge clkb) rb <= address_b;
+		wire [width_a-1:0] w = mem[rb[widthad_b-1:SUB]];
+		assign q_b = w[rb[SUB-1:0] * width_b +: width_b];
+	end
+endgenerate
+
+assign eccstatus = 0;
+
+endmodule
+
+// ---- the PLL: 96 and 48 MHz come from the test bench, edges aligned ----
+module pll
+(
+	input         refclk,
+	input         rst,
+	output        outclk_0,
+	output        outclk_1,
+	input  [63:0] reconfig_to_pll,
+	output [63:0] reconfig_from_pll,
+	output        locked
+);
+assign outclk_0 = sim_top.clk96;
+assign outclk_1 = sim_top.clk48;
+assign reconfig_from_pll = 0;
+assign locked = 1;
+endmodule
+
+module pll_cfg
+(
+	input         mgmt_clk,
+	input         mgmt_reset,
+	output        mgmt_waitrequest,
+	input         mgmt_read,
+	output [31:0] mgmt_readdata,
+	input         mgmt_write,
+	input   [5:0] mgmt_address,
+	input  [31:0] mgmt_writedata,
+	output [63:0] reconfig_to_pll,
+	input  [63:0] reconfig_from_pll
+);
+assign mgmt_waitrequest = 0;
+assign mgmt_readdata = 0;
+assign reconfig_to_pll = 0;
+endmodule
+
+// ---- hps_io: status, controllers and the file download, from the bench ----
+module hps_io #(parameter CONF_STR = "", parameter WIDE = 0, parameter VDNUM = 1)
+(
+	input         clk_sys,
+	inout  [45:0] HPS_BUS,
+	output        forced_scandoubler,
+	output [15:0] joystick_0, joystick_1, joystick_2, joystick_3,
+	output  [8:0] spinner_0, spinner_1,
+	output [24:0] ps2_mouse,
+	output  [1:0] buttons,
+	output [10:0] ps2_key,
+	output [63:0] status,
+	input  [15:0] status_menumask,
+	output [64:0] RTC,
+	output [15:0] sdram_sz,
+	output [21:0] gamma_bus,
+	output        ioctl_wr,
+	output [26:0] ioctl_addr,
+	output [15:0] ioctl_dout,
+	output        ioctl_download,
+	output  [7:0] ioctl_index,
+	input         ioctl_wait,
+	input  [31:0] sd_lba[VDNUM],
+	input   [VDNUM-1:0] sd_rd,
+	input   [VDNUM-1:0] sd_wr,
+	output  [VDNUM-1:0] sd_ack,
+	output  [7:0] sd_buff_addr,
+	output [15:0] sd_buff_dout,
+	input  [15:0] sd_buff_din[VDNUM],
+	output        sd_buff_wr,
+	output  [VDNUM-1:0] img_mounted,
+	output        img_readonly,
+	output [63:0] img_size,
+	inout  [35:0] EXT_BUS
+);
+assign forced_scandoubler = 0;
+assign joystick_0 = sim_top.joystick_0;
+assign joystick_1 = sim_top.joystick_1;
+assign joystick_2 = 0;
+assign joystick_3 = 0;
+assign spinner_0 = 0;
+assign spinner_1 = 0;
+assign ps2_mouse = 0;
+assign buttons = 0;
+assign ps2_key = 0;
+assign status = sim_top.status;
+assign RTC = 0;
+assign sdram_sz = sim_top.sdram_sz;
+assign gamma_bus = 0;
+assign ioctl_wr = sim_top.ioctl_wr;
+assign ioctl_addr = sim_top.ioctl_addr;
+assign ioctl_dout = sim_top.ioctl_dout;
+assign ioctl_download = sim_top.ioctl_download;
+assign ioctl_index = sim_top.ioctl_index;
+assign sd_ack = 0;
+assign sd_buff_addr = 0;
+assign sd_buff_dout = 0;
+assign sd_buff_wr = 0;
+assign img_mounted = 0;
+assign img_readonly = 0;
+assign img_size = 0;
+// the CD's extension bus: nobody talks
+assign EXT_BUS[34:33] = 2'b00;
+assign EXT_BUS[31:16] = 16'd0;
+endmodule
+
+// ---- video: the core's own picture goes straight through ----
+module video_mixer #(parameter LINE_LENGTH = 768, parameter HALF_DEPTH = 0, parameter GAMMA = 0)
+(
+	input            CLK_VIDEO,
+	output           CE_PIXEL,
+	input            ce_pix,
+	input            scandoubler,
+	input            hq2x,
+	output           freeze_sync,
+	input      [7:0] R, G, B,
+	input            HSync, VSync, HBlank, VBlank,
+	output     [7:0] VGA_R, VGA_G, VGA_B,
+	output           VGA_VS, VGA_HS, VGA_DE
+);
+assign CE_PIXEL = ce_pix;
+assign freeze_sync = 0;
+assign {VGA_R, VGA_G, VGA_B} = {R, G, B};
+assign VGA_VS = VSync;
+assign VGA_HS = HSync;
+assign VGA_DE = ~(HBlank | VBlank);
+endmodule
+
+module video_freak
+(
+	input             CLK_VIDEO,
+	input             VGA_DE_IN,
+	output            VGA_DE,
+	output     [12:0] VIDEO_ARX,
+	output     [12:0] VIDEO_ARY,
+	input      [11:0] ARX, ARY, CROP_SIZE,
+	input       [4:0] CROP_OFF,
+	input       [2:0] SCALE
+);
+assign VGA_DE = VGA_DE_IN;
+assign VIDEO_ARX = {1'b0, ARX};
+assign VIDEO_ARY = {1'b0, ARY};
+endmodule
diff --git a/npsim/synth.sh b/npsim/synth.sh
new file mode 100755
index 0000000..9722f20
--- /dev/null
+++ b/npsim/synth.sh
@@ -0,0 +1,20 @@
+#!/usr/bin/env bash
+# The core's VHDL (the Z80 T80pa, the CD's CEGen) -> Verilog for Verilator,
+# with ghdl synth in the Docker image hdlc/ghdl:yosys. build/vhdl.txt (prep.py)
+# lists the files in the order of the Quartus project.
+set -u
+cd "$(dirname "$0")"
+mkdir -p build/vlog build/ghdl
+t80=$(grep -i '/T80' build/vhdl.txt | sed 's|^|/src/|' | tr '\n' ' ')
+# analysis order: the package first, the wrapper last
+order=""
+for f in T80_Pack T80_Reg T80_MCode T80_ALU T80 T80pa; do
+	for g in $t80; do [ "$(basename "$g" .vhd)" = "$f" ] && order="$order $g"; done
+done
+ceg=$(grep -i 'CEGen' build/vhdl.txt | sed 's|^|/src/|')
+docker run --rm -u "$(id -u):$(id -g)" -v "$PWD/..":/src:ro -v "$PWD/build":/out -w /out hdlc/ghdl:yosys sh -c "
+  ghdl synth --std=08 -fsynopsys -frelaxed --workdir=/out/ghdl --out=verilog $order -e T80pa > /out/vlog/T80pa.v 2> /out/vlog/T80pa.log || exit 1
+  ghdl synth --std=08 -fsynopsys -frelaxed --workdir=/out/ghdl --out=verilog $ceg -e CEGen > /out/vlog/CEGen.v 2> /out/vlog/CEGen.log || exit 1"
+rc=$?
+grep -h error build/vlog/T80pa.log build/vlog/CEGen.log | sort -u | head -20
+[ $rc -eq 0 ] && grep -q '^module T80pa' build/vlog/T80pa.v && grep -q '^module CEGen' build/vlog/CEGen.v
-- 
