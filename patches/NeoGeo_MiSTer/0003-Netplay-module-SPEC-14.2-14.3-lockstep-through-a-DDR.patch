From 102acde73e3ab30cd2f23c2bd5d6fec6fc367e3b Mon Sep 17 00:00:00 2001
From: netplay <netplay@localhost>
Date: Sat, 14 Nov 2026 15:59:23 +0100
Subject: [PATCH 3/3] Netplay module (SPEC 14.2, 14.3): lockstep through a DDR3
 mailbox (NEOGNP01 at 0x3FC00000, its own ddram.sv channel), the machine held
 in reset from arming to the session's start, every frame start held by
 stopping the 24 MHz enables (64 clocks at least, SDRAM refreshes in long
 holds), CRC over the 68000's writes, a CTRL heartbeat; npsim: --session (the
 bench as Main's netplay thread, late input), det.sh compares six sessions
---
 NeoGeo.sdc                    |   6 +
 files.qip                     |   1 +
 neogeo.sv                     |  92 +++++--
 npsim/det.sh                  |  82 ++++---
 npsim/neogeo_sim.cpp          | 124 +++++++++-
 npsim/sim_top.sv              |  11 +
 rtl/mem/ddram.sv              |  36 ++-
 rtl/mem/sdram_mux.sv          |   9 +-
 rtl/netplay/neogeo_netplay.sv | 444 ++++++++++++++++++++++++++++++++++
 9 files changed, 747 insertions(+), 58 deletions(-)
 create mode 100644 rtl/netplay/neogeo_netplay.sv

diff --git a/NeoGeo.sdc b/NeoGeo.sdc
index a6b805c..cde91cb 100644
--- a/NeoGeo.sdc
+++ b/NeoGeo.sdc
@@ -5,3 +5,9 @@ set_false_path -from {emu|cfg[*]}
 
 set_multicycle_path -from {emu|Z80CPU|*} -setup 2
 set_multicycle_path -from {emu|Z80CPU|*} -hold 1
+
+# Netplay mailbox (rtl/mem/ddram.sv, 96 MHz -> rtl/netplay/neogeo_netplay.sv,
+# 48 MHz): np_dout is written together with np_ack, and the module reads it only
+# after it has seen np_ack change, a clock or more later. It never changes when
+# it is taken.
+set_false_path -from {emu|DDRAM|np_dout[*]} -to {emu|NETPLAY|*}
