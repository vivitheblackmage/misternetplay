diff --git a/rtl/netplay/neogeo_netplay.sv b/rtl/netplay/neogeo_netplay.sv
new file mode 100644
index 0000000..2b6b0ca
--- /dev/null
+++ b/rtl/netplay/neogeo_netplay.sv
@@ -0,0 +1,444 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// neogeo_netplay.sv - delay-based lockstep netplay for the Neo Geo core
+// (netplay SPEC.md 14). Each MiSTer runs the whole machine; the network
+// carries only the controllers. This side never touches the network: it
+// trades per-frame input with Main_MiSTer through a mailbox in DDR3 at BASE,
+// in the layout of the arcade and NES cores (SPEC.md 4, 12.3):
+//
+//   MAGIC  +0x0000  "NEOGNP01"
+//   STATUS +0x0008  {frame, 4'b0, ran, state, error, stalls}
+//   CTRL   +0x0010  {"CTRL", heartbeat[15:0], session, 4'b0, join, run, enable}
+//   LOCAL  +0x1000  256 entries {f[11:0], sess, joy[11:0]} in both halves
+//   CRC    +0x1800  256 entries {f[15:0], crc half} in both halves
+//   INPUT  +0x2000  256 entries {f[11:0], sess, p2 / p1 joy[11:0]}
+//
+// Joy words (active high): 3:0 Right Left Down Up, 7:4 A B C D, 8 Start,
+// 9 Select, 10 Coin, 11 the core's bit 11 (A+B+C).
+//
+// Freezing. Every clock enable of the emulated machine comes from the 24 MHz
+// pair the core makes (CLK_EN_24M_N/P); `hold` stops that pair without losing
+// a pulse or catching one up, so a held clock does not exist for the machine
+// (shown in simulation: T2n). A frame starts where the machine's vertical
+// blank starts. It is always held for HOLD_MIN clocks, longer when INPUT[k] is
+// not in hand: any SDRAM read in flight ends inside the hold on every MiSTer,
+// so the hold's length cannot reach the machine. The machine's SDRAM refresh
+// comes with its picture and stops in a hold, so a hold older than HOLD_MIN
+// asks sdram_mux for a refresh (rfsh_req) every RFSH_PERIOD clocks, and lasts
+// until RFSH_TIME clocks after the last one: the machine never meets one.
+//
+// Session start (SPEC.md 14.2). The machine must start a session as it is
+// after the FPGA was loaded. Main_MiSTer arms netplay (CTRL enable) before it
+// loads the ROM set, and the module keeps the machine in reset from then
+// until the session starts (ARMED, PRIME): reset is released in the clock in
+// which INPUT[0] and INPUT[1] are in hand, and frame 0 starts there. `ran`
+// tells Main_MiSTer that the machine has run since the FPGA was loaded: then
+// it loads the core again first.
+//
+// CTRL carries a heartbeat that Main_MiSTer changes all the time. DDR3 is not
+// cleared when cores change: a CTRL word nobody changes is left over and never
+// arms netplay (IDLE arms only on a change); one that stops changing for
+// HB_BITS clocks ends the session.
+
+module neogeo_netplay #(
+	parameter int          POLL_INTERVAL = 256,           // clocks between INPUT polls
+	parameter int          CTRL_INTERVAL = 4096,          // clocks between CTRL reads
+	parameter int          HOLD_MIN      = 64,            // clocks held at every frame start
+	parameter int          HB_BITS       = 24,            // heartbeat timeout: 2^24 clocks (0.35 s at 48 MHz)
+	parameter int          RFSH_PERIOD   = 340,           // clocks between refreshes in a hold (SDRAM: 7.8 us = 375)
+	parameter int          RFSH_TIME     = 16,            // clocks a refresh takes, with margin (sdram.sv: 7 of 96 MHz)
+	parameter logic [31:0] BASE          = 32'h3FC00000   // physical byte address of the mailbox
+)(
+	input             clk,
+	input             reset,          // power-on (FPGA load) only
+	input             downloading,    // a ROM load or the loader's reset is in progress
+
+	// the machine
+	input             vblank,         // ~BNKB: high in the vertical blank (changes on clock enables only)
+	input             machine_run,    // the machine is out of reset (nRESET)
+	input             st_en,          // a step of the game state: a write of the 68000
+	input      [39:0] st,             // {address, data}
+	input      [11:0] local_joy,      // this side's player 1 controls, active high
+	output reg        rfsh_req,       // toggles: sdram_mux refreshes the SDRAM (only in a hold)
+
+	output            active,
+	output            hold_reset,     // keep the machine in reset
+	output reg        hold,           // freeze the machine's clock enables
+	output            stall,          // held for missing input or an error
+	output reg        is_join,
+	output reg [11:0] joy_p1,         // what the machine sees as player 1 (the host)
+	output reg [11:0] joy_p2,         // and player 2 (the join)
+
+	// DDR3 channel (rtl/mem/ddram.sv: toggle handshake, req != ack = busy),
+	// byte address bits 27:3 in the core's window at 0x30000000
+	output reg [27:3] ddr_addr,
+	output reg [63:0] ddr_din,
+	input      [63:0] ddr_dout,
+	output reg        ddr_we,
+	output reg        ddr_req,
+	input             ddr_ack,
+
+	// observation
+	output      [2:0] state_o,
+	output     [31:0] frame_o,
+	output      [7:0] error_o,
+	output reg        ran
+);
+
+localparam logic [15:0] OFF_MAGIC  = 16'h0000;
+localparam logic [15:0] OFF_STATUS = 16'h0008;
+localparam logic [15:0] OFF_CTRL   = 16'h0010;
+localparam logic [15:0] OFF_LOCAL  = 16'h1000;
+localparam logic [15:0] OFF_CRC    = 16'h1800;
+localparam logic [15:0] OFF_INPUT  = 16'h2000;
+
+localparam logic [63:0] MAGIC      = 64'h3130504E47454F4E; // "NEOGNP01"
+localparam logic [31:0] CTRL_MAGIC = 32'h4C525443;          // "CTRL"
+
+localparam logic [2:0] S_IDLE  = 3'd0;
+localparam logic [2:0] S_ARMED = 3'd1;
+localparam logic [2:0] S_PRIME = 3'd2;
+localparam logic [2:0] S_RUN   = 3'd3;
+localparam logic [2:0] S_ERROR = 3'd4;
+
+localparam int ERR_CTRL_DROP = 1;
+localparam int ERR_RELOAD    = 2;
+
+localparam logic [31:0] CRC_INIT = 32'hFFFFFFFF;
+
+function automatic logic [31:0] crc_byte(input logic [31:0] c, input logic [7:0] d);
+	logic [31:0] x;
+	x = c ^ {24'd0, d};
+	for (int i = 0; i < 8; i++)
+		x = x[0] ? ((x >> 1) ^ 32'hEDB88320) : (x >> 1);
+	return x;
+endfunction
+
+function automatic logic [31:0] crc_joy(input logic [11:0] p1, input logic [11:0] p2);
+	return crc_byte(crc_byte(crc_byte(CRC_INIT, p1[7:0]), {p2[3:0], p1[11:8]}), p2[11:4]);
+endfunction
+
+function automatic logic [31:0] crc_st(input logic [31:0] c, input logic [39:0] d);
+	return crc_byte(crc_byte(crc_byte(crc_byte(crc_byte(c, d[39:32]), d[31:24]), d[23:16]), d[15:8]), d[7:0]);
+endfunction
+
+function automatic logic [27:3] waddr(input logic [15:3] off);
+	return BASE[27:3] + {12'd0, off};
+endfunction
+
+function automatic logic [15:3] ring(input logic [15:3] base_off, input logic [7:0] slot);
+	return base_off + {5'd0, slot};
+endfunction
+
+// ---------------------------------------------------------------------------
+// State
+
+logic [2:0]  state;
+logic [31:0] frame;
+logic [7:0]  error;
+logic [15:0] stalls;
+logic [7:0]  sess;
+
+// Lookahead: slot 0 holds INPUT[base], slot 1 INPUT[base+1], where base is
+// the first frame not started yet (0 in PRIME, frame+1 in RUN).
+logic        have0, have1;
+logic [11:0] a_p1, a_p2;
+logic [11:0] b_p1, b_p2;
+logic [31:0] crc;
+
+logic        vbl_prev;
+logic        waiting;         // a frame start is due and its INPUT is missing
+logic  [7:0] post;            // clocks still held after a frame start
+
+wire         tick_now = !vbl_prev && vblank;                       // first clock of a vertical blank
+wire         run_due  = (state == S_RUN) && (tick_now || waiting); // frame k is due now
+wire         consume  = run_due && have0;                          // frame k starts in this clock
+wire         start0   = (state == S_PRIME) && have0 && have1 && !downloading;
+
+// SDRAM refresh in a hold
+logic  [7:0] hold_age;        // clocks the hold has lasted (saturates)
+logic  [9:0] rfsh_wait;       // clocks to the next refresh
+logic  [4:0] rfsh_busy;       // clocks a refresh still takes
+wire         rfsh_now = hold && (hold_age == 8'hFF || hold_age >= 8'(HOLD_MIN)) && (rfsh_wait == 10'd0) && (rfsh_busy == 5'd0);
+
+// `hold` is a register: the freeze starts in the clock after a frame tick,
+// which is the same clock of the machine on every MiSTer
+wire         hold_d   = run_due || (post != 8'd0) || (hold && (rfsh_busy != 5'd0 || rfsh_now))
+                     || (state == S_ERROR && !downloading);
+
+assign stall      = waiting || (state == S_ERROR && !downloading);
+assign active     = (state != S_IDLE);
+assign hold_reset = (state == S_ARMED) || (state == S_PRIME);
+
+assign state_o = state;
+assign frame_o = frame;
+assign error_o = error;
+
+// Pending mailbox work
+logic        p_magic, p_status, p_local, p_crc;
+logic [15:0] local_frame;
+logic [11:0] local_val;
+logic [15:0] crc_frame;
+logic [31:0] crc_val;
+logic        hold_prev;
+
+// Poll timers and the heartbeat
+logic [15:0] poll_cnt, ctrl_cnt;
+logic        poll_due, ctrl_due;
+logic [15:0] hb_last;
+logic        hb_seen;         // hb_last holds a value read before
+logic [HB_BITS:0] hb_age;     // clocks since the heartbeat last changed
+wire         hb_dead = hb_age[HB_BITS];
+
+// DDR sequencer
+localparam logic [2:0] OP_NONE    = 3'd0;
+localparam logic [2:0] OP_MAGIC   = 3'd1;
+localparam logic [2:0] OP_CRC     = 3'd2;
+localparam logic [2:0] OP_LOCAL   = 3'd3;
+localparam logic [2:0] OP_STATUS  = 3'd4;
+localparam logic [2:0] OP_CTRL    = 3'd5;
+localparam logic [2:0] OP_INPUT   = 3'd6;
+
+logic [2:0]  op;
+logic [31:0] op_frame;
+wire         ddr_done = (op != OP_NONE) && (ddr_req == ddr_ack);
+
+wire  [31:0] base       = (state == S_PRIME) ? 32'd0 : frame + 32'd1;
+wire         fetching   = (state == S_PRIME) || (state == S_RUN);
+wire         need_input = fetching && !(have0 && have1);
+wire  [31:0] want_frame = have0 ? base + 32'd1 : base;
+
+wire         ctrl_ok  = (ddr_dout[63:32] == CTRL_MAGIC);
+wire         ctrl_en  = ctrl_ok & ddr_dout[0];
+wire         ctrl_run = ctrl_ok & ddr_dout[1];
+wire  [15:0] ctrl_hb  = ddr_dout[31:16];
+wire         hb_moved = ctrl_ok && hb_seen && (ctrl_hb != hb_last);
+
+wire  [63:0] status_word = {frame, 4'd0, ran, state, error, stalls};
+
+wire  [31:0] in_hi = ddr_dout[63:32];
+wire  [31:0] in_lo = ddr_dout[31:0];
+wire         in_ok = (in_hi[31:20] == op_frame[11:0]) && (in_lo[31:20] == op_frame[11:0])
+                  && (in_hi[19:12] == sess)           && (in_lo[19:12] == sess);
+
+always_ff @(posedge clk) begin
+	hold      <= hold_d;
+	hold_prev <= hold;
+	vbl_prev  <= vblank;
+	if (post != 8'd0) post <= post - 8'd1;
+	if (machine_run) ran <= 1'b1;
+	if (!hb_dead) hb_age <= hb_age + 1'd1;
+
+	if (!hold) hold_age <= 8'd0;
+	else if (hold_age != 8'hFF) hold_age <= hold_age + 8'd1;
+	if (rfsh_wait != 10'd0) rfsh_wait <= rfsh_wait - 10'd1;
+	if (rfsh_busy != 5'd0) rfsh_busy <= rfsh_busy - 5'd1;
+	if (rfsh_now) begin
+		rfsh_req  <= ~rfsh_req;
+		rfsh_wait <= 10'(RFSH_PERIOD);
+		rfsh_busy <= 5'(RFSH_TIME);
+	end
+
+	if (poll_cnt == POLL_INTERVAL[15:0] - 16'd1) begin poll_cnt <= 16'd0; poll_due <= 1'b1; end
+	else poll_cnt <= poll_cnt + 16'd1;
+	if (ctrl_cnt == CTRL_INTERVAL[15:0] - 16'd1) begin ctrl_cnt <= 16'd0; ctrl_due <= 1'b1; end
+	else ctrl_cnt <= ctrl_cnt + 16'd1;
+
+	// -----------------------------------------------------------------------
+	// Per-frame work in RUN
+	if (state == S_RUN) begin
+		if (hold && !hold_prev && waiting && stalls != 16'hFFFF) stalls <= stalls + 16'd1;
+		if (tick_now && !have0) waiting <= 1'b1;
+
+		if (consume) begin
+			waiting     <= 1'b0;
+			post        <= 8'(HOLD_MIN);
+			frame       <= frame + 32'd1;
+			joy_p1      <= a_p1;
+			joy_p2      <= a_p2;
+			have0       <= have1;
+			a_p1        <= b_p1;
+			a_p2        <= b_p2;
+			have1       <= 1'b0;
+
+			crc_frame   <= frame[15:0];
+			crc_val     <= crc;
+			p_crc       <= 1'b1;
+
+			local_frame <= frame[15:0] + 16'd1;
+			local_val   <= local_joy;
+			p_local     <= 1'b1;
+
+			p_status    <= 1'b1;
+			crc         <= crc_joy(a_p1, a_p2);
+		end
+		else if (st_en) begin
+			crc <= crc_st(crc, st);
+		end
+
+		if (downloading) begin
+			error[ERR_RELOAD] <= 1'b1;
+			state    <= S_ERROR;
+			waiting  <= 1'b0;
+			p_status <= 1'b1;
+		end
+	end
+
+	// PRIME -> RUN once INPUT[0] and INPUT[1] are in hand: the machine leaves
+	// reset in the next clock, and frame 0 starts there
+	if (start0) begin
+		state       <= S_RUN;
+		frame       <= 32'd0;
+		waiting     <= 1'b0;
+		post        <= 8'd0;
+		joy_p1      <= a_p1;
+		joy_p2      <= a_p2;
+		have0       <= 1'b1;
+		a_p1        <= b_p1;
+		a_p2        <= b_p2;
+		have1       <= 1'b0;
+		local_frame <= 16'd0;
+		local_val   <= local_joy;
+		p_local     <= 1'b1;
+		p_status    <= 1'b1;
+		crc         <= crc_joy(a_p1, a_p2);
+	end
+
+	// -----------------------------------------------------------------------
+	// DDR sequencer: one outstanding request at a time (none during the reset,
+	// which would forget it while ddr_req stays toggled)
+	if (reset) ;
+	else if (op == OP_NONE) begin
+		if (p_magic) begin
+			op <= OP_MAGIC;   ddr_addr <= waddr(OFF_MAGIC[15:3]);  ddr_din <= MAGIC;       ddr_we <= 1'b1; ddr_req <= ~ddr_req;
+		end
+		else if (p_crc) begin
+			op <= OP_CRC;     ddr_addr <= waddr(ring(OFF_CRC[15:3], crc_frame[7:0]));
+			ddr_din <= {crc_frame, crc_val[31:16], crc_frame, crc_val[15:0]};
+			ddr_we <= 1'b1; ddr_req <= ~ddr_req;
+		end
+		else if (p_local) begin
+			op <= OP_LOCAL;   ddr_addr <= waddr(ring(OFF_LOCAL[15:3], local_frame[7:0]));
+			ddr_din <= {local_frame[11:0], sess, local_val, local_frame[11:0], sess, local_val};
+			ddr_we <= 1'b1; ddr_req <= ~ddr_req;
+		end
+		else if (p_status) begin
+			op <= OP_STATUS;  ddr_addr <= waddr(OFF_STATUS[15:3]); ddr_din <= status_word; ddr_we <= 1'b1; ddr_req <= ~ddr_req;
+		end
+		else if (ctrl_due) begin
+			op <= OP_CTRL;    ddr_addr <= waddr(OFF_CTRL[15:3]);   ddr_we <= 1'b0; ddr_req <= ~ddr_req;
+		end
+		else if (poll_due && need_input) begin
+			op <= OP_INPUT;   ddr_addr <= waddr(ring(OFF_INPUT[15:3], want_frame[7:0]));
+			op_frame <= want_frame;
+			ddr_we <= 1'b0; ddr_req <= ~ddr_req;
+		end
+	end
+	else if (ddr_done) begin
+		op <= OP_NONE;
+		case (op)
+			OP_MAGIC:   p_magic    <= 1'b0;
+			OP_CRC:     p_crc      <= 1'b0;
+			OP_LOCAL:   p_local    <= 1'b0;
+			OP_STATUS:  p_status   <= 1'b0;
+			OP_INPUT: begin
+				poll_due <= 1'b0;
+				// A frame starting in this very clock shifts the lookahead: drop
+				// the word and let the next poll fetch it again.
+				if (in_ok && fetching && !consume && !start0) begin
+					if (!have0 && op_frame == base) begin
+						a_p1  <= in_lo[11:0];
+						a_p2  <= in_hi[11:0];
+						have0 <= 1'b1;
+					end
+					else if (have0 && !have1 && op_frame == base + 32'd1) begin
+						b_p1  <= in_lo[11:0];
+						b_p2  <= in_hi[11:0];
+						have1 <= 1'b1;
+					end
+				end
+			end
+			OP_CTRL: begin
+				ctrl_due <= 1'b0;
+				hb_seen  <= ctrl_ok;
+				hb_last  <= ctrl_hb;
+				if (hb_moved) hb_age <= '0;
+				case (state)
+					S_IDLE: if (ctrl_en && hb_moved) begin
+						state     <= S_ARMED;
+						sess      <= ddr_dout[15:8];
+						is_join   <= ddr_dout[2];
+						error     <= 8'd0;
+						stalls    <= 16'd0;
+						frame     <= 32'd0;
+						have0     <= 1'b0;
+						have1     <= 1'b0;
+						waiting   <= 1'b0;
+						p_status  <= 1'b1;
+					end
+					S_ARMED: begin
+						if (!ctrl_en || hb_dead) begin state <= S_IDLE; waiting <= 1'b0; post <= 8'd0; p_status <= 1'b1; p_local <= 1'b0; p_crc <= 1'b0; end
+						else if (ctrl_run)       begin state <= S_PRIME; p_status <= 1'b1; end
+					end
+					S_PRIME, S_ERROR: if ((!ctrl_en || hb_dead) && !start0) begin state <= S_IDLE; waiting <= 1'b0; post <= 8'd0; p_status <= 1'b1; p_local <= 1'b0; p_crc <= 1'b0; end
+					S_RUN: if (!ctrl_en || hb_dead) begin
+						error[ERR_CTRL_DROP] <= 1'b1;
+						state <= S_IDLE; waiting <= 1'b0; post <= 8'd0; p_status <= 1'b1; p_local <= 1'b0; p_crc <= 1'b0;
+					end
+					default: ;
+				endcase
+			end
+			default: ;
+		endcase
+	end
+
+	if (reset) begin
+		state      <= S_IDLE;
+		frame      <= 32'd0;
+		error      <= 8'd0;
+		stalls     <= 16'd0;
+		sess       <= 8'd0;
+		is_join    <= 1'b0;
+		ran        <= 1'b0;
+		have0      <= 1'b0;
+		have1      <= 1'b0;
+		a_p1       <= 12'd0;
+		a_p2       <= 12'd0;
+		b_p1       <= 12'd0;
+		b_p2       <= 12'd0;
+		joy_p1     <= 12'd0;
+		joy_p2     <= 12'd0;
+		crc        <= CRC_INIT;
+		waiting    <= 1'b0;
+		post       <= 8'd0;
+		hold       <= 1'b0;
+		hold_age   <= 8'd0;
+		rfsh_wait  <= 10'd0;
+		rfsh_busy  <= 5'd0;
+		p_magic    <= 1'b1;
+		p_status   <= 1'b1;
+		p_local    <= 1'b0;
+		p_crc      <= 1'b0;
+		poll_cnt   <= 16'd0;
+		ctrl_cnt   <= 16'd0;
+		poll_due   <= 1'b0;
+		ctrl_due   <= 1'b1;
+		hb_last    <= 16'd0;
+		hb_seen    <= 1'b0;
+		hb_age     <= '0;
+		op         <= OP_NONE;
+		op_frame   <= 32'd0;
+		ddr_we     <= 1'b0;
+		ddr_addr   <= '0;
+		ddr_din    <= '0;
+		local_frame <= 16'd0;
+		local_val   <= 12'd0;
+		crc_frame   <= 16'd0;
+		crc_val     <= 32'd0;
+		hold_prev   <= 1'b0;
+		// ddr_req is not reset: it must keep matching ddr_ack across a reset,
+		// nor rfsh_req (sdram_mux compares it with its own copy)
+	end
+end
+
+endmodule
