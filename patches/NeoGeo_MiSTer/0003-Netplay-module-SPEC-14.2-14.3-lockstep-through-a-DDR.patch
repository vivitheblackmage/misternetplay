 //                     report the frames after that: a core that ran before
 //     --play          press buttons (P1 Start, A, Right; P2 Start, A) on fixed
 //                     frames, the same in every run
+//     --session       a netplay session (SPEC.md 14): the bench is Main_MiSTer's
+//                     netplay thread too. It arms netplay before the ROM load,
+//                     starts the session and writes INPUT[k] (both players' input,
+//                     a fixed script of k) when the core's frame allows. Frames
+//                     are then the session's (k), and clocks count only where
+//                     the machine is not held.
+//     --start-delay C the session starts C clocks of 48 MHz after the core is armed
+//     --stall P M     per mille of the frames whose INPUT comes up to M clocks late
+//                     (the core holds the machine until it is there)
 //     --mvs           System Type: Arcade (default: Console, AES)
 //     --no-netplay    OSD Netplay: Off (default: Host)
 //     --bios FILE     system ROM in the bios folder (default uni-bios.rom)
@@ -52,6 +61,8 @@
 //   c68    bus cycles of the 68000; w68, wz80: writes of the 68000 and the Z80
 //   zwait / ymwait  48 MHz clocks the Z80 waited for its ROM and the YM2610
 //          stood still for ADPCM data (both DDR3)
+// With --session also, per frame k: "C k crc", the CRC the core wrote for frame
+// k (what two MiSTers compare to see a desync), and in the end the stalls.
 
 #include <cstdint>
 #include <cstdio>
@@ -138,6 +149,15 @@ static void ddr_after(const DdrIn &s)
 	top->DDRAM_BUSY = busy_left > 0 && beats.empty() && !top->DDRAM_DOUT_READY;
 }
 
+// ------------------------------------------- Main_MiSTer's netplay thread ----
+// The mailbox (neogeo_netplay.sv), at 0x3FC00000 in DDR3
+static const uint32_t MB = 0x3FC00000 - DDR_BASE;
+static const uint32_t MB_STATUS = 0x0008, MB_CTRL = 0x0010, MB_CRC = 0x1800, MB_INPUT = 0x2000;
