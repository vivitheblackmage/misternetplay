+// the loader sends the program (index 4) and M1 (index 9) through the netplay
+// hook. NP_NEO_SPLIT: this side's ROM set has the program in two files, P1 and
+// P2 (index 6), as another format does: the identity must be the same.
+static void neo_send(int index, uint32_t offset, const std::vector<uint8_t> &d, size_t from, size_t len)
+{
+	for (size_t i = 0; i < len; i += 4096)
+		netplay_neogeo_data(index, offset + (uint32_t)i, d.data() + from + i, (uint32_t)std::min((size_t)4096, len - i));
+}
 int neogeo_romset_tx(char *name, int cd_en)
 {
 	if (netplay_neogeo_before(name, cd_en)) return 1;
+	auto rd = [&](const char *f) {
+		std::vector<uint8_t> d;
+		if (FILE *h = fopen(getFullPath((std::string(name) + "/" + f).c_str()), "rb"))
+		{
+			int c;
+			while ((c = fgetc(h)) != EOF) d.push_back((uint8_t)c);
+			fclose(h);
+		}
+		return d;
+	};
+	std::vector<uint8_t> p = rd("prom"), m = rd("m1rom");
+	if (getenv("NP_NEO_SPLIT")) { size_t h = p.size() / 2; neo_send(4, 0, p, 0, h); neo_send(6, 0, p, h, p.size() - h); }
+	else neo_send(4, 0, p, 0, p.size());
+	neo_send(9, 0, m, 0, m.size());
 	printf("[harness] ROM set %s loaded\n", name);
 	fpga->loaded = true;
-	netplay_neogeo_loaded(name, cd_en);
+	netplay_neogeo_loaded(name, cd_en, 0x00800000);
 	return 1;
 }
 static void step_start()
