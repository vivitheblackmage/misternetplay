diff --git a/support/netplay/netplay.cpp b/support/netplay/netplay.cpp
index df94f2c..92eee01 100644
--- a/support/netplay/netplay.cpp
+++ b/support/netplay/netplay.cpp
@@ -2260,42 +2260,27 @@ static void begin_session(const char *name, unsigned char index, char opensave);
 // ---------------------------------------------------------------------------
 // Neo Geo (SPEC.md 14)
 
-// The ROM set's identity: a folder (the Darksoft layout) by the files the game
-// runs from, all but the sprites (crom*) and the ADPCM samples (vrom*), which
-// decide no game timing and are most of the size; a .zip or .neo by the file.
-static bool neogeo_md5(const char *name, uint8_t out[16])
-{
-	std::string full = getFullPath(name);
-	struct stat st;
-	if (stat(full.c_str(), &st)) return false;
-	if (!S_ISDIR(st.st_mode)) return md5_file(name, out, nullptr, 0);
-	std::vector<std::string> files;
-	if (DIR *d = opendir(full.c_str()))
-	{
-		while (dirent *e = readdir(d))
-		{
-			std::string n = e->d_name;
-			if (n.empty() || n[0] == '.' || !strncasecmp(n.c_str(), "crom", 4) || !strncasecmp(n.c_str(), "vrom", 4)) continue;
-			struct stat fs;
-			if (!stat((full + "/" + n).c_str(), &fs) && S_ISREG(fs.st_mode)) files.push_back(n);
-		}
-		closedir(d);
-	}
-	if (files.empty()) return false;
-	std::sort(files.begin(), files.end());
+// The ROM set's identity: the program (P ROMs) and the Z80's ROM (M1) as the
+// loader sends them to the core, by where they land, and the cart's
+// configuration word (protection chips, wait states). The same game gives the
+// same md5 from a Darksoft folder, a MAME zip or a .neo file; the sprites and
+// the ADPCM samples decide no game timing and are left out.
+static std::map<uint32_t, std::vector<uint8_t>> neo_rom;   // core address -> data
+static bool neo_rom_md5(uint32_t config, uint8_t out[16])
+{
+	if (neo_rom.empty()) return false;
 	MD5Context ctx;
 	MD5Init(&ctx);
-	uint8_t buf[16384];
-	for (const std::string &n : files)
+	uint32_t prog = 0;
+	for (auto &c : neo_rom)
 	{
-		MD5Update(&ctx, (const uint8_t *)n.c_str(), (unsigned)n.size() + 1);
-		FILE *f = fopen((full + "/" + n).c_str(), "rb");
-		if (!f) return false;
-		size_t k;
-		while ((k = fread(buf, 1, sizeof(buf), f)) > 0) MD5Update(&ctx, buf, (unsigned)k);
-		fclose(f);
+		if (c.first >= 0x10000000 && !prog++) MD5Update(&ctx, (const uint8_t *)"M1", 2);   // the Z80's ROM after the program
+		MD5Update(&ctx, c.second.data(), (unsigned)c.second.size());
 	}
+	uint8_t cf[4] = { (uint8_t)config, (uint8_t)(config >> 8), (uint8_t)(config >> 16), (uint8_t)(config >> 24) };
+	MD5Update(&ctx, cf, 4);
 	MD5Final(out, &ctx);
+	neo_rom.clear();                      // up to 10 MB: not kept
 	return true;
 }
 
@@ -2380,6 +2365,7 @@ static Mode current_mode()
 bool netplay_neogeo_before(const char *name, int cd_en)
 {
 	if (own_reload || !core_armed || core_sys != SYS_NEOGEO) return false;
+	neo_rom.clear();
 	bool ran = neo_ran;
 	neo_ran = true;                         // the machine runs after this load, with or without a session
 	if (cd_en || current_mode() == M_OFF) return false;
@@ -2404,10 +2390,23 @@ bool netplay_neogeo_before(const char *name, int cd_en)
 	return false;
 }
 
+// neogeo_loader, a piece of ROM on its way to the core: the program (P1 at
+// $200000, its second 512 KB at $280000, P2 at $300000 in the core's SDRAM) and
+// M1 (kept apart, above them)
+void netplay_neogeo_data(int index, uint32_t offset, const uint8_t *data, uint32_t len)
+{
+	if (!core_armed || core_sys != SYS_NEOGEO) return;
+	uint32_t at = index == 4 ? 0x200000 : index == 5 ? 0x280000 : index == 6 ? 0x300000 : index == 9 ? 0x10000000 : 0;
+	if (!at || !len) return;
+	neo_rom[at + offset].assign(data, data + len);
+}
+
 // neogeo_loader, after the ROM set has loaded
-void netplay_neogeo_loaded(const char *name, int cd_en)
+static uint32_t neo_config = 0;
+void netplay_neogeo_loaded(const char *name, int cd_en, uint32_t config)
 {
 	if (own_reload || !core_armed || core_sys != SYS_NEOGEO || cd_en || !neo_prearm) return;
+	neo_config = config;
 	begin_session(name, 1, 0);
 }
 
@@ -2601,7 +2600,7 @@ static void begin_session(const char *name_in, unsigned char index, char opensav
 	}
 	else if (core_sys == SYS_NEOGEO)
 	{
-		if (!neogeo_md5(name, li.rom_md5) || !neogeo_bios_md5(name, li.boot_md5))
+		if (!neo_rom_md5(neo_config, li.rom_md5) || !neogeo_bios_md5(name, li.boot_md5))
 		{
 			post_message("Netplay: cannot read the ROM set or the BIOS");
 			neo_prearm = false;
