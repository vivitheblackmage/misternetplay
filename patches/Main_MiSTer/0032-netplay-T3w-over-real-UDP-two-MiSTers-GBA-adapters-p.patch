+// GBA with the wireless adapter (SPEC.md 13.6, T3w): the core's side of the
+// mailbox as gba_rfu.sv does it, one command at a time; the scripts are what a
+// game sends (LinkRawWireless): the host opens a room and waits for a client
+// and its data; the join searches, connects, sends and waits for the host's.
+static uint16_t gba_seq = 0, gba_eseq = 0;
+static void gba_sleep(int ms)   // the main thread keeps running netplay_poll() (it shows the messages)
+{
+	for (uint64_t t = now_ms(); now_ms() - t < (uint64_t)ms; usleep(1000)) netplay_poll();
+}
+static int gba_cmd(uint8_t cmd, const std::vector<uint32_t> &d, uint32_t *out, uint32_t *err)
+{
+	volatile uint64_t *mb = gba_mb;
+	for (size_t i = 0; i < d.size(); i++) mb[(0x018 >> 3) + i] = d[i];
+	gba_seq++;
+	uint32_t h = (uint32_t)gba_seq << 16 | (uint32_t)cmd << 8 | (uint32_t)d.size();
+	mb[0x010 >> 3] = (uint64_t)h << 32 | h;
+	for (uint64_t t = now_ms(); now_ms() - t < 3000; usleep(100))
+	{
+		netplay_poll();
+		uint64_t a = mb[0x200 >> 3];
+		uint32_t lo = (uint32_t)a;
+		if (lo != (uint32_t)(a >> 32) || (lo >> 16) != gba_seq) continue;
+		int n = lo & 0xff;
+		if (lo & 0x100) { *err = (uint32_t)mb[0x208 >> 3]; return -1; }
+		for (int i = 0; i < n; i++) out[i] = (uint32_t)mb[(0x208 >> 3) + i];
+		return n;
+	}
+	printf("[harness] no answer to command %02x\n", cmd);
+	return -2;
+}
+static int gba_event(uint32_t *out, int ms)   // after Wait: the words the adapter pushes
+{
+	volatile uint64_t *mb = gba_mb;
+	for (uint64_t t = now_ms(); now_ms() - t < (uint64_t)ms; usleep(200))
+	{
+		netplay_poll();
+		uint64_t e = mb[0x500 >> 3];
+		uint32_t lo = (uint32_t)e;
+		if (lo != (uint32_t)(e >> 32) || (lo >> 16) == gba_eseq || !(lo & 7)) continue;
+		gba_eseq = lo >> 16;
+		int n = lo & 7;
+		for (int i = 0; i < n; i++) out[i] = (uint32_t)mb[(0x508 >> 3) + i];
+		return n;
+	}
+	return 0;
+}
+
+static int run_gba(bool host)
+{
+	// the core is up: magic and status (as gba_rfu.sv writes them)
+	gba_mb[0] = 0x4742415246553031ull;   // "GBARFU01"
+	gba_mb[1] = 0;
+	netplay_start();
+	gba_sleep(200);
+	// each side its own game (FireRed and LeafGreen talk): different md5s
+	make_rom(getFullPath("game.gba"), host ? 0 : 7);
+	netplay_note_file("game.gba", 1, 0);
+	uint32_t out[Rfu::MAX_WORDS], err = 0;
+	bool ok = true;
+	auto expect = [&](bool c, const char *what) { if (!c) { printf("[harness] FAIL %s\n", what); ok = false; } };
+
+	expect(gba_cmd(0x10, {}, out, &err) == 0, "Hello");
+	if (host)
+	{
+		expect(gba_cmd(0x17, {0x003C0420}, out, &err) == 0, "Setup");
+		expect(gba_cmd(0x16, {0x11, 0x22, 0x33, 0x44, 0x55, 0x66}, out, &err) == 0, "Broadcast");
+		expect(gba_cmd(0x19, {}, out, &err) == 0, "StartHost");
+		int n = 0;
+		for (uint64_t t = now_ms(); n < 1 && now_ms() - t < 20000; gba_sleep(20)) n = gba_cmd(0x1a, {}, out, &err);
+		expect(n == 1, "a client in PollConnections");
+		// wait for the client's data (it may already be there)
+		int got = 0;
+		for (uint64_t t = now_ms(); !got && now_ms() - t < 20000; )
+		{
+			expect(gba_cmd(0x27, {}, out, &err) == 0, "Wait");
+			uint32_t ev[8];
+			int k = gba_event(ev, 3000);
+			if (k >= 1 && ev[0] == 0x99660028)
+			{
+				int m = gba_cmd(0x26, {}, out, &err);
+				if (m >= 2 && out[0] == 0x400 && out[1] == 0xc0ffee11) got = 1;
+			}
+		}
+		expect(got, "the client's data c0ffee11");
+		expect(gba_cmd(0x24, {4, 0x12345678}, out, &err) == 0, "SendData to the client");
+		gba_sleep(7000);   // let it go out, and the messages show, before leaving
+	}
+	else
+	{
+		uint32_t id = 0;
+		for (uint64_t t = now_ms(); !id && now_ms() - t < 20000; )
+		{
+			gba_cmd(0x1c, {}, out, &err);
+			gba_sleep(300);
+			int n = gba_cmd(0x1d, {}, out, &err);
+			if (n >= 7 && out[1] == 0x11 && out[6] == 0x66) id = out[0];
+			gba_cmd(0x1e, {}, out, &err);
+		}
+		expect(id != 0, "the host's broadcast");
+		expect(gba_cmd(0x1f, {id}, out, &err) == 0, "Connect");
+		uint32_t st = 0x01000000;
+		for (uint64_t t = now_ms(); st == 0x01000000 && now_ms() - t < 10000; gba_sleep(20))
+			if (gba_cmd(0x20, {}, out, &err) == 1) st = out[0];
+		expect(st != 0x01000000 && (st >> 16) == 0, "connected as client 0");
+		expect(gba_cmd(0x21, {}, out, &err) == 1, "FinishConnection");
+		expect(gba_cmd(0x24, {4u << 8, 0xc0ffee11}, out, &err) == 0, "SendData to the host");
+		int got = 0;
+		for (uint64_t t = now_ms(); !got && now_ms() - t < 20000; gba_sleep(20))
+		{
+			int m = gba_cmd(0x26, {}, out, &err);
+			if (m >= 2 && out[0] == 4 && out[1] == 0x12345678) got = 1;
+		}
+		expect(got, "the host's data 12345678");
+		gba_sleep(7000);   // the messages are shown one after the other, 1.5 s each
+	}
+	netplay_stop();
+	printf("RESULT frames=0 stalls=0 reloads=%d dip=0 digest=%s\n", reloads, ok ? "gba-ok" : "gba-fail");
+	return ok ? 0 : 1;
+}
