index c8a22ff..631a78a 100644
--- a/support/netplay/netplay_proto.h
+++ b/support/netplay/netplay_proto.h
@@ -39,9 +39,14 @@ struct Status
 
 inline uint32_t ring_off(uint32_t base, uint32_t frame) { return base + (frame & (MB_RING - 1)) * 8; }
 
+// CTRL is only believed by the FPGA with CTRL_MAGIC in its upper half: DDR3
+// is not cleared between cores, and a stray word must never arm netplay.
+constexpr uint32_t CTRL_MAGIC    = 0x4C525443;   // "CTRL"
+
 inline uint64_t ctrl_word(bool enable, bool run, uint8_t session)
 {
-	return (uint64_t)session << 8 | (run ? 2u : 0u) | (enable ? 1u : 0u);
+	if (!enable) return 0;
+	return (uint64_t)CTRL_MAGIC << 32 | (uint64_t)session << 8 | (run ? 2u : 0u) | 1u;
 }
 
 // INPUT[f]: both 32-bit halves carry the frame tag and session, so a torn
@@ -71,6 +76,7 @@ struct Settings
 	uint8_t mask_edges;    // status [28:27]
 	uint8_t overscan;      // status [68:67]
 	uint8_t cheats_off;    // status [20], 1 = off
+	uint8_t debug_dots;    // status [69], changes the picture
 };
 
 uint32_t pack_settings(const Settings &s);
