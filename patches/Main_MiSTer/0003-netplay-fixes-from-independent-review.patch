@@ -11,6 +11,9 @@ Session::Session(Mode mode, uint8_t delay, Mailbox mb, Transport *net, Recording
                  uint8_t session_seed, Timing t)
 	: mode_(mode), delay_(delay), mb_(mb), net_(net), rec_(rec), t_(t), seed_(session_seed)
 {
+	// A replay must use the delay it was recorded with, or every input shifts.
+	if (mode_ == M_REPLAY && rec_ && rec_->delay) delay_ = rec_->delay;
+	if (mode_ == M_RECORD && rec_) rec_->delay = delay_;
 	local_.assign(WIN, Slot8{0, 0, false});
 	remote_.assign(WIN, Slot8{0, 0, false});
 	my_crc_.assign(WIN, Slot32{0, 0, false});
@@ -127,6 +130,13 @@ void Session::step(uint64_t now)
 	{
 	case PH_WAIT_CORE:
 		if (!have_info_ || mb_.rd(MB_MAGIC) != MAGIC_VALUE) break;
+		// A previous session may have just written CTRL=0: wait until the core
+		// has seen it, or a fast re-arm would land before it ever went IDLE.
+		if (decode_status(mb_.rd(MB_STATUS)).state != FS_IDLE)
+		{
+			mb_.wr(MB_CTRL, ctrl_word(false, false, 0));
+			break;
+		}
 		{
 			uint8_t r = check_local(info_.settings, info_.rom_region, delay_);
 			if (r != REJ_OK)
@@ -276,6 +286,7 @@ void Session::handle_packet(uint64_t now, const Packet &p)
 		for (uint32_t i = 0; i < p.input.count; i++)
 		{
 			uint32_t f = p.input.first_frame + i;
+			if (f < p.input.first_frame) break;       // wrapped: malformed
 			if (f < remote_next_ || f >= remote_next_ + WIN) continue;
 			Slot8 &s = remote_[f % WIN];
 			s.f = f; s.v = p.input.joy[i]; s.ok = true;
@@ -285,7 +296,8 @@ void Session::handle_packet(uint64_t now, const Packet &p)
 		break;
 
 	case P_CRC:
-		if (phase_ == PH_RUN) put_crc(peer_crc_.data(), p.crc.frame, p.crc.crc, now);
+		// the peer may start a little earlier: keep its CRCs while we wait
+		if (phase_ == PH_RUN || phase_ == PH_READY) put_crc(peer_crc_.data(), p.crc.frame, p.crc.crc, now);
 		break;
 
 	case P_BYE:
@@ -301,8 +313,9 @@ void Session::arm(uint64_t now)
 {
 	for (uint32_t i = 0; i < MB_RING; i++)
 	{
-		mb_.wr(MB_LOCAL + i * 8, 0);
-		mb_.wr(MB_CRC + i * 8, 0);
+		// INVALID_WORD, not 0: a zero CRC word decodes as a valid CRC[0] = 0.
+		mb_.wr(MB_LOCAL + i * 8, INVALID_WORD);
+		mb_.wr(MB_CRC + i * 8, INVALID_WORD);
 		mb_.wr(MB_INPUT + i * 8, INVALID_WORD);
 	}
 	mb_.wr(MB_CTRL, ctrl_word(true, false, sess_));
