+static void test_ring_clear_is_invalid()
+{
+	printf("rings are cleared to words that never decode (review C3)\n");
+	FakeFpga f(0);
+	f.frame_ms = 1000000;                          // core never posts anything
+	Session s(M_RECORD, 2, f.mb, nullptr, nullptr, 0x21);
+	s.set_local(make_info());
+	for (uint64_t now = 1; now < 200; now++) { f.step(now); s.step(now); if (s.reload_requested()) s.reload_done(now); }
+	uint32_t c; uint8_t j;
+	CHECK(!decode_crc(f.mb.rd(ring_off(MB_CRC, 0)), 0, &c));
+	CHECK(!decode_local(f.mb.rd(ring_off(MB_LOCAL, 0)), 0, 0x21, &j));
+	CHECK(f.mb.rd(MB_CTRL) >> 32 == CTRL_MAGIC);
+}
+
+static void test_restart_rearms()
+{
+	printf("a new session right after the last one re-arms the core (review M6)\n");
+	FakeFpga f(0);
+	Recording rec;
+	Session *s = new Session(M_RECORD, 2, f.mb, nullptr, &rec, 0x31);
+	s->set_local(make_info());
+	uint64_t now = 0;
+	while (f.frame < 100 && now < 20000) { now++; f.step(now); s->step(now); if (s->reload_requested()) s->reload_done(now); }
+	CHECK(f.state == FS_RUN);
+	// what the netplay thread does on a new ROM: stop and re-create in one go,
+	// before the core has had a chance to look at CTRL
+	s->stop(now, "Netplay: new ROM");
+	delete s;
+	Recording rec2;
+	s = new Session(M_RECORD, 2, f.mb, nullptr, &rec2, 0x33);
+	s->set_local(make_info());
+	uint64_t t0 = now;
+	while (s->phase() != PH_RUN && now < t0 + 10000) { now++; s->step(now); f.step(now); if (s->reload_requested()) s->reload_done(now); }
+	CHECKM(s->phase() == PH_RUN, "second session stuck: '%s'", s->message());
+	CHECK(f.sess == 0x33);
+	delete s;
+}
+
+static void test_replay_uses_recorded_delay()
+{
+	printf("replay uses the recording's delay (review m2)\n");
+	Recording rec;
+	{
+		FakeFpga f(0);
+		Session s(M_RECORD, 5, f.mb, nullptr, &rec, 0x41);
+		s.set_local(make_info());
+		uint64_t now = 0;
+		while (f.frame < 300 && now < 30000) { now++; f.step(now); s.step(now); if (s.reload_requested()) s.reload_done(now); }
+		s.stop(now, "done");
+	}
+	CHECK(rec.delay == 5);
+	FakeFpga f(1);
+	Session s(M_REPLAY, 2, f.mb, nullptr, &rec, 0x42);   // ini says 2, recording says 5
+	s.set_local(make_info());
+	uint64_t now = 0;
+	while (s.phase() != PH_DONE && now < 30000) { now++; f.step(now); s.step(now); if (s.reload_requested()) s.reload_done(now); }
+	CHECKM(!s.failed() && strstr(s.message(), "replay OK"), "'%s'", s.message());
+}
