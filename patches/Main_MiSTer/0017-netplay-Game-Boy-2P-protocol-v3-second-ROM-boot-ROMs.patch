+static void test_gb2p_record_replay()
+{
+	printf("gb2p: record and replay\n");
+	Recording rec;
+	rec.system = SYS_GB2P;
+	FakeFpga f1(0, SYS_GB2P);
+	Session r(M_RECORD, 4, f1.mb, nullptr, &rec, 9);
+	r.set_local(make_info(SYS_GB2P));
+	uint64_t now = 0;
+	while (f1.frame < 600 && now < 60000)
+	{
+		now++;
+		f1.step(now); r.step(now);
+		if (r.reload_requested() && now % 40 == 0) r.reload_done(now);
+	}
