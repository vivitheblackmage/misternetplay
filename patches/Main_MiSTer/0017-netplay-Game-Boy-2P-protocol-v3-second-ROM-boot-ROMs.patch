+static void test_gb2p_rejects()
+{
+	printf("gb2p: second ROM, boot ROM, other console\n");
+	{
+		Pair P(3, Timing(), SYS_GB2P, SYS_GB2P);
+		LocalInfo jb = make_info(SYS_GB2P);
+		jb.rom2_md5[0] ^= 1;
+		P.b.set_local(jb);
+		P.run_until([&] { return P.b.failed(); }, 20000);
+		CHECKM(P.b.failed() && strstr(P.b.message(), "Different ROM"), "rom2: %s", P.b.message());
+	}
+	{
+		Pair P(3, Timing(), SYS_GB2P, SYS_GB2P);
+		LocalInfo jb = make_info(SYS_GB2P);
+		jb.boot_md5[3] = 9;
+		P.b.set_local(jb);
+		P.run_until([&] { return P.b.failed(); }, 20000);
+		CHECKM(P.b.failed() && strstr(P.b.message(), "settings"), "boot: %s", P.b.message());
+	}
+	{
+		Pair P(3, Timing(), SYS_GB2P, SYS_GB2P);
+		LocalInfo jb = make_info(SYS_GB2P);
+		jb.gb.dupe_save = 1;
+		P.b.set_local(jb);
+		P.run_until([&] { return P.b.failed(); }, 20000);
+		CHECKM(P.b.failed() && strstr(P.b.message(), "settings"), "settings: %s", P.b.message());
+	}
+	for (System other : { SYS_NES, SYS_SNES })
+	{
+		// GB2P host, older-protocol join: refused in the join's own format
+		Pair P(3, Timing(), SYS_GB2P, other);
+		int acks = 0, own_format = 0;
+		size_t want = other == SYS_NES ? 4 + 2 + 1 + 48 + 4 + 1 + 2 : 4 + 2 + 1 + 1 + 48 + 4 + 1 + 2;
+		P.net.drop_if = [&](int from, const uint8_t *b, size_t n) {
+			if (from == 0 && n > 6 && b[4] == P_HELLO_ACK) { acks++; if (n == want && b[n - 1] == REJ_OTHER_SYSTEM) own_format++; }
+			return false;
+		};
+		P.run_until([&] { return P.b.failed(); }, 20000);
+		CHECKM(acks > 0 && acks == own_format, "join %d: %d of %d refusals in its format", other, own_format, acks);
+		CHECKM(P.b.failed() && strstr(P.b.message(), "another console"), "join %d: %s", other, P.b.message());
+	}
