+	s.system = 2; CHECK(check_local(s, 0, 3) == REJ_OK);
+	s.system = 3; CHECK(check_local(s, 0, 3) == REJ_SYSTEM);    // MegaDuck
+	s.system = 0; CHECK(check_local(s, 1, 3) == REJ_SYSTEM);    // a .bin (MegaDuck) cart
+	CHECK(check_local(s, 0, 16) == REJ_DELAY);
+	GbSettings base {};
+	uint32_t seen[8];
+	GbSettings v[7] = {};
+	v[0].system = 1; v[1].mapper = 4; v[2].extra_spr = 1; v[3].gba_mode = 1;
+	v[4].fast_boot = 1; v[5].audio_mode = 1; v[6].dupe_save = 1;
+	seen[7] = pack_settings(base);
+	for (int i = 0; i < 7; i++)
