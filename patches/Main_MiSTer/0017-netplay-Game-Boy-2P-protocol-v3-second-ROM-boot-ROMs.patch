+static void test_gb2p_words()
+{
+	printf("gb2p: mailbox words and CTRL\n");
+	CHECK(input_word(SYS_GB2P, 7, 0x5A, 0x81, 0x42) == input_word(7, 0x5A, 0x81, 0x42));   // as NES
+	CHECK(input_word(SYS_GB2P, 7, 0x5A, 0x181, 0) == input_word(7, 0x5A, 0x81, 0));       // 8 bits
+	CHECK(mailbox_phys(SYS_GB2P) == 0x3C000000);
+	CHECK(mailbox_magic(SYS_GB2P) == 0x3130504E50324247ULL);   // "GB2PNP01" as rtl/netplay.sv
+	CHECK(ctrl_word(true, true, 9, true) == (0x4C525443ULL << 32 | 9 << 8 | 7));
+	CHECK(ctrl_word(true, false, 9) == (0x4C525443ULL << 32 | 9 << 8 | 1));
+	CHECK(ctrl_word(false, true, 9, true) == 0);
+}
+
+static void test_gb2p_packets()
+{
+	printf("gb2p: packets\n");
+	uint8_t buf[MAX_PACKET];
+	Packet h {}, q;
+	h.type = P_HELLO_ACK; h.session = 3; h.hello.version = PROTO_VERSION_GB2P; h.hello.system = SYS_GB2P;
+	memset(h.hello.rom_md5, 1, 16); memset(h.hello.sav_md5, 2, 16);
+	memset(h.hello.rom2_md5, 3, 16); memset(h.hello.boot_md5, 4, 16);
+	h.hello.rtc_time = 0x89ABCDEF; h.hello.settings = 0x155; h.hello.delay = 5; h.hello.accept = 1;
+	size_t n = encode(h, buf, sizeof(buf));
+	CHECK(n == 4 + 2 + 1 + 1 + 48 + 32 + 4 + 4 + 1 + 2 && buf[7] == SYS_GB2P);
+	// rom2_md5, boot_md5, rtc_time right after sav_md5
+	CHECK(buf[56] == 3 && buf[72] == 4 && buf[88] == 0xEF && buf[91] == 0x89);
+	CHECK(decode(buf, n, &q) && q.hello.version == 3 && q.hello.system == SYS_GB2P
+	      && q.hello.rom2_md5[15] == 3 && q.hello.boot_md5[0] == 4 && q.hello.rtc_time == 0x89ABCDEF
+	      && q.hello.settings == 0x155 && q.hello.delay == 5 && q.hello.accept == 1);
+	CHECK(!decode(buf, n - 1, &q));               // truncated
+	h.hello.version = PROTO_VERSION_SNES;         // a version 2 HELLO has none of them
+	CHECK(encode(h, buf, sizeof(buf)) == 4 + 2 + 1 + 1 + 48 + 4 + 1 + 2);
+
+	Packet p {};
+	p.type = P_INPUT; p.session = 7; p.input.first_frame = 9; p.input.count = 2;
+	p.input.joy[0] = 0xFF; p.input.joy[1] = 0x01;
+	n = encode(p, buf, sizeof(buf), wide_input(SYS_GB2P));
+	CHECK(n == 4 + 2 + 4 + 1 + 2 * 2);            // u16 samples, as SNES
+}
