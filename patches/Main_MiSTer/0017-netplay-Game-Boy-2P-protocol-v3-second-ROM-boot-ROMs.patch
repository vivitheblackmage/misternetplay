+	{
+		now++;
+		f2.step(now); p.step(now);
+		if (p.reload_requested() && now % 40 == 0) p.reload_done(now);
+	}
+	CHECKM(!p.failed() && strstr(p.message(), "replay OK"), "replay: %s", p.message());
+	CHECKM(p.rtc_time() == 1800000000u, "replay rtc %u", p.rtc_time());
+}
