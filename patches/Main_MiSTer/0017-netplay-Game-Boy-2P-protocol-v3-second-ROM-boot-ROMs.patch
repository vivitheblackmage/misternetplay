+static std::map<unsigned char, std::string> gb_boot;   // index byte -> md5 (16 bytes)
+
+// md5 over {index, md5[16]} of each boot ROM in index order; zeros for none
+static void gb_boot_md5(uint8_t out[16])
+{
+	memset(out, 0, 16);
+	if (gb_boot.empty()) return;
+	MD5Context ctx;
+	MD5Init(&ctx);
+	for (const auto &b : gb_boot)
+	{
+		uint8_t i = b.first;
+		MD5Update(&ctx, &i, 1);
+		MD5Update(&ctx, (const unsigned char *)b.second.data(), 16);
+	}
+	MD5Final(out, &ctx);
+}
+
+// The cart RTC's time as the core gets it at core load: local time, computed
+// as user_io's send_rtc(2) does for this core
+static uint32_t local_unix_time()
+{
+	time_t t = time(nullptr);
+	struct tm g;
+	gmtime_r(&t, &g);
+	return (uint32_t)(t + (t - mktime(&g)));
+}
+
+static void send_timestamp(uint32_t t)
+{
+	spi_uio_cmd_cont(UIO_TIMESTAMP);
+	spi_w((uint16_t)t);
+	spi_w((uint16_t)(t >> 16));
+	DisableIO();
+}
