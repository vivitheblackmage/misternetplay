+static void test_gb2p_session()
+{
+	printf("gb2p: session over a lossy link\n");
+	Pair P(3, Timing(), SYS_GB2P, SYS_GB2P);
+	LocalInfo jb = make_info(SYS_GB2P);
+	jb.rtc_time = 1700000000u;                    // the join's clock is off: the host's wins
+	P.b.set_local(jb);
+	rng_state = 777;
+	P.net.loss_pct = 5; P.net.delay_ms = 30; P.net.jitter_ms = 10;
+	bool ok = P.run_until([&] { return P.fa.frame >= 2000 && P.fb.frame >= 2000; }, 120000);
+	CHECKM(ok, "did not reach 2000 frames: A %s / B %s", P.a.message(), P.b.message());
+	check_same_inputs(P, 3);
+	int wrong = 0;
+	for (size_t f = 3; f < 1900; f++)
+		if (P.fa.seen[f].first != P.fa.posted[f - 3] || P.fa.seen[f].second != P.fb.posted[f - 3]) wrong++;
+	CHECKM(wrong == 0, "%d frames with wrong port or delay", wrong);
+	CHECKM(!P.fa.join && P.fb.join, "CTRL[2]: host %d join %d", P.fa.join, P.fb.join);
+	CHECKM(P.a.rtc_time() == 1800000000u && P.b.rtc_time() == 1800000000u, "rtc host %u join %u", P.a.rtc_time(), P.b.rtc_time());
+}
