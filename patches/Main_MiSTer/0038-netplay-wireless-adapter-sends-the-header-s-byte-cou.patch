From 3f4e11a86049b0de83240369aad5dd511b0640d4 Mon Sep 17 00:00:00 2001
From: netplay <netplay@localhost>
Date: Wed, 11 Nov 2026 21:59:27 +0100
Subject: [PATCH 38/42] netplay: wireless adapter sends the header's byte count
 (Pokemon's parent: 1 byte, no word); adapter trace in /tmp/rfu_trace.txt
---
 support/netplay/netplay.cpp     | 78 ++++++++++++++++++++++++++++++++-
 support/netplay/rfu.cpp         |  5 ++-
 support/netplay/rfu_mailbox.cpp |  3 ++
 support/netplay/rfu_mailbox.h   |  5 +++
 4 files changed, 88 insertions(+), 3 deletions(-)

diff --git a/support/netplay/netplay.cpp b/support/netplay/netplay.cpp
index 2f57dff..0bb2a0d 100644
--- a/support/netplay/netplay.cpp
+++ b/support/netplay/netplay.cpp
@@ -6,6 +6,7 @@
 // which is plain memory and needs no SPI.
 
 #include <stdio.h>
+#include <stdarg.h>
 #include <stdlib.h>
 #include <string.h>
 #include <strings.h>
@@ -933,15 +934,76 @@ static void *netplay_thread(void *)
 constexpr uint32_t RFU_MB_PHYS = 0x3C000000;   // gba_rfu.sv MB_BASE (ddram window 0x30000000)
 constexpr uint32_t RFU_MB_MAP  = 0x1000;
 
+// /tmp/rfu_trace.txt (RAM): every adapter command, event and packet with its
+// time, for finding out what a game does when it drops the link. 4 MB, then
+// the old half goes to rfu_trace.1.txt.
+static FILE *rfu_trace_f = nullptr;
+static uint64_t rfu_trace_flushed = 0;
+
+static void rfu_trace_open()
+{
+	if (rfu_trace_f) fclose(rfu_trace_f);
+	rfu_trace_f = fopen("/tmp/rfu_trace.txt", "w");
+}
+
+static void rfu_trace(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+static void rfu_trace(const char *fmt, ...)
+{
+	if (!rfu_trace_f) rfu_trace_open();
+	if (!rfu_trace_f) return;
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	fprintf(rfu_trace_f, "%6ld.%03ld ", (long)ts.tv_sec, ts.tv_nsec / 1000000);
+	va_list ap;
+	va_start(ap, fmt);
+	vfprintf(rfu_trace_f, fmt, ap);
+	va_end(ap);
+	fputc('\n', rfu_trace_f);
+	if (ftell(rfu_trace_f) > 4 * 1024 * 1024)
+	{
+		fclose(rfu_trace_f);
+		rfu_trace_f = nullptr;
+		rename("/tmp/rfu_trace.txt", "/tmp/rfu_trace.1.txt");
+	}
+}
+
+static void rfu_trace_words(char kind, uint8_t cmd, const uint32_t *in, int len, const uint32_t *out, int n)
+{
+	char line[600];
+	int p = 0;
+	if (kind == 'C') p += snprintf(line + p, sizeof(line) - p, "cmd %02x", cmd);
+	else if (kind == 'E') p += snprintf(line + p, sizeof(line) - p, "evt");
+	else p += snprintf(line + p, sizeof(line) - p, "reset");
+	for (int i = 0; i < len && i < 24 && p < 280; i++) p += snprintf(line + p, sizeof(line) - p, " %08x", in[i]);
+	if (kind == 'C') p += snprintf(line + p, sizeof(line) - p, " ->%s%d", n < 0 ? " err " : " ", n < 0 ? -n : n);
+	for (int i = 0; out && i < n && i < 24 && p < (int)sizeof(line) - 12; i++) p += snprintf(line + p, sizeof(line) - p, " %08x", out[i]);
+	rfu_trace("%s", line);
+}
+
+static void rfu_trace_pkt(const char *dir, const uint8_t *b, size_t n)
+{
+	// RFU1 header: type and h (big endian), then the first payload bytes
+	if (n < 12) { rfu_trace("%s short %u", dir, (unsigned)n); return; }
+	uint32_t t = (uint32_t)b[4] << 24 | (uint32_t)b[5] << 16 | (uint32_t)b[6] << 8 | b[7];
+	uint32_t h = (uint32_t)b[8] << 24 | (uint32_t)b[9] << 16 | (uint32_t)b[10] << 8 | b[11];
+	char hex[50];
+	int p = 0;
+	for (size_t i = 12; i < n && i < 28; i++) p += snprintf(hex + p, sizeof(hex) - p, "%02x", b[i]);
+	hex[p] = 0;
+	rfu_trace("%s type %u h %08x len %u %s", dir, t, h, (unsigned)n, hex);
+}
+
 static void *gba_wireless_thread(void *)
 {
 	volatile uint64_t *mem = (volatile uint64_t *)shmem_map(RFU_MB_PHYS, RFU_MB_MAP);
 	if (!mem) { post_message("Netplay: cannot map DDR3 mailbox"); return nullptr; }
 	RfuMailbox mbx(mem);
+	mbx.trace = rfu_trace_words;
+	rfu_trace_open();
 
 	Udp *udp = nullptr;
 	RfuLink *link = nullptr;
-	Rfu rfu([&link](int, const uint8_t *b, size_t n) { if (link) link->send(b, n); },
+	Rfu rfu([&link](int, const uint8_t *b, size_t n) { rfu_trace_pkt(link ? "tx" : "tx-nolink", b, n); if (link) link->send(b, n); },
 	        (uint32_t)(now_ms() ^ ((uint64_t)getpid() << 16)));
 	uint32_t seen_rom = 0;
 	bool linked = false;
@@ -950,6 +1012,7 @@ static void *gba_wireless_thread(void *)
 	uint64_t last_busy = 0, last_stats = 0;
 	bool lost_told = false;
 	uint32_t restarts = 0;
+	Rfu::State traced_state = Rfu::IDLE;
 
 	while (!quit)
 	{
@@ -1034,7 +1097,7 @@ static void *gba_wireless_thread(void *)
 		}
 		if (link)
 		{
-			link->tick(now, [&rfu](const uint8_t *b, size_t n) { rfu.receive(0, b, n); });
+			link->tick(now, [&rfu](const uint8_t *b, size_t n) { rfu_trace_pkt("rx", b, n); rfu.receive(0, b, n); });
 			if (link->connected() && !linked && !lost_told)
 			{
 				linked = true;
@@ -1087,6 +1150,17 @@ static void *gba_wireless_thread(void *)
 		// the game waits for every answer: poll often while it talks to the
 		// adapter (commands come in bursts), else once a millisecond (CPU)
 		if (mbx.poll((uint32_t)now, rfu)) last_busy = now;
+		if (rfu.state() != traced_state)
+		{
+			static const char *names[] = { "idle", "host", "connecting", "client" };
+			traced_state = rfu.state();
+			rfu_trace("state %s", names[traced_state & 3]);
+		}
+		if (now - rfu_trace_flushed >= 1000 && rfu_trace_f)
+		{
+			rfu_trace_flushed = now;
+			fflush(rfu_trace_f);
+		}
 		usleep(now - last_busy < 50 ? 100 : 1000);
 	}
 
diff --git a/support/netplay/rfu.cpp b/support/netplay/rfu.cpp
index 60bcaa9..26708c2 100644
--- a/support/netplay/rfu.cpp
+++ b/support/netplay/rfu.cpp
@@ -281,8 +281,11 @@ int Rfu::command(uint8_t cmd, const uint32_t *data, int len, uint32_t *out)
 		{
 			int words = len - 1;
 			if (words > 23) words = 23;
+			// a header may count more bytes than the words that follow (Pokemon's
+			// parent sends header 1 and no word): send that many bytes, as the
+			// adapter (and gpSP) do, the missing ones zero
+			memset(tx_.buf, 0, sizeof(tx_.buf));
 			memcpy(tx_.buf, &buf_[1], words * sizeof(uint32_t));
-			if (tx_.blen > words * 4) tx_.blen = (uint8_t)(words * 4);   // never more than the game gave
 		}
 		/* fallthrough */
 	case CMD_RTX_WAIT:
diff --git a/support/netplay/rfu_mailbox.cpp b/support/netplay/rfu_mailbox.cpp
index ce3965b..99bb72e 100644
--- a/support/netplay/rfu_mailbox.cpp
+++ b/support/netplay/rfu_mailbox.cpp
@@ -28,6 +28,7 @@ bool RfuMailbox::poll(uint32_t now_ms, Rfu &rfu)
 		{
 			resets_ = resets;
 			rfu.reset();
+			if (trace) trace('R', 0, nullptr, 0, nullptr, 0);
 			waiting_ = false;
 			did = true;
 		}
@@ -50,6 +51,7 @@ bool RfuMailbox::poll(uint32_t now_ms, Rfu &rfu)
 			for (int i = 0; i < len; i++) in[i] = (uint32_t)rd(OFF_CDATA + 8 * i);
 			int n = rfu.command(cmd, in, len, out);
 			commands_++;
+			if (trace) trace('C', cmd, in, len, out, n);
 			uint32_t hdr;
 			if (n < 0)
 			{
@@ -81,6 +83,7 @@ bool RfuMailbox::poll(uint32_t now_ms, Rfu &rfu)
 		if (n > 0)
 		{
 			if (n > MAX_EVT_WORDS) n = MAX_EVT_WORDS;
+			if (trace) trace('E', 0, nullptr, 0, ev, n);
 			for (int i = 0; i < n; i++) wr(OFF_EDATA + 8 * i, ev[i]);
 			eseq_++;
 			if (!eseq_) eseq_ = 1;
diff --git a/support/netplay/rfu_mailbox.h b/support/netplay/rfu_mailbox.h
index 340175b..5d15813 100644
--- a/support/netplay/rfu_mailbox.h
+++ b/support/netplay/rfu_mailbox.h
@@ -8,6 +8,7 @@
 
 #include <stdint.h>
 #include "rfu.h"
+#include <functional>
 
 class RfuMailbox
 {
@@ -22,6 +23,10 @@ public:
 
 	uint32_t commands() const { return commands_; }  // observation (tests)
 
+	// optional: every command ('C', its words, the answer; n < 0 an error) and
+	// every event ('E', no command words) for a trace file
+	std::function<void(char kind, uint8_t cmd, const uint32_t *in, int len, const uint32_t *out, int n)> trace;
+
 private:
 	volatile uint64_t *mb_;
 	uint16_t last_seq_ = 0, eseq_ = 0, resets_ = 0;
-- 
2.43.0

