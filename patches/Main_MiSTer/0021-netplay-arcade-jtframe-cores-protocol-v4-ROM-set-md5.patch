-// netplay.h — NES, SNES and Game Boy 2P lockstep netplay, Main_MiSTer integration (SPEC.md 7, 10, 11)
+// netplay.h — NES, SNES, Game Boy 2P and arcade lockstep netplay, Main_MiSTer integration (SPEC.md 7, 10, 11, 12)
 
 #ifndef NETPLAY_H
 #define NETPLAY_H
 
-void netplay_start(void);                                // a core was loaded; arms only for NES, SNES, GAMEBOY2P
+void netplay_start(void);                                // a core was loaded; arms only for NES, SNES, GAMEBOY2P, arcade with netplay
 void netplay_stop(void);                                 // core is about to change
