@@ -1498,16 +1511,76 @@ static bool room_of(const std::string &full, uint32_t seq, RoomFile *out)
 	return true;
 }
 
-// The loaded core: SYS_NES, SYS_SNES, SYS_GB2P, or -1 for one without netplay
+// Arcade (SPEC.md 12): a core loaded from an MRA whose configuration string
+// has the OSD option "O[127:126],Netplay,..." (the jtframe cores built with netplay)
+static bool arcade_has_netplay()
+{
+	if (!is_arcade()) return false;
+	for (int i = 0; ; i++)
+	{
+		char *p = user_io_get_confstr(i);
+		if (!p) return false;
+		if (strstr(p, "[127:126]") && strstr(p, ",Netplay,")) return true;
+	}
+}
+
+// The loaded core: SYS_NES, SYS_SNES, SYS_GB2P, SYS_ARCADE, or -1 for one without netplay
 static int netplay_system()
 {
 	const char *n = user_io_get_core_name();
 	if (!strcasecmp(n, "NES")) return SYS_NES;
 	if (!strcasecmp(n, "SNES")) return SYS_SNES;
 	if (!strcasecmp(n, "GAMEBOY2P")) return SYS_GB2P;
+	if (arcade_has_netplay()) return SYS_ARCADE;
 	return -1;
 }
 
+// OSD "Netplay": 0 netplay.ini, 1 Off, 2 Host, 3 Join
+static const char *osd_netplay_bits()
+{
+	switch (core_sys)
+	{
+	case SYS_SNES:   return "[59:58]";
+	case SYS_GB2P:   return "[47:46]";
+	case SYS_ARCADE: return "[127:126]";
+	default:         return "[89:88]";
+	}
+}
+
+// Arcade (SPEC.md 12.2), main thread only: the md5 of each ROM index as Main
+// assembled it from the MRA, the MRA loaded, and the DIP switches.
+static std::map<int, std::string> arc_roms;       // rom index -> md5 (16 bytes)
+static bool        arc_pending = false;           // an MRA is being parsed
+static std::string arc_xml;                       // the MRA the core holds, empty before one
+static bool        arc_nvram = false;             // it has NVRAM (refused, SPEC.md 12.4)
+static uint32_t    arc_osd_seen = 0;              // OSD Netplay when last looked at
+static bool        dip_applied = false;           // the session's DIP switches replace the player's
+static uint64_t    dip_own = 0;                   // the player's, while they are replaced
+static uint64_t    dip_own_saved = 0;             // what their .dip file holds (sw->dip_saved), meanwhile
+static uint32_t    dip_for = 0;                   // the session (load seq) they were applied for
+
+// md5 over {index u8, md5[16]} of each ROM index, in index order
+static void arcade_md5(uint8_t out[16])
+{
+	MD5Context ctx;
+	MD5Init(&ctx);
+	for (const auto &r : arc_roms)
+	{
+		uint8_t i = (uint8_t)r.first;
+		MD5Update(&ctx, &i, 1);
+		MD5Update(&ctx, (const unsigned char *)r.second.data(), 16);
+	}
+	MD5Final(out, &ctx);
+}
+
+static void dip_send(uint64_t v)
+{
+	sw_struct *sw = arcade_sw();
+	if (sw->dip_cur == v) return;
+	sw->dip_cur = v;
+	arcade_sw_send();
+}
+
 // SNES (SPEC.md 10.2): 1 if the cartridge needs something that cannot be the
 // same on both sides: MSU-1 (streamed from the SD card), BS-X, a real-time
 // clock (S-RTC, SPC7110 with RTC), or the competition carts' timers.
@@ -1621,6 +1694,35 @@ static unsigned char gb_index(const std::string &name)
 
 static void begin_session(const char *name, unsigned char index, char opensave);
 
+// Arcade hooks from mra_loader.cpp (SPEC.md 12.2)
+void netplay_note_arcade_rom(int index, const unsigned char *md5)
+{
+	if (!arc_pending) { arc_roms.clear(); arc_pending = true; }
+	arc_roms[index] = std::string((const char *)md5, 16);
+}
+
+void netplay_note_arcade(const char *xml, int nvram)
+{
+	if (!arc_pending) arc_roms.clear();   // an MRA without any ROM data
+	arc_pending = false;
+	if (!core_armed || core_sys != SYS_ARCADE) return;
+	arc_xml = xml;
+	arc_nvram = nvram != 0;
+	dip_applied = false;                 // arcade_send_rom() just sent the player's own
+	arc_osd_seen = user_io_status_get(osd_netplay_bits());
+	begin_session(arc_xml.c_str(), 0, 0);
+}
+
+void netplay_note_dip(void)
+{
+	if (own_reload || arc_pending || !core_armed || core_sys != SYS_ARCADE || arc_xml.empty()) return;
+	// the player changed a DIP switch: these are now theirs, and a session
+	// starts again (a join gets the host's switches once more)
+	if (dip_applied) arcade_sw()->dip_saved = dip_own_saved;   // the OSD saves them against the real file
+	dip_applied = false;
+	if (thread_running) begin_session(arc_xml.c_str(), 0, 0);
+}
+
 void netplay_note_file(const char *name, unsigned char index, char opensave)
 {
 	if (own_reload) return;
@@ -1671,9 +1773,9 @@ static void begin_session(const char *name_in, unsigned char index, char opensav
 	std::string name_copy = name_in;
 	const char *name = name_copy.c_str();
 
-	// OSD "Netplay" (NES [89:88], SNES [59:58], Game Boy 2P [47:46]): 0 netplay.ini, 1 Off, 2 Host, 3 Join
+	// OSD "Netplay" (NES [89:88], SNES [59:58], Game Boy 2P [47:46], arcade [127:126])
 	static const Mode osd_modes[4] = { M_OFF, M_OFF, M_HOST, M_JOIN };
-	uint32_t osd = user_io_status_get(core_sys == SYS_SNES ? "[59:58]" : core_sys == SYS_GB2P ? "[47:46]" : "[89:88]");
+	uint32_t osd = user_io_status_get(osd_netplay_bits());
 	Mode mode = osd ? osd_modes[osd & 3] : cfg.mode;
 	std::string room;
 	if (cfg.server[0])
@@ -1730,9 +1832,16 @@ static void begin_session(const char *name_in, unsigned char index, char opensav
 			return;
 		}
 	}
+	else if (core_sys == SYS_ARCADE)
+	{
+		// no file to read: the ROM as Main assembled it from the MRA (SPEC.md 12.2)
+		arcade_md5(li.rom_md5);
+		// the player's own: switches still applied from a join session are not theirs
+		li.dip = dip_applied ? dip_own : arcade_sw()->dip_cur;
+	}
 	else if (!md5_file(name, li.rom_md5, hdr, sizeof(hdr))) return;
 	if (core_sys != SYS_GB2P) memcpy(li.rom2_md5, li.rom_md5, 16);
-	if (cfg.server[0])
+	if (cfg.server[0] && core_sys != SYS_ARCADE)    // arcade games never come from the server
 	{
 		std::lock_guard<std::mutex> g(cat_mtx);
 		if (!catalog.empty() && (!catalog.count(md5_hex(li.rom_md5)) || !catalog.count(md5_hex(li.rom2_md5))))
@@ -1741,6 +1850,7 @@ static void begin_session(const char *name_in, unsigned char index, char opensav
 	const char *dot = strrchr(name, '.');
 	if (core_sys == SYS_SNES) li.rom_region = snes_refused(name);
 	else if (core_sys == SYS_GB2P) li.rom_region = has_ext(gb_rom1, ".bin") || has_ext(gb_rom2, ".bin");   // MegaDuck
+	else if (core_sys == SYS_ARCADE) li.rom_region = arc_nvram;
 	else li.rom_region = rom_region_from_header(hdr, sizeof(hdr), dot ? dot + 1 : "");
 	core_build(li.core_build);
 
@@ -1752,7 +1862,7 @@ static void begin_session(const char *name_in, unsigned char index, char opensav
 	size_t d = sav.rfind('.');
 	if (d != std::string::npos) sav.resize(d);
 	sav += ".sav";
-	if (!md5_file(sav.c_str(), li.sav_md5, nullptr, 0)) memset(li.sav_md5, 0, 16);
+	if (core_sys == SYS_ARCADE || !md5_file(sav.c_str(), li.sav_md5, nullptr, 0)) memset(li.sav_md5, 0, 16);
 
 	if (core_sys == SYS_GB2P)
 	{
@@ -1827,14 +1937,18 @@ void netplay_start(void)
 	core_name = user_io_get_core_name();
 	srv_core = core_sys == SYS_GB2P ? "GB2P" : core_name;
 	gb_rom1.clear(); gb_rom2.clear();   // gb_boot already holds the boot ROMs of this core load
+	arc_xml.clear(); arc_roms.clear(); arc_pending = false; dip_applied = false;
 	core_armed = true;
-	if (cfg.server[0]) server_games_start();
+	// arcade: no games from the server, no room folder (the games are MRA files, SPEC.md 12.5)
+	if (cfg.server[0] && core_sys != SYS_ARCADE) server_games_start();
 }
 
 void netplay_stop(void)
 {
 	core_armed = false;
 	gb_boot.clear();                    // the next core starts without them
+	arc_xml.clear();
+	dip_applied = false;                // the next MRA reads its own DIP switches
 	server_games_stop();
 	if (!thread_running) return;
 	quit = true;
@@ -1846,6 +1960,18 @@ void netplay_poll(void)
 {
 	if (!thread_running && !core_armed) return;   // lobby messages come before any session
 
+	// Arcade: there is no game load to start a session after the MRA, so a
+	// change of the OSD option starts (or stops) one (SPEC.md 12.2)
+	if (core_armed && core_sys == SYS_ARCADE && !arc_xml.empty())
+	{
+		uint32_t o = user_io_status_get(osd_netplay_bits());
+		if (o != arc_osd_seen)
+		{
+			arc_osd_seen = o;
+			begin_session(arc_xml.c_str(), 0, 0);
+		}
+	}
+
 	if (reload_req)
 	{
 		std::string path, path2;
@@ -1860,7 +1986,23 @@ void netplay_poll(void)
 			opensave = rom_opensave;
 		}
 		own_reload = true;                 // keep netplay_note_file from starting a new session
-		if (core_sys == SYS_GB2P)
+		if (core_sys == SYS_ARCADE)
+		{
+			// SPEC.md 12.4: no ROM load (the core clears its RAM itself while
+			// armed); the session's DIP switches, the host's, go in instead
+			// sent, not saved: the OSD's save compares against dip_saved
+			uint32_t live = dip_live;
+			uint64_t d = reload_dip;
+			sw_struct *sw = arcade_sw();
+			if (live && sw->dip_cur != d)    // 0: that session is over already
+			{
+				if (!dip_applied) { dip_own = sw->dip_cur; dip_own_saved = sw->dip_saved; dip_applied = true; }
+				dip_send(d);
+				sw->dip_saved = d;
+			}
+			if (dip_applied) dip_for = live;
+		}
+		else if (core_sys == SYS_GB2P)
 		{
 			// SPEC.md 11.2, 11.4: the host's clock for the cart RTC before the
 			// .sav loads; game 1 into both Game Boys, then game 2 into gb2, the
@@ -1884,6 +2026,17 @@ void netplay_poll(void)
 		reload_req = false;                // thread never sees both false and asks again
 	}
 
+	// Arcade: the session the DIP switches were applied for is over, the
+	// player's own come back, and their .dip file is what it was (SPEC.md 12.4)
+	if (dip_applied && dip_live != dip_for)
+	{
+		own_reload = true;
+		dip_send(dip_own);
+		own_reload = false;
+		arcade_sw()->dip_saved = dip_own_saved;
+		dip_applied = false;
+	}
+
 	// one message at a time, each at least 1.5 s, so none is overwritten unseen
 	static uint64_t t_shown = 0;
 	char text[96];
diff --git a/support/netplay/netplay.h b/support/netplay/netplay.h
