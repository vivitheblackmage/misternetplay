diff --git a/support/netplay/netplay_proto.cpp b/support/netplay/netplay_proto.cpp
index 23558df..2873bda 100644
--- a/support/netplay/netplay_proto.cpp
+++ b/support/netplay/netplay_proto.cpp
@@ -103,10 +103,18 @@ const char *reject_text(uint8_t r)
 	case REJ_BUSY:      return "Host is busy";
 	case REJ_CHIP:      return "Game chip not supported in netplay";
 	case REJ_OTHER_SYSTEM: return "The other player runs another console";
+	case REJ_NVRAM:     return "Games with NVRAM are not supported yet";
 	default:          return "Rejected";
 	}
 }
 
+const char *reject_text(System s, uint8_t r)
+{
+	if (s == SYS_ARCADE && r == REJ_ROM)  return "Different ROM set (MRA or zip)";
+	if (s == SYS_ARCADE && r == REJ_CORE) return "Different core version (update both)";
+	return reject_text(r);
+}
+
 uint8_t check_local(const Settings &s, uint8_t rom_region, uint8_t delay)
 {
 	if (delay < 2 || delay > 15) return REJ_DELAY;
@@ -133,6 +141,13 @@ uint8_t check_local(const GbSettings &s, uint8_t rom_ok, uint8_t delay)
 	return REJ_OK;
 }
 
+uint8_t check_local_arcade(uint8_t rom_ok, uint8_t delay)
+{
+	if (delay < 2 || delay > 15) return REJ_DELAY;
+	if (rom_ok) return REJ_NVRAM;
+	return REJ_OK;
+}
+
 uint8_t rom_region_from_header(const uint8_t *hdr, size_t len, const char *ext)
 {
 	if (ext && (!strcasecmp(ext, "fds") || !strcasecmp(ext, "nsf"))) return 3;
@@ -173,6 +188,7 @@ struct Writer
 	void u8(uint8_t v)   { if (n + 1 > cap) { ok = false; return; } p[n++] = v; }
 	void u16(uint16_t v) { u8((uint8_t)v); u8((uint8_t)(v >> 8)); }
 	void u32(uint32_t v) { u16((uint16_t)v); u16((uint16_t)(v >> 16)); }
+	void u64(uint64_t v) { u32((uint32_t)v); u32((uint32_t)(v >> 32)); }
 	void raw(const uint8_t *s, size_t l) { for (size_t i = 0; i < l; i++) u8(s[i]); }
 };
 
@@ -182,6 +198,7 @@ struct Reader
 	uint8_t u8()   { if (n + 1 > len) { ok = false; return 0; } return p[n++]; }
 	uint16_t u16() { uint16_t a = u8(); return (uint16_t)(a | u8() << 8); }
