+// Arcade (SPEC.md 12): no ROM file and no reload. The MRA load is what
+// mra_loader does: each ROM index's md5, the player's DIP switches, then the
+// MRA. NP_DIP=hex: this side's DIP switches (the join's differ by default; the
+// host's must be used, and the join's come back when the session is over).
+// NP_ROMSALT=n: another ROM set here (the handshake must refuse it).
+static int run_arcade(bool host, bool osd, uint32_t want)
+{
+	fpga = new FakeFpga(host ? 0 : 1, SYS_ARCADE);
+	netplay_start();
+	uint8_t m0[16], m1[16];
+	memset(m0, 0x11 + (getenv("NP_ROMSALT") ? atoi(getenv("NP_ROMSALT")) : 0), 16);
+	memset(m1, 0x22, 16);
+	uint64_t own = getenv("NP_DIP") ? strtoull(getenv("NP_DIP"), nullptr, 16) : host ? 0xFFFF : 0xF7FF;
+	sw.dip_num = 2;
+	sw.dip_cur = own;
+	sw.dip_saved = own;                        // what the player's .dip file holds
+	netplay_note_arcade_rom(0, m0);
+	netplay_note_arcade_rom(1, m1);
+	arcade_sw_send();                          // mra_loader sends the DIP switches before the end
+	netplay_note_arcade("/media/fat/_Arcade/Bubble Bobble (Japan, Ver 0.1).mra", 0);
+	// NP_OSD: netplay.ini says off; the OSD option, set after the MRA is loaded, starts it
+	if (osd)
+	{
+		for (int i = 0; i < 20; i++) { netplay_poll(); usleep(1000); }
+		osd_netplay = host ? 2 : 3;
+	}
+
+	uint64_t t0 = now_ms();
+	uint64_t dip_run = 0;
+	bool saved_ok = true;
+	while (fpga->frame < want && now_ms() - t0 < 60000)
+	{
+		fpga->step(now_ms());
+		netplay_poll();
+		if (fpga->frame > 10) dip_run = sw.dip_cur;
+		if (sw.dip_saved != sw.dip_cur) saved_ok = false;   // the OSD would save the session's as the player's
+		usleep(500);
+	}
+	uint32_t reached = fpga->frame;
+	for (uint64_t t = now_ms(); now_ms() - t < 500; usleep(500)) { fpga->step(now_ms()); netplay_poll(); }
+	// the session ends here (OSD Off): the player's own DIP switches come back
+	osd_netplay = 1;
+	for (uint64_t t = now_ms(); now_ms() - t < 300; usleep(1000)) { fpga->step(now_ms()); netplay_poll(); }
+	uint64_t dip_after = sw.dip_cur;
+	netplay_stop();
+
+	uint64_t digest = 1469598103934665603ULL;
+	uint32_t n = 0;
+	for (auto &p : fpga->seen)
+	{
+		if (n++ >= want) break;
+		digest = (digest ^ p.first) * 1099511628211ULL;
+		digest = (digest ^ p.second) * 1099511628211ULL;
+	}
+	digest = (digest ^ dip_run) * 1099511628211ULL;   // both must have played with the host's
+	bool ok = reached >= want && reloads == 0 && dip_after == own && !fpga->join && saved_ok && sw.dip_saved == own;
+	if (!saved_ok || sw.dip_saved != own) printf("[harness] dip_saved wrong: the .dip file would change\n");
+	if (dip_after != own) printf("[harness] DIP switches %llx after the session, own %llx\n", (unsigned long long)dip_after, (unsigned long long)own);
+	printf("[harness] dip sends %s\n", dip_sends.c_str());
+	printf("RESULT frames=%u stalls=%u reloads=%d dip=%llx digest=%016llx\n", reached, fpga->stalls, reloads,
+	       (unsigned long long)dip_run, (unsigned long long)digest);
+	return ok ? 0 : 1;
+}
