+static bool resolve(const char *host, uint16_t port, sockaddr_in *out)
+{
+	addrinfo hints {}, *res = nullptr;
+	hints.ai_family = AF_INET;
+	hints.ai_socktype = SOCK_DGRAM;
+	char ps[8];
+	snprintf(ps, sizeof(ps), "%u", port);
+	if (getaddrinfo(host, ps, &hints, &res) || !res) return false;
+	memcpy(out, res->ai_addr, sizeof(*out));
+	freeaddrinfo(res);
+	return true;
+}
+
+// "a.b.c.d:port" -> address; false for anything else
+static bool parse_addr(const std::string &s, sockaddr_in *out)
+{
+	size_t c = s.rfind(':');
+	if (c == std::string::npos || c > 15) return false;
+	std::string ip = s.substr(0, c);
+	char *end = nullptr;
+	unsigned long port = strtoul(s.c_str() + c + 1, &end, 10);
+	if (!end || *end || !port || port > 65535) return false;
+	sockaddr_in a {};
+	a.sin_family = AF_INET;
+	if (inet_pton(AF_INET, ip.c_str(), &a.sin_addr) != 1 || !a.sin_addr.s_addr) return false;
+	a.sin_port = htons((uint16_t)port);
+	*out = a;
+	return true;
+}
+
+static bool unicast(const sockaddr_in &a)
+{
+	uint32_t ip = ntohl(a.sin_addr.s_addr);
+	return ip && (ip >> 28) != 0xE && (ip >> 28) != 0xF;     // not 0, multicast, 240/4 or broadcast
+}
+
+static bool is_private(const sockaddr_in &a)
+{
+	uint32_t ip = ntohl(a.sin_addr.s_addr);
+	return (ip >> 24) == 10 || (ip >> 20) == 0xAC1 || (ip >> 16) == 0xC0A8 || (ip >> 24) == 127
+	    || (ip >> 16) == 0xA9FE;                                  // 10/8 172.16/12 192.168/16 127/8 169.254/16
+}
+
+static bool same_addr(const sockaddr_in &a, const sockaddr_in &b)
+{
+	return a.sin_addr.s_addr == b.sin_addr.s_addr && a.sin_port == b.sin_port;
+}
+
+// Tab-separated fields of a control packet after "NPS1 " (at most 12)
+static int split_fields(const char *b, size_t n, std::string *f, int max)
+{
+	int k = 0;
+	f[0].clear();
+	for (size_t i = 5; i < n; i++)
+	{
+		unsigned char c = (unsigned char)b[i];
+		if (c == '\t') { if (++k >= max) return 0; f[k].clear(); }
+		else if (c == '\r' || c == '\n') break;
+		else if (c >= 0x20 && c < 0x7F && f[k].size() < 80) f[k] += (char)c;
+	}
+	return k + 1;
+}
