+		uint64_t now = now_ms();
+		if (srv_mounted && (!last || now - last >= 3000))
+		{
+			last = now;
+			std::string list;
+			if (http_get("/rooms?" + key + "&core=" + url_enc(core_name.c_str()), &list, 1 << 18) && !dl_quit)
+				update_rooms(list);
+		}
+		usleep(100000);
+	}
 	return nullptr;
 }
 
