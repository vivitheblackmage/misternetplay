+// A room folder and the game in it
+static void remove_entry(const std::string &full)
+{
+	if (DIR *d = opendir(full.c_str()))
+	{
+		std::vector<std::string> names;
+		while (dirent *e = readdir(d)) if (strcmp(e->d_name, ".") && strcmp(e->d_name, "..")) names.push_back(e->d_name);
+		closedir(d);
+		for (const std::string &n : names) unlink((full + "/" + n).c_str());
+		rmdir(full.c_str());
+	}
+	else unlink(full.c_str());
+}
+
+// Make rooms_dir match the server's list of waiting rooms.
+static void update_rooms(const std::string &list)
+{
+	struct Want { RoomFile room; std::string src, file; };
+	std::map<std::string, Want> want;               // entry name -> what it should be
+	std::string mine, pinned;
+	{
+		std::lock_guard<std::mutex> g(lobby_mtx);
+		mine = my_room;
+		pinned = pinned_entry;
+	}
+
+	size_t pos = 0;
+	int count = 0;
+	while (pos < list.size() && count < 100)
+	{
+		size_t end = list.find('\n', pos);
+		if (end == std::string::npos) end = list.size();
+		std::string line = list.substr(pos, end - pos);
+		pos = end + 1;
+		std::string f[8];
+		int k = 0;
+		for (char c : line)
+		{
+			if (c == '\t') { if (++k >= 8) break; }
+			else if (f[k].size() < 100) f[k] += c;
+		}
+		if (k != 6 || !is_hex(f[0], 8) || f[1] != "waiting" || strcasecmp(f[2].c_str(), core_name.c_str()) || !is_hex(f[3], 32)) continue;
+		if (f[0] == mine) continue;
+		count++;
+
+		char nm[17];
+		clean_name(f[4].c_str(), nm, sizeof(nm));
+		std::string game = clean_file(f[5], 80);
+		if (game.empty()) game = "game";
+		std::string base = clean_file(std::string(*nm ? nm : "player") + " - " + game, 70);
+		std::string src;
+		{
+			std::lock_guard<std::mutex> g(cat_mtx);
+			auto s = srv_games.find(f[3]);
+			if (s != srv_games.end()) src = s->second;
+		}
+		if (src.empty())
+		{
+			std::lock_guard<std::mutex> g(idx_mtx);
+			auto s = idx_by_md5.find(f[3]);
+			if (s != idx_by_md5.end()) src = s->second;
+		}
+		if (!src.empty() && copy_failed.count(f[3])) src.clear();
+		// The room is a folder with the game under the host's file name, so the
+		// core's .sav is saves/NES/<game>.sav on both sides.
+		std::string entry;
+		for (int n = 1; n < 10; n++)
+		{
+			std::string b = n == 1 ? base : base + " (" + std::to_string(n) + ")";
+			entry = src.empty() ? b + " (missing game)" : b;
+			if (!want.count(entry)) break;
+		}
+		want[entry] = Want { RoomFile { f[0], f[3] }, src, game + ".nes" };
+	}
+
+	// remove what is no longer wanted (or no longer the same room)
+	std::map<std::string, RoomFile> have;
+	{
+		std::lock_guard<std::mutex> g(lobby_mtx);
+		have = room_files;
+	}
+	DIR *d = opendir(rooms_dir.c_str());
+	std::vector<std::string> present;
+	if (d)
+	{
+		while (dirent *e = readdir(d)) if (e->d_name[0] != '.') present.push_back(e->d_name);
+		closedir(d);
+	}
+	std::map<std::string, RoomFile> now;
+	for (const std::string &n : present)
+	{
+		std::string full = rooms_dir + "/" + n;
+		auto w = want.find(n);
+		auto h = have.find(n);
+		bool keep = w != want.end() && h != have.end() && h->second.id == w->second.room.id;
+		if (n == pinned && h != have.end()) { now[n] = h->second; continue; }   // our session needs it
+		if (keep) { now[n] = h->second; continue; }
+		remove_entry(full);
+	}
+	// add what is missing
+	for (const auto &w : want)
+	{
+		if (now.count(w.first)) continue;
+		std::string full = rooms_dir + "/" + w.first;
+		if (mkdir(full.c_str(), 0755)) continue;
+		if (!w.second.src.empty() && !copy_file(w.second.src, full + "/" + w.second.file))
+		{
+			copy_failed.insert(w.second.room.md5);   // RAM folder full: show it as missing from now on
+			remove_entry(full);
+			continue;
+		}
+		now[w.first] = w.second.room;
+	}
+	std::lock_guard<std::mutex> g(lobby_mtx);
+	room_files = now;
+}
