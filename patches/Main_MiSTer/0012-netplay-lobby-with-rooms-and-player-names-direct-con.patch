+// Player names: letters, digits, space and -_. , at most 16; å ä ö -> a a o
+// (the OSD font has no such letters), anything else dropped (SPEC.md 7, "Names").
+static void clean_name(const char *in, char *out, size_t cap)
+{
+	size_t n = 0;
+	for (const unsigned char *p = (const unsigned char *)in; *p && n + 1 < cap && n < 16; p++)
+	{
+		char c = 0;
+		if (*p == 0xC3 && p[1])
+		{
+			p++;
+			switch (*p)
+			{
+			case 0xA5: case 0xA4: case 0xA0: case 0xA1: case 0xA2: c = 'a'; break;
+			case 0x85: case 0x84: case 0x80: case 0x81: case 0x82: c = 'A'; break;
+			case 0xB6: case 0xB8: case 0xB3: c = 'o'; break;
+			case 0x96: case 0x98: case 0x93: c = 'O'; break;
+			case 0xA9: case 0xA8: c = 'e'; break;
+			case 0x89: case 0x88: c = 'E'; break;
+			case 0xBC: c = 'u'; break;
+			case 0x9C: c = 'U'; break;
+			}
+		}
+		else if (isalnum(*p) && *p < 0x80) c = (char)*p;
+		else if (strchr(" -_.", *p) && *p) c = (char)*p;
+		if (c) out[n++] = c;
+	}
+	out[n] = 0;
+	while (n && out[n - 1] == ' ') out[--n] = 0;
+	size_t lead = strspn(out, " ");
+	if (lead) memmove(out, out + lead, n - lead + 1);
+}
+
+// "MiSTer-" + the last four hex digits of the network card's MAC
+static void default_name(char *out, size_t cap)
+{
+	const char *ifs[] = { "eth0", "wlan0", "end0" };
+	for (const char *i : ifs)
+	{
+		char path[64], mac[32] = {};
+		snprintf(path, sizeof(path), "/sys/class/net/%s/address", i);
+		FILE *f = fopen(path, "r");
+		if (!f) continue;
+		bool ok = fgets(mac, sizeof(mac), f) != nullptr;
+		fclose(f);
+		size_t l = ok ? strcspn(mac, "\r\n") : 0;
+		if (l >= 5)
+		{
+			snprintf(out, cap, "MiSTer-%c%c%c%c", mac[l - 5], mac[l - 4], mac[l - 2], mac[l - 1]);
+			return;
+		}
+	}
+	snprintf(out, cap, "MiSTer");
+}
