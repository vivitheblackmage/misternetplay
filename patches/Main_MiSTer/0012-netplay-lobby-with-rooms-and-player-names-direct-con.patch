+// The netplay thread tells the lobby which room it hosts (not listed), and
+// when the session it joined is over (its room may go).
+static void lobby_host(const std::string &room)
+{
+	std::lock_guard<std::mutex> g(lobby_mtx);
+	my_room = room;
+}
+
+static void lobby_unpin(uint32_t seq)
+{
+	std::lock_guard<std::mutex> g(lobby_mtx);
+	if (pinned_seq == seq) pinned_entry.clear();
+}
+
+// A file loaded from Rooms/<entry>/: which room (main thread). The room stays
+// (its folder is not removed) until the session for load seq is over.
+static bool in_rooms(const std::string &full)
+{
+	return !rooms_dir.empty() && !full.compare(0, rooms_dir.size() + 1, rooms_dir + "/");
+}
+
+static bool room_of(const std::string &full, uint32_t seq, RoomFile *out)
+{
+	if (!in_rooms(full)) return false;
+	std::string rest = full.substr(rooms_dir.size() + 1);
+	size_t slash = rest.find('/');
+	if (slash == std::string::npos) return false;
+	std::string entry = rest.substr(0, slash);
+	std::lock_guard<std::mutex> g(lobby_mtx);
+	auto r = room_files.find(entry);
+	if (r == room_files.end()) return false;
+	*out = r->second;
+	pinned_entry = entry;
+	pinned_seq = seq;
+	return true;
+}
