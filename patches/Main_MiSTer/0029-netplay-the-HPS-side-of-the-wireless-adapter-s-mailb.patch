diff --git a/support/netplay/rfu_mailbox.cpp b/support/netplay/rfu_mailbox.cpp
new file mode 100644
index 0000000..ce3965b
--- /dev/null
+++ b/support/netplay/rfu_mailbox.cpp
@@ -0,0 +1,93 @@
+// rfu_mailbox.cpp — the HPS side of the wireless adapter's mailbox (SPEC.md 13.3).
+
+#include "rfu_mailbox.h"
+
+namespace {
+const uint64_t MAGIC = 0x4742415246553031ull;   // "GBARFU01" as gba_rfu.sv writes it
+const uint32_t OFF_MAGIC = 0x000, OFF_STATUS = 0x008, OFF_CMD = 0x010, OFF_CDATA = 0x018,
+               OFF_ANS = 0x200, OFF_ADATA = 0x208, OFF_EVT = 0x500, OFF_EDATA = 0x508;
+const int MAX_CMD_WORDS = 32, MAX_ANS_WORDS = 64, MAX_EVT_WORDS = 4;
+}
+
+bool RfuMailbox::present() const
+{
+	return rd(OFF_MAGIC) == MAGIC;
+}
+
+bool RfuMailbox::poll(uint32_t now_ms, Rfu &rfu)
+{
+	if (!present()) { synced_ = false; return false; }
+	bool did = false;
+
+	// SD pulses (and the core starting) reset the adapter
+	uint64_t st = rd(OFF_STATUS);
+	if ((uint32_t)st == (uint32_t)(st >> 32))
+	{
+		uint16_t resets = (uint16_t)(st >> 16);
+		if (!synced_ || resets != resets_)
+		{
+			resets_ = resets;
+			rfu.reset();
+			waiting_ = false;
+			did = true;
+		}
+	}
+
+	// a new command: both halves alike, a sequence number not served yet
+	uint64_t h = rd(OFF_CMD);
+	uint32_t lo = (uint32_t)h;
+	if (lo == (uint32_t)(h >> 32))
+	{
+		uint16_t seq = lo >> 16;
+		if (!synced_) { last_seq_ = seq; synced_ = true; }   // what was there before is old
+		else if (seq != last_seq_)
+		{
+			last_seq_ = seq;
+			uint8_t cmd = (uint8_t)(lo >> 8);
+			int len = lo & 0xff;
+			if (len > MAX_CMD_WORDS) len = MAX_CMD_WORDS;
+			uint32_t in[MAX_CMD_WORDS], out[Rfu::MAX_WORDS];
+			for (int i = 0; i < len; i++) in[i] = (uint32_t)rd(OFF_CDATA + 8 * i);
+			int n = rfu.command(cmd, in, len, out);
+			commands_++;
+			uint32_t hdr;
+			if (n < 0)
+			{
+				wr(OFF_ADATA, (uint32_t)-n);   // error code
+				hdr = (uint32_t)seq << 16 | 1 << 8 | 1;
+			}
+			else
+			{
+				if (n > MAX_ANS_WORDS) n = MAX_ANS_WORDS;
+				for (int i = 0; i < n; i++) wr(OFF_ADATA + 8 * i, out[i]);
+				hdr = (uint32_t)seq << 16 | (uint32_t)n;
+			}
+			wr(OFF_ANS, twice(hdr));   // after the data
+			if (n >= 0 && Rfu::waits(cmd))
+			{
+				rfu.begin_wait(now_ms);
+				waiting_ = true;
+			}
+			did = true;
+		}
+	}
+	else if (!synced_) synced_ = true;
+
+	// the adapter is clock master: hand the event to the core when there is one
+	if (waiting_)
+	{
+		uint32_t ev[8];
+		int n = rfu.wait_poll(now_ms, ev);
+		if (n > 0)
+		{
+			if (n > MAX_EVT_WORDS) n = MAX_EVT_WORDS;
+			for (int i = 0; i < n; i++) wr(OFF_EDATA + 8 * i, ev[i]);
+			eseq_++;
+			if (!eseq_) eseq_ = 1;
+			wr(OFF_EVT, twice((uint32_t)eseq_ << 16 | (uint32_t)n));
+			waiting_ = false;
+			did = true;
+		}
+	}
+	return did;
+}
diff --git a/support/netplay/rfu_mailbox.h b/support/netplay/rfu_mailbox.h
new file mode 100644
index 0000000..340175b
--- /dev/null
+++ b/support/netplay/rfu_mailbox.h
@@ -0,0 +1,36 @@
+// rfu_mailbox.h — the HPS side of the wireless adapter's mailbox
+// (SPEC.md 13.3; the FPGA side is GBA_MiSTer rtl/gba_rfu.sv). Works on a plain
+// pointer to the mailbox so the same code runs in Main (DDR3 mapped) and in the
+// core's test bench (an array). No OS calls.
+
+#ifndef RFU_MAILBOX_H
+#define RFU_MAILBOX_H
+
+#include <stdint.h>
+#include "rfu.h"
+
+class RfuMailbox
+{
+public:
+	static const uint32_t SIZE = 0x600;            // bytes from the base
+	explicit RfuMailbox(volatile uint64_t *base) : mb_(base) {}
+
+	bool present() const;                          // the core wrote its magic
+	// Serves the core: a reset, a new command, events while waiting.
+	// Returns true when something was done.
+	bool poll(uint32_t now_ms, Rfu &rfu);
+
+	uint32_t commands() const { return commands_; }  // observation (tests)
+
+private:
+	volatile uint64_t *mb_;
+	uint16_t last_seq_ = 0, eseq_ = 0, resets_ = 0;
+	bool synced_ = false, waiting_ = false;
+	uint32_t commands_ = 0;
+
+	uint64_t rd(uint32_t off) const { return mb_[off / 8]; }
+	void wr(uint32_t off, uint64_t v) { mb_[off / 8] = v; }
+	static uint64_t twice(uint32_t v) { return (uint64_t)v << 32 | v; }
+};
+
+#endif
