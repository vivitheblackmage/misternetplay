+// ---------------------------------------------------------------------------
+// ao486's network card in a room (SPEC.md 15.4): two MiSTers pair as the other
+// cores do (OSD Netplay Host or Join, peer= or the server's AO486 room, hole
+// punching, relay) and the card's Ethernet frames cross the pair. No lockstep
+// and no game: the room is a LAN. The window is the main thread's (ne2000.cpp);
+// the frames reach this thread through ne2000_room_take/give. A change of the
+// mode (the OSD or Network Off/On) comes as a new rom_seq.
+
+static void *lan_thread(void *)
+{
+	Udp *udp = nullptr;
+	EthLink *link = nullptr;
+	uint32_t seen = 0, restarts = 0;
+	Mode mode = M_OFF;
+	bool linked = false, lost_told = false, repair = false;
+	const char *told = nullptr;
+	uint64_t last_stats = 0;
+
+	while (!quit)
+	{
+		uint64_t now = now_ms();
+		uint32_t seq;
+		{
+			std::lock_guard<std::mutex> g(info_mtx);
+			seq = rom_seq;
+			if (seq != seen) mode = rom_mode;
+		}
+		// a new mode from the OSD, or the link lost: pair from the start. After
+		// 10 s of silence both sides do it (a new socket, the host a new room, the
+		// join asks for the open room again), so they find each other after one
+		// of them toggled its option or loaded the core again.
+		if (seq != seen || repair)
+		{
+			seen = seq;
+			repair = false;
+			delete link; link = nullptr;
+			if (udp) udp->leave();
+			delete udp; udp = nullptr;
+			lobby_host("");
+			linked = false;
+			told = nullptr;
+			restarts = 0;
+
+			bool ok = mode == M_HOST || mode == M_JOIN;
+			if (ok && mode == M_JOIN && !cfg.peer[0] && !cfg.server[0])
+			{
+				post_message("Netplay: Join needs peer= or server= in netplay.ini");
+				ok = false;
+			}
+			else if (ok && cfg.server[0])
+			{
+				ServerReg r {};
+				r.host = mode == M_HOST;
+				if (r.host) random_id(r.room, sizeof(r.room));
+				else snprintf(r.room, sizeof(r.room), "*");    // the open AO486 room (no game to match)
+				snprintf(r.core, sizeof(r.core), "%s", srv_core.c_str());
+				snprintf(r.game, sizeof(r.game), "LAN");
+				lobby_host(r.host ? r.room : "");
+				udp = new Udp();
+				if (!udp->open_server(cfg, r))
+				{
+					post_message("Netplay: cannot reach server (check server=)");
+					ok = false;
+				}
+			}
+			else if (ok)
+			{
+				udp = new Udp();
+				if (!udp->open_socket(cfg.port, mode == M_JOIN ? cfg.peer : nullptr))
+				{
+					post_message(mode == M_JOIN ? "Netplay: cannot reach peer (check peer=)" : "Netplay: cannot open port");
+					ok = false;
+				}
+			}
+			if (ok)
+			{
+				link = new EthLink(udp, random32());
+				if (!lost_told) post_message(mode == M_HOST ? "Netplay: waiting for player 2 (network card)" : "Netplay: connecting (network card)");
+			}
+			else
+			{
+				delete udp;
+				udp = nullptr;
+			}
+			if (!ok) lost_told = false;
+		}
+
+		if (udp)
+		{
+			udp->tick(now);
+			if (const char *n = udp->take_notice()) post_message(n);
+		}
+		if (link)
+		{
+			link->tick(now, [](const uint8_t *f, size_t n) { ne2000_room_give(f, n); });
+			uint8_t frame[EthLink::MAX_FRAME];
+			size_t len;
+			for (int i = 0; i < 64 && ne2000_room_take(frame, sizeof(frame), &len); i++) link->send(frame, len);
+
+			if (link->connected() && !linked)
+			{
