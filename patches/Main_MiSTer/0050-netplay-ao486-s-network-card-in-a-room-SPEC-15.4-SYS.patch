diff --git a/support/netplay/eth_link.cpp b/support/netplay/eth_link.cpp
new file mode 100644
index 0000000..481b7a1
--- /dev/null
+++ b/support/netplay/eth_link.cpp
@@ -0,0 +1,95 @@
+// eth_link.cpp — ao486's network card frames between two MiSTers (SPEC.md 15.4).
+
+#include "eth_link.h"
+#include <string.h>
+
+namespace {
+const uint8_t MAGIC[4] = { 'N', 'P', 'E', '1' };
+const uint64_t HELLO_MS = 500, KEEPALIVE_MS = 1000;
+
+void put32(uint8_t *p, uint32_t v) { p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v; }
+uint32_t get32(const uint8_t *p) { return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3]; }
+}
+
+void EthLink::put(uint8_t type, const uint8_t *data, size_t len)
+{
+	uint8_t pkt[HDR + MAX_FRAME];
+	memcpy(pkt, MAGIC, 4);
+	pkt[4] = type;
+	pkt[5] = VERSION;
+	put32(pkt + 6, sid_);
+	put32(pkt + 10, peer_sid_);
+	if (len) memcpy(pkt + HDR, data, len);
+	t_->send(pkt, HDR + len);
+	if (type == T_HELLO) { last_hello_ = now_; hello_sent_ = true; }
+}
+
+void EthLink::send(const uint8_t *frame, size_t len)
+{
+	if (!connected_ || len < MIN_FRAME || len > MAX_FRAME) { dropped_++; return; }
+	put(T_FRAME, frame, len);
+	sent_++;
+}
+
+void EthLink::tick(uint64_t now_ms, const Deliver &deliver)
+{
+	now_ = now_ms;
+	// larger than any packet: a datagram cut to the buffer still shows as too long
+	uint8_t buf[2048];
+	int n;
+	while ((n = t_->recv(buf, sizeof(buf))) >= 0)
+	{
+		if ((size_t)n < HDR || memcmp(buf, MAGIC, 4))
+		{
+			// a lockstep player, the wireless adapter, or junk
+			foreign_++;
+			if (n >= 4 && !connected_) refusal_ = "Netplay: the other player is not using the network card";
+			continue;
+		}
+		uint8_t type = buf[4];
+		uint32_t from = get32(buf + 6), to = get32(buf + 10);
+		if (buf[5] != VERSION)
+		{
+			foreign_++;
+			refusal_ = "Netplay: different netplay version";
+			continue;
+		}
+		if (from == 0 || (type != T_HELLO && type != T_FRAME)) { foreign_++; continue; }
+
+		if (type == T_HELLO)
+		{
+			if (peer_sid_ != from)
+			{
+				// the first hello, or the other side came back with a new id
+				if (peer_sid_) restarts_++;
+				peer_sid_ = from;
+				connected_ = false;
+			}
+			last_rx_ = now_;
+			if (to == sid_)
+			{
+				if (!connected_)
+				{
+					connected_ = true;
+					refusal_ = nullptr;
+					if (!locked_) { t_->lock_peer(); locked_ = true; }   // from now on only this player
+					put(T_HELLO, nullptr, 0);   // so the other side connects too, not a keepalive later
+				}
+			}
+			else put(T_HELLO, nullptr, 0);   // it has not heard us yet: answer at once
+			continue;
+		}
+
+		// a frame: only from the paired side, addressed to this pairing
+		if (!connected_ || from != peer_sid_ || to != sid_) { foreign_++; continue; }
+		size_t len = (size_t)n - HDR;
+		if (len < MIN_FRAME || len > MAX_FRAME) { foreign_++; continue; }
+		last_rx_ = now_;
+		received_++;
+		deliver(buf + HDR, len);
+	}
+
+	// hellos until the other side has heard us, then a keepalive
+	uint64_t every = connected_ ? KEEPALIVE_MS : HELLO_MS;
+	if (!hello_sent_ || now_ - last_hello_ >= every) put(T_HELLO, nullptr, 0);
+}
diff --git a/support/netplay/eth_link.h b/support/netplay/eth_link.h
new file mode 100644
index 0000000..5d6698d
--- /dev/null
+++ b/support/netplay/eth_link.h
@@ -0,0 +1,58 @@
+// eth_link.h — ao486's network card frames between two MiSTers (SPEC.md 15.4):
+// the card's Ethernet frames over the netplay Transport (UDP, direct or through
+// the server). Not reliable and not ordered, as Ethernet is not: IPX games and
+// TCP do their own resending. No lockstep. No OS calls (time comes in as an
+// argument), so it builds in the x86 tests.
+
+#ifndef ETH_LINK_H
+#define ETH_LINK_H
+
+#include <stdint.h>
+#include <stddef.h>
+#include <functional>
+#include "netplay_session.h"   // Transport
+
+class EthLink
+{
+public:
+	static const size_t MIN_FRAME = 14;        // an Ethernet header
+	static const size_t MAX_FRAME = 1536;      // the card's slot (a frame is at most 1514 bytes)
+	static const size_t HDR = 14;              // "NPE1" type version from32 to32
+	using Deliver = std::function<void(const uint8_t *frame, size_t len)>;
+
+	// sid: this side's random id for this pairing (0 is not allowed). The other
+	// side coming back with a new id (its core loaded again) starts over.
+	EthLink(netplay::Transport *t, uint32_t sid) : t_(t), sid_(sid ? sid : 1) {}
+
+	void send(const uint8_t *frame, size_t len);          // dropped until connected (no cable yet)
+	void tick(uint64_t now_ms, const Deliver &deliver);   // receive, hello, keep alive
+
+	bool connected() const { return connected_; }
+	// ten seconds without a packet from the side it last heard (also after that
+	// side came back with a new id and then went quiet)
+	bool lost(uint64_t now_ms) const { return peer_sid_ && now_ms - last_rx_ > 10000; }
+	const char *refusal() const { return refusal_; }     // the other side is not a network card
+	uint32_t restarts() const { return restarts_; }
+
+	// observation (netplay.log, tests)
+	uint32_t sent() const { return sent_; }
+	uint32_t received() const { return received_; }
+	uint32_t dropped() const { return dropped_; }        // frames to send before the link was up, or too long
+	uint32_t foreign() const { return foreign_; }
+
+private:
+	enum : uint8_t { T_HELLO = 0, T_FRAME = 1 };
+	static const uint8_t VERSION = 1;
+
+	netplay::Transport *t_;
+	uint32_t sid_, peer_sid_ = 0;
+	bool connected_ = false, locked_ = false;
+	const char *refusal_ = nullptr;
+	uint64_t now_ = 0, last_hello_ = 0, last_rx_ = 0;
+	bool hello_sent_ = false;
+	uint32_t restarts_ = 0, sent_ = 0, received_ = 0, dropped_ = 0, foreign_ = 0;
+
+	void put(uint8_t type, const uint8_t *data, size_t len);
+};
+
+#endif
