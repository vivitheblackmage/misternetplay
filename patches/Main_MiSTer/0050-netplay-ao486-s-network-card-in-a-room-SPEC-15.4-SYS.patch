+// the room's frames for the card, while the ring has room (the queue holds the rest)
+static void poll_room_rx(void)
+{
+	std::lock_guard<std::mutex> g(room_mtx);
+	while (!room_in.empty())
+	{
+		const std::vector<uint8_t> &f = room_in.front();
+		if (!ring_put(f.data(), (int)f.size())) break;
