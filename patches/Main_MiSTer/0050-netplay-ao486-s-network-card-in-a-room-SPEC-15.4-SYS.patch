+}
+
+bool ne2000_room_take(uint8_t *buf, size_t cap, size_t *len)
+{
+	std::lock_guard<std::mutex> g(room_mtx);
+	if (room_out.empty()) return false;
+	const std::vector<uint8_t> &f = room_out.front();
+	size_t n = f.size() < cap ? f.size() : cap;
+	memcpy(buf, f.data(), n);
+	*len = n;
+	room_out.pop_front();
+	return true;
+}
+
+void ne2000_room_give(const uint8_t *frame, size_t len)
+{
+	if (len < 14 || len > MAX_FRAME) return;
+	std::lock_guard<std::mutex> g(room_mtx);
+	if (room_in.size() >= ROOM_QUEUE) room_in.pop_front();
+	room_in.push_back(std::vector<uint8_t>(frame, frame + len));
