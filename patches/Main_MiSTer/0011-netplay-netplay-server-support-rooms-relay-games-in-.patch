 // ---------------------------------------------------------------------------
 // Main-thread side
 
+// ---------------------------------------------------------------------------
+// Games from the server: its roms folder is copied into a RAM folder (tmpfs)
+// inside the NES games folder, "_Netplay server", so the OSD file browser shows
+// them and nothing is written to the SD card. Its catalog (versions everyone
+// brings themselves) is kept in memory to warn about a different version.
+
+static std::string        srv_dir;            // the RAM folder
+static bool               srv_mounted = false;
+static pthread_t          dl_thread;
+static bool               dl_running = false;
+static std::atomic<bool>  dl_quit { false };
+static std::mutex         cat_mtx;
+static std::map<std::string, std::string> catalog;   // md5 hex -> name
+
+static std::string url_enc(const char *in)
+{
+	std::string out;
+	for (const unsigned char *p = (const unsigned char *)in; *p; p++)
+	{
+		if (isalnum(*p) || strchr("-_.~", *p)) out += (char)*p;
+		else { char h[4]; snprintf(h, sizeof(h), "%%%02X", *p); out += h; }
+	}
+	return out;
+}
+
+static std::string md5_hex(const uint8_t *d)
+{
+	char h[33];
+	for (int i = 0; i < 16; i++) snprintf(h + 2 * i, 3, "%02x", d[i]);
+	return h;
+}
+
+// Blocking HTTP/1.0 GET to the server's TCP port; 5 s timeouts. Body in *out.
+static bool http_get(const std::string &path, std::string *out, size_t limit)
+{
+	char h[128];
+	uint16_t port;
+	split_hostport(cfg.server, cfg.port, h, sizeof(h), &port);
+	addrinfo hints {}, *res = nullptr;
+	hints.ai_family = AF_INET;
+	hints.ai_socktype = SOCK_STREAM;
+	char ps[8];
+	snprintf(ps, sizeof(ps), "%u", port);
+	if (getaddrinfo(h, ps, &hints, &res) || !res) return false;
+	int fd = socket(AF_INET, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+	bool ok = fd >= 0;
+	if (ok && connect(fd, res->ai_addr, res->ai_addrlen) < 0)
+	{
+		pollfd pf { fd, POLLOUT, 0 };
+		int err = 0;
+		socklen_t el = sizeof(err);
+		ok = errno == EINPROGRESS && poll(&pf, 1, 5000) == 1
+		  && !getsockopt(fd, SOL_SOCKET, SO_ERROR, &err, &el) && !err;
+	}
+	freeaddrinfo(res);
+	if (!ok) { if (fd >= 0) close(fd); return false; }
+	fcntl(fd, F_SETFL, fcntl(fd, F_GETFL) & ~O_NONBLOCK);
+	timeval tv { 5, 0 };
+	setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+	setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+
+	std::string req = "GET " + path + " HTTP/1.0\r\nHost: " + h + "\r\nConnection: close\r\n\r\n";
+	std::string resp;
+	ok = ::send(fd, req.data(), req.size(), MSG_NOSIGNAL) == (ssize_t)req.size();
+	char buf[4096];
+	while (ok && !dl_quit)
+	{
+		ssize_t n = ::recv(fd, buf, sizeof(buf), 0);
+		if (n == 0) break;
+		if (n < 0 || resp.size() + n > limit + 4096) { ok = false; break; }
+		resp.append(buf, n);
+	}
+	close(fd);
+	size_t body = resp.find("\r\n\r\n");
+	if (!ok || dl_quit || body == std::string::npos || (resp.compare(0, 12, "HTTP/1.1 200") && resp.compare(0, 12, "HTTP/1.0 200")))
+		return false;
+	*out = resp.substr(body + 4);
+	return true;
+}
+
+// "md5 rest" lines
+static void for_lines(const std::string &text, void (*fn)(const std::string &md5, const std::string &rest, void *), void *arg)
+{
+	size_t pos = 0;
+	while (pos < text.size())
+	{
+		size_t end = text.find('\n', pos);
+		if (end == std::string::npos) end = text.size();
+		std::string line = text.substr(pos, end - pos);
+		pos = end + 1;
+		size_t sp = line.find(' ');
+		if (sp == 32) fn(line.substr(0, 32), line.substr(33), arg);
+	}
+}
+
+static void *download_thread(void *)
+{
+	std::string key = "key=" + url_enc(cfg.key[0] ? cfg.key : "-");
+	int got = 0, offered = 0;
+	std::string list;
+	if (srv_mounted && http_get("/roms?" + key, &list, 1 << 20))
+	{
+		struct Ctx { int *got, *offered; const std::string *key; } ctx { &got, &offered, &key };
+		for_lines(list, [](const std::string &md5, const std::string &rest, void *a) {
+			Ctx *c = (Ctx *)a;
+			if (dl_quit) return;
+			size_t sp = rest.find(' ');                   // "size name"
+			if (sp == std::string::npos) return;
+			std::string name = rest.substr(sp + 1);
+			unsigned long size = strtoul(rest.c_str(), nullptr, 10);
+			if (name.empty() || name[0] == '.' || name.find('/') != std::string::npos || size > (4u << 20)) return;
+			(*c->offered)++;
+			std::string data;
+			if (!http_get("/rom?" + *c->key + "&name=" + url_enc(name.c_str()), &data, 4u << 20)) return;
+			MD5Context m;
+			uint8_t d[16];
+			MD5Init(&m);
+			MD5Update(&m, (const unsigned char *)data.data(), (unsigned)data.size());
+			MD5Final(d, &m);
+			if (md5_hex(d) != md5) return;
+			std::string path = srv_dir + "/" + name;
+			FILE *f = fopen(path.c_str(), "wb");
+			if (!f) return;
+			bool w = fwrite(data.data(), 1, data.size(), f) == data.size();
+			fclose(f);
+			if (!w) { unlink(path.c_str()); return; }
+			(*c->got)++;
+			std::lock_guard<std::mutex> g(cat_mtx);
+			catalog[md5] = name;
+		}, &ctx);
+	}
+
+	std::string cat;
+	if (!dl_quit && http_get("/catalog?" + key, &cat, 1 << 20))
+		for_lines(cat, [](const std::string &md5, const std::string &rest, void *) {
+			std::lock_guard<std::mutex> g(cat_mtx);
+			catalog[md5] = rest;
+		}, nullptr);
+
+	if (dl_quit) return nullptr;
+	char text[96];
+	if (offered && got < offered) snprintf(text, sizeof(text), "Netplay: %d of %d server games loaded", got, offered);
+	else if (got) snprintf(text, sizeof(text), "Netplay: %d games in _Netplay server", got);
+	else if (list.empty() && cat.empty()) snprintf(text, sizeof(text), "Netplay: no answer from server (check server=, key=)");
+	else return nullptr;
+	post_message(text);
+	return nullptr;
+}
+
+// Main thread, at core load.
+static void server_games_start()
+{
+	srv_dir = std::string(getFullPath(user_io_get_core_path(nullptr, 0))) + "/_Netplay server";
+	mkdir(srv_dir.c_str(), 0755);
+	umount2(srv_dir.c_str(), MNT_DETACH);         // a RAM folder left over from a crash
+	srv_mounted = !mount("tmpfs", srv_dir.c_str(), "tmpfs", MS_NOSUID | MS_NODEV | MS_NOEXEC, "size=48m,mode=0755");
+	if (!srv_mounted) post_message("Netplay: no RAM folder for server games");
+	{
+		std::lock_guard<std::mutex> g(cat_mtx);
+		catalog.clear();
+	}
+	dl_quit = false;
+	dl_running = pthread_create(&dl_thread, nullptr, download_thread, nullptr) == 0;
+}
+
+static void server_games_stop()
+{
+	dl_quit = true;
+	if (dl_running) pthread_join(dl_thread, nullptr);
+	dl_running = false;
+	if (srv_mounted) umount2(srv_dir.c_str(), MNT_DETACH);   // the games are gone with it
+	srv_mounted = false;
+}
+
 static bool is_nes_core()
 {
 	return !strcasecmp(user_io_get_core_name(), "NES");
@@ -405,6 +696,12 @@ void netplay_note_file(const char *name, unsigned char index, char opensave)
 	LocalInfo li {};
 	uint8_t hdr[16] = {};
 	if (!md5_file(name, li.rom_md5, hdr, sizeof(hdr))) return;
+	if (cfg.server[0])
+	{
+		std::lock_guard<std::mutex> g(cat_mtx);
+		if (!catalog.empty() && !catalog.count(md5_hex(li.rom_md5)))
+			post_message("Netplay: not the server's version of this game");
+	}
 	const char *dot = strrchr(name, '.');
 	li.rom_region = rom_region_from_header(hdr, sizeof(hdr), dot ? dot + 1 : "");
 	core_build(li.core_build);
@@ -455,11 +752,13 @@ void netplay_start(void)
 	cfg = Config();
 	load_config(&cfg);
 	nes_armed = true;
+	if (cfg.server[0]) server_games_start();
 }
 
 void netplay_stop(void)
 {
 	nes_armed = false;
+	server_games_stop();
 	if (!thread_running) return;
 	quit = true;
 	pthread_join(thread, nullptr);
