+	// Through a netplay-server: both sides send only to the server, which pairs
+	// host and join of a room and relays the session packets unchanged.
+	bool open_server(const char *server, uint16_t def_port, const char *key, const char *room, bool host)
+	{
+		fd_ = socket(AF_INET, SOCK_DGRAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+		if (fd_ < 0) return false;
+		sockaddr_in a {};
+		a.sin_family = AF_INET;
+		a.sin_addr.s_addr = htonl(INADDR_ANY);
+		if (bind(fd_, (sockaddr *)&a, sizeof(a)) < 0) return false;
+
+		char h[128];
+		uint16_t port;
+		split_hostport(server, def_port, h, sizeof(h), &port);
+		addrinfo hints {}, *res = nullptr;
+		hints.ai_family = AF_INET;
+		hints.ai_socktype = SOCK_DGRAM;
+		char ps[8];
+		snprintf(ps, sizeof(ps), "%u", port);
+		if (getaddrinfo(h, ps, &hints, &res) || !res) return false;
+		memcpy(&peer_, res->ai_addr, sizeof(peer_));
+		freeaddrinfo(res);
+		have_peer_ = locked_ = server_ = true;
+		snprintf(room_, sizeof(room_), "%s", room);
+		snprintf(reg_, sizeof(reg_), "NPS1 REG %s %s %s", *key ? key : "-", room, host ? "host" : "join");
+		register_now();
+		return true;
+	}
+
+	// A message for the OSD, once per change (server replies)
+	const char *take_notice()
+	{
+		if (notice_seq_ == notice_shown_) return nullptr;
+		notice_shown_ = notice_seq_;
+		return notice_;
+	}
+
 	~Udp() override { if (fd_ >= 0) close(fd_); }
 
