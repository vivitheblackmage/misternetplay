+// "host:port" or "host" -> host, port
+static void split_hostport(const char *in, uint16_t def, char *host, size_t cap, uint16_t *port)
+{
+	snprintf(host, cap, "%s", in);
+	*port = def;
+	char *c = strrchr(host, ':');
+	if (c) { *c = 0; *port = (uint16_t)strtoul(c + 1, nullptr, 10); if (!*port) *port = def; }
+}
