+static void make_rom(const char *path)            // same bytes on both sides
+{
+	FILE *f = fopen(path, "wb");
+	uint8_t hdr[16] = {'N', 'E', 'S', 0x1A, 2, 1};
+	fwrite(hdr, 16, 1, f);
+	for (int i = 0; i < 40960; i++) fputc((i * 7) & 0xFF, f);
+	fclose(f);
+}
+
 int main(int argc, char **argv)
