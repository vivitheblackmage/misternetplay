@@ -133,12 +190,21 @@ public:
 
 	int recv(uint8_t *buf, size_t cap) override
 	{
+		// registration until the server answers, then a keepalive for the room
+		// and the NAT mapping
+		if (server_ && now_ms() - t_reg_ >= (registered_ ? 3000u : 1000u)) register_now();
 		for (;;)
 		{
 			sockaddr_in from {};
 			socklen_t fl = sizeof(from);
 			ssize_t n = recvfrom(fd_, buf, cap, MSG_DONTWAIT, (sockaddr *)&from, &fl);
 			if (n < 0) return -1;
+			if (server_ && n >= 5 && !memcmp(buf, "NPS1 ", 5))
+			{
+				if (from.sin_addr.s_addr == peer_.sin_addr.s_addr && from.sin_port == peer_.sin_port)
+					server_reply((const char *)buf, (size_t)n);
+				continue;
+			}
 			if (locked_)
 			{
 				// ignore everyone but the peer once a session is agreed
@@ -156,9 +222,49 @@ public:
 	void lock_peer() override { if (have_peer_) locked_ = true; }
 
 private:
+	static uint64_t now_ms()
+	{
+		timespec ts;
+		clock_gettime(CLOCK_MONOTONIC, &ts);
+		return (uint64_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+	}
+
+	void register_now()
+	{
+		t_reg_ = now_ms();
+		sendto(fd_, reg_, strlen(reg_), 0, (sockaddr *)&peer_, sizeof(peer_));
+	}
+
+	void server_reply(const char *b, size_t n)
+	{
+		char r[96];
+		snprintf(r, sizeof(r), "%.*s", (int)(n < sizeof(r) - 1 ? n : sizeof(r) - 1), b);
+		char text[96];
+		if (!strncmp(r, "NPS1 OK", 7))
+		{
+			if (registered_) return;
+			registered_ = true;
+			snprintf(text, sizeof(text), "Netplay: server, room %s", room_);
+		}
+		else if (!strncmp(r, "NPS1 ERR ", 9))
+		{
+			registered_ = false;
+			snprintf(text, sizeof(text), "Netplay: server: %.70s", r + 9);
+		}
+		else return;
+		if (!strcmp(text, notice_)) return;
+		snprintf(notice_, sizeof(notice_), "%s", text);
+		notice_seq_++;
+	}
+
 	int fd_ = -1;
 	sockaddr_in peer_ {};
 	bool have_peer_ = false, locked_ = false;
+	bool server_ = false, registered_ = false;
+	uint64_t t_reg_ = 0;
+	char reg_[200] = {}, room_[64] = {};
+	char notice_[96] = {};
+	uint32_t notice_seq_ = 0, notice_shown_ = 0;
 };
 
