--- /dev/null
+++ b/support/netplay/netplay_proto.cpp
@@ -0,0 +1,229 @@
+// netplay_proto.cpp — see netplay_proto.h
+
+#include <string.h>
+#include <strings.h>
+#include "netplay_proto.h"
+
+namespace netplay {
+
+// ---------------------------------------------------------------------------
+// Mailbox
+
+bool decode_local(uint64_t w, uint32_t frame, uint8_t session, uint8_t *joy)
+{
+	uint32_t hi = (uint32_t)(w >> 32), lo = (uint32_t)w;
+	uint32_t tag = (frame & 0xFFFF) << 16 | (uint32_t)session << 8;
+	if ((hi & 0xFFFFFF00) != tag || (lo & 0xFFFFFF00) != tag) return false;
+	if ((hi & 0xFF) != (lo & 0xFF)) return false;
+	*joy = (uint8_t)lo;
+	return true;
+}
+
+bool decode_crc(uint64_t w, uint32_t frame, uint32_t *crc)
+{
+	uint32_t hi = (uint32_t)(w >> 32), lo = (uint32_t)w;
+	uint32_t tag = frame & 0xFFFF;
+	if ((hi >> 16) != tag || (lo >> 16) != tag) return false;
+	*crc = (hi & 0xFFFF) << 16 | (lo & 0xFFFF);
+	return true;
+}
+
+Status decode_status(uint64_t w)
+{
+	Status s;
+	s.frame  = (uint32_t)(w >> 32);
+	s.state  = (uint8_t)((w >> 24) & 0x07);
+	s.error  = (uint8_t)(w >> 16);
+	s.stalls = (uint16_t)w;
+	return s;
+}
+
+// ---------------------------------------------------------------------------
+// Settings
+
+uint32_t pack_settings(const Settings &s)
+{
+	return (uint32_t)(s.sys_type & 7)
+	     | (uint32_t)(s.ram_clear & 3) << 3
+	     | (uint32_t)(s.ppu_reset & 1) << 5
+	     | (uint32_t)(s.extra_spr & 1) << 6
+	     | (uint32_t)(s.mask_edges & 3) << 7
+	     | (uint32_t)(s.overscan & 3) << 9
+	     | (uint32_t)(s.cheats_off & 1) << 11;
+}
+
+const char *reject_text(uint8_t r)
+{
+	switch (r)
+	{
+	case REJ_OK:        return "OK";
+	case REJ_PROTOCOL:  return "Different netplay version";
+	case REJ_CORE:      return "Different NES core build";
+	case REJ_ROM:       return "Different ROM file";
+	case REJ_SAV:       return "Different save (.sav) file";
+	case REJ_SETTINGS:  return "Different core settings";
+	case REJ_RAM_CLEAR: return "Set RAM Clear to $00 or $FF";
+	case REJ_CHEATS:    return "Turn cheats off";
+	case REJ_SYSTEM:    return "Only NTSC/PAL cartridges";
+	case REJ_DELAY:     return "Delay must be 2-15";
+	case REJ_BUSY:      return "Host is busy";
+	default:          return "Rejected";
+	}
+}
+
+uint8_t check_local(const Settings &s, uint8_t rom_region, uint8_t delay)
+{
+	if (delay < 2 || delay > 15) return REJ_DELAY;
+	if (s.ram_clear != 1 && s.ram_clear != 2) return REJ_RAM_CLEAR;
+	if (!s.cheats_off) return REJ_CHEATS;
+	// System Type: 0 Auto, 1 NTSC, 2 PAL, 3 Dendy, 4 Vs.
+	if (s.sys_type == 3 || s.sys_type >= 4) return REJ_SYSTEM;
+	if (s.sys_type == 0 && rom_region >= 2) return REJ_SYSTEM;
+	return REJ_OK;
+}
+
+uint8_t rom_region_from_header(const uint8_t *hdr, size_t len, const char *ext)
+{
+	if (ext && (!strcasecmp(ext, "fds") || !strcasecmp(ext, "nsf"))) return 3;
+	if (len < 16 || memcmp(hdr, "NES\x1A", 4)) return 3;
+
+	bool nes2 = (hdr[7] & 0x0C) == 0x08;
+	uint8_t console = hdr[7] & 0x03;            // 1 = Vs. System, 2 = PlayChoice
+	if (console == 1) return 3;
+	if (!nes2) return 0;                        // iNES 1.0: core assumes NTSC
+	switch (hdr[12] & 0x03)
+	{
+	case 0:  return 0;                          // NTSC
+	case 1:  return 1;                          // PAL
+	default: return 2;                          // multi-region / Dendy
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Packets
+
+namespace {
+
+struct Writer
+{
+	uint8_t *p; size_t cap, n; bool ok;
+	void u8(uint8_t v)   { if (n + 1 > cap) { ok = false; return; } p[n++] = v; }
+	void u16(uint16_t v) { u8((uint8_t)v); u8((uint8_t)(v >> 8)); }
+	void u32(uint32_t v) { u16((uint16_t)v); u16((uint16_t)(v >> 16)); }
+	void raw(const uint8_t *s, size_t l) { for (size_t i = 0; i < l; i++) u8(s[i]); }
+};
+
+struct Reader
+{
+	const uint8_t *p; size_t len, n; bool ok;
+	uint8_t u8()   { if (n + 1 > len) { ok = false; return 0; } return p[n++]; }
+	uint16_t u16() { uint16_t a = u8(); return (uint16_t)(a | u8() << 8); }
+	uint32_t u32() { uint32_t a = u16(); return a | (uint32_t)u16() << 16; }
+	void raw(uint8_t *d, size_t l) { for (size_t i = 0; i < l; i++) d[i] = u8(); }
+};
+
+} // namespace
+
+size_t encode(const Packet &p, uint8_t *buf, size_t cap)
+{
+	Writer w{buf, cap, 0, true};
+	w.u32(PKT_MAGIC);
+	w.u8(p.type);
+	w.u8(p.session);
+
+	switch (p.type)
+	{
+	case P_HELLO:
+	case P_HELLO_ACK:
+		w.u8(p.hello.version);
+		w.raw(p.hello.core_build, 16);
+		w.raw(p.hello.rom_md5, 16);
+		w.raw(p.hello.sav_md5, 16);
+		w.u32(p.hello.settings);
+		w.u8(p.hello.delay);
+		if (p.type == P_HELLO_ACK)
+		{
+			w.u8(p.hello.accept);
+			w.u8(p.hello.reason);
+		}
+		break;
+
+	case P_START:
+		break;
+
+	case P_INPUT:
+		if (p.input.count == 0 || p.input.count > MAX_HISTORY) return 0;
+		w.u32(p.input.first_frame);
+		w.u8(p.input.count);
+		w.raw(p.input.joy, p.input.count);
+		break;
+
+	case P_CRC:
+		w.u32(p.crc.frame);
+		w.u32(p.crc.crc);
+		break;
+
+	case P_BYE:
+		w.u8(p.reason);
+		break;
+
+	default:
+		return 0;
+	}
+
+	return w.ok ? w.n : 0;
+}
+
+bool decode(const uint8_t *buf, size_t len, Packet *p)
+{
+	Reader r{buf, len, 0, true};
+	memset(p, 0, sizeof(*p));
+	if (r.u32() != PKT_MAGIC || !r.ok) return false;
+	p->type = r.u8();
+	p->session = r.u8();
+
+	switch (p->type)
+	{
+	case P_HELLO:
+	case P_HELLO_ACK:
+		p->hello.version = r.u8();
+		r.raw(p->hello.core_build, 16);
+		r.raw(p->hello.rom_md5, 16);
+		r.raw(p->hello.sav_md5, 16);
+		p->hello.settings = r.u32();
+		p->hello.delay = r.u8();
+		if (p->type == P_HELLO_ACK)
+		{
+			p->hello.accept = r.u8();
+			p->hello.reason = r.u8();
+		}
+		break;
+
+	case P_START:
+		break;
+
+	case P_INPUT:
+		p->input.first_frame = r.u32();
+		p->input.count = r.u8();
+		if (!r.ok || p->input.count == 0 || p->input.count > MAX_HISTORY) return false;
+		r.raw(p->input.joy, p->input.count);
+		break;
+
+	case P_CRC:
+		p->crc.frame = r.u32();
+		p->crc.crc = r.u32();
+		break;
+
+	case P_BYE:
+		p->reason = r.u8();
+		break;
+
+	default:
+		return false;
+	}
+
+	// trailing bytes mean a different layout: reject rather than guess
+	return r.ok && r.n == len;
+}
+
+} // namespace netplay
diff --git a/support/netplay/netplay_proto.h b/support/netplay/netplay_proto.h
new file mode 100644
index 0000000..c8a22ff
--- /dev/null
+++ b/support/netplay/netplay_proto.h
@@ -0,0 +1,158 @@
+// netplay_proto.h — NES netplay: wire format and mailbox layout (SPEC.md 4, 7)
+//
+// Pure data handling with no I/O, so it builds and is unit tested on x86.
+
+#ifndef NETPLAY_PROTO_H
+#define NETPLAY_PROTO_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+namespace netplay {
+
+// ---------------------------------------------------------------------------
+// DDR3 mailbox, shared with rtl/netplay.sv
+
+constexpr uint32_t MB_PHYS       = 0x3C000000;
+constexpr uint32_t MB_SIZE       = 0x4000;
+
+constexpr uint32_t MB_MAGIC      = 0x0000;
+constexpr uint32_t MB_STATUS     = 0x0008;
+constexpr uint32_t MB_CTRL       = 0x0010;
+constexpr uint32_t MB_LOCAL      = 0x1000;
+constexpr uint32_t MB_CRC        = 0x1800;
+constexpr uint32_t MB_INPUT      = 0x2000;
+constexpr uint32_t MB_RING       = 256;
+
+constexpr uint64_t MAGIC_VALUE   = 0x313030504E53454EULL;   // "NESNP001"
+
+enum FpgaState : uint8_t { FS_IDLE = 0, FS_ARMED = 1, FS_PRIME = 2, FS_RUN = 3, FS_ERROR = 4 };
+enum FpgaError : uint8_t { FE_UNDERRUN = 1, FE_CTRL_DROP = 2, FE_RELOAD = 4 };
+
+struct Status
+{
+	uint32_t frame;
+	uint8_t  state;
+	uint8_t  error;
+	uint16_t stalls;
+};
+
+inline uint32_t ring_off(uint32_t base, uint32_t frame) { return base + (frame & (MB_RING - 1)) * 8; }
+
+inline uint64_t ctrl_word(bool enable, bool run, uint8_t session)
+{
+	return (uint64_t)session << 8 | (run ? 2u : 0u) | (enable ? 1u : 0u);
+}
+
+// INPUT[f]: both 32-bit halves carry the frame tag and session, so a torn
+// 64-bit store is never mistaken for a valid entry.
+inline uint64_t input_word(uint32_t frame, uint8_t session, uint8_t p1, uint8_t p2)
+{
+	uint32_t tag = (uint32_t)(frame & 0xFFFF) << 16 | (uint32_t)session << 8;
+	return (uint64_t)(tag | p2) << 32 | (tag | p1);
+}
+
+// Words that can never decode as valid: tags in the two halves differ.
+constexpr uint64_t INVALID_WORD  = 0xFFFF000000000000ULL;
+
+bool decode_local(uint64_t w, uint32_t frame, uint8_t session, uint8_t *joy);
+bool decode_crc(uint64_t w, uint32_t frame, uint32_t *crc);
+Status decode_status(uint64_t w);
+
+// ---------------------------------------------------------------------------
+// OSD settings that change emulation, packed for the handshake (SPEC.md 8)
+
+struct Settings
+{
+	uint8_t sys_type;      // status [72:70]
+	uint8_t ram_clear;     // status [66:65]
+	uint8_t ppu_reset;     // status [64]
+	uint8_t extra_spr;     // status [25]
+	uint8_t mask_edges;    // status [28:27]
+	uint8_t overscan;      // status [68:67]
+	uint8_t cheats_off;    // status [20], 1 = off
+};
+
+uint32_t pack_settings(const Settings &s);
+
+// Why a session cannot start, or 0 if it can. Same codes go into HELLO_ACK.
+enum Reject : uint8_t
+{
+	REJ_OK = 0,
+	REJ_PROTOCOL,      // different protocol version
+	REJ_CORE,          // different core build
+	REJ_ROM,           // different ROM
+	REJ_SAV,           // different battery save
+	REJ_SETTINGS,      // different OSD settings
+	REJ_RAM_CLEAR,     // RAM Clear must be $00 or $FF
+	REJ_CHEATS,        // cheats must be off
+	REJ_SYSTEM,        // Dendy, Vs. System, FDS and NSF are not supported in v1
+	REJ_DELAY,         // delay outside 2..15
+	REJ_BUSY,          // host already has a peer
+};
+
+const char *reject_text(uint8_t r);
+
+// Checks one side can take part at all (independent of the peer).
+uint8_t check_local(const Settings &s, uint8_t rom_region, uint8_t delay);
+
+// rom_region from the iNES header: 0 NTSC, 1 PAL, 2 Dendy/multi, 3 Vs. or not iNES.
+uint8_t rom_region_from_header(const uint8_t *hdr, size_t len, const char *ext);
+
+// ---------------------------------------------------------------------------
+// UDP packets (all little endian)
+
+constexpr uint32_t PKT_MAGIC     = 0x31504E4E;   // "NNP1"
+constexpr uint8_t  PROTO_VERSION = 1;
+constexpr int      MAX_HISTORY   = 16;            // inputs per INPUT packet
+constexpr int      MAX_PACKET    = 128;
+
+enum PacketType : uint8_t { P_HELLO = 1, P_HELLO_ACK = 2, P_START = 3, P_INPUT = 4, P_CRC = 5, P_BYE = 6 };
+
+struct Hello
+{
+	uint8_t  version;
+	uint8_t  core_build[16];
+	uint8_t  rom_md5[16];
+	uint8_t  sav_md5[16];
+	uint32_t settings;
+	uint8_t  delay;
+	uint8_t  accept;       // ACK only
+	uint8_t  reason;       // ACK only
+};
+
+struct InputRun
+{
+	uint32_t first_frame;
+	uint8_t  count;
+	uint8_t  joy[MAX_HISTORY];
+};
+
+struct CrcReport
+{
+	uint32_t frame;
+	uint32_t crc;
+};
+
+struct Packet
+{
+	uint8_t type;
+	uint8_t session;
+	union
+	{
+		Hello     hello;      // HELLO, HELLO_ACK
+		InputRun  input;      // INPUT
+		CrcReport crc;        // CRC
+		uint8_t   reason;     // BYE
+	};
+};
+
+// Returns the encoded length, or 0 if the packet does not fit.
+size_t encode(const Packet &p, uint8_t *buf, size_t cap);
+
+// Returns false for anything malformed; never reads past len.
+bool decode(const uint8_t *buf, size_t len, Packet *p);
+
+} // namespace netplay
+
+#endif
diff --git a/support/netplay/netplay_session.cpp b/support/netplay/netplay_session.cpp
new file mode 100644
index 0000000..57f56c3
--- /dev/null
+++ b/support/netplay/netplay_session.cpp
@@ -0,0 +1,455 @@
+// netplay_session.cpp — see netplay_session.h and SPEC.md
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+#include "netplay_session.h"
+
+namespace netplay {
+
+Session::Session(Mode mode, uint8_t delay, Mailbox mb, Transport *net, Recording *rec,
+                 uint8_t session_seed, Timing t)
+	: mode_(mode), delay_(delay), mb_(mb), net_(net), rec_(rec), t_(t), seed_(session_seed)
+{
+	local_.assign(WIN, Slot8{0, 0, false});
+	remote_.assign(WIN, Slot8{0, 0, false});
+	my_crc_.assign(WIN, Slot32{0, 0, false});
+	peer_crc_.assign(WIN, Slot32{0, 0, false});
+}
+
+void Session::set_local(const LocalInfo &info)
+{
+	info_ = info;
+	have_info_ = true;
+}
+
+// ---------------------------------------------------------------------------
+// Messages and endings
+
+void Session::say(const char *fmt, ...)
+{
+	va_list ap;
+	va_start(ap, fmt);
+	vsnprintf(msg_, sizeof(msg_), fmt, ap);
+	va_end(ap);
+	msg_seq_++;
+}
+
+void Session::fail(uint64_t now, uint8_t bye_reason, const char *fmt, ...)
+{
+	(void)now;
+	va_list ap;
+	va_start(ap, fmt);
+	vsnprintf(msg_, sizeof(msg_), fmt, ap);
+	va_end(ap);
+	msg_seq_++;
+
+	if (phase_ >= PH_ARM) mb_.wr(MB_CTRL, ctrl_word(false, false, sess_));
+	if (net_ && phase_ >= PH_HANDSHAKE)
+	{
+		Packet p {};
+		p.type = P_BYE;
+		p.session = sess_;
+		p.reason = bye_reason;
+		send(p);
+	}
+	failed_ = true;
+	reload_req_ = false;
+	phase_ = PH_DONE;
+}
+
+void Session::finish_ok(uint64_t now, const char *text)
+{
+	(void)now;
+	mb_.wr(MB_CTRL, ctrl_word(false, false, sess_));
+	say("%s", text);
+	phase_ = PH_DONE;
+}
+
+void Session::stop(uint64_t now, const char *why)
+{
+	if (phase_ == PH_DONE) return;
+	fail(now, 0, "%s", why);
+	failed_ = false;   // a requested stop is not an error
+}
+
+// ---------------------------------------------------------------------------
+// Network helpers
+
+void Session::send(const Packet &p)
+{
+	uint8_t buf[MAX_PACKET];
+	size_t n = encode(p, buf, sizeof(buf));
+	if (n && net_) net_->send(buf, n);
+}
+
+void Session::send_hello(uint8_t type, uint8_t accept, uint8_t reason)
+{
+	Packet p {};
+	p.type = type;
+	p.session = sess_;
+	p.hello.version = PROTO_VERSION;
+	memcpy(p.hello.core_build, info_.core_build, 16);
+	memcpy(p.hello.rom_md5, info_.rom_md5, 16);
+	memcpy(p.hello.sav_md5, info_.sav_md5, 16);
+	p.hello.settings = pack_settings(info_.settings);
+	p.hello.delay = delay_;
+	p.hello.accept = accept;
+	p.hello.reason = reason;
+	send(p);
+}
+
+uint8_t Session::compare_peer(const Hello &h) const
+{
+	if (h.version != PROTO_VERSION) return REJ_PROTOCOL;
+	if (memcmp(h.core_build, info_.core_build, 16)) return REJ_CORE;
+	if (memcmp(h.rom_md5, info_.rom_md5, 16)) return REJ_ROM;
+	if (memcmp(h.sav_md5, info_.sav_md5, 16)) return REJ_SAV;
+	if (h.settings != pack_settings(info_.settings)) return REJ_SETTINGS;
+	return REJ_OK;
+}
+
+// ---------------------------------------------------------------------------
+
+void Session::step(uint64_t now)
+{
+	// Drain the socket first: handshake and run both depend on it.
+	if (net_ && phase_ != PH_DONE && phase_ != PH_WAIT_CORE)
+	{
+		uint8_t buf[MAX_PACKET];
+		Packet p;
+		int n;
+		while (phase_ != PH_DONE && (n = net_->recv(buf, sizeof(buf))) >= 0)
+			if (decode(buf, (size_t)n, &p)) handle_packet(now, p);
+	}
+
+	switch (phase_)
+	{
+	case PH_WAIT_CORE:
+		if (!have_info_ || mb_.rd(MB_MAGIC) != MAGIC_VALUE) break;
+		{
+			uint8_t r = check_local(info_.settings, info_.rom_region, delay_);
+			if (r != REJ_OK)
+			{
+				// nothing armed yet: no BYE, no CTRL write
+				say("Netplay: %s", reject_text(r));
+				failed_ = true;
+				phase_ = PH_DONE;
+				break;
+			}
+		}
+		t_phase_ = now;
+		if (mode_ == M_HOST || mode_ == M_JOIN)
+		{
+			phase_ = PH_HANDSHAKE;
+			sess_ = 0;
+			say(mode_ == M_HOST ? "Netplay: waiting for player 2" : "Netplay: connecting to host");
+		}
+		else
+		{
+			sess_ = seed_ ? seed_ : 1;
+			arm(now);
+		}
+		break;
+
+	case PH_HANDSHAKE:
+		if (mode_ == M_JOIN && now - t_hello_ >= t_.hello_ms)
+		{
+			t_hello_ = now;
+			send_hello(P_HELLO, 0, 0);
+		}
+		break;
+
+	case PH_ARM:
+		if (decode_status(mb_.rd(MB_STATUS)).state == FS_ARMED)
+		{
+			reload_req_ = true;
+			phase_ = PH_RELOAD;
+			t_phase_ = now;
+			say("Netplay: loading ROM");
+		}
+		else if (now - t_phase_ > t_.arm_ms)
+		{
+			fail(now, 0, "Netplay: core did not respond");
+		}
+		break;
+
+	case PH_RELOAD:
+		break;   // reload_done() moves on
+
+	case PH_SETTLE:
+		if (now - t_phase_ < t_.settle_ms) break;
+		for (uint32_t f = 0; f < delay_; f++)
+			mb_.wr(ring_off(MB_INPUT, f), input_word(f, sess_, 0, 0));
+		input_next_ = delay_;
+		if (mode_ == M_HOST || mode_ == M_JOIN)
+		{
+			phase_ = PH_READY;
+			t_start_ = 0;
+			t_rx_ = now;
+			say("Netplay: waiting for other player");
+		}
+		else start_run(now);
+		break;
+
+	case PH_READY:
+		if (now - t_start_ >= t_.start_ms)
+		{
+			t_start_ = now;
+			Packet p {};
+			p.type = P_START;
+			p.session = sess_;
+			send(p);
+		}
+		if (peer_started_) start_run(now);
+		else if (now - t_rx_ > 30000) fail(now, 0, "Netplay: other player did not start");
+		break;
+
+	case PH_RUN:
+		run(now);
+		break;
+
+	case PH_DONE:
+		break;
+	}
+}
+
+void Session::handle_packet(uint64_t now, const Packet &p)
+{
+	// Before a session id is agreed only HELLO/HELLO_ACK make sense.
+	if (phase_ == PH_HANDSHAKE)
+	{
+		if (mode_ == M_HOST && p.type == P_HELLO)
+		{
+			uint8_t r = compare_peer(p.hello);
+			if (r == REJ_OK && (p.hello.delay < 2 || p.hello.delay > 15)) r = REJ_DELAY;
+			if (r != REJ_OK)
+			{
+				send_hello(P_HELLO_ACK, 0, r);
+				say("Netplay: player 2 rejected: %s", reject_text(r));
+				return;
+			}
+			net_->lock_peer();
+			sess_ = (uint8_t)(seed_ ? seed_ : 1);
+			send_hello(P_HELLO_ACK, 1, REJ_OK);
+			t_rx_ = now;
+			arm(now);
+		}
+		else if (mode_ == M_JOIN && p.type == P_HELLO_ACK)
+		{
+			if (!p.hello.accept)
+			{
+				fail(now, 0, "Netplay: host refused: %s", reject_text(p.hello.reason));
+				return;
+			}
+			uint8_t r = compare_peer(p.hello);
+			if (r != REJ_OK) { fail(now, 0, "Netplay: %s", reject_text(r)); return; }
+			if (p.hello.delay < 2 || p.hello.delay > 15 || p.session == 0) { fail(now, 0, "Netplay: bad reply from host"); return; }
+			net_->lock_peer();
+			sess_ = p.session;
+			delay_ = p.hello.delay;          // the host's delay wins
+			t_rx_ = now;
+			arm(now);
+		}
+		return;
+	}
+
+	// Join missed our ACK and is still saying HELLO (with session 0): repeat
+	// it. The transport is locked to that peer by now.
+	if (p.type == P_HELLO)
+	{
+		if (mode_ == M_HOST && phase_ != PH_DONE) send_hello(P_HELLO_ACK, 1, REJ_OK);
+		return;
+	}
+
+	if (p.session != sess_) return;
+	t_rx_ = now;
+
+	switch (p.type)
+	{
+	case P_START:
+		peer_started_ = true;
+		break;
+
+	case P_INPUT:
+		peer_started_ = true;             // it only sends INPUT once running
+		for (uint32_t i = 0; i < p.input.count; i++)
+		{
+			uint32_t f = p.input.first_frame + i;
+			if (f < remote_next_ || f >= remote_next_ + WIN) continue;
+			Slot8 &s = remote_[f % WIN];
+			s.f = f; s.v = p.input.joy[i]; s.ok = true;
+		}
+		while (remote_[remote_next_ % WIN].ok && remote_[remote_next_ % WIN].f == remote_next_)
+			remote_next_++;
+		break;
+
+	case P_CRC:
+		if (phase_ == PH_RUN) put_crc(peer_crc_.data(), p.crc.frame, p.crc.crc, now);
+		break;
+
+	case P_BYE:
+		if (phase_ != PH_DONE) fail(now, 0, "Netplay: other player left");
+		break;
+
+	default:
+		break;
+	}
+}
+
+void Session::arm(uint64_t now)
+{
+	for (uint32_t i = 0; i < MB_RING; i++)
+	{
+		mb_.wr(MB_LOCAL + i * 8, 0);
+		mb_.wr(MB_CRC + i * 8, 0);
+		mb_.wr(MB_INPUT + i * 8, INVALID_WORD);
+	}
+	mb_.wr(MB_CTRL, ctrl_word(true, false, sess_));
+	phase_ = PH_ARM;
+	t_phase_ = now;
+	say("Netplay: arming core");
+}
+
+void Session::reload_done(uint64_t now)
+{
+	if (phase_ != PH_RELOAD) return;
+	reload_req_ = false;
+	phase_ = PH_SETTLE;
+	t_phase_ = now;
+}
+
+void Session::start_run(uint64_t now)
+{
+	mb_.wr(MB_CTRL, ctrl_word(true, true, sess_));
+	phase_ = PH_RUN;
+	t_rx_ = now;
+	t_input_ = 0;
+	if (mode_ == M_HOST || mode_ == M_JOIN) say("Netplay: playing (delay %u)", delay_);
+	else say(mode_ == M_RECORD ? "Netplay: recording" : "Netplay: replaying");
+}
+
+void Session::put_crc(Slot32 *ring, uint32_t f, uint32_t v, uint64_t now)
+{
+	Slot32 &s = ring[f % WIN];
+	s.f = f; s.v = v; s.ok = true;
+
+	Slot32 *other = (ring == my_crc_.data()) ? peer_crc_.data() : my_crc_.data();
+	Slot32 &o = other[f % WIN];
+	if (o.ok && o.f == f)
+	{
+		if (o.v != v) { fail(now, 1, "Netplay: DESYNC at frame %u", f); return; }
+		crc_checked_++;
+	}
+}
+
+void Session::run(uint64_t now)
+{
+	Status st = decode_status(mb_.rd(MB_STATUS));
+	stalls_ = st.stalls;
+	if (st.state == FS_ERROR)
+	{
+		if (st.error & FE_RELOAD) fail(now, 0, "Netplay: ROM reloaded, session ended");
+		else fail(now, 0, "Netplay: core ran out of input (error %u)", st.error);
+		return;
+	}
+
+	// LOCAL[] from the FPGA
+	bool fresh = false;
+	uint8_t joy;
+	while (decode_local(mb_.rd(ring_off(MB_LOCAL, local_next_)), local_next_, sess_, &joy))
+	{
+		Slot8 &s = local_[local_next_ % WIN];
+		s.f = local_next_; s.v = joy; s.ok = true;
+		if (mode_ == M_RECORD && rec_) rec_->joy.push_back(joy);
+		local_next_++;
+		fresh = true;
+	}
+
+	if (mode_ == M_HOST || mode_ == M_JOIN)
+	{
+		// Every INPUT packet repeats the last few frames, so a lost packet is
+		// covered by the next one. Resend even with nothing new: the peer may
+		// be stalled waiting on exactly the packet that was lost.
+		if (local_next_ && (fresh || now - t_input_ >= t_.resend_ms))
+		{
+			t_input_ = now;
+			Packet p {};
+			p.type = P_INPUT;
+			p.session = sess_;
+			uint32_t n = local_next_ < (uint32_t)MAX_HISTORY ? local_next_ : (uint32_t)MAX_HISTORY;
+			p.input.first_frame = local_next_ - n;
+			p.input.count = (uint8_t)n;
+			for (uint32_t i = 0; i < n; i++) p.input.joy[i] = local_[(p.input.first_frame + i) % WIN].v;
+			send(p);
+		}
+		if (now - t_rx_ > t_.timeout_ms)
+		{
+			fail(now, 2, "Netplay: connection lost");
+			return;
+		}
+	}
+
+	// INPUT[k] = combine(LOCAL[k-D] here, LOCAL[k-D] there)
+	for (;;)
+	{
+		// Paced by the core in every mode: INPUT[k] is written only after the
+		// core has posted LOCAL[k-D], so the 256-entry ring can never overrun.
+		uint32_t src = input_next_ - delay_;
+		if (src >= local_next_) break;
+		uint8_t me, other = 0;
+
+		if (mode_ == M_REPLAY)
+		{
+			if (!rec_ || src >= rec_->joy.size()) break;
+			me = rec_->joy[src];                     // the recording replaces the pad
+		}
+		else me = local_[src % WIN].v;
+
+		if (mode_ == M_HOST || mode_ == M_JOIN)
+		{
+			if (src >= remote_next_) break;
+			other = remote_[src % WIN].v;
+		}
+
+		uint8_t p1 = (mode_ == M_JOIN) ? other : me;
+		uint8_t p2 = (mode_ == M_JOIN) ? me : other;
+		mb_.wr(ring_off(MB_INPUT, input_next_), input_word(input_next_, sess_, p1, p2));
+		input_next_++;
+	}
+
+	// CRC[] from the FPGA
+	uint32_t c;
+	while (phase_ == PH_RUN && decode_crc(mb_.rd(ring_off(MB_CRC, crc_next_)), crc_next_, &c))
+	{
+		uint32_t f = crc_next_++;
+		if (mode_ == M_RECORD && rec_) rec_->crc.push_back(c);
+		else if (mode_ == M_REPLAY && rec_)
+		{
+			if (f < rec_->crc.size())
+			{
+				if (rec_->crc[f] != c) { fail(now, 0, "Netplay: replay DESYNC at frame %u", f); return; }
+				crc_checked_++;
+			}
+		}
+		else
+		{
+			Packet p {};
+			p.type = P_CRC;
+			p.session = sess_;
+			p.crc.frame = f;
+			p.crc.crc = c;
+			send(p);
+			put_crc(my_crc_.data(), f, c, now);
+		}
+	}
+
+	if (mode_ == M_REPLAY && rec_ && phase_ == PH_RUN && crc_next_ >= rec_->crc.size() && crc_next_ > 0)
+	{
+		char text[96];
+		snprintf(text, sizeof(text), "Netplay: replay OK, %u frames match", crc_checked_);
+		finish_ok(now, text);
+	}
+}
+
+} // namespace netplay
diff --git a/support/netplay/netplay_session.h b/support/netplay/netplay_session.h
new file mode 100644
index 0000000..61f9a3e
--- /dev/null
+++ b/support/netplay/netplay_session.h
@@ -0,0 +1,151 @@
+// netplay_session.h — NES netplay session engine (SPEC.md 3, 4, 7)
+//
+// Single-threaded and free of OS calls: the mailbox is a plain pointer and
+// the network sits behind Transport, so the whole engine runs in the x86
+// unit tests against a model of the FPGA side.
+
+#ifndef NETPLAY_SESSION_H
+#define NETPLAY_SESSION_H
+
+#include <stdint.h>
+#include <stddef.h>
+#include <vector>
+#include "netplay_proto.h"
+
+namespace netplay {
+
+struct Mailbox
+{
+	volatile uint8_t *base;
+	uint64_t rd(uint32_t off) const { return *(volatile uint64_t *)(base + off); }
+	void wr(uint32_t off, uint64_t v) const { *(volatile uint64_t *)(base + off) = v; }
+};
+
+class Transport
+{
+public:
+	virtual ~Transport() {}
+	virtual void send(const uint8_t *buf, size_t len) = 0;
+	virtual int  recv(uint8_t *buf, size_t cap) = 0;   // length, or -1 if nothing waiting
+	virtual void lock_peer() = 0;                        // host: talk only to the last sender from now on
+};
+
+enum Mode : uint8_t { M_OFF, M_HOST, M_JOIN, M_RECORD, M_REPLAY };
+
+enum Phase : uint8_t
+{
+	PH_WAIT_CORE,   // waiting for the core's MAGIC and a loaded ROM
+	PH_HANDSHAKE,   // HELLO / HELLO_ACK
+	PH_ARM,         // CTRL.enable written, waiting for the core to hold reset
+	PH_RELOAD,      // main thread is reloading the ROM
+	PH_SETTLE,      // give the .sav time to load
+	PH_READY,       // START exchange
+	PH_RUN,
+	PH_DONE,
+};
+
+struct LocalInfo
+{
+	uint8_t  core_build[16];
+	uint8_t  rom_md5[16];
+	uint8_t  sav_md5[16];
+	Settings settings;
+	uint8_t  rom_region;
+};
+
+// Record/replay data: one controller byte and one CRC per frame.
+struct Recording
+{
+	std::vector<uint8_t>  joy;
+	std::vector<uint32_t> crc;
+};
+
+struct Timing
+{
+	uint32_t hello_ms   = 250;    // join: HELLO resend
+	uint32_t start_ms   = 100;    // START resend
+	uint32_t resend_ms  = 15;     // INPUT resend while nothing new
+	uint32_t timeout_ms = 5000;   // peer silent this long: connection lost
+	uint32_t arm_ms     = 2000;   // core must reach ARMED within this
+	uint32_t settle_ms  = 1000;   // after reload, before START
+};
+
+class Session
+{
+public:
+	Session(Mode mode, uint8_t delay, Mailbox mb, Transport *net, Recording *rec,
+	        uint8_t session_seed, Timing t = Timing());
+
+	// Call once before the first step(); a new ROM load means a new Session.
+	void set_local(const LocalInfo &info);
+
+	void step(uint64_t now_ms);
+	void stop(uint64_t now_ms, const char *why);   // user or core change
+
+	// Main-thread handshake for the ROM reload (SPEC.md "Sessionsstart" 3-4).
+	bool reload_requested() const { return reload_req_; }
+	void reload_done(uint64_t now_ms);
+
+	Phase       phase()   const { return phase_; }
+	bool        failed()  const { return failed_; }
+	const char *message() const { return msg_; }
+	uint32_t    msg_seq() const { return msg_seq_; }
+
+	uint32_t frames()      const { return local_next_; }
+	uint32_t crc_checked() const { return crc_checked_; }
+	uint16_t stalls()      const { return stalls_; }
+	uint8_t  session_id()  const { return sess_; }
+	uint8_t  delay()       const { return delay_; }
+
+private:
+	static constexpr uint32_t WIN = 1024;   // frames of history kept per stream
+
+	struct Slot8  { uint32_t f; uint8_t  v; bool ok; };
+	struct Slot32 { uint32_t f; uint32_t v; bool ok; };
+
+	void say(const char *fmt, ...);
+	void fail(uint64_t now, uint8_t bye_reason, const char *fmt, ...);
+	void finish_ok(uint64_t now, const char *text);
+	void send(const Packet &p);
+	void send_hello(uint8_t type, uint8_t accept, uint8_t reason);
+	uint8_t compare_peer(const Hello &h) const;
+	void handle_packet(uint64_t now, const Packet &p);
+	void arm(uint64_t now);
+	void start_run(uint64_t now);
+	void run(uint64_t now);
+	void put_crc(Slot32 *ring, uint32_t f, uint32_t v, uint64_t now);
+
+	Mode       mode_;
+	uint8_t    delay_;
+	Mailbox    mb_;
+	Transport *net_;
+	Recording *rec_;
+	Timing     t_;
+
+	Phase      phase_ = PH_WAIT_CORE;
+	bool       have_info_ = false;
+	LocalInfo  info_ {};
+	uint8_t    sess_ = 0;
+	uint8_t    seed_;
+	bool       failed_ = false;
+	bool       reload_req_ = false;
+	bool       peer_started_ = false;
+	char       msg_[96] = "Netplay: waiting for core";
+	uint32_t   msg_seq_ = 1;
+
+	uint64_t   t_phase_ = 0, t_hello_ = 0, t_start_ = 0, t_input_ = 0, t_rx_ = 0;
+
+	uint32_t   local_next_ = 0;     // next LOCAL[] frame expected from the FPGA
+	uint32_t   remote_next_ = 0;    // first remote frame not yet received
+	uint32_t   input_next_ = 0;     // next INPUT[] frame to write
+	uint32_t   crc_next_ = 0;       // next CRC[] frame expected from the FPGA
+	uint32_t   crc_checked_ = 0;
+	uint16_t   stalls_ = 0;
+
+	std::vector<Slot8>  local_, remote_;
+	std::vector<Slot32> my_crc_, peer_crc_;
+};
+
+} // namespace netplay
+
+#endif
