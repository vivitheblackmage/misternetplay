+static void test_record_replay()
+{
+	printf("record, then replay\n");
+	Recording rec;
+	{
+		FakeFpga f(0);
+		Session s(M_RECORD, 2, f.mb, nullptr, &rec, 0x31);
+		s.set_local(make_info());
+		uint64_t now = 0;
+		while (f.frame < 1500 && now < 100000)
+		{
+			now++;
+			f.step(now); s.step(now);
+			if (s.reload_requested()) s.reload_done(now);
+		}
+		s.stop(now, "Netplay: recording saved");
+		CHECK(rec.joy.size() >= 1500 && rec.crc.size() >= 1499);
+	}
+	printf("  recorded %zu frames, %zu CRCs\n", rec.joy.size(), rec.crc.size());
+
+	for (int corrupt = 0; corrupt < 2; corrupt++)
+	{
+		FakeFpga f(1);                                  // different live pad: must be ignored
+		if (corrupt) f.corrupt_crc_at = 1000;
+		Session s(M_REPLAY, 2, f.mb, nullptr, &rec, 0x77);
+		s.set_local(make_info());
+		uint64_t now = 0;
+		while (s.phase() != PH_DONE && now < 100000)
+		{
+			now++;
+			f.step(now); s.step(now);
+			if (s.reload_requested()) s.reload_done(now);
+		}
+		if (!corrupt)
+		{
+			CHECKM(!s.failed() && strstr(s.message(), "replay OK"), "replay: '%s'", s.message());
+			CHECK(s.crc_checked() == rec.crc.size());
+		}
+		else CHECKM(s.failed() && strstr(s.message(), "replay DESYNC at frame 1000"), "corrupt replay: '%s'", s.message());
+	}
+}
