+// netplay.cpp — NES lockstep netplay, Main_MiSTer integration (SPEC.md 7)
+//
+// Threading: everything that touches SPI or the OSD (status bits, ROM reload,
+// Info boxes) runs on the main thread in netplay_poll()/netplay_note_file().
+// The netplay thread owns the Session, the UDP socket and the DDR3 mailbox,
+// which is plain memory and needs no SPI.
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <unistd.h>
+#include <time.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <netdb.h>
+#include <arpa/inet.h>
+#include <sys/socket.h>
+#include <netinet/in.h>
+
+#include <atomic>
+#include <mutex>
+#include <string>
+
+#include "../../user_io.h"
+#include "../../shmem.h"
+#include "../../file_io.h"
+#include "../../menu.h"
+#include "md5.h"
+
+#include "netplay.h"
+#include "netplay_proto.h"
+#include "netplay_session.h"
+
+using namespace netplay;
+
+// ---------------------------------------------------------------------------
+// Configuration: /media/fat/netplay.ini
+
+struct Config
+{
+	Mode     mode = M_OFF;
+	char     peer[128] = {};
+	uint16_t port = 7845;
+	uint8_t  delay = 2;
+	char     file[512] = "netplay/rec.npr";
+};
+
+static bool load_config(Config *c)
+{
+	FILE *f = fopen(getFullPath("netplay.ini"), "r");
+	if (!f) return false;
+
+	char line[640];
+	bool in_section = false;
+	while (fgets(line, sizeof(line), f))
+	{
+		char *s = line;
+		while (*s == ' ' || *s == '\t') s++;
+		char *e = s + strcspn(s, ";#\r\n");
+		while (e > s && (e[-1] == ' ' || e[-1] == '\t')) e--;
+		*e = 0;
+		if (!*s) continue;
+		if (*s == '[') { in_section = !strcasecmp(s, "[netplay]"); continue; }
+		if (!in_section) continue;
+
+		char *eq = strchr(s, '=');
+		if (!eq) continue;
+		*eq = 0;
+		char *k = s, *v = eq + 1;
+		for (char *t = eq - 1; t >= k && (*t == ' ' || *t == '\t'); t--) *t = 0;
+		while (*v == ' ' || *v == '\t') v++;
+
+		if (!strcasecmp(k, "mode"))
+		{
+			c->mode = !strcasecmp(v, "host")   ? M_HOST
+			        : !strcasecmp(v, "join")   ? M_JOIN
+			        : !strcasecmp(v, "record") ? M_RECORD
+			        : !strcasecmp(v, "replay") ? M_REPLAY : M_OFF;
+		}
+		else if (!strcasecmp(k, "peer"))  snprintf(c->peer, sizeof(c->peer), "%s", v);
+		else if (!strcasecmp(k, "port"))  c->port = (uint16_t)strtoul(v, nullptr, 10);
+		else if (!strcasecmp(k, "delay")) c->delay = (uint8_t)strtoul(v, nullptr, 10);
+		else if (!strcasecmp(k, "file"))  snprintf(c->file, sizeof(c->file), "%s", v);
+	}
+	fclose(f);
+	return true;
+}
+
+// ---------------------------------------------------------------------------
+// UDP
+
+class Udp : public Transport
+{
+public:
+	bool open_socket(uint16_t port, const char *peer)
+	{
+		fd_ = socket(AF_INET, SOCK_DGRAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+		if (fd_ < 0) return false;
+		int one = 1;
+		setsockopt(fd_, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+
+		sockaddr_in a {};
+		a.sin_family = AF_INET;
+		a.sin_addr.s_addr = htonl(INADDR_ANY);
+		a.sin_port = htons(peer && *peer ? 0 : port);   // host listens on port, join uses any
+		if (bind(fd_, (sockaddr *)&a, sizeof(a)) < 0) return false;
+
+		if (peer && *peer)
+		{
+			addrinfo hints {}, *res = nullptr;
+			hints.ai_family = AF_INET;
+			hints.ai_socktype = SOCK_DGRAM;
+			char ps[8];
+			snprintf(ps, sizeof(ps), "%u", port);
+			if (getaddrinfo(peer, ps, &hints, &res) || !res) return false;
+			memcpy(&peer_, res->ai_addr, sizeof(peer_));
+			freeaddrinfo(res);
+			have_peer_ = locked_ = true;
+		}
+		return true;
+	}
+
+	~Udp() override { if (fd_ >= 0) close(fd_); }
+
+	void send(const uint8_t *buf, size_t len) override
+	{
+		if (fd_ < 0 || !have_peer_) return;
+		sendto(fd_, buf, len, 0, (sockaddr *)&peer_, sizeof(peer_));
+	}
+
+	int recv(uint8_t *buf, size_t cap) override
+	{
+		for (;;)
+		{
+			sockaddr_in from {};
+			socklen_t fl = sizeof(from);
+			ssize_t n = recvfrom(fd_, buf, cap, MSG_DONTWAIT, (sockaddr *)&from, &fl);
+			if (n < 0) return -1;
+			if (locked_)
+			{
+				// ignore everyone but the peer once a session is agreed
+				if (from.sin_addr.s_addr != peer_.sin_addr.s_addr || from.sin_port != peer_.sin_port) continue;
+			}
+			else
+			{
+				peer_ = from;
+				have_peer_ = true;
+			}
+			return (int)n;
+		}
+	}
+
+	void lock_peer() override { if (have_peer_) locked_ = true; }
+
+private:
+	int fd_ = -1;
+	sockaddr_in peer_ {};
+	bool have_peer_ = false, locked_ = false;
+};
+
+// ---------------------------------------------------------------------------
+// Recordings (.npr): "NPR1", rom md5[16], u32 frames, joy[frames], u32 crcs, crc[crcs]
+
+static bool save_recording(const char *path, const Recording &r, const uint8_t *md5)
+{
+	FILE *f = fopen(getFullPath(path), "wb");
+	if (!f) return false;
+	uint32_t n = (uint32_t)r.joy.size(), m = (uint32_t)r.crc.size();
+	bool ok = fwrite("NPR1", 4, 1, f) == 1 && fwrite(md5, 16, 1, f) == 1
+	       && fwrite(&n, 4, 1, f) == 1 && (!n || fwrite(r.joy.data(), n, 1, f) == 1)
+	       && fwrite(&m, 4, 1, f) == 1 && (!m || fwrite(r.crc.data(), 4 * m, 1, f) == 1);
+	fclose(f);
+	return ok;
+}
+
+static bool load_recording(const char *path, Recording *r, uint8_t *md5)
+{
+	FILE *f = fopen(getFullPath(path), "rb");
+	if (!f) return false;
+	char magic[4];
+	uint32_t n = 0, m = 0;
+	bool ok = fread(magic, 4, 1, f) == 1 && !memcmp(magic, "NPR1", 4) && fread(md5, 16, 1, f) == 1
+	       && fread(&n, 4, 1, f) == 1 && n < 10000000;
+	if (ok) { r->joy.resize(n); ok = !n || fread(r->joy.data(), n, 1, f) == 1; }
+	if (ok) ok = fread(&m, 4, 1, f) == 1 && m < 10000000;
+	if (ok) { r->crc.resize(m); ok = !m || fread(r->crc.data(), 4 * m, 1, f) == 1; }
+	fclose(f);
+	return ok;
+}
+
+// ---------------------------------------------------------------------------
+// Shared state between the main thread and the netplay thread
+
+static Config            cfg;
+static pthread_t         thread;
+static bool              thread_running = false;
+static std::atomic<bool> quit { false };
+
+static std::mutex        info_mtx;          // guards the fields below
+static LocalInfo         rom_info;
+static std::string       rom_path;
+static unsigned char     rom_index = 0;
+static uint32_t          rom_seq = 0;        // bumps on every user ROM load
+
+static std::atomic<bool> reload_req { false };
+static std::atomic<bool> reload_done { false };
+static bool              own_reload = false; // main thread only
+
+static std::mutex        msg_mtx;
+static char              msg_text[96];
+static uint32_t          msg_seq = 0, msg_shown = 0;
+
+static uint64_t now_ms()
+{
+	timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (uint64_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+static void post_message(const char *m)
+{
+	std::lock_guard<std::mutex> g(msg_mtx);
+	snprintf(msg_text, sizeof(msg_text), "%s", m);
+	msg_seq++;
+}
+
+static void *netplay_thread(void *)
+{
+	volatile uint8_t *mem = (volatile uint8_t *)shmem_map(MB_PHYS, MB_SIZE);
+	if (!mem) { post_message("Netplay: cannot map DDR3 mailbox"); return nullptr; }
+	Mailbox mb { mem };
+
+	Session  *s = nullptr;
+	Udp      *udp = nullptr;
+	Recording rec;
+	uint8_t   md5[16] = {};
+	uint32_t  seen_rom = 0, seen_msg = 0;
+	bool      saved = false;
+
+	while (!quit)
+	{
+		uint64_t now = now_ms();
+
+		// A ROM loaded from the OSD starts a fresh session.
+		uint32_t seq;
+		{
+			std::lock_guard<std::mutex> g(info_mtx);
+			seq = rom_seq;
+		}
+		if (seq != seen_rom)
+		{
+			seen_rom = seq;
+			if (s) { s->stop(now, "Netplay: new ROM"); delete s; s = nullptr; }
+			delete udp; udp = nullptr;
+			rec = Recording();
+			saved = false;
+			reload_req = false;
+			reload_done = false;
+
+			LocalInfo li;
+			{
+				std::lock_guard<std::mutex> g(info_mtx);
+				li = rom_info;
+			}
+			memcpy(md5, li.rom_md5, 16);
+
+			bool ok = true;
+			if (cfg.mode == M_HOST || cfg.mode == M_JOIN)
+			{
+				udp = new Udp();
+				if (!udp->open_socket(cfg.port, cfg.mode == M_JOIN ? cfg.peer : nullptr))
+				{
+					post_message(cfg.mode == M_JOIN ? "Netplay: cannot reach peer (check peer=)" : "Netplay: cannot open port");
+					ok = false;
+				}
+			}
+			else if (cfg.mode == M_REPLAY)
+			{
+				uint8_t rmd5[16];
+				if (!load_recording(cfg.file, &rec, rmd5)) { post_message("Netplay: cannot read recording"); ok = false; }
+				else if (memcmp(rmd5, li.rom_md5, 16)) { post_message("Netplay: recording is for another ROM"); ok = false; }
+			}
+
+			if (ok)
+			{
+				uint8_t seed = (uint8_t)((now ^ (now >> 8) ^ getpid()) | 1);
+				s = new Session(cfg.mode, cfg.delay, mb, udp, &rec, seed);
+				s->set_local(li);
+			}
+		}
+
+		if (s)
+		{
+			s->step(now);
+			if (s->reload_requested() && !reload_req && !reload_done) reload_req = true;
+			if (reload_done.exchange(false)) s->reload_done(now);
+			if (s->msg_seq() != seen_msg) { seen_msg = s->msg_seq(); post_message(s->message()); }
+
+			if (cfg.mode == M_RECORD && s->phase() == PH_DONE && !saved)
+			{
+				saved = true;
+				post_message(save_recording(cfg.file, rec, md5) ? "Netplay: recording saved" : "Netplay: cannot save recording");
+			}
+		}
+
+		usleep(1000);
+	}
+
+	if (s)
+	{
+		s->stop(now_ms(), "Netplay: stopped");
+		if (cfg.mode == M_RECORD && !saved) save_recording(cfg.file, rec, md5);
+		delete s;
+	}
+	delete udp;
+	mb.wr(MB_CTRL, 0);
+	shmem_unmap((void *)mem, MB_SIZE);
+	return nullptr;
+}
+
+// ---------------------------------------------------------------------------
+// Main-thread side
+
+static bool is_nes_core()
+{
+	return !strcasecmp(user_io_get_core_name(), "NES");
+}
+
+static void core_build(uint8_t out[16])
+{
+	memset(out, 0, 16);
+	for (int i = 0; ; i++)
+	{
+		char *p = user_io_get_confstr(i);
+		if (!p) break;
+		if (p[0] == 'V' && p[1] == ',') { strncpy((char *)out, p + 2, 16); break; }
+	}
+}
+
+static bool md5_file(const char *path, uint8_t out[16], uint8_t *hdr, size_t hdr_len)
+{
+	FILE *f = fopen(getFullPath(path), "rb");
+	if (!f) return false;
+	MD5Context ctx;
+	MD5Init(&ctx);
+	uint8_t buf[16384];
+	size_t n, total = 0;
+	while ((n = fread(buf, 1, sizeof(buf), f)) > 0)
+	{
+		if (hdr && total == 0) memcpy(hdr, buf, n < hdr_len ? n : hdr_len);
+		MD5Update(&ctx, buf, (unsigned)n);
+		total += n;
+	}
+	fclose(f);
+	MD5Final(out, &ctx);
+	return true;
+}
+
+void netplay_note_file(const char *name, unsigned char index)
+{
+	if (!thread_running || own_reload || !is_nes_core()) return;
+	if ((index & 0x3F) == 0) return;                      // FDS BIOS (boot0) is not a game
+
+	LocalInfo li {};
+	uint8_t hdr[16] = {};
+	if (!md5_file(name, li.rom_md5, hdr, sizeof(hdr))) return;
+	const char *dot = strrchr(name, '.');
+	li.rom_region = rom_region_from_header(hdr, sizeof(hdr), dot ? dot + 1 : "");
+	core_build(li.core_build);
+
+	// .sav next to the other saves, same base name
+	const char *base = strrchr(name, '/');
+	std::string sav = std::string("saves/NES/") + (base ? base + 1 : name);
+	size_t d = sav.rfind('.');
+	if (d != std::string::npos) sav.resize(d);
+	sav += ".sav";
+	if (!md5_file(sav.c_str(), li.sav_md5, nullptr, 0)) memset(li.sav_md5, 0, 16);
+
+	li.settings.sys_type   = (uint8_t)user_io_status_get("[72:70]");
+	li.settings.ram_clear  = (uint8_t)user_io_status_get("[66:65]");
+	li.settings.ppu_reset  = (uint8_t)user_io_status_get("[64]");
+	li.settings.extra_spr  = (uint8_t)user_io_status_get("[25]");
+	li.settings.mask_edges = (uint8_t)user_io_status_get("[28:27]");
+	li.settings.overscan   = (uint8_t)user_io_status_get("[68:67]");
+	li.settings.cheats_off = (uint8_t)user_io_status_get("[20]");
+
+	std::lock_guard<std::mutex> g(info_mtx);
+	rom_info = li;
+	rom_path = name;
+	rom_index = index;
+	rom_seq++;
+}
+
+void netplay_start(void)
+{
+	if (thread_running || !is_nes_core()) return;
+	cfg = Config();
+	if (!load_config(&cfg) || cfg.mode == M_OFF) return;
+
+	quit = false;
+	reload_req = false;
+	reload_done = false;
+	if (pthread_create(&thread, nullptr, netplay_thread, nullptr) == 0) thread_running = true;
+	else printf("netplay: cannot start thread\n");
+}
+
+void netplay_stop(void)
+{
+	if (!thread_running) return;
+	quit = true;
+	pthread_join(thread, nullptr);
+	thread_running = false;
+}
+
+void netplay_poll(void)
+{
+	if (!thread_running) return;
+
+	if (reload_req)
+	{
+		std::string path;
+		unsigned char index;
+		{
+			std::lock_guard<std::mutex> g(info_mtx);
+			path = rom_path;
+			index = rom_index;
+		}
+		own_reload = true;                 // keep netplay_note_file from starting a new session
+		user_io_file_tx(path.c_str(), index);
+		own_reload = false;
+		reload_done = true;                // before clearing the request, so the
+		reload_req = false;                // thread never sees both false and asks again
+	}
+
+	char text[96];
+	bool show = false;
+	{
+		std::lock_guard<std::mutex> g(msg_mtx);
+		if (msg_seq != msg_shown) { msg_shown = msg_seq; snprintf(text, sizeof(text), "%s", msg_text); show = true; }
+	}
+	if (show)
+	{
+		printf("%s\n", text);
+		Info(text, 3000);
+	}
+}
