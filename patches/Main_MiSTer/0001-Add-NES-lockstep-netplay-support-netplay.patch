+static void test_settings()
+{
+	printf("settings and ROM checks\n");
+	Settings s {}; s.ram_clear = 1; s.cheats_off = 1;
+	CHECK(check_local(s, 0, 2) == REJ_OK);
+	CHECK(check_local(s, 0, 1) == REJ_DELAY);
+	CHECK(check_local(s, 0, 16) == REJ_DELAY);
+	s.ram_clear = 0; CHECK(check_local(s, 0, 3) == REJ_RAM_CLEAR);
+	s.ram_clear = 3; CHECK(check_local(s, 0, 3) == REJ_RAM_CLEAR);
+	s.ram_clear = 2; s.cheats_off = 0; CHECK(check_local(s, 0, 3) == REJ_CHEATS);
+	s.cheats_off = 1; s.sys_type = 3; CHECK(check_local(s, 0, 3) == REJ_SYSTEM);
+	s.sys_type = 4; CHECK(check_local(s, 0, 3) == REJ_SYSTEM);
+	s.sys_type = 0; CHECK(check_local(s, 2, 3) == REJ_SYSTEM);
+	s.sys_type = 2; CHECK(check_local(s, 2, 3) == REJ_OK);      // forced PAL is fine
+
+	uint8_t h[16] = {'N', 'E', 'S', 0x1A};
+	CHECK(rom_region_from_header(h, 16, "nes") == 0);
+	h[7] = 0x08; h[12] = 1; CHECK(rom_region_from_header(h, 16, "nes") == 1);
+	h[12] = 3; CHECK(rom_region_from_header(h, 16, "nes") == 2);
+	h[7] = 0x09; CHECK(rom_region_from_header(h, 16, "nes") == 3);
+	CHECK(rom_region_from_header(h, 16, "FDS") == 3);
+	CHECK(rom_region_from_header(h, 8, "nes") == 3);
+
+	Settings x {}, y {}; y.overscan = 1;
+	CHECK(pack_settings(x) != pack_settings(y));
+}
+
+static void check_same_inputs(Pair &P, uint8_t delay)
+{
+	size_t n = P.fa.seen.size() < P.fb.seen.size() ? P.fa.seen.size() : P.fb.seen.size();
+	int bad = 0;
+	for (size_t f = 0; f < n; f++) if (P.fa.seen[f] != P.fb.seen[f]) bad++;
+	CHECKM(bad == 0, "%d of %zu frames saw different inputs", bad, n);
+	CHECK(P.fa.seen[0] == std::make_pair((uint8_t)0, (uint8_t)0));
+	CHECK(P.fa.seen.size() > delay);
+	(void)delay;
+}
+
+static void test_session_clean()
+{
+	printf("session: clean LAN\n");
+	Pair P(3);
+	bool ok = P.run_until([&] { return P.fa.frame >= 3000 && P.fb.frame >= 3000; }, 120000);
+	CHECKM(ok, "did not reach 3000 frames: A %s / B %s", P.a.message(), P.b.message());
+	CHECK(P.a.phase() == PH_RUN && P.b.phase() == PH_RUN);
+	CHECK(P.b.delay() == 3);                         // the host's delay wins
+	CHECK(P.a.session_id() == 0x42 && P.b.session_id() == 0x42);
+	CHECKM(P.a.crc_checked() > 2900, "only %u CRCs compared", P.a.crc_checked());
+	CHECKM(P.fa.stalls == 0 && P.fb.stalls == 0, "stalls on a clean LAN: %u/%u", P.fa.stalls, P.fb.stalls);
+	check_same_inputs(P, 3);
+
+	// port mapping and delay: frame f sees host LOCAL[f-D] as player 1 and
+	// join LOCAL[f-D] as player 2 (symmetric bugs would not desync, so check)
+	int wrong = 0, nonzero = 0;
+	for (size_t f = 3; f < 2900; f++)
+	{
+		if (P.fa.seen[f].first != P.fa.posted[f - 3] || P.fa.seen[f].second != P.fb.posted[f - 3]) wrong++;
+		if (P.fa.seen[f].first != P.fa.seen[f].second) nonzero++;
+	}
+	CHECKM(wrong == 0, "%d frames with wrong port or delay", wrong);
+	CHECK(nonzero > 1000);       // the two pads really differ
+}
+
+static void test_session_lossy()
+{
+	printf("session: 5%% loss, 30+-10 ms\n");
+	rng_state = 777;
+	Pair P(4);
+	P.net.loss_pct = 5; P.net.delay_ms = 30; P.net.jitter_ms = 10;
+	bool ok = P.run_until([&] { return P.fa.frame >= 3000 && P.fb.frame >= 3000; }, 300000);
+	CHECKM(ok, "did not reach 3000 frames: A '%s' B '%s'", P.a.message(), P.b.message());
+	CHECK(!P.a.failed() && !P.b.failed());
+	CHECKM(P.a.crc_checked() > 2500, "only %u CRCs compared", P.a.crc_checked());
+	check_same_inputs(P, 4);
+	printf("  stalls A=%u B=%u over %u frames\n", P.fa.stalls, P.fb.stalls, P.fa.frame);
+	CHECKM(P.fa.stalls < 300, "too many stalls: %u", P.fa.stalls);
+}
+
+static void test_reject_rom()
+{
+	printf("handshake: different ROM\n");
+	Pair P(3);
+	LocalInfo ia = make_info(), ib = make_info();
+	ib.rom_md5[0] ^= 1;
+	P.a.set_local(ia); P.b.set_local(ib);
+	P.run_until([&] { return P.b.phase() == PH_DONE; }, 5000);
+	CHECK(P.b.failed());
+	CHECKM(strstr(P.b.message(), "Different ROM") != nullptr, "join says '%s'", P.b.message());
+	CHECK(P.a.phase() == PH_HANDSHAKE);              // host keeps waiting
+	CHECK(P.fa.state == FS_IDLE && P.fb.state == FS_IDLE);   // nothing armed
+}
+
+static void test_desync()
+{
+	printf("desync detection\n");
+	Pair P(3);
+	P.fb.corrupt_crc_at = 500;
+	P.run_until([&] { return P.a.phase() == PH_DONE && P.b.phase() == PH_DONE; }, 60000);
+	CHECKM(strstr(P.a.message(), "DESYNC at frame 500") || strstr(P.b.message(), "DESYNC at frame 500"),
+	       "A '%s' B '%s'", P.a.message(), P.b.message());
+	CHECK(P.a.failed() && P.b.failed());
+	for (int i = 0; i < 5; i++) P.step();            // let the cores see CTRL=0
+	CHECK(P.fa.state == FS_IDLE && P.fb.state == FS_IDLE);   // cores released to local play
+}
+
+static void test_connection_lost()
+{
+	printf("connection lost\n");
+	Pair P(3);
+	P.run_until([&] { return P.fa.frame >= 300; }, 60000);
+	P.net.cut = true;
+	uint64_t t0 = P.now;
+	P.run_until([&] { return P.a.phase() == PH_DONE && P.b.phase() == PH_DONE; }, 20000);
+	CHECKM(strstr(P.a.message(), "connection lost") != nullptr, "A '%s'", P.a.message());
+	CHECKM(P.now - t0 < 7000, "took %llu ms", (unsigned long long)(P.now - t0));
+}
+
+static void test_outage_recovers()
+{
+	printf("half-second outage, then recovery\n");
+	Pair P(2);
+	P.run_until([&] { return P.fa.frame >= 300; }, 60000);
+	P.net.cut = true;
+	for (int i = 0; i < 500; i++) P.step();          // both sides stall, nothing new to send
+	P.net.cut = false;
+	bool ok = P.run_until([&] { return P.fa.frame >= 600 && P.fb.frame >= 600; }, 30000);
+	CHECKM(ok && !P.a.failed() && !P.b.failed(), "A '%s' B '%s'", P.a.message(), P.b.message());
+	CHECK(P.fa.stalls > 0);
+	check_same_inputs(P, 2);
+}
+
+static void test_bye()
+{
+	printf("other player quits\n");
+	Pair P(3);
+	P.run_until([&] { return P.fa.frame >= 200; }, 60000);
+	P.a.stop(P.now, "Netplay: stopped");
+	CHECK(!P.a.failed());
+	P.run_until([&] { return P.b.phase() == PH_DONE; }, 1000);
+	CHECKM(strstr(P.b.message(), "other player left") != nullptr, "B '%s'", P.b.message());
+}
+
+static void test_lost_ack()
+{
+	printf("handshake: first HELLO_ACK lost\n");
+	Pair P(3);
+	int dropped = 0;
+	P.net.drop_if = [&](int from, const uint8_t *b, size_t n) {
+		Packet q;
+		if (from == 0 && decode(b, n, &q) && q.type == P_HELLO_ACK && dropped < 2) { dropped++; return true; }
+		return false;
+	};
+	bool ok = P.run_until([&] { return P.fa.frame >= 100 && P.fb.frame >= 100; }, 60000);
+	CHECKM(ok, "A '%s' B '%s'", P.a.message(), P.b.message());
+	CHECK(dropped == 2);
+	check_same_inputs(P, 3);
+}
