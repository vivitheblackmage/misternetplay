+static void test_bad_local_settings()
+{
+	printf("local settings refused before arming\n");
+	FakeFpga f(0);
+	Net net; End e(&net, 0);
+	Session s(M_HOST, 3, f.mb, &e, nullptr, 1);
+	LocalInfo li = make_info(); li.settings.ram_clear = 3;   // Random
+	s.set_local(li);
+	for (uint64_t now = 1; now < 100; now++) { f.step(now); s.step(now); }
+	CHECK(s.failed() && strstr(s.message(), "RAM Clear"));
+	CHECK(f.mb.rd(MB_CTRL) == 0);
+}
