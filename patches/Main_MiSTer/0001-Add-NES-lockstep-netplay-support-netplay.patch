+static void test_core_without_netplay()
+{
+	printf("core without netplay support\n");
+	FakeFpga f(0);
+	f.mb.wr(MB_MAGIC, 0);                               // upstream core: no MAGIC
+	Net net; End e(&net, 0);
+	Session s(M_HOST, 3, f.mb, &e, nullptr, 1);
+	s.set_local(make_info());
+	for (uint64_t now = 1; now < 5000; now++) { f.step(now); s.step(now); }
+	CHECK(s.phase() == PH_WAIT_CORE);
+	CHECK(f.mb.rd(MB_CTRL) == 0);                       // never touched
+}
