+# x86 tests for the netplay engine (SPEC.md T3). Needs only g++.
+#   make        build and run
+
+CXX      ?= g++
+CXXFLAGS ?= -std=gnu++14 -O1 -g -Wall -Wextra -Werror -fsanitize=address,undefined
+SRC      := ../netplay_proto.cpp ../netplay_session.cpp test_netplay.cpp
+
+.PHONY: test clean
+test: test_netplay
+	./test_netplay
+
+test_netplay: $(SRC) ../netplay_proto.h ../netplay_session.h
+	$(CXX) $(CXXFLAGS) -o $@ $(SRC)
+
+clean:
+	rm -f test_netplay
diff --git a/support/netplay/test/test_netplay.cpp b/support/netplay/test/test_netplay.cpp
new file mode 100644
index 0000000..6fa3d73
--- /dev/null
+++ b/support/netplay/test/test_netplay.cpp
@@ -0,0 +1,557 @@
+// test_netplay.cpp — x86 tests for the Main_MiSTer side of NES netplay (SPEC.md T3)
+//
+// Two Session engines talk over a simulated lossy network. Each drives a
+// FakeFpga that follows the same mailbox protocol as rtl/netplay.sv, in
+// simulated milliseconds. Build and run with `make` in this directory.
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <deque>
+#include <vector>
+#include <string>
+#include <functional>
+
+#include "../netplay_proto.h"
+#include "../netplay_session.h"
+
+using namespace netplay;
+
+static int g_fail = 0, g_checks = 0;
+#define CHECK(c) do { g_checks++; if (!(c)) { g_fail++; printf("  FAIL %s:%d: %s\n", __FILE__, __LINE__, #c); } } while (0)
+#define CHECKM(c, ...) do { g_checks++; if (!(c)) { g_fail++; printf("  FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+static uint32_t rng_state = 12345;
+static uint32_t rnd() { rng_state = rng_state * 1103515245u + 12345u; return rng_state >> 8; }
+
+// ---------------------------------------------------------------------------
+// FakeFpga: rtl/netplay.sv at the mailbox level, plus a "game" whose state
+// folds in every input it is given.
+
+struct FakeFpga
+{
+	uint8_t mem[MB_SIZE] = {};
+	Mailbox mb { mem };
+
+	int      id;
+	uint32_t frame_ms = 16;
+	uint8_t  state = FS_IDLE, error = 0, sess = 0;
+	uint32_t frame = 0;
+	uint16_t stalls = 0;
+	bool     have0 = false, have1 = false;
+	uint8_t  a1 = 0, a2 = 0, b1 = 0, b2 = 0, cur1 = 0, cur2 = 0;
+	uint64_t next_tick = 0;
+	uint32_t game = 0x12345678;
+	int      corrupt_crc_at = -1;
+	bool     stalled = false;
+	std::vector<std::pair<uint8_t, uint8_t>> seen;   // inputs per frame
+	std::vector<uint8_t> posted;                     // LOCAL[] per frame
+	std::function<uint8_t(uint64_t)> pad;
+
+	explicit FakeFpga(int i) : id(i)
+	{
+		mb.wr(MB_MAGIC, MAGIC_VALUE);
+		pad = [i](uint64_t now) { return (uint8_t)((now / (37 + 11 * i)) * (i ? 0x5B : 0x3D)); };
+	}
+
+	void status() { mb.wr(MB_STATUS, (uint64_t)frame << 32 | (uint64_t)state << 24 | (uint64_t)error << 16 | stalls); }
+
+	bool fetch(uint32_t f, uint8_t *p1, uint8_t *p2)
+	{
+		uint64_t w = mb.rd(ring_off(MB_INPUT, f));
+		uint32_t hi = (uint32_t)(w >> 32), lo = (uint32_t)w;
+		uint32_t tag = (f & 0xFFFF) << 16 | (uint32_t)sess << 8;
+		if ((hi & 0xFFFFFF00) != tag || (lo & 0xFFFFFF00) != tag) return false;
+		*p1 = (uint8_t)lo; *p2 = (uint8_t)hi;
+		return true;
+	}
+
+	void post_local(uint32_t f, uint8_t j)
+	{
+		if (posted.size() == f) posted.push_back(j);
+		uint32_t half = (f & 0xFFFF) << 16 | (uint32_t)sess << 8 | j;
+		mb.wr(ring_off(MB_LOCAL, f), (uint64_t)half << 32 | half);
+	}
+
+	void post_crc(uint32_t f, uint32_t c)
+	{
+		uint64_t w = (uint64_t)((f & 0xFFFF) << 16 | (c >> 16)) << 32 | ((f & 0xFFFF) << 16 | (c & 0xFFFF));
+		mb.wr(ring_off(MB_CRC, f), w);
+	}
+
+	void apply(uint8_t p1, uint8_t p2)
+	{
+		cur1 = p1; cur2 = p2;
+		game = game * 31 + (uint32_t)(p1 | p2 << 8) + 1;
+		seen.push_back({p1, p2});
+	}
+
+	void step(uint64_t now)
+	{
+		uint64_t ctrl = mb.rd(MB_CTRL);
+		bool en = ctrl & 1, run = ctrl & 2;
+
+		switch (state)
+		{
+		case FS_IDLE:
+			if (en) { state = FS_ARMED; sess = (uint8_t)(ctrl >> 8); frame = 0; error = 0; stalls = 0; have0 = have1 = false; status(); }
+			break;
+		case FS_ARMED:
+			if (!en) { state = FS_IDLE; status(); }
+			else if (run) { state = FS_PRIME; status(); }
+			break;
+		case FS_PRIME:
+			if (!en) { state = FS_IDLE; status(); break; }
+			if (!have0) have0 = fetch(0, &a1, &a2);
+			if (have0 && !have1) have1 = fetch(1, &b1, &b2);
+			if (have0 && have1)
+			{
+				state = FS_RUN; frame = 0;
+				apply(a1, a2);
+				a1 = b1; a2 = b2; have1 = false;
+				post_local(0, pad(now));
+				next_tick = now + frame_ms;
+				status();
+			}
+			break;
+		case FS_RUN:
+			if (!en) { state = FS_IDLE; error |= FE_CTRL_DROP; status(); break; }
+			if (!have0) have0 = fetch(frame + 1, &a1, &a2);
+			else if (!have1) have1 = fetch(frame + 2, &b1, &b2);
+			if (now >= next_tick)
+			{
+				if (!have0)
+				{
+					// real core pauses in vblank and resumes a whole frame later
+					if (!stalled) { stalls++; stalled = true; }
+					next_tick = now + frame_ms;
+					break;
+				}
+				stalled = false;
+				uint32_t c = game ^ (corrupt_crc_at == (int)frame ? 1u : 0u);
+				post_crc(frame, c);
+				frame++;
+				apply(a1, a2);
+				have0 = have1; a1 = b1; a2 = b2; have1 = false;
+				post_local(frame, pad(now));
+				next_tick += frame_ms;
+				status();
+			}
+			break;
+		default:
+			if (!en) { state = FS_IDLE; status(); }
+			break;
+		}
+	}
+};
+
+// ---------------------------------------------------------------------------
+// Simulated network between exactly two endpoints
+
+struct Net
+{
+	struct Msg { uint64_t at; int to; std::vector<uint8_t> data; };
+	std::vector<Msg> inflight;
+	uint64_t now = 0;
+	int      loss_pct = 0;
+	uint32_t delay_ms = 2, jitter_ms = 0;
+	bool     cut = false;
+	std::function<bool(int from, const uint8_t *, size_t)> drop_if;   // targeted drops
+
+	void deliver(int from, const uint8_t *b, size_t n)
+	{
+		if (cut) return;
+		if (drop_if && drop_if(from, b, n)) return;
+		if (loss_pct && (int)(rnd() % 100) < loss_pct) return;
+		uint64_t at = now + delay_ms + (jitter_ms ? rnd() % (2 * jitter_ms + 1) : 0) - (jitter_ms ? jitter_ms : 0);
+		inflight.push_back({at, 1 - from, std::vector<uint8_t>(b, b + n)});
+	}
+
+	int take(int to, uint8_t *buf, size_t cap)
+	{
+		// earliest due message first: jitter reorders packets
+		int best = -1;
+		for (size_t i = 0; i < inflight.size(); i++)
+			if (inflight[i].to == to && inflight[i].at <= now && (best < 0 || inflight[i].at < inflight[best].at)) best = (int)i;
+		if (best < 0) return -1;
+		size_t n = inflight[best].data.size() < cap ? inflight[best].data.size() : cap;
+		memcpy(buf, inflight[best].data.data(), n);
+		inflight.erase(inflight.begin() + best);
+		return (int)n;
+	}
+};
+
+struct End : Transport
+{
+	Net *net; int me;
+	End(Net *n, int i) : net(n), me(i) {}
+	void send(const uint8_t *b, size_t n) override { net->deliver(me, b, n); }
+	int  recv(uint8_t *b, size_t cap) override { return net->take(me, b, cap); }
+	void lock_peer() override {}
+};
+
+static LocalInfo make_info()
+{
+	LocalInfo li {};
+	memcpy(li.core_build, "NES_20261030____", 16);
+	memset(li.rom_md5, 0xAB, 16);
+	li.settings.ram_clear = 1;
+	li.settings.cheats_off = 1;
+	li.settings.sys_type = 0;
+	li.rom_region = 0;
+	return li;
+}
+
+// Runs host+join until both have played `frames` frames or something ends.
+struct Pair
+{
+	Net net;
+	End ea { &net, 0 }, eb { &net, 1 };
+	FakeFpga fa { 0 }, fb { 1 };
+	Session a, b;
+	uint64_t now = 0;
+
+	Pair(uint8_t delay = 3, Timing t = Timing())
+		: a(M_HOST, delay, fa.mb, &ea, nullptr, 0x42, t),
+		  b(M_JOIN, 2, fb.mb, &eb, nullptr, 0, t)
+	{
+		a.set_local(make_info());
+		b.set_local(make_info());
+	}
+
+	void step()
+	{
+		now++;
+		net.now = now;
+		fa.step(now); fb.step(now);
+		a.step(now); b.step(now);
+		// the main thread's ROM reload takes a little while
+		if (a.reload_requested() && (now % 50) == 0) a.reload_done(now);
+		if (b.reload_requested() && (now % 70) == 0) b.reload_done(now);
+	}
+
+	bool run_until(std::function<bool()> done, uint64_t limit_ms)
+	{
+		uint64_t end = now + limit_ms;
+		while (now < end && !done()) step();
+		return done();
+	}
+};
+
+// ---------------------------------------------------------------------------
+
+static void test_packets()
+{
+	printf("packets\n");
+	uint8_t buf[MAX_PACKET];
+	Packet p {}, q;
+
+	p.type = P_INPUT; p.session = 7; p.input.first_frame = 0xDEADBEEF; p.input.count = 3;
+	p.input.joy[0] = 1; p.input.joy[1] = 2; p.input.joy[2] = 3;
+	size_t n = encode(p, buf, sizeof(buf));
+	CHECK(n == 4 + 2 + 4 + 1 + 3);
+	CHECK(decode(buf, n, &q) && q.type == P_INPUT && q.session == 7 && q.input.first_frame == 0xDEADBEEF && q.input.count == 3 && q.input.joy[2] == 3);
+	CHECK(!decode(buf, n - 1, &q));                   // truncated
+	buf[n] = 0; CHECK(!decode(buf, n + 1, &q));       // trailing byte
+	buf[0] ^= 1; CHECK(!decode(buf, n, &q));          // bad magic
+
+	p.input.count = 0;  CHECK(encode(p, buf, sizeof(buf)) == 0);
+	p.input.count = 17; CHECK(encode(p, buf, sizeof(buf)) == 0);
+
+	Packet h {}; h.type = P_HELLO_ACK; h.session = 9; h.hello.version = 1; h.hello.settings = 0x1234; h.hello.delay = 4; h.hello.accept = 1; h.hello.reason = 0;
+	memset(h.hello.rom_md5, 0x5A, 16);
+	n = encode(h, buf, sizeof(buf));
+	CHECK(n > 0 && decode(buf, n, &q) && q.hello.settings == 0x1234 && q.hello.delay == 4 && q.hello.accept == 1 && q.hello.rom_md5[15] == 0x5A);
+
+	Packet c {}; c.type = P_CRC; c.crc.frame = 77; c.crc.crc = 0xCAFEF00D;
+	n = encode(c, buf, sizeof(buf));
+	CHECK(decode(buf, n, &q) && q.crc.frame == 77 && q.crc.crc == 0xCAFEF00D);
+
+	// a count field claiming more bytes than the packet holds must not be read
+	uint8_t evil[] = {0x4E, 0x4E, 0x50, 0x31, P_INPUT, 1, 0, 0, 0, 0, 16, 1, 2};
+	CHECK(!decode(evil, sizeof(evil), &q));
+
+	// fuzz: random buffers never crash and rarely decode
+	int ok = 0;
+	for (int i = 0; i < 200000; i++)
+	{
+		size_t len = rnd() % 80;
+		for (size_t k = 0; k < len; k++) buf[k] = (uint8_t)rnd();
+		if (i & 1) { buf[0] = 0x4E; buf[1] = 0x4E; buf[2] = 0x50; buf[3] = 0x31; }
+		ok += decode(buf, len, &q);
+	}
+	printf("  fuzz: %d of 200000 random buffers decoded\n", ok);
+}
+
+static void test_mailbox_words()
+{
+	printf("mailbox words\n");
+	uint64_t w = input_word(0x12345, 0x5A, 0x81, 0x42);
+	CHECK((uint32_t)w == ((0x2345u << 16) | (0x5A << 8) | 0x81));
+	CHECK((uint32_t)(w >> 32) == ((0x2345u << 16) | (0x5A << 8) | 0x42));
+
+	uint8_t j;
+	uint32_t half = (7u << 16) | (0x5A << 8) | 0x99;
+	CHECK(decode_local((uint64_t)half << 32 | half, 7, 0x5A, &j) && j == 0x99);
+	CHECK(!decode_local((uint64_t)half << 32 | half, 8, 0x5A, &j));            // wrong frame
+	CHECK(!decode_local((uint64_t)half << 32 | half, 7, 0x5B, &j));            // wrong session
+	uint32_t old = (((7u - 256) & 0xFFFF) << 16) | (0x5A << 8) | 0x11;   // entry from 256 frames ago
+	CHECK(!decode_local((uint64_t)half << 32 | (old & 0xFFFFFFFF), 7, 0x5A, &j)); // torn
+	CHECK(!decode_local(INVALID_WORD, 0, 0, &j));
+	CHECK(!decode_local(INVALID_WORD, 0xFFFF, 0, &j));
+
+	uint32_t c;
+	CHECK(decode_crc(((uint64_t)(3u << 16 | 0xCAFE) << 32) | (3u << 16 | 0xF00D), 3, &c) && c == 0xCAFEF00D);
+	CHECK(!decode_crc(((uint64_t)(3u << 16 | 0xCAFE) << 32) | (4u << 16 | 0xF00D), 3, &c));
+
+	Status s = decode_status((uint64_t)1234 << 32 | (uint64_t)FS_RUN << 24 | (uint64_t)FE_RELOAD << 16 | 9);
+	CHECK(s.frame == 1234 && s.state == FS_RUN && s.error == FE_RELOAD && s.stalls == 9);
+}
