+{
+	test_packets();
+	test_mailbox_words();
+	test_settings();
+	test_session_clean();
+	test_session_lossy();
+	test_reject_rom();
+	test_desync();
+	test_connection_lost();
+	test_outage_recovers();
+	test_bye();
+	test_lost_ack();
+	test_record_replay();
+	test_core_without_netplay();
+	test_bad_local_settings();
