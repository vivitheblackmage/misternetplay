+static void test_snes_session()
+{
+	printf("snes: session over a lossy link\n");
+	Pair P(3, Timing(), SYS_SNES, SYS_SNES);
+	rng_state = 4242;
+	P.net.loss_pct = 5; P.net.delay_ms = 30; P.net.jitter_ms = 10;
+	bool ok = P.run_until([&] { return P.fa.frame >= 2000 && P.fb.frame >= 2000; }, 120000);
+	CHECKM(ok, "did not reach 2000 frames: A %s / B %s", P.a.message(), P.b.message());
+	CHECK(P.a.phase() == PH_RUN && P.b.phase() == PH_RUN);
+	check_same_inputs(P, 3);
+	int wrong = 0, wide = 0;
+	for (size_t f = 3; f < 1900; f++)
+	{
+		if (P.fa.seen[f].first != P.fa.posted[f - 3] || P.fa.seen[f].second != P.fb.posted[f - 3]) wrong++;
+		if (P.fa.seen[f].first > 0xFF || P.fa.seen[f].second > 0xFF) wide++;
