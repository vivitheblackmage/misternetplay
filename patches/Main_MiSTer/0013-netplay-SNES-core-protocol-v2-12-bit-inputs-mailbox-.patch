+// SNES (SPEC.md 10.2): 1 if the cartridge needs something that cannot be the
+// same on both sides: MSU-1 (streamed from the SD card), BS-X, a real-time
+// clock (S-RTC, SPC7110 with RTC), or the competition carts' timers.
+static uint8_t snes_refused(const char *name)
+{
+	const char *dot = strrchr(name, '.');
+	if (dot && !strcasecmp(dot, ".bs")) return 1;
+	std::string msu = name;
+	size_t d = msu.rfind('.');
+	if (d != std::string::npos) msu.resize(d);
+	msu += ".msu";
+	if (FileExists(msu.c_str())) return 1;
+	fileTYPE f = {};
+	if (!FileOpen(&f, name, 1)) return 1;
+	uint8_t t = snes_get_header(&f)[1];     // ROM type as the core gets it
+	FileClose(&f);
+	uint8_t chip = t >> 4, map = t & 0x0F;
+	if (t == 0x30) return 1;                          // BS-X BIOS
+	if (chip == 0x0 && (map & 0x08)) return 1;        // S-RTC
+	if (chip == 0x0 && map == 3) return 1;            // LoROM with a BS-X slot
+	if (chip == 0xD && (map & 0x08)) return 1;        // SPC7110 with RTC
+	if (chip == 0xE || chip == 0xF) return 1;         // Campus Challenge '92, PowerFest '94
+	return 0;
 }
 
