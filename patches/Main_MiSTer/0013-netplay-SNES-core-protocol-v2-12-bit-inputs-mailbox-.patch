+static void test_snes_words()
+{
+	printf("snes: mailbox words\n");
+	uint64_t w = input_word(SYS_SNES, 0x12345, 0x5A, 0xABC, 0x123);
+	CHECK((uint32_t)w == ((0x345u << 20) | (0x5Au << 12) | 0xABC));
+	CHECK((uint32_t)(w >> 32) == ((0x345u << 20) | (0x5Au << 12) | 0x123));
+	CHECK(input_word(SYS_NES, 7, 0x5A, 0x81, 0x42) == input_word(7, 0x5A, 0x81, 0x42));   // NES unchanged
+
+	uint16_t j;
+	uint32_t half = (7u << 20) | (0x5Au << 12) | 0xFED;
+	CHECK(decode_local(SYS_SNES, (uint64_t)half << 32 | half, 7, 0x5A, &j) && j == 0xFED);
+	CHECK(!decode_local(SYS_SNES, (uint64_t)half << 32 | half, 8, 0x5A, &j));
+	CHECK(!decode_local(SYS_SNES, (uint64_t)half << 32 | half, 7, 0x5B, &j));
+	CHECK(!decode_local(SYS_SNES, (uint64_t)half << 32 | (half ^ 1), 7, 0x5A, &j));   // torn
+	CHECK(decode_local(SYS_SNES, (uint64_t)half << 32 | half, 7 + 4096, 0x5A, &j));   // 12-bit tag: 4096 frames apart look the same (the ring has 256)
+	CHECK(!decode_local(SYS_SNES, INVALID_WORD, 0, 0, &j));
+	CHECK(!decode_local(SYS_SNES, INVALID_WORD, 0xFFF, 0, &j));
+	CHECK(mailbox_phys(SYS_SNES) == 0x3FC00000 && mailbox_phys(SYS_NES) == 0x3C000000);
+	CHECK(mailbox_magic(SYS_SNES) == 0x3130504E53454E53ULL);
+}
+
+static void test_snes_packets()
+{
+	printf("snes: packets\n");
+	uint8_t buf[MAX_PACKET];
+	Packet p {}, q;
+	p.type = P_INPUT; p.session = 7; p.input.first_frame = 9; p.input.count = 3;
+	p.input.joy[0] = 0xFFF; p.input.joy[1] = 0x800; p.input.joy[2] = 0x001;
+	size_t n = encode(p, buf, sizeof(buf), true);
+	CHECK(n == 4 + 2 + 4 + 1 + 2 * 3);
+	CHECK(decode(buf, n, &q, true) && q.input.count == 3 && q.input.joy[0] == 0xFFF && q.input.joy[1] == 0x800);
+	CHECK(!decode(buf, n, &q, false));            // a NES peer never reads it as narrow
+	size_t nn = encode(p, buf, sizeof(buf), false);
+	CHECK(nn == 4 + 2 + 4 + 1 + 3 && buf[11] == 0xFF);   // NES keeps one byte per sample
+
+	Packet h {}; h.type = P_HELLO; h.hello.version = 1; h.hello.delay = 3;
+	CHECK(encode(h, buf, sizeof(buf)) == 4 + 2 + 1 + 48 + 4 + 1);    // NES HELLO: unchanged length
+	h.hello.version = PROTO_VERSION_SNES; h.hello.system = SYS_SNES;
+	n = encode(h, buf, sizeof(buf));
+	CHECK(n == 4 + 2 + 1 + 1 + 48 + 4 + 1 && buf[7] == SYS_SNES);
+	CHECK(decode(buf, n, &q) && q.hello.version == 2 && q.hello.system == SYS_SNES && q.hello.delay == 3);
+}
