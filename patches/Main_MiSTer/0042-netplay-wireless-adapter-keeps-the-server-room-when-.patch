From 3cb4bd0176c671771e3ed22f2c970890e7d769cb Mon Sep 17 00:00:00 2001
From: netplay <netplay@localhost>
Date: Sat, 14 Nov 2026 00:27:24 +0100
Subject: [PATCH 42/42] netplay: wireless adapter keeps the server room when
 the game is loaded again (a host's new room stranded the join); T3w: second
 round after the host or the join loads its game again
---
 support/netplay/netplay.cpp          | 30 +++++++++---
 support/netplay/test/Makefile        |  4 +-
 support/netplay/test/run_udp_test.sh |  2 +-
 support/netplay/test/udp_harness.cpp | 71 +++++++++++++++++++++-------
 4 files changed, 80 insertions(+), 27 deletions(-)

diff --git a/support/netplay/netplay.cpp b/support/netplay/netplay.cpp
index 231620e..c412ff3 100644
--- a/support/netplay/netplay.cpp
+++ b/support/netplay/netplay.cpp
@@ -1035,6 +1035,8 @@ static void *gba_wireless_thread(void *)
 	Rfu rfu([&link](int, const uint8_t *b, size_t n) { rfu_trace_pkt(link ? "tx" : "tx-nolink", b, n); if (link) link->send(b, n); },
 	        (uint32_t)(now_ms() ^ ((uint64_t)getpid() << 16)));
 	uint32_t seen_rom = 0;
+	Mode pair_mode = M_OFF;      // what udp was opened for
+	std::string pair_room;
 	bool linked = false;
 	const char *told = nullptr;
 	uint64_t next_frame_us = now_ms() * 1000;
@@ -1058,13 +1060,6 @@ static void *gba_wireless_thread(void *)
 		if (seq != seen_rom)
 		{
 			seen_rom = seq;
-			delete link; link = nullptr;
-			if (udp) udp->leave();
-			delete udp; udp = nullptr;
-			lobby_host("");
-			linked = false;
-			told = nullptr;
-
 			LocalInfo li;
 			Mode mode;
 			std::string room, path;
@@ -1075,6 +1070,27 @@ static void *gba_wireless_thread(void *)
 				room = rom_room;
 				path = rom_path;
 			}
+			linked = false;
+			lost_told = false;
+			told = nullptr;
+			// The same mode and room as before (the game loaded again): keep the
+			// place on the server and the way to the other player; only the link
+			// starts over, with a new session id, which the other side follows.
+			// A new room here would leave a join that already got this one
+			// asking for a room that is gone.
+			if (udp && link && mode == pair_mode && room == pair_room)
+			{
+				delete link;
+				link = new RfuLink(udp, mode == M_HOST, random32());
+				restarts = 0;
+				continue;   // the next round of the loop serves the mailbox
+			}
+			delete link; link = nullptr;
+			if (udp) udp->leave();
+			delete udp; udp = nullptr;
+			lobby_host("");
+			pair_mode = mode;
+			pair_room = room;
 			bool ok = mode == M_HOST || mode == M_JOIN;
 			if (mode == M_JOIN && !cfg.peer[0] && !cfg.server[0])
 			{
diff --git a/support/netplay/test/Makefile b/support/netplay/test/Makefile
index 99a52d1..c57b3b4 100644
--- a/support/netplay/test/Makefile
