diff --git a/support/netplay/test/test_ne2000.cpp b/support/netplay/test/test_ne2000.cpp
new file mode 100644
index 0000000..a0a2ec5
--- /dev/null
+++ b/support/netplay/test/test_ne2000.cpp
@@ -0,0 +1,168 @@
+// T3 for the ao486 NE2000's wire in Main (support/netplay/ne2000.cpp): the
+// shared window's contract as the core (rtl/soc/ne2000/ne2000_core.v) and the
+// PR's reference daemon (sw/nettest/ne2000d.py) define it, with the window in
+// plain memory, a fake core writing and reading it, and a fake Ethernet.
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include <vector>
+#include <deque>
+#include <string>
+
+// ---- Main's surroundings, faked ---------------------------------------------
+static uint8_t window[0x10000] __attribute__((aligned(8)));
+void *shmem_map(uint32_t, uint32_t) { return window; }
+
+static uint32_t st_enable = 0, st_mode = 0;
+uint32_t user_io_status_get(const char *opt, int)
+{
+	if (!strcmp(opt, "[66]")) return st_enable;
+	if (!strcmp(opt, "[65:64]")) return st_mode;
+	return 0;
+}
+
+static int opens = 0, closes = 0, promisc_seen = -1;
+static std::string open_iface;
+static uint8_t filter_mac[6];
+static int filters = 0;
+static std::vector<std::vector<uint8_t>> sent;
+static std::deque<std::vector<uint8_t>> wire_in;
+int  ethernet_open(const char *iface, int promiscuous) { opens++; open_iface = iface; promisc_seen = promiscuous; return 1; }
+void ethernet_close(void) { closes++; }
+void ethernet_send(const uint8_t *f, int len) { sent.push_back(std::vector<uint8_t>(f, f + len)); }
+int  ethernet_recv_nb(uint8_t *buf, int maxlen)
+{
+	if (wire_in.empty()) return 0;
+	std::vector<uint8_t> f = wire_in.front(); wire_in.pop_front();
+	int n = (int)f.size() < maxlen ? (int)f.size() : maxlen;
+	memcpy(buf, f.data(), n);
+	return n;
+}
+int  ethernet_set_mac_filter(const uint8_t *mac) { memcpy(filter_mac, mac, 6); filters++; return 1; }
+int  ethernet_macvlan_create(const char *, const char *, const uint8_t *) { return 1; }
+void ethernet_macvlan_delete(const char *) {}
+int  a2065_mode_available(int mode) { return mode != 2; }   // no eth1 on this "MiSTer"
+
+#include "../ne2000.cpp"
+
+// ---- checks -----------------------------------------------------------------
+static int fails = 0, checks = 0;
+#define CHECK(c, ...) do { checks++; if (!(c)) { fails++; printf("FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+static uint16_t w16(uint32_t off) { return (uint16_t)(window[off] | (window[off + 1] << 8)); }
+static void set16(uint32_t off, uint16_t v) { window[off] = v & 0xFF; window[off + 1] = v >> 8; }
+// a 32-bit slot as the core assembles it: {word@off+2, word@off}
+static uint32_t core32(uint32_t off) { return ((uint32_t)w16(off + 2) << 16) | w16(off); }
+
+static std::vector<uint8_t> frame(uint8_t tag, int len, const uint8_t *src = 0)
+{
+	std::vector<uint8_t> f(len, tag);
+	memset(f.data(), 0xFF, 6);                                  // broadcast
+	static const uint8_t other[6] = { 0x02, 0, 0, 0, 0, 0x99 };
+	memcpy(f.data() + 6, src ? src : other, 6);
+	return f;
+}
+
+// the core stages a frame and publishes the sequence last
+static void core_tx(uint16_t seq, const std::vector<uint8_t> &f)
+{
+	memcpy(window + OFF_TX_BUFFER, f.data(), f.size());
+	set16(OFF_TX_REQ_LEN, (uint16_t)f.size());
+	set16(OFF_TX_REQ_SEQ, seq);
+}
+
+int main()
+{
+	// ---- start: the window is published over whatever DDR3 held
+	memset(window, 0xA5, sizeof(window));
+	ne2000_start();
+	CHECK(core32(OFF_SIGNATURE) == 0xCAFEBABE, "signature %08X", core32(OFF_SIGNATURE));
+	CHECK(w16(OFF_RX_HEAD) == 0 && w16(OFF_RX_TAIL) == 0 && w16(OFF_TX_REQ_SEQ) == 0, "window not cleared");
+	CHECK(window[0x8000] == 0 && window[0xFFFF] == 0, "window not cleared to the end");
+	CHECK(window[OFF_MAC] == 0x52 && window[OFF_MAC + 1] == 0x54 && window[OFF_MAC + 2] == 0x05 && window[OFF_MAC + 3] == 0x04,
+	      "MAC prefix %02X:%02X:%02X:%02X", window[OFF_MAC], window[OFF_MAC + 1], window[OFF_MAC + 2], window[OFF_MAC + 3]);
+	CHECK(!(window[OFF_MAC] & 1) && (window[OFF_MAC] & 2), "the core adopts only a unicast, locally administered MAC");
+	uint8_t card_mac[6];
+	memcpy(card_mac, window + OFF_MAC, 6);
+
+	// ---- the heartbeat moves on every pass; Network Off opens nothing
+	uint32_t hb0 = core32(OFF_HEARTBEAT);
+	ne2000_poll();
+	uint32_t hb1 = core32(OFF_HEARTBEAT);
+	ne2000_poll();
+	CHECK(hb1 != hb0 && core32(OFF_HEARTBEAT) != hb1, "heartbeat %u %u %u", hb0, hb1, core32(OFF_HEARTBEAT));
+	CHECK(opens == 0, "a link opened with Network Off");
+
+	// ---- with no link, a transmit completes and goes nowhere (a card without a cable)
+	core_tx(1, frame(0x11, 60));
+	ne2000_poll();
+	CHECK(w16(OFF_TX_DONE_SEQ) == 1 && sent.empty(), "TX without link: done %u, sent %zu", w16(OFF_TX_DONE_SEQ), sent.size());
+
+	// ---- Network On, Shared: eth0, promiscuous, filtered on the card's MAC
+	st_enable = 1; st_mode = 0;
+	ne2000_poll();
+	CHECK(opens == 1 && open_iface == "eth0" && promisc_seen == 1, "open %d %s %d", opens, open_iface.c_str(), promisc_seen);
+	CHECK(filters == 1 && !memcmp(filter_mac, card_mac, 6), "MAC filter not set to the card's address");
+
+	// ---- transmit: sent once, acked after the send, not again for the same sequence
+	std::vector<uint8_t> f2 = frame(0x22, 1514);
+	core_tx(2, f2);
+	ne2000_poll();
+	ne2000_poll();
+	CHECK(sent.size() == 1 && sent[0] == f2, "TX: %zu frames sent", sent.size());
+	CHECK(w16(OFF_TX_DONE_SEQ) == 2, "TX done %u", w16(OFF_TX_DONE_SEQ));
+
+	// a nonsense length is never acked (the guest would take it as sent)
+	set16(OFF_TX_REQ_LEN, 4000);
+	set16(OFF_TX_REQ_SEQ, 3);
+	ne2000_poll();
+	CHECK(w16(OFF_TX_DONE_SEQ) == 2 && sent.size() == 1, "bad length acked or sent");
+	core_tx(3, frame(0x33, 64));
+	ne2000_poll();
+	CHECK(w16(OFF_TX_DONE_SEQ) == 3 && sent.size() == 2, "the retried request did not go");
+
+	// ---- receive: slots in order, the length before the tail, our own echo and runts dropped
+	wire_in.push_back(frame(0x41, 60));
+	wire_in.push_back(frame(0x42, 60, card_mac));     // our own transmit, echoed
+	wire_in.push_back(std::vector<uint8_t>(10, 0x43)); // runt
+	wire_in.push_back(frame(0x44, 1514));
+	ne2000_poll();
+	CHECK(w16(OFF_RX_TAIL) == 2, "RX tail %u", w16(OFF_RX_TAIL));
+	CHECK(w16(OFF_RX_LEN + 0) == 60 && window[OFF_RX_DATA + 20] == 0x41, "slot 0");
+	CHECK(w16(OFF_RX_LEN + 2) == 1514 && window[OFF_RX_DATA + RX_SLOT_BYTES + 1000] == 0x44, "slot 1");
+	CHECK(window[OFF_FLAGS] & FLAG_RX_AVAIL, "RX_AVAIL not set");
+
+	// ---- the ring holds 15; what does not fit is dropped, not kept for later
+	for (int i = 0; i < 20; i++) wire_in.push_back(frame((uint8_t)(0x50 + i), 100));
+	ne2000_poll();
+	CHECK(w16(OFF_RX_TAIL) == 15 && wire_in.empty(), "full ring: tail %u, left %zu", w16(OFF_RX_TAIL), wire_in.size());
+	CHECK(window[OFF_RX_DATA + 14 * RX_SLOT_BYTES + 50] == 0x50 + 12, "slot 14 holds the 13th frame");
+
+	// the core consumes four: four more fit, wrapping past slot 15
+	set16(OFF_RX_HEAD, 4);
+	for (int i = 0; i < 6; i++) wire_in.push_back(frame((uint8_t)(0x70 + i), 80));
+	ne2000_poll();
+	CHECK(w16(OFF_RX_TAIL) == 3, "wrapped tail %u", w16(OFF_RX_TAIL));
+	CHECK(window[OFF_RX_DATA + 15 * RX_SLOT_BYTES + 40] == 0x70 && window[OFF_RX_DATA + 2 * RX_SLOT_BYTES + 40] == 0x73, "wrapped slots");
+
+	// ---- a mode the MiSTer lacks (eth1) is Off; back to Off closes the link
+	st_mode = 1;
+	ne2000_poll();
+	CHECK(closes >= 1, "eth1 (absent) did not close the link");
+	int opens_before = opens;
+	st_mode = 2;                                       // MACVLAN
+	ne2000_poll();
+	CHECK(opens == opens_before + 1 && open_iface == "ne2k0", "macvlan: %s", open_iface.c_str());
+	st_enable = 0;
+	int closes_before = closes;
+	ne2000_poll();
+	CHECK(closes == closes_before + 1, "Network Off did not close the link");
+
+	// ---- another core: the signature is withdrawn
+	ne2000_stop();
+	CHECK(core32(OFF_SIGNATURE) == 0, "signature left after stop");
+
+	printf("%s: %d checks, %d failed\n", fails ? "FAIL test_ne2000" : "PASS test_ne2000", checks, fails);
+	return fails ? 1 : 0;
+}
