diff --git a/support/netplay/ne2000.cpp b/support/netplay/ne2000.cpp
new file mode 100644
index 0000000..ede2a39
--- /dev/null
+++ b/support/netplay/ne2000.cpp
@@ -0,0 +1,263 @@
+// The wire behind the ao486 core's NE2000 -- see ne2000.h.
+//
+// The window's contract is the core's (rtl/soc/ne2000/ne2000_core.v, the
+// ETH_SHM_* offsets) and the PR's reference daemon (sw/nettest/ne2000d.py):
+//   1. clear the whole window before publishing anything
+//   2. the MAC, then the signature 0xCAFEBABE, last
+//   3. a heartbeat that changes on every pass (the core reports COMM_OK only
+//      while it moves)
+//   4. the signature cleared when Main lets go
+// The core reads the MAC once, when it leaves reset; it keeps its built-in
+// address unless the window holds a unicast, locally administered one.
+// 16-bit values are little-endian and a 32-bit value is {word+2, word}, so
+// plain little-endian access on the ARM matches both.
+//
+// Transmit: the core puts the frame at TX_BUFFER, its length at TX_REQ_LEN and
+// then a new TX_REQ_SEQ; Main sends it and only then copies the sequence to
+// TX_DONE_SEQ (the guest's transmit completes on that).
+// Receive: a ring of 16 slots of 1536 bytes; the core owns HEAD, Main owns
+// TAIL and writes the frame and its length before it advances TAIL.
+
+#include <stdio.h>
+#include <string.h>
+#include <stdint.h>
+
+#include "../../user_io.h"
+#include "../../shmem.h"
+#include "ne2000.h"
+
+// shared host-network layer from the A2065 module
+extern int  ethernet_open(const char *iface, int promiscuous);
+extern void ethernet_close(void);
+extern void ethernet_send(const uint8_t *frame, int len);
+extern int  ethernet_recv_nb(uint8_t *buf, int maxlen);
+extern int  ethernet_set_mac_filter(const uint8_t *mac);
+extern int  ethernet_macvlan_create(const char *parent, const char *name, const uint8_t *mac);
+extern void ethernet_macvlan_delete(const char *name);
+extern int  a2065_mode_available(int mode);
+
+#define NE_BASE          0x1FF00000UL
+#define NE_SIZE          0x10000UL
+
+#define OFF_FLAGS        0x1000
+#define OFF_MAC          0x104C
+#define OFF_STATUS       0x1052
+#define OFF_HEARTBEAT    0x1088
+#define OFF_SIGNATURE    0x108C
+#define OFF_TX_BUFFER    0x2000
+#define OFF_TX_REQ_LEN   0x2C02
+#define OFF_RX_HEAD      0x2C04
+#define OFF_RX_TAIL      0x2C06
+#define OFF_TX_REQ_SEQ   0x2C08
+#define OFF_TX_DONE_SEQ  0x2C0A
+#define OFF_RX_LEN       0x2C20      // 16 x u16, by slot
+#define OFF_RX_DATA      0x9000      // 16 x 1536 bytes
+
+#define RX_SLOTS         16
+#define RX_SLOT_BYTES    0x600
+#define FLAG_RX_AVAIL    0x04        // Main's bit in the low byte of FLAGS
+#define SIGNATURE        0xCAFEBABEu
+#define MAX_FRAME        1536
+
+#define ST_COMM_OK       0x1000
+
+// modes as the A2065 module numbers them (a2065_mode_available)
+#define MODE_OFF         0
+#define MODE_ETH0        1
+#define MODE_ETH1        2
+#define MODE_MACVLAN     3
+#define MODE_TAP         4
+
+#define MACVLAN_NAME     "ne2k0"
+
+static volatile uint8_t *win = 0;
+static int      running = 0;
+static int      link_open = 0;
+static int      made_macvlan = 0;
+static int      cur_mode = MODE_OFF;
+static uint32_t heartbeat = 0;
+static uint16_t last_tx_seq = 0;
+static uint16_t last_status = 0;
+static uint8_t  mac[6];
+
+static inline uint16_t rd16(uint32_t off) { return *(volatile uint16_t *)(win + off); }
+static inline void wr16(uint32_t off, uint16_t v) { *(volatile uint16_t *)(win + off) = v; }
+static inline void wr32(uint32_t off, uint32_t v) { *(volatile uint32_t *)(win + off) = v; }
+
+// 52:54:05:04 (unicast, locally administered: the card's own prefix) and the
+// last two bytes of eth0's address, so two MiSTers on one LAN differ.
+static void make_mac(void)
+{
+	static const uint8_t def[6] = { 0x52, 0x54, 0x05, 0x04, 0x03, 0x02 };
+	memcpy(mac, def, 6);
+	FILE *f = fopen("/sys/class/net/eth0/address", "r");
+	if (!f) return;
+	unsigned int b[6];
+	if (fscanf(f, "%x:%x:%x:%x:%x:%x", &b[0], &b[1], &b[2], &b[3], &b[4], &b[5]) == 6)
+	{
+		mac[4] = (uint8_t)b[4];
+		mac[5] = (uint8_t)b[5];
+	}
+	fclose(f);
+}
+
+static void close_link(void)
+{
+	if (link_open)
+	{
+		ethernet_close();
+		link_open = 0;
+	}
+	if (made_macvlan)
+	{
+		ethernet_macvlan_delete(MACVLAN_NAME);
+		made_macvlan = 0;
+	}
+}
+
+static void open_link(int mode)
+{
+	const char *iface;
+	int promisc = 0;
+
+	close_link();
+	switch (mode)
+	{
+	case MODE_ETH0:    iface = "eth0"; promisc = 1; break;   // shared NIC: promiscuous plus the MAC filter
+	case MODE_ETH1:    iface = "eth1"; break;
+	case MODE_MACVLAN:
+		if (!ethernet_macvlan_create("eth0", MACVLAN_NAME, mac)) return;
+		made_macvlan = 1;
+		iface = MACVLAN_NAME;
+		break;
+	case MODE_TAP:     iface = "tap0"; break;
+	default: return;
+	}
+
+	if (!ethernet_open(iface, promisc)) return;
+	link_open = 1;
+
+	// what the kernel queued before the link was up is stale for the guest
+	uint8_t scratch[MAX_FRAME];
+	while (ethernet_recv_nb(scratch, MAX_FRAME) > 0) {}
+
+	if (mode == MODE_ETH0) ethernet_set_mac_filter(mac);
+	printf("[ne2000] link up on %s (mode %d)\n", iface, mode);
+}
+
+static int mode_from_status(void)
+{
+	if (!user_io_status_get("[66]")) return MODE_OFF;
+	int mode = (int)user_io_status_get("[65:64]") + 1;
+	if (!a2065_mode_available(mode)) return MODE_OFF;
+	return mode;
+}
+
+void ne2000_start(void)
+{
+	if (!win)
+	{
+		win = (volatile uint8_t *)shmem_map(NE_BASE, NE_SIZE);
+		if (!win)
+		{
+			printf("[ne2000] shmem_map failed\n");
+			return;
+		}
+	}
+
+	close_link();
+	memset((void *)win, 0, NE_SIZE);
+	make_mac();
+	for (int i = 0; i < 6; i++) win[OFF_MAC + i] = mac[i];
+	heartbeat = 0;
+	wr32(OFF_HEARTBEAT, 0);
+	__sync_synchronize();
+	wr32(OFF_SIGNATURE, SIGNATURE);
+	__sync_synchronize();
+
+	last_tx_seq = rd16(OFF_TX_DONE_SEQ);
+	last_status = 0;
+	cur_mode = MODE_OFF;
+	running = 1;
+	printf("[ne2000] window at 0x%08lX, card MAC %02X:%02X:%02X:%02X:%02X:%02X\n",
+	       NE_BASE, mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
+}
+
+void ne2000_stop(void)
+{
+	if (!running) return;
+	running = 0;
+	close_link();
+	if (win) wr32(OFF_SIGNATURE, 0);
+	printf("[ne2000] stopped\n");
+}
+
+static void poll_tx(void)
+{
+	uint16_t seq = rd16(OFF_TX_REQ_SEQ);
+	if (seq == last_tx_seq || seq == 0) return;
+
+	int len = rd16(OFF_TX_REQ_LEN);
+	if (len <= 0 || len > MAX_FRAME) return;      // never ack nonsense: the guest would take it as sent
+
+	if (link_open)
+	{
+		static uint8_t frame[MAX_FRAME];
+		memcpy(frame, (const void *)(win + OFF_TX_BUFFER), len);
+		ethernet_send(frame, len);
+	}
+	// with no link the frame is dropped, as a card with no cable does
+	__sync_synchronize();
+	wr16(OFF_TX_DONE_SEQ, seq);
+	last_tx_seq = seq;
+}
+
+static void poll_rx(void)
+{
+	static uint8_t frame[MAX_FRAME];
+
+	// drain the socket dry every pass: a card that is not keeping up drops
+	// frames on the wire, it does not get them later
+	for (;;)
+	{
+		int len = ethernet_recv_nb(frame, MAX_FRAME);
+		if (len <= 0) break;
+		if (len < 14) continue;
+		if (!memcmp(frame + 6, mac, 6)) continue;  // our own transmit, echoed by AF_PACKET
+
+		uint16_t head = rd16(OFF_RX_HEAD) & (RX_SLOTS - 1);
+		uint16_t tail = rd16(OFF_RX_TAIL) & (RX_SLOTS - 1);
+		uint16_t next = (tail + 1) & (RX_SLOTS - 1);
+		if (next == head) continue;                  // ring full: the guest is behind
+
+		if (len > RX_SLOT_BYTES) len = RX_SLOT_BYTES;
+		memcpy((void *)(win + OFF_RX_DATA + tail * RX_SLOT_BYTES), frame, len);
+		wr16(OFF_RX_LEN + tail * 2, (uint16_t)len);
+		__sync_synchronize();
+		wr16(OFF_RX_TAIL, next);                     // only now is the slot the core's
+		win[OFF_FLAGS] = win[OFF_FLAGS] | FLAG_RX_AVAIL;
+	}
+}
+
+void ne2000_poll(void)
+{
+	if (!running || !win) return;
+
+	wr32(OFF_HEARTBEAT, ++heartbeat);
+
+	int mode = mode_from_status();
+	if (mode != cur_mode)
+	{
+		cur_mode = mode;
+		if (mode == MODE_OFF) close_link();
+		else open_link(mode);
+	}
+
+	poll_tx();
+	if (link_open) poll_rx();
+
+	uint16_t st = rd16(OFF_STATUS);
+	if ((st & ST_COMM_OK) != (last_status & ST_COMM_OK))
+		printf("[ne2000] core %s the window\n", (st & ST_COMM_OK) ? "talks to" : "lost");
+	last_status = st;
+}
diff --git a/support/netplay/ne2000.h b/support/netplay/ne2000.h
new file mode 100644
index 0000000..676beec
--- /dev/null
+++ b/support/netplay/ne2000.h
@@ -0,0 +1,17 @@
+#ifndef NP_NE2000_H
+#define NP_NE2000_H
+
+// The wire behind the ao486 core's NE2000 (rtl/soc/ne2000, from upstream
+// ao486 PR #238). The card exchanges raw Ethernet frames with Main through a
+// 64 KB window in DDR3 at ARM physical 0x1FF00000, the same window the A2065
+// and the NeXT core use (one core runs at a time). The host network side
+// (AF_PACKET sockets, the MAC filter, macvlan, tap) is the A2065 module's.
+//
+// OSD (ao486.sv): [66] Network Off/On, [68:67] the card's IRQ (the core's
+// business), [65:64] the mode: Shared (eth0), eth1, MACVLAN, Bridge (tap0).
+
+void ne2000_start(void);   // the core was loaded: publish the window
+void ne2000_stop(void);    // another core: close the link, withdraw the window
+void ne2000_poll(void);    // every pass of Main's loop
+
+#endif
