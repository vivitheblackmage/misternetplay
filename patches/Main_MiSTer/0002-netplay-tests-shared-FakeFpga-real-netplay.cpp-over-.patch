diff --git a/support/netplay/test/udp_harness.cpp b/support/netplay/test/udp_harness.cpp
new file mode 100644
index 0000000..57398d4
--- /dev/null
+++ b/support/netplay/test/udp_harness.cpp
@@ -0,0 +1,107 @@
+// udp_harness.cpp — runs the real support/netplay/netplay.cpp (thread, UDP,
+// ini parsing, ROM reload handshake) on x86 against a FakeFpga, with the few
+// MiSTer functions it calls stubbed out. One process per player:
+//
+//   udp_harness <host|join> <workdir> <frames>
+//
+// Prints "RESULT frames=<n> digest=<hash of every input seen>" on success.
+// run_udp_test.sh starts a host and a join and compares the digests.
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+#include <string>
+
+#include "../netplay.h"
+#include "fake_fpga.h"
+
+using namespace netplay;
+
+static FakeFpga   *fpga;
+static std::string workdir;
+static int         reloads = 0;
+
+// --- stubs for the MiSTer functions netplay.cpp uses ------------------------
+
+char *user_io_get_core_name(int) { static char n[] = "NES"; return n; }
+
+char *user_io_get_confstr(int index)
+{
+	static char a[] = "NES", b[] = "V,v261030";
+	return index == 0 ? a : index == 1 ? b : nullptr;
+}
+
+uint32_t user_io_status_get(const char *opt, int)
+{
+	if (!strcmp(opt, "[66:65]")) return 1;   // RAM Clear $00
+	if (!strcmp(opt, "[20]")) return 1;      // cheats off
+	return 0;
+}
+
+int user_io_file_tx(const char *name, unsigned char index, char, char, char, uint32_t)
+{
+	reloads++;
+	printf("[harness] reload %s index %u\n", name, index);
+	netplay_note_file(name, index);           // like the real one: must be ignored
+	return 1;
+}
+
+const char *getFullPath(const char *name)
+{
+	static char buf[1024];
+	snprintf(buf, sizeof(buf), "%s/%s", workdir.c_str(), name);
+	return buf;
+}
+
+void Info(const char *message, int, int, int, int) { printf("[osd] %s\n", message); fflush(stdout); }
+
+void *shmem_map(uint32_t, uint32_t) { return fpga->own; }
+int shmem_unmap(void *, uint32_t) { return 1; }
+
+// -----------------------------------------------------------------------------
+
+static uint64_t now_ms()
+{
+	timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (uint64_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+int main(int argc, char **argv)
+{
+	if (argc != 4) { fprintf(stderr, "usage: udp_harness <host|join> <workdir> <frames>\n"); return 2; }
+	bool host = !strcmp(argv[1], "host");
+	workdir = argv[2];
+	uint32_t want = (uint32_t)atoi(argv[3]);
+
+	FILE *f = fopen(getFullPath("netplay.ini"), "w");
+	fprintf(f, "; test\n[netplay]\nmode = %s ; comment\npeer=%s\nport=47845\ndelay=3\n",
+	        host ? "host" : "join", host ? "" : "127.0.0.1");
+	fclose(f);
+
+	f = fopen(getFullPath("game.nes"), "wb");               // same bytes on both sides
+	uint8_t hdr[16] = {'N', 'E', 'S', 0x1A, 2, 1};
+	fwrite(hdr, 16, 1, f);
+	for (int i = 0; i < 40960; i++) fputc((i * 7) & 0xFF, f);
+	fclose(f);
+
+	fpga = new FakeFpga(host ? 0 : 1);
+	netplay_start();
+	netplay_note_file("game.nes", 1);
+
+	uint64_t t0 = now_ms();
+	while (fpga->frame < want && now_ms() - t0 < 60000)
+	{
+		fpga->step(now_ms());
+		netplay_poll();
+		usleep(500);
+	}
+	netplay_stop();
+
+	uint64_t digest = 1469598103934665603ULL;
+	for (auto &p : fpga->seen) { digest = (digest ^ p.first) * 1099511628211ULL; digest = (digest ^ p.second) * 1099511628211ULL; }
+	printf("RESULT frames=%u stalls=%u reloads=%d digest=%016llx\n", fpga->frame, fpga->stalls, reloads, (unsigned long long)digest);
+	return (fpga->frame >= want && reloads == 1) ? 0 : 1;
+}
