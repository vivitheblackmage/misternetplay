+// rfu.cpp — the GBA Wireless Adapter (RFU), emulated on the HPS (SPEC.md 13.4).
+//
+// Ported from gpSP's rfu.c, Copyright (C) 2023 David Guillen Fandos
+// <david@davidgf.net>, GPL-2.0-or-later. Changes: a class instead of globals,
+// time in milliseconds instead of GBA cycles, packets to "peer n" instead of
+// RetroArch netpacket client IDs, and every length and index taken from a
+// packet is checked (packets come from the network; Main runs as root).
+
+#include "rfu.h"
+#include <string.h>
+
+namespace {
+
+// command numbers (afska's names in comments)
+enum : uint8_t {
+	CMD_INIT1 = 0x10,        // Hello
+	CMD_LINKPWR = 0x11,      // SignalLevel
+	CMD_SYSVER = 0x12,       // VersionStatus
+	CMD_SYSSTAT = 0x13,      // SystemStatus
+	CMD_SLOTSTAT = 0x14,     // SlotStatus
+	CMD_CFGSTAT = 0x15,      // ConfigStatus
+	CMD_BCST_DATA = 0x16,    // Broadcast
+	CMD_SYSCFG = 0x17,       // Setup
+	CMD_HOST_START = 0x19,   // StartHost
+	CMD_HOST_ACCEPT = 0x1a,  // PollConnections
+	CMD_HOST_STOP = 0x1b,    // EndHost
+	CMD_BCRD_START = 0x1c,   // BroadcastReadStart
+	CMD_BCRD_FETCH = 0x1d,   // BroadcastReadPoll
+	CMD_BCRD_STOP = 0x1e,    // BroadcastReadEnd
+	CMD_CONNECT = 0x1f,      // Connect
+	CMD_ISCONNECTED = 0x20,  // IsConnectionComplete
+	CMD_CONCOMPL = 0x21,     // FinishConnection
+	CMD_SEND_DATA = 0x24,    // SendData
+	CMD_SEND_DATAW = 0x25,   // SendDataWait
+	CMD_RECV_DATA = 0x26,    // ReceiveData
+	CMD_WAIT = 0x27,         // Wait
+	CMD_DISCONNECT = 0x30,   // DisconnectClient
+	CMD_RTX_WAIT = 0x37,     // RetransmitAndWait
+	CMD_INIT2 = 0x3d,        // Bye
+	// pushed by the adapter while it is clock master
+	EVT_TIMEOUT = 0x27,
+	EVT_DATA = 0x28,
+	EVT_DISC = 0x29,
+};
+
+const uint32_t CONN_INPROGRESS = 0x01000000;
+const uint32_t CONN_FAILED = 0x02000000;
+const uint32_t CONN_COMP_FAIL = 0x01000000;
+
+// network packets (gpSP's RFU1)
+const uint32_t NET_HEADER = 0x52465531;   // "RFU1"
+enum : uint32_t {
+	NET_BROADCAST = 0, NET_CONNECT_REQ = 1, NET_CONNECT_ACK = 2, NET_CONNECT_NACK = 3,
+	NET_DISCONNECT = 4, NET_HOST_SEND = 5, NET_CLIENT_SEND = 6, NET_CLIENT_ACK = 7,
+};
+
+const unsigned BCST_ANNOUNCE_FRAMES = 30;     // broadcast twice per second
+const unsigned CLIENT_TIMEOUT_FRAMES = 240;   // host drops a silent client after 4 s
+
+uint32_t be32(const uint8_t *p) { return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3]; }
+uint32_t le32(const uint8_t *p) { return p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24; }
+void put_be32(uint8_t *p, uint32_t v) { p[0] = v >> 24; p[1] = v >> 16; p[2] = v >> 8; p[3] = v; }
+
+}
+
+Rfu::Rfu(Send send, uint32_t seed) : send_(send), rng_(seed ? seed : 1)
+{
+	reset();
+}
+
+uint32_t Rfu::rand()
+{
+	rng_ ^= rng_ << 13;
+	rng_ ^= rng_ >> 17;
+	rng_ ^= rng_ << 5;
+	return rng_;
+}
+
+uint16_t Rfu::new_devid()
+{
+	for (;;)
+	{
+		uint16_t n = (uint16_t)rand();
+		if (n) return n;
+	}
+}
+
+void Rfu::reset()
+{
+	state_ = IDLE;
+	waiting_ = false;
+	timeout_frames_ = 32;
+	rtx_max_ = 4;
+	memset(&tx_, 0, sizeof(tx_));
+	memset(&host_, 0, sizeof(host_));
+	memset(&client_, 0, sizeof(client_));
+	memset(peer_bcst_, 0, sizeof(peer_bcst_));
+}
+
+void Rfu::send_cmd(int peer, uint32_t ptype, uint32_t h)
+{
+	uint8_t pkt[16] = {};
+	put_be32(pkt, NET_HEADER);
+	put_be32(pkt + 4, ptype);
+	put_be32(pkt + 8, h);
+	send_(peer, pkt, sizeof(pkt));
+}
+
+void Rfu::send_bcast(uint32_t ptype, uint32_t h, const uint32_t *pload)
+{
+	uint8_t pkt[36];
+	put_be32(pkt, NET_HEADER);
+	put_be32(pkt + 4, ptype);
+	put_be32(pkt + 8, h);
+	for (int i = 0; i < 6; i++) put_be32(pkt + 12 + 4 * i, pload[i]);
+	send_(-1, pkt, sizeof(pkt));
+}
+
+void Rfu::send_data(int peer, uint32_t ptype, uint32_t h, const uint32_t *pload, unsigned plen)
+{
+	uint8_t pkt[104] = {};
+	put_be32(pkt, NET_HEADER);
+	put_be32(pkt + 4, ptype);
+	put_be32(pkt + 8, h);
+	if (plen > 92) plen = 92;
+	// data goes little endian over the air
+	for (unsigned i = 0; i < plen; i++) pkt[12 + i] = (uint8_t)(pload[i / 4] >> (8 * (i & 3)));
+	send_(peer, pkt, sizeof(pkt));
+}
+
+bool Rfu::data_avail() const
+{
+	if (state_ == CLIENT) return client_.pkts[0].len != 0;
+	if (state_ == HOST)
+		for (int i = 0; i < 4; i++)
+			if (host_.clients[i].devid && host_.clients[i].pkts[0].len) return true;
+	return false;
+}
+
+int Rfu::command(uint8_t cmd, const uint32_t *data, int len, uint32_t *out)
+{
+	if (len < 0) len = 0;
+	if (len > MAX_WORDS) len = MAX_WORDS;
+	if (len) memcpy(buf_, data, len * sizeof(uint32_t));
+	int cnt = 0;
+
+	switch (cmd)
+	{
+	case CMD_INIT1:
+	case CMD_INIT2:
+	case CMD_WAIT:              // the FPGA turns the clock around after the ack
+	case CMD_BCRD_START:
+		return 0;
+
+	case CMD_SYSCFG:
+		if (len < 1) return 0;
+		timeout_frames_ = (uint8_t)buf_[0];
+		rtx_max_ = (uint8_t)(buf_[0] >> 8);
+		return 0;
+
+	case CMD_SYSVER:
+		out[0] = 0x00830117;
+		return 1;
+
+	case CMD_SYSSTAT:
+		if (state_ == HOST) out[0] = (1u << 24) | host_.devid;
+		else if (state_ == CLIENT) out[0] = (5u << 24) | ((1u << client_.clnum) << 16) | client_.devid;
+		else out[0] = 0;
+		return 1;
+
+	case CMD_SLOTSTAT:
+		if (state_ != HOST) return 0;
+		out[cnt++] = 0;
+		for (int i = 0; i < 4; i++)
+			if (host_.clients[i].devid)
+			{
+				out[0]++;
+				out[cnt++] = host_.clients[i].devid | (uint32_t)i << 16;
+			}
+		return cnt;
+
+	case CMD_CFGSTAT:
+		return 0;
+
+	case CMD_LINKPWR:
+		if (state_ == HOST)
+			out[0] = (host_.clients[0].devid ? 0x000000ffu : 0) | (host_.clients[1].devid ? 0x0000ff00u : 0) |
+			         (host_.clients[2].devid ? 0x00ff0000u : 0) | (host_.clients[3].devid ? 0xff000000u : 0);
+		else out[0] = state_ == CLIENT ? 0xffffffffu : 0;
+		return 1;
+
+	case CMD_BCRD_FETCH:
+	case CMD_BCRD_STOP:
+	{
+		// up to four broadcasting peers, starting at a random one (as gpSP)
+		int first = (int)(rand() % MAX_PEERS);
+		for (int j = 0; j < MAX_PEERS && cnt < 4 * 7; j++)
+		{
+			const Bcst &b = peer_bcst_[(first + j) % MAX_PEERS];
+			if (!b.valid) continue;
+			out[cnt++] = b.devid;
+			memcpy(&out[cnt], b.data, sizeof(b.data));
+			cnt += 6;
+		}
+		return cnt;
+	}
+
+	case CMD_BCST_DATA:
+		if (len == 6) memcpy(host_.bdata, buf_, sizeof(host_.bdata));
+		return 0;
+
+	case CMD_HOST_START:
+		if (state_ == CLIENT) return -1;
+		if (state_ == IDLE)
+		{
+			host_.devid = new_devid();
+			memset(host_.clients, 0, sizeof(host_.clients));
+			state_ = HOST;
+		}
+		host_.tx_ttl = 0xff;   // broadcast on the next frame
+		return 0;
+
+	case CMD_HOST_STOP:
+		if (state_ == IDLE) return -1;
+		if (state_ == HOST)
+		{
+			for (int i = 0; i < 4; i++)
+				if (host_.clients[i].devid) return 0;   // keeps hosting its clients
+			state_ = IDLE;
+		}
+		return 0;
+
+	case CMD_HOST_ACCEPT:
+		if (state_ == IDLE) return -1;
+		for (int i = 0; i < 4; i++)
+			if (host_.clients[i].devid) out[cnt++] = host_.clients[i].devid | (uint32_t)i << 16;
+		return cnt;
+
+	case CMD_CONNECT:
+		if (state_ == HOST) return -1;
+		if (len >= 1)
+		{
+			uint16_t reqid = (uint16_t)buf_[0];
+			for (int i = 0; i < MAX_PEERS; i++)
+				if (peer_bcst_[i].valid && peer_bcst_[i].devid == reqid)
+				{
+					send_cmd(i, NET_CONNECT_REQ, reqid);
+					state_ = CONNECTING;
+					return 0;
+				}
+		}
+		return 0;   // unknown ID: IsConnectionComplete fails later
+
+	case CMD_ISCONNECTED:
+		if (state_ == HOST) return -1;
+		if (state_ == CONNECTING) out[0] = CONN_INPROGRESS;
+		else if (state_ == IDLE) out[0] = CONN_FAILED;
+		else out[0] = client_.devid | (uint32_t)client_.clnum << 16;
+		return 1;
+
+	case CMD_CONCOMPL:
+		if (state_ == HOST) return -1;
+		if (state_ == CLIENT) out[0] = client_.devid | (uint32_t)client_.clnum << 16;
+		else
+		{
+			out[0] = CONN_COMP_FAIL;
+			state_ = IDLE;
+		}
+		return 1;
+
+	case CMD_SEND_DATAW:
+	case CMD_SEND_DATA:
+		if (!len) return 0;
+		if (state_ == HOST) tx_.blen = buf_[0] & 0x7f;
+		else if (state_ == CLIENT) tx_.blen = (buf_[0] >> (8 + client_.clnum * 5)) & 0x1f;
+		if (state_ == HOST || state_ == CLIENT)
+		{
+			int words = len - 1;
+			if (words > 23) words = 23;
+			memcpy(tx_.buf, &buf_[1], words * sizeof(uint32_t));
+			if (tx_.blen > words * 4) tx_.blen = (uint8_t)(words * 4);   // never more than the game gave
+		}
+		/* fallthrough */
+	case CMD_RTX_WAIT:
+		if (state_ == HOST)
+		{
+			if (tx_.blen <= 90)
+				for (int i = 0; i < 4; i++)
+					if (host_.clients[i].devid)
+						send_data(host_.clients[i].peer, NET_HOST_SEND, tx_.blen, tx_.buf, tx_.blen);
+		}
+		else if (state_ == CLIENT)
+		{
+			if (tx_.blen <= 16)
+				send_data(client_.host_peer, NET_CLIENT_SEND,
+				          (uint32_t)tx_.blen << 24 | (uint32_t)client_.clnum << 16 | client_.devid, tx_.buf, tx_.blen);
+		}
+		else return -1;   // neither connected nor hosting
+		return 0;
+
+	case CMD_RECV_DATA:
+		if (state_ == HOST)
+		{
+			uint8_t tmp[16 * 4] = {};
+			unsigned bytes = 0;
+			out[cnt++] = 0;   // byte counts per client as a bitfield
+			for (int i = 0; i < 4; i++)
+			{
+				Client &c = host_.clients[i];
+				uint32_t dlen = c.pkts[0].len < 16 ? c.pkts[0].len : 16;
+				if (!c.devid || !dlen) continue;
+				memcpy(&tmp[bytes], c.pkts[0].data, dlen);
+				bytes += dlen;
+				out[0] |= dlen << (8 + i * 5);
+				memmove(&c.pkts[0], &c.pkts[1], 3 * sizeof(c.pkts[0]));
+				c.pkts[3].len = 0;
+			}
+			for (unsigned i = 0; i < (bytes + 3) / 4; i++) out[cnt++] = le32(&tmp[i * 4]);
+			return cnt;
+		}
+		if (state_ == CLIENT)
+		{
+			uint32_t dlen = client_.pkts[0].len;
+			out[cnt++] = dlen;
+			for (uint32_t j = 0; j < (dlen + 3) / 4; j++) out[cnt++] = le32(&client_.pkts[0].data[j * 4]);
+			memmove(&client_.pkts[0], &client_.pkts[1], 3 * sizeof(client_.pkts[0]));
+			client_.pkts[3].len = 0;
+			return cnt;
+		}
+		return 0;
+
+	case CMD_DISCONNECT:
+		if (state_ == CLIENT)
+		{
+			send_cmd(client_.host_peer, NET_DISCONNECT, client_.devid | (uint32_t)client_.clnum << 16);
+			state_ = IDLE;
+		}
+		else if (state_ == HOST && len >= 1)
+		{
+			for (int i = 0; i < 4; i++)
+				if (buf_[0] & (1u << i) && host_.clients[i].devid)
+				{
+					send_cmd(host_.clients[i].peer, NET_DISCONNECT, host_.clients[i].devid | (uint32_t)i << 16);
+					memset(&host_.clients[i], 0, sizeof(host_.clients[i]));
+				}
+		}
+		return 0;
+
+	default:
+		return 0;   // unknown commands are acked (as gpSP)
+	}
+}
+
+void Rfu::begin_wait(uint32_t now_ms)
+{
+	wait_start_ = now_ms;
+	waiting_ = true;
+}
+
+int Rfu::wait_poll(uint32_t now_ms, uint32_t *out)
+{
+	if (!waiting_) return 0;
+	uint32_t waited = now_ms - wait_start_;
+	// timeouts as gpSP: Setup's timeout in frames (0: none), and for a host
+	// the retransmissions in adapter "frames" of 1/6 of a GBA frame
+	bool timed_out = timeout_frames_ && waited >= (uint32_t)timeout_frames_ * 1000 / 60;
+	bool rtx_out = waited >= (uint32_t)rtx_max_ * 1000 / 360;
+	int n = 0;
+	if (state_ == IDLE)
+	{
+		out[n++] = 0x99660000 | 1 << 8 | EVT_DISC;
+		out[n++] = 0xF;
+	}
+	else if (data_avail()) out[n++] = 0x99660000 | EVT_DATA;
+	else if (state_ == HOST && rtx_out)
+	{
+		out[n++] = 0x99660000 | 1 << 8 | EVT_DATA;   // clients that did not receive
+		out[n++] = 0x00000F0F;
+	}
+	else if (timed_out) out[n++] = 0x99660000 | EVT_TIMEOUT;
+	else return 0;
+	out[n++] = 0x80000000;
+	waiting_ = false;
+	return n;
+}
+
+void Rfu::frame()
+{
+	for (int i = 0; i < MAX_PEERS; i++)
+		if (peer_bcst_[i].valid && --peer_bcst_[i].ttl == 0) peer_bcst_[i].valid = false;
+	if (state_ != HOST) return;
+	if (host_.tx_ttl++ >= BCST_ANNOUNCE_FRAMES)
+	{
+		host_.tx_ttl = 0;
+		send_bcast(NET_BROADCAST, host_.devid, host_.bdata);
+	}
+	for (int i = 0; i < 4; i++)
+		if (host_.clients[i].devid && ++host_.clients[i].ttl >= CLIENT_TIMEOUT_FRAMES)
+			memset(&host_.clients[i], 0, sizeof(host_.clients[i]));
+}
+
+void Rfu::receive(int peer, const uint8_t *buf, size_t len)
+{
+	if (peer < 0 || peer >= MAX_PEERS || len < 12 || be32(buf) != NET_HEADER) return;
+	uint32_t ptype = be32(buf + 4);
+	uint32_t h = be32(buf + 8);
+	const uint8_t *payl = buf + 12;
+	size_t plen = len - 12;
+
+	switch (ptype)
+	{
+	case NET_BROADCAST:
+		if (plen < 24) return;
+		peer_bcst_[peer].devid = (uint16_t)h;
+		peer_bcst_[peer].valid = true;
+		peer_bcst_[peer].ttl = 0xff;
+		for (int j = 0; j < 6; j++) peer_bcst_[peer].data[j] = be32(payl + 4 * j);
+		break;
+
+	case NET_CONNECT_REQ:
+		if (state_ != HOST)
+		{
+			send_cmd(peer, NET_CONNECT_NACK, 0);
+			return;
+		}
+		for (int i = 0; i < 4; i++)
+			if (host_.clients[i].devid && host_.clients[i].peer == peer) return;   // already in
+		for (int i = 0; i < 4; i++)
+			if (!host_.clients[i].devid)
+			{
+				memset(&host_.clients[i], 0, sizeof(host_.clients[i]));
+				host_.clients[i].devid = new_devid();
+				host_.clients[i].peer = peer;
+				send_cmd(peer, NET_CONNECT_ACK, host_.clients[i].devid | (uint32_t)i << 16);
+				return;
+			}
+		send_cmd(peer, NET_CONNECT_NACK, 0);
+		break;
+
+	case NET_CONNECT_ACK:
+		if (state_ != CONNECTING) return;
+		memset(&client_, 0, sizeof(client_));
+		client_.devid = (uint16_t)h;
+		client_.clnum = (h >> 16) & 3;
+		client_.host_peer = peer;
+		state_ = CLIENT;
+		break;
+
+	case NET_CONNECT_NACK:
+		if (state_ == CONNECTING) state_ = IDLE;
+		break;
+
+	case NET_DISCONNECT:
+		if (state_ == HOST)
+		{
+			uint32_t clnum = (h >> 16) & 3;
+			if (host_.clients[clnum].devid == (uint16_t)h && host_.clients[clnum].peer == peer)
+				memset(&host_.clients[clnum], 0, sizeof(host_.clients[clnum]));
+		}
+		else if (state_ == CLIENT && peer == client_.host_peer)
+		{
+			memset(&client_, 0, sizeof(client_));
+			state_ = IDLE;
+		}
+		break;
+
+	case NET_HOST_SEND:
+		if (state_ != CLIENT || peer != client_.host_peer) return;
+		{
+			uint32_t blen = h & 0x7f;
+			if (blen > plen || blen > sizeof(client_.pkts[0].data)) return;
+			send_cmd(peer, NET_CLIENT_ACK, client_.devid | (uint32_t)client_.clnum << 16);
+			for (int i = 0; i < 4; i++)
+				if (!client_.pkts[i].len)
+				{
+					memcpy(client_.pkts[i].data, payl, blen);
+					client_.pkts[i].len = (uint16_t)blen;
+					return;
+				}
+		}
+		break;
+
+	case NET_CLIENT_SEND:
+		if (state_ != HOST) return;
+		{
+			uint16_t devid = (uint16_t)h;
+			uint32_t clid = (h >> 16) & 3, blen = h >> 24;
+			Client &c = host_.clients[clid];
+			if (c.devid != devid || c.peer != peer || blen > 16 || blen > plen) return;
+			c.ttl = 0;
+			for (int i = 0; i < 4; i++)
+				if (!c.pkts[i].len)
+				{
+					memcpy(c.pkts[i].data, payl, blen);
+					c.pkts[i].len = blen;
+					return;
+				}
+		}
+		break;
+
+	case NET_CLIENT_ACK:
+		if (state_ != HOST) return;
+		{
+			uint32_t clid = (h >> 16) & 3;
+			if (host_.clients[clid].devid == (uint16_t)h && host_.clients[clid].peer == peer) host_.clients[clid].ttl = 0;
+		}
+		break;
+	}
+}
diff --git a/support/netplay/rfu.h b/support/netplay/rfu.h
new file mode 100644
index 0000000..191ab27
--- /dev/null
+++ b/support/netplay/rfu.h
@@ -0,0 +1,80 @@
+// rfu.h — the GBA Wireless Adapter (RFU), emulated on the HPS (SPEC.md 13.4).
+//
+// Ported from gpSP's rfu.c (Copyright (C) 2023 David Guillen Fandos,
+// GPL-2.0-or-later); the protocol as documented by afska and davidgfnet in
+// gba-link-connection (docs/wireless_adapter.md). The packets between adapters
+// are gpSP's (RFU1), so a later bridge to RetroArch can carry them unchanged.
+//
+// The core collects a whole command (0x9966LLCC + LL words) and asks once per
+// command; the NINTENDO handshake and the word streaming stay in the FPGA.
+// Not thread-safe: one thread (the netplay thread) owns an Rfu.
+
+#ifndef RFU_H
+#define RFU_H
+
+#include <stdint.h>
+#include <stddef.h>
+#include <functional>
+
+class Rfu
+{
+public:
+	static const int MAX_PEERS = 4;           // other players this adapter can see
+	static const int MAX_WORDS = 255;         // longest answer
+
+	// peer: 0..MAX_PEERS-1, or -1 for every peer (broadcast)
+	using Send = std::function<void(int peer, const uint8_t *buf, size_t len)>;
+
+	Rfu(Send send, uint32_t seed);
+
+	void reset();                             // SD pulse, or the core's reset
+
+	// A complete command from the GBA. Returns the number of answer words in
+	// out (the FPGA sends the ack 0x99660080|cmd|n<<8 before them), or a
+	// negative error code (the FPGA sends 0x996601ee and then -result).
+	int command(uint8_t cmd, const uint32_t *data, int len, uint32_t *out);
+
+	// After the ack of Wait, SendDataWait or RetransmitAndWait the adapter is
+	// clock master: call begin_wait(), then wait_poll() until it returns words
+	// to push to the GBA (the event and its words, 0x80000000 last).
+	static bool waits(uint8_t cmd) { return cmd == 0x27 || cmd == 0x25 || cmd == 0x37; }
+	void begin_wait(uint32_t now_ms);
+	int wait_poll(uint32_t now_ms, uint32_t *out);
+
+	void frame();                             // once per GBA frame (TTLs, host broadcast)
+	void receive(int peer, const uint8_t *buf, size_t len);   // a packet from a peer
+
+	// observation (tests, OSD)
+	enum State { IDLE, HOST, CONNECTING, CLIENT };
+	State state() const { return state_; }
+
+private:
+	Send send_;
+	uint32_t rng_;
+	State state_ = IDLE;
+	uint32_t buf_[MAX_WORDS];                 // command data, then answer
+	uint8_t timeout_frames_ = 32, rtx_max_ = 4;
+	uint32_t wait_start_ = 0;
+	bool waiting_ = false;
+
+	struct { uint32_t buf[23]; uint8_t blen; } tx_ {};
+
+	struct Pkt { uint32_t len; uint8_t data[16]; };
+	struct Client { int peer; uint16_t devid, ttl; Pkt pkts[4]; };
+	struct { uint16_t devid; uint8_t tx_ttl; uint32_t bdata[6]; Client clients[4]; } host_ {};
+
+	struct HPkt { uint16_t len; uint8_t data[128]; };
+	struct { uint16_t devid, clnum; int host_peer; HPkt pkts[4]; } client_ {};
+
+	struct Bcst { bool valid; uint8_t ttl; uint16_t devid; uint32_t data[6]; };
+	Bcst peer_bcst_[MAX_PEERS] {};
+
+	uint16_t new_devid();
+	uint32_t rand();
+	bool data_avail() const;
+	void send_cmd(int peer, uint32_t ptype, uint32_t h);
+	void send_bcast(uint32_t ptype, uint32_t h, const uint32_t *pload);
+	void send_data(int peer, uint32_t ptype, uint32_t h, const uint32_t *pload, unsigned plen);
+};
+
+#endif
