diff --git a/support/netplay/test/test_rfu.cpp b/support/netplay/test/test_rfu.cpp
new file mode 100644
index 0000000..b3db18c
--- /dev/null
+++ b/support/netplay/test/test_rfu.cpp
@@ -0,0 +1,183 @@
+// T3w (SPEC.md 13.6), first part: two emulated wireless adapters (rfu.cpp)
+// talking through an in-memory link, driven by the command sequences
+// gba-link-connection's LinkRawWireless sends: host, broadcast read, connect,
+// data both ways, wait events, disconnect, timeout. Then malformed packets.
+
+#include "../rfu.h"
+#include <stdio.h>
+#include <string.h>
+#include <deque>
+#include <vector>
+
+static int fails = 0, checks = 0;
+#define CHECK(c, ...) do { checks++; if (!(c)) { fails++; printf("FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+struct Packet { int to; std::vector<uint8_t> data; };
+static std::deque<Packet> wire;      // packets in flight (to 0 = A, 1 = B)
+
+// A is peer 0 of B and B is peer 0 of A (each sees one other player)
+static Rfu A([](int, const uint8_t *b, size_t n) { wire.push_back({1, std::vector<uint8_t>(b, b + n)}); }, 11);
+static Rfu B([](int, const uint8_t *b, size_t n) { wire.push_back({0, std::vector<uint8_t>(b, b + n)}); }, 22);
+
+static void deliver()
+{
+	while (!wire.empty())
+	{
+		Packet p = wire.front();
+		wire.pop_front();
+		(p.to == 0 ? A : B).receive(0, p.data.data(), p.data.size());
+	}
+}
+
+static uint32_t out[Rfu::MAX_WORDS];
+static int cmd(Rfu &r, uint8_t c, std::vector<uint32_t> d = {})
+{
+	int n = r.command(c, d.data(), (int)d.size(), out);
+	deliver();
+	return n;
+}
+
+int main()
+{
+	// --- setup and hosting (A) ---
+	CHECK(cmd(A, 0x10) == 0, "Hello");
+	CHECK(cmd(A, 0x17, {0x003C0420}) == 0, "Setup");
+	CHECK(cmd(A, 0x16, {0x11, 0x22, 0x33, 0x44, 0x55, 0x66}) == 0, "Broadcast");
+	CHECK(cmd(A, 0x19) == 0 && A.state() == Rfu::HOST, "StartHost");
+	CHECK(cmd(A, 0x13) == 1 && (out[0] >> 24) == 1, "SystemStatus host");
+	uint16_t host_id = out[0] & 0xffff;
+	CHECK(host_id != 0, "host has an ID");
+	A.frame();                  // the first frame after StartHost broadcasts
+	deliver();
+
+	// --- search (B) ---
+	CHECK(cmd(B, 0x10) == 0, "Hello B");
+	CHECK(cmd(B, 0x1c) == 0, "BroadcastReadStart");
+	int n = cmd(B, 0x1d);
+	CHECK(n == 7, "BroadcastReadPoll: one host (%d words)", n);
+	CHECK(out[0] == host_id && out[1] == 0x11 && out[6] == 0x66, "broadcast data %x %x %x", out[0], out[1], out[6]);
+	CHECK(cmd(B, 0x1e) == 7, "BroadcastReadEnd");
+
+	// --- connect (B to A) ---
+	CHECK(cmd(B, 0x1f, {host_id}) == 0 && B.state() == Rfu::CLIENT, "Connect (state %d)", B.state());
+	CHECK(cmd(B, 0x20) == 1 && (out[0] >> 16) == 0, "IsConnectionComplete: client 0 (%x)", out[0]);
+	uint16_t client_id = out[0] & 0xffff;
+	CHECK(cmd(B, 0x21) == 1 && (out[0] & 0xffff) == client_id, "FinishConnection");
+	CHECK(cmd(A, 0x1a) == 1 && out[0] == client_id, "PollConnections: %x", out[0]);
+	CHECK(cmd(A, 0x14) == 2 && out[0] == 1 && out[1] == client_id, "SlotStatus");
+
+	// --- host to client ---
+	CHECK(cmd(A, 0x24, {8, 0xaabbccdd, 0x12345678}) == 0, "host SendData");
+	n = cmd(B, 0x26);
+	CHECK(n == 3 && out[0] == 8 && out[1] == 0xaabbccdd && out[2] == 0x12345678, "client ReceiveData %d %x %x %x", n, out[0], out[1], out[2]);
+	CHECK(cmd(B, 0x26) == 1 && out[0] == 0, "client ReceiveData again: nothing");
+
+	// --- client to host (client 0: header bytes << 8) ---
+	CHECK(cmd(B, 0x24, {4u << 8, 0xcafef00d}) == 0, "client SendData");
+	n = cmd(A, 0x26);
+	CHECK(n == 2 && out[0] == (4u << 8) && out[1] == 0xcafef00d, "host ReceiveData %d %x %x", n, out[0], out[1]);
+
+	// --- wait: the client waits for data from the host ---
+	CHECK(Rfu::waits(0x27) && Rfu::waits(0x25) && !Rfu::waits(0x24), "waiting commands");
+	CHECK(cmd(B, 0x27) == 0, "client Wait");
+	B.begin_wait(1000);
+	CHECK(B.wait_poll(1001, out) == 0, "nothing yet");
+	cmd(A, 0x24, {1, 0x5a});
+	n = B.wait_poll(1002, out);
+	CHECK(n == 2 && out[0] == 0x99660028 && out[1] == 0x80000000, "data event %d %x", n, out[0]);
+	CHECK(cmd(B, 0x26) == 2 && out[0] == 1 && (out[1] & 0xff) == 0x5a, "data after the event");
+
+	// --- wait: timeout (Setup timeout 0x20 frames = 533 ms) ---
+	cmd(B, 0x17, {0x20});
+	B.begin_wait(5000);
+	CHECK(B.wait_poll(5300, out) == 0, "no timeout yet");
+	n = B.wait_poll(5600, out);
+	CHECK(n == 2 && out[0] == 0x99660027, "timeout event %x", out[0]);
+
+	// --- host waits after SendDataWait with no answer: missed clients ---
+	cmd(A, 0x25, {1, 1});
+	A.begin_wait(9000);
+	n = A.wait_poll(9100, out);
+	CHECK(n == 3 && out[0] == 0x99660128 && out[1] == 0x0F0F, "host rtx event %x %x", out[0], out[1]);
+	cmd(B, 0x26);   // the client takes the host's packet
+
+	// --- disconnect: the host drops client 0, the waiting client hears it ---
+	CHECK(cmd(A, 0x30, {1}) == 0, "DisconnectClient");
+	CHECK(B.state() == Rfu::IDLE, "client idle after the host dropped it");
+	B.begin_wait(12000);
+	n = B.wait_poll(12000, out);
+	CHECK(n == 3 && out[0] == 0x99660129 && out[1] == 0xF, "disconnect event %x", out[0]);
+	CHECK(cmd(A, 0x1a) == 0, "host has no clients");
+	CHECK(cmd(B, 0x24, {4u << 8, 1}) < 0, "SendData when idle is an error");
+
+	// --- host timeout of a silent client ---
+	cmd(B, 0x1c);
+	A.frame();
+	for (int i = 0; i < 40; i++) { A.frame(); deliver(); }
+	cmd(B, 0x1d);
+	cmd(B, 0x1e);
+	cmd(B, 0x1f, {host_id});
+	CHECK(B.state() == Rfu::CLIENT, "reconnected");
+	CHECK(cmd(A, 0x1a) == 1, "host sees the client again");
+	for (int i = 0; i < 241; i++) A.frame();
+	wire.clear();
+	CHECK(cmd(A, 0x1a) == 0, "silent client dropped after 4 s");
+
+	// --- malformed and hostile packets must be ignored (run under ASan) ---
+	A.reset();
+	B.reset();
+	cmd(A, 0x19);
+	uint32_t seed = 12345;
+	for (int i = 0; i < 20000; i++)
+	{
+		uint8_t pkt[120];
+		size_t len = 12 + (seed >> 8) % 108;
+		for (size_t k = 0; k < sizeof(pkt); k++) { seed = seed * 1103515245 + 12345; pkt[k] = seed >> 16; }
+		pkt[0] = 'R'; pkt[1] = 'F'; pkt[2] = 'U'; pkt[3] = '1';
+		pkt[4] = pkt[5] = pkt[6] = 0; pkt[7] = i % 9;
+		A.receive(i % 5 - 1, pkt, len);
+		B.receive(0, pkt, len);
+		A.receive(0, pkt, i % 12);
+	}
+	wire.clear();
+	n = cmd(A, 0x26);
+	CHECK(n >= 1 && n <= 1 + 16, "host ReceiveData after junk stays in bounds (%d)", n);
+
+	// hostile packets aimed at a real connection: right IDs, lengths too big
+	A.reset();
+	B.reset();
+	wire.clear();
+	cmd(A, 0x16, {1, 2, 3, 4, 5, 6});
+	cmd(A, 0x19);
+	A.frame();
+	deliver();
+	cmd(B, 0x1c);
+	n = cmd(B, 0x1d);
+	cmd(B, 0x1e);
+	CHECK(n == 7, "B sees A again");
+	cmd(B, 0x1f, {out[0]});
+	CHECK(B.state() == Rfu::CLIENT, "B connected for the hostile test");
+	cmd(B, 0x20);
+	uint32_t cl = out[0];
+	uint32_t a_id = 0;
+	cmd(A, 0x13);
+	a_id = out[0] & 0xffff;
+	for (uint32_t blen = 0; blen < 256; blen += 17)
+	{
+		uint8_t pkt[12 + 20] = {'R', 'F', 'U', '1', 0, 0, 0, 6};
+		uint32_t h = blen << 24 | (cl & 0x30000) | (cl & 0xffff);   // client data, 20 bytes of payload at most
+		pkt[8] = h >> 24; pkt[9] = h >> 16; pkt[10] = h >> 8; pkt[11] = h;
+		A.receive(0, pkt, sizeof(pkt));
+		uint8_t hp[12 + 8] = {'R', 'F', 'U', '1', 0, 0, 0, 5, 0, 0, 0, (uint8_t)(blen & 0x7f)};
+		B.receive(0, hp, sizeof(hp));   // host data longer than the packet
+	}
+	wire.clear();
+	n = cmd(A, 0x26);
+	CHECK(n <= 1 + 4 && (out[0] >> 8 & 0x1f) <= 16, "host keeps client data within 16 bytes (%d, %x)", n, out[0]);
+	n = cmd(B, 0x26);
+	CHECK(n <= 1 + 2 && out[0] <= 8, "client keeps host data within the packet (%d, %x)", n, out[0]);
+	(void)a_id;
+
+	printf("%s: %d checks, %d failed\n", fails ? "FAIL" : "PASS", checks, fails);
+	return fails ? 1 : 0;
+}
