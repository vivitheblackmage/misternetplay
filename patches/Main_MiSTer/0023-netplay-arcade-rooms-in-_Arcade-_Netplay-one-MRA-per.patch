+// Arcade rooms (SPEC.md 12.5): _Arcade/_Netplay is a RAM folder with one MRA
+// per waiting room, "<name> - <game>.mra", a copy of the player's own MRA of
+// that name with the room id in a comment. Loading an MRA reloads the core and
+// restarts Main, so the folder stays mounted across netplay_stop() and the room
+// is read back from the file, not from room_files.
+static bool                             arc_lobby = false;   // the lobby serves an arcade core
+static std::mutex                       arc_mtx;
+static std::map<std::string, std::string> arc_mras;          // lower-case MRA name (no .mra) -> path
+static const char                       ARC_TAG[] = "<!-- netplay room: ";
+
+static std::string lower(std::string v)
+{
+	for (char &c : v) c = (char)tolower((unsigned char)c);
+	return v;
+}
+
+static bool is_mount_point(const std::string &dir)
+{
+	FILE *f = fopen("/proc/mounts", "r");
+	if (!f) return false;
+	char line[1024];
+	bool found = false;
+	while (!found && fgets(line, sizeof(line), f))
+	{
+		char dev[256], mnt[512];
+		if (sscanf(line, "%255s %511s", dev, mnt) == 2 && dir == mnt) found = true;
+	}
+	fclose(f);
+	return found;
+}
+
+// The player's MRA files by name: _Arcade and its folders (not cores, not _Netplay)
+static void arc_index(const std::string &dir, int depth, std::map<std::string, std::string> *out)
+{
+	if (depth > 3 || dl_quit) return;
+	DIR *d = opendir(dir.c_str());
+	if (!d) return;
+	std::vector<std::string> names;
+	while (dirent *e = readdir(d)) names.push_back(e->d_name);
+	closedir(d);
+	for (const std::string &n : names)
+	{
+		if (n.empty() || n[0] == '.' || !strncasecmp(n.c_str(), "_Netplay", 8) || !strcasecmp(n.c_str(), "cores")) continue;
+		std::string p = dir + "/" + n;
+		struct stat st;
+		if (stat(p.c_str(), &st)) continue;
+		if (S_ISDIR(st.st_mode)) { arc_index(p, depth + 1, out); continue; }
+		if (S_ISREG(st.st_mode) && n.size() > 4 && !strcasecmp(n.c_str() + n.size() - 4, ".mra"))
+		{
+			std::string key = lower(n.substr(0, n.size() - 4));
+			if (!out->count(key) || depth == 0) (*out)[key] = p;   // _Arcade itself first
+		}
+	}
+}
+
+// The room's MRA: the player's own, with the room id after the root tag
+static bool arc_room_write(const std::string &src, const std::string &dst, const std::string &id)
+{
+	FILE *in = fopen(src.c_str(), "rb");
+	if (!in) return false;
+	std::string x;
+	char buf[16384];
+	size_t n;
+	while ((n = fread(buf, 1, sizeof(buf), in)) > 0 && x.size() < (1u << 20)) x.append(buf, n);
+	fclose(in);
+	size_t at = x.find("<misterromdescription");
+	if (at == std::string::npos) return false;
+	at = x.find('>', at);
+	if (at == std::string::npos) return false;
+	x.insert(at + 1, std::string("\n    ") + ARC_TAG + id + " -->");
+	FILE *out = fopen(dst.c_str(), "wb");
+	if (!out) return false;
+	bool ok = fwrite(x.data(), 1, x.size(), out) == x.size();
+	if (fclose(out)) ok = false;
+	if (!ok) unlink(dst.c_str());
+	return ok;
+}
+
+// The room id in a room MRA (main thread, at the MRA load)
+static bool arc_room_id(const std::string &path, std::string *id)
+{
+	FILE *f = fopen(path.c_str(), "rb");
+	if (!f) return false;
+	char buf[4096];
+	size_t n = fread(buf, 1, sizeof(buf) - 1, f);
+	fclose(f);
+	buf[n] = 0;
+	const char *p = strstr(buf, ARC_TAG);
+	if (!p) return false;
+	std::string v(p + sizeof(ARC_TAG) - 1, strnlen(p + sizeof(ARC_TAG) - 1, 8));
+	if (!is_hex(v, 8)) return false;
+	*id = v;
+	return true;
+}
