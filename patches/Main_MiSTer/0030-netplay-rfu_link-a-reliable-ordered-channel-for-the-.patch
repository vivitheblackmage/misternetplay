diff --git a/support/netplay/test/test_rfu_link.cpp b/support/netplay/test/test_rfu_link.cpp
new file mode 100644
index 0000000..c849627
--- /dev/null
+++ b/support/netplay/test/test_rfu_link.cpp
@@ -0,0 +1,135 @@
+// T3w, second part: rfu_link.cpp over a bad network (loss, duplicates,
+// reordering, delay): every packet arrives once and in order on both sides.
+// Then a lockstep peer, another version, and junk.
+
+#include "../rfu_link.h"
+#include <stdio.h>
+#include <string.h>
+#include <vector>
+#include <deque>
+
+static int fails = 0, checks = 0;
+#define CHECK(c, ...) do { checks++; if (!(c)) { fails++; printf("FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+static uint32_t rng = 1;
+static uint32_t rnd() { rng ^= rng << 13; rng ^= rng >> 17; rng ^= rng << 5; return rng; }
+
+struct Net;
+struct End : netplay::Transport
+{
+	Net *net; int me;
+	void send(const uint8_t *b, size_t n) override;
+	int recv(uint8_t *b, size_t cap) override;
+	void lock_peer() override { locked = true; }
+	bool locked = false;
+};
+struct Pkt { uint64_t at; std::vector<uint8_t> d; };
+struct Net
+{
+	End e[2];
+	std::vector<Pkt> q[2];            // to end 0, to end 1
+	uint64_t now = 0;
+	int loss = 20, dup = 10, maxdelay = 80;
+	Net() { e[0].net = e[1].net = this; e[0].me = 0; e[1].me = 1; }
+};
+void End::send(const uint8_t *b, size_t n)
+{
+	int to = 1 - me;
+	if ((int)(rnd() % 100) < net->loss) return;
+	int copies = (int)(rnd() % 100) < net->dup ? 2 : 1;
+	for (int i = 0; i < copies; i++)
+		net->q[to].push_back({ net->now + 5 + rnd() % net->maxdelay, std::vector<uint8_t>(b, b + n) });
+}
+int End::recv(uint8_t *b, size_t cap)
+{
+	auto &q = net->q[me];
+	for (size_t i = 0; i < q.size(); i++)   // any due packet: order is not kept
+		if (q[i].at <= net->now)
+		{
+			size_t n = q[i].d.size() < cap ? q[i].d.size() : cap;
+			if (n) memcpy(b, q[i].d.data(), n);
+			q.erase(q.begin() + i);
+			return (int)n;
+		}
+	return -1;
+}
+
+int main()
+{
+	Net net;
+	RfuLink host(&net.e[0], true), join(&net.e[1], false);
+	std::vector<uint32_t> got[2];
+	auto deliver0 = [&](const uint8_t *b, size_t n) { uint32_t v; if (n >= 4) { memcpy(&v, b, 4); got[0].push_back(v); } };
+	auto deliver1 = [&](const uint8_t *b, size_t n) { uint32_t v; if (n >= 4) { memcpy(&v, b, 4); got[1].push_back(v); } };
+
+	// packets sent before the link is up are kept and go out once it is
+	uint32_t early = 0xEA41;
+	join.send((const uint8_t *)&early, 4);
+
+	const uint32_t N = 2000;
+	uint32_t sent0 = 0, sent1 = 0;
+	for (int step = 0; step < 200000 && (got[0].size() < N + 1 || got[1].size() < N); step++)
+	{
+		net.now++;
+		if (host.connected() && sent0 < N && rnd() % 3 == 0) { uint32_t v = 1000000 + sent0++; uint8_t b[100] = {}; memcpy(b, &v, 4); host.send(b, 4 + rnd() % 96); }
+		if (join.connected() && sent1 < N && rnd() % 3 == 0) { uint32_t v = 2000000 + sent1++; uint8_t b[100] = {}; memcpy(b, &v, 4); join.send(b, 4 + rnd() % 96); }
+		host.tick(net.now, deliver0);
+		join.tick(net.now, deliver1);
+	}
+	CHECK(host.connected() && join.connected(), "both connected");
+	CHECK(net.e[0].locked && !net.e[1].locked, "the host locked its peer");
+	CHECK(got[1].size() == N, "join got %zu of %u", got[1].size(), N);
+	CHECK(got[0].size() == N + 1, "host got %zu of %u", got[0].size(), N + 1);
+	bool order1 = true, order0 = got[0].size() && got[0][0] == early;
+	for (size_t i = 0; i < got[1].size(); i++) if (got[1][i] != 1000000 + i) order1 = false;
+	for (size_t i = 1; i < got[0].size(); i++) if (got[0][i] != 2000000 + i - 1) order0 = false;
+	CHECK(order1, "join: in order, once each");
+	CHECK(order0, "host: the early packet first, then in order, once each");
+	CHECK(host.resent() > 0 && join.resent() > 0, "losses were resent (%u, %u)", host.resent(), join.resent());
+	for (int i = 0; i < 3000; i++) { net.now++; host.tick(net.now, deliver0); join.tick(net.now, deliver1); }
+	CHECK(host.unacked() == 0 && join.unacked() == 0, "everything acked (%zu, %zu)", host.unacked(), join.unacked());
+	CHECK(!host.lost(net.now) && !join.lost(net.now), "keepalive holds the link");
+	net.loss = 100;
+	for (int i = 0; i < 11000; i++) { net.now++; host.tick(net.now, deliver0); }
+	CHECK(host.lost(net.now), "silence for 10 s: lost");
+
+	// a lockstep peer (netplay HELLO) and a different version are named
+	{
+		Net n2;
+		n2.loss = 0; n2.dup = 0;
+		RfuLink a(&n2.e[0], true);
+		const uint8_t lockstep[] = { 'N', 'P', 'L', 'Y', 1, 2, 3, 4, 5, 6, 7, 8 };
+		n2.e[1].send(lockstep, sizeof(lockstep));
+		for (int i = 0; i < 200; i++) { n2.now++; a.tick(n2.now, deliver0); }
+		CHECK(a.refusal() && strstr(a.refusal(), "not using the wireless adapter"), "lockstep peer named");
+		CHECK(!a.connected(), "not connected to it");
+		const uint8_t v9[] = { 'N', 'P', 'W', '1', 0, 0, 0, 0, 0, 0, 1, 9 };
+		n2.e[1].send(v9, sizeof(v9));
+		for (int i = 0; i < 200; i++) { n2.now++; a.tick(n2.now, deliver0); }
+		CHECK(a.refusal() && strstr(a.refusal(), "version"), "other version named");
+	}
+
+	// junk must not crash or deliver (ASan)
+	{
+		Net n3;
+		n3.loss = 0; n3.dup = 0;
+		RfuLink a(&n3.e[0], false);
+		size_t delivered = 0;
+		auto count = [&](const uint8_t *, size_t n) { delivered++; if (n > RfuLink::MAX_PAYLOAD) delivered += 1000000; };
+		for (int i = 0; i < 20000; i++)
+		{
+			uint8_t pkt[300];
+			for (auto &c : pkt) c = (uint8_t)rnd();
+			memcpy(pkt, "NPW1", 4);
+			pkt[4] = i % 4;
+			size_t len = rnd() % sizeof(pkt);
+			n3.e[1].send(pkt, len);
+			n3.now++;
+			a.tick(n3.now, count);
+		}
+		CHECK(delivered < 1000000, "never a payload over the limit");
+	}
+
+	printf("%s: %d checks, %d failed\n", fails ? "FAIL" : "PASS", checks, fails);
+	return fails ? 1 : 0;
+}
