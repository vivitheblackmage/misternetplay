+		RfuLink a(&n5.e[0], true, 0x5555), b(&n5.e[1], false, 0x6666);
+		auto none = [](const uint8_t *, size_t) {};
+		for (int i = 0; i < 200; i++) { n5.now++; a.tick(n5.now, none); b.tick(n5.now, none); }
+		CHECK(a.connected() && b.connected(), "connected");
+		uint8_t p[4] = {1, 2, 3, 4};
+		for (int i = 0; i < 50; i++) a.send(p, 4);
+		// b drops everything of a's (as if all of it got lost), but keeps the link alive
+		uint32_t before = 0;
+		for (int i = 0; i < 13000; i++)
+		{
+			n5.now++;
+			a.tick(n5.now, none);
+			n5.q[1].clear();
+			if (i % 500 == 0) b.tick(n5.now, none);
