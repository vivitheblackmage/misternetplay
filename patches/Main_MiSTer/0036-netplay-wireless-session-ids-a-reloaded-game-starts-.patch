 		CHECK(host.sent() - before < 50 * 4 + 10, "lost: resends once a second, not every 100 ms (%u)", host.sent() - before);
 	}
 
+	// the other side loads its game again: a new link (new session id) while
+	// this one still has unacked packets. Both start over, nothing of the old
+	// link is delivered, and data flows again (2026-11-11: it deadlocked).
+	{
+		Net n4;
+		n4.loss = 10; n4.dup = 5; n4.maxdelay = 40;
+		RfuLink h(&n4.e[0], true, 0xAAAA);
+		std::vector<uint32_t> gh, gj;
+		auto dh = [&](const uint8_t *b, size_t n) { uint32_t v; if (n >= 4) { memcpy(&v, b, 4); gh.push_back(v); } };
+		auto dj = [&](const uint8_t *b, size_t n) { uint32_t v; if (n >= 4) { memcpy(&v, b, 4); gj.push_back(v); } };
+		{
+			RfuLink j(&n4.e[1], false, 0xBBBB);
+			for (int i = 0; i < 3000; i++)
+			{
+				n4.now++;
+				if (h.connected() && i % 2 == 0) { uint32_t v = 7000000 + i; h.send((const uint8_t *)&v, 4); }
+				if (j.connected() && i % 2 == 1) { uint32_t v = 8000000 + i; j.send((const uint8_t *)&v, 4); }
+				h.tick(n4.now, dh);
+				j.tick(n4.now, dj);
+			}
+			CHECK(gj.size() > 500 && gh.size() > 500, "first link carries data (%zu, %zu)", gh.size(), gj.size());
+			for (uint32_t k = 0; k < 40; k++) { uint32_t v = 7500000 + k; h.send((const uint8_t *)&v, 4); }   // never acked by j
+		}
+		gh.clear(); gj.clear();
+		RfuLink j2(&n4.e[1], false, 0xCCCC);
+		const uint32_t M = 500;
+		uint32_t s0 = 0, s1 = 0;
+		for (int i = 0; i < 60000 && (gh.size() < M || gj.size() < M); i++)
+		{
+			n4.now++;
+			if (h.connected() && j2.connected() && h.restarts() && s0 < M && i % 2 == 0) { uint32_t v = 9000000 + s0++; h.send((const uint8_t *)&v, 4); }
+			if (j2.connected() && s1 < M && i % 2 == 1) { uint32_t v = 6000000 + s1++; j2.send((const uint8_t *)&v, 4); }
+			h.tick(n4.now, dh);
+			j2.tick(n4.now, dj);
+		}
+		CHECK(h.restarts() == 1, "the host saw the restart once (%u)", h.restarts());
+		bool ok0 = gj.size() == M, ok1 = gh.size() == M;
+		for (size_t i = 0; ok0 && i < gj.size(); i++) if (gj[i] != 9000000 + i) ok0 = false;
+		for (size_t i = 0; ok1 && i < gh.size(); i++) if (gh[i] != 6000000 + i) ok1 = false;
+		CHECK(ok0, "new join: only the new link's packets, in order (%zu)", gj.size());
+		CHECK(ok1, "host: the new join's packets, in order (%zu)", gh.size());
+		for (int i = 0; i < 2000; i++) { n4.now++; h.tick(n4.now, dh); j2.tick(n4.now, dj); }
+		CHECK(h.unacked() == 0 && j2.unacked() == 0, "everything acked after the restart (%zu, %zu)", h.unacked(), j2.unacked());
+	}
+
+	// a peer that answers but never acks (a broken link): resends slow down
+	{
