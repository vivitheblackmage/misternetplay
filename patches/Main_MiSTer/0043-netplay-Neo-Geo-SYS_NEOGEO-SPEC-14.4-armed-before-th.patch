+// the session's start on a core armed before the ROM set loaded
+static void test_neogeo()
+{
+	printf("neogeo: heartbeat, settings, pre-armed start, a heartbeat that stops\n");
+	CHECK((uint32_t)ctrl_word(true, false, 0x5A, false, 0x1234) == 0x12345A01u);
+	CHECK((uint32_t)(ctrl_word(true, true, 0x5A, false, 0x1234) >> 32) == CTRL_MAGIC);
+	CHECK(ctrl_word(false, false, 0x5A, false, 0x1234) == 0);
+	CHECK(mailbox_phys(SYS_NEOGEO) == 0x3FC00000 && mailbox_magic(SYS_NEOGEO) == MAGIC_NEOGEO && joy12(SYS_NEOGEO));
+	CHECK(proto_version(SYS_NEOGEO) == PROTO_VERSION_ARCADE);
+	CHECK(decode_status(1ull << 27 | 3ull << 24).ran && decode_status(1ull << 27 | 3ull << 24).state == FS_RUN);
+	CHECK(!decode_status(3ull << 24).ran);
+	{
+		NeoSettings a {}, b {};
+		CHECK(pack_settings(a) == pack_settings(b));
+		b.sys_type = 1; CHECK(pack_settings(a) != pack_settings(b)); b = a;
+		b.video = 1;    CHECK(pack_settings(a) != pack_settings(b)); b = a;
+		b.bios_orig = 1; CHECK(pack_settings(a) != pack_settings(b)); b = a;
+		b.dips = 4;     CHECK(pack_settings(a) != pack_settings(b));
+	}
+	CHECK(check_local_neogeo(0, 3) == REJ_OK && check_local_neogeo(1, 3) == REJ_SYSTEM && check_local_neogeo(0, 1) == REJ_DELAY);
+
+	LocalInfo li = make_info(SYS_NEOGEO);
+	// 1. Not armed before the load: the machine has run, no session
+	{
+		FakeFpga f(0, SYS_NEOGEO);
+		Recording rec;
+		Session r(M_RECORD, 3, f.mb, nullptr, &rec, 9);
+		r.set_local(li);
+		uint64_t now = 0;
+		while (r.phase() != PH_DONE && now < 1000) { now++; r.step(now); f.step(now); }
+		CHECKM(r.failed() && strstr(r.message(), "load the game again"), "not armed: %s", r.message());
+	}
+	// 2. Armed (session 0, a moving heartbeat) before the load: the session
+	//    runs, and the core takes the session's id while it is armed
+	{
+		FakeFpga f(0, SYS_NEOGEO);
+		Recording rec;
+		uint64_t now = 0;
+		for (uint16_t hb = 1; f.state != FS_ARMED && now < 100; hb++) { now++; f.mb.wr(MB_CTRL, ctrl_word(true, false, 0, false, hb)); f.step(now); }
