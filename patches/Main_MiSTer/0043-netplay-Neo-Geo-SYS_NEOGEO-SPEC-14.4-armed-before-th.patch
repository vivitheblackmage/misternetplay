+// ---------------------------------------------------------------------------
+// Neo Geo (SPEC.md 14)
+
+// The ROM set's identity: a folder (the Darksoft layout) by the files the game
+// runs from, all but the sprites (crom*) and the ADPCM samples (vrom*), which
+// decide no game timing and are most of the size; a .zip or .neo by the file.
+static bool neogeo_md5(const char *name, uint8_t out[16])
+{
+	std::string full = getFullPath(name);
+	struct stat st;
+	if (stat(full.c_str(), &st)) return false;
+	if (!S_ISDIR(st.st_mode)) return md5_file(name, out, nullptr, 0);
+	std::vector<std::string> files;
+	if (DIR *d = opendir(full.c_str()))
+	{
+		while (dirent *e = readdir(d))
+		{
+			std::string n = e->d_name;
+			if (n.empty() || n[0] == '.' || !strncasecmp(n.c_str(), "crom", 4) || !strncasecmp(n.c_str(), "vrom", 4)) continue;
+			struct stat fs;
+			if (!stat((full + "/" + n).c_str(), &fs) && S_ISREG(fs.st_mode)) files.push_back(n);
+		}
+		closedir(d);
+	}
+	if (files.empty()) return false;
+	std::sort(files.begin(), files.end());
+	MD5Context ctx;
+	MD5Init(&ctx);
+	uint8_t buf[16384];
+	for (const std::string &n : files)
+	{
+		MD5Update(&ctx, (const uint8_t *)n.c_str(), (unsigned)n.size() + 1);
+		FILE *f = fopen((full + "/" + n).c_str(), "rb");
+		if (!f) return false;
+		size_t k;
+		while ((k = fread(buf, 1, sizeof(buf), f)) > 0) MD5Update(&ctx, buf, (unsigned)k);
+		fclose(f);
+	}
+	MD5Final(out, &ctx);
+	return true;
+}
+
+// The BIOS files the loader sends (neogeo_romset_tx): the system ROM it picks,
+// sfix.sfix and 000-lo.lo, from the folder they are in (the ROM set's, or a
+// folder above it).
+static bool neogeo_bios_md5(const char *name, uint8_t out[16])
+{
+	std::string dir = getFullPath(name);
+	for (int up = 0; up < 3; up++)
+	{
+		size_t sl = dir.rfind('/');
+		if (sl == std::string::npos) return false;
+		dir.resize(sl);
+		struct stat st;
+		if (!stat((dir + "/000-lo.lo").c_str(), &st)) break;
+		if (up == 2) return false;
+	}
+	bool orig = user_io_status_get("[22]") & 1, mvs = user_io_status_get("[1]") & 1;
+	struct stat st;
+	std::string sys = (!orig && !stat((dir + "/uni-bios.rom").c_str(), &st)) ? "uni-bios.rom" : mvs ? "sp-s2.sp1" : "neo-epo.sp1";
+	MD5Context ctx;
+	MD5Init(&ctx);
+	uint8_t buf[16384];
+	for (const std::string &n : { sys, std::string("sfix.sfix"), std::string("000-lo.lo") })
+	{
+		MD5Update(&ctx, (const uint8_t *)n.c_str(), (unsigned)n.size() + 1);
+		FILE *f = fopen((dir + "/" + n).c_str(), "rb");
+		if (!f) continue;                   // the loader goes on without it, so does the md5
+		size_t k;
+		while ((k = fread(buf, 1, sizeof(buf), f)) > 0) MD5Update(&ctx, buf, (unsigned)k);
+		fclose(f);
+	}
+	MD5Final(out, &ctx);
+	return true;
+}
+
+// The ROM set to load once the core is up again: the core reload restarts
+// Main, and DDR3 keeps what is in it. Behind the mailbox's rings: magic, the
+// time (CLOCK_MONOTONIC ms, which a restart of Main keeps), the path. Taken
+// only within 30 s, so nothing left over ever loads a game by itself.
+constexpr uint32_t NEO_PEND = 0x3000;
+constexpr uint64_t NEO_PEND_MAGIC = 0x31444E4550504E4EULL;   // "NNPPEND1"
+
+static void neo_pending_put(const char *name)
+{
+	volatile uint8_t *m = (volatile uint8_t *)shmem_map(mailbox_phys(SYS_NEOGEO), MB_SIZE);
+	if (!m) return;
+	Mailbox mb { m };
+	size_t n = strlen(name);
+	if (n > MB_SIZE - NEO_PEND - 24) n = MB_SIZE - NEO_PEND - 24;
+	for (size_t i = 0; i <= n; i++) m[NEO_PEND + 16 + i] = i < n ? (uint8_t)name[i] : 0;
+	mb.wr(NEO_PEND + 8, now_ms());
+	mb.wr(NEO_PEND, NEO_PEND_MAGIC);
+	shmem_unmap((void *)m, MB_SIZE);
+}
+
+static std::string neo_pending_take()
+{
+	std::string r;
+	volatile uint8_t *m = (volatile uint8_t *)shmem_map(mailbox_phys(SYS_NEOGEO), MB_SIZE);
+	if (!m) return r;
+	Mailbox mb { m };
+	if (mb.rd(NEO_PEND) == NEO_PEND_MAGIC && now_ms() - mb.rd(NEO_PEND + 8) < 30000)
+		for (size_t i = NEO_PEND + 16; i < MB_SIZE && m[i]; i++) r += (char)m[i];
+	mb.wr(NEO_PEND, 0);
+	shmem_unmap((void *)m, MB_SIZE);
+	return r;
+}
+
+static Mode current_mode()
+{
+	static const Mode osd_modes[4] = { M_OFF, M_OFF, M_HOST, M_JOIN };
+	uint32_t osd = user_io_status_get(osd_netplay_bits());
+	return osd ? osd_modes[osd & 3] : cfg.mode;
+}
+
+// neogeo_loader, before a ROM set loads. A session needs a machine that has
+// not run since the FPGA was loaded, armed before the load (SPEC.md 14.2):
+// the first load after the core gets armed here; a later one loads the core
+// again first, and the ROM set after it (true: the core is being loaded).
+bool netplay_neogeo_before(const char *name, int cd_en)
+{
+	if (own_reload || !core_armed || core_sys != SYS_NEOGEO) return false;
+	bool ran = neo_ran;
+	neo_ran = true;                         // the machine runs after this load, with or without a session
+	if (cd_en || current_mode() == M_OFF) return false;
+	if (ran)
+	{
+		// the core again, then this ROM set (netplay_start() finds it in DDR3)
+		neo_pending_put(name);
+		post_message("Netplay: loading the core again for a fresh start");
+		netplay_stop();
+		fpga_load_rbf(get_rbf_path());      // does not return on a MiSTer (Main restarts)
+		return true;
+	}
+	if (!thread_running) start_thread();
+	neo_armed = false;
+	neo_prearm = true;
+	for (uint64_t t = now_ms(); !neo_armed && now_ms() - t < 1000; ) usleep(1000);
+	if (!neo_armed)
+	{
+		neo_prearm = false;
+		post_message("Netplay: the core did not respond");
+	}
+	return false;
+}
+
+// neogeo_loader, after the ROM set has loaded
+void netplay_neogeo_loaded(const char *name, int cd_en)
+{
+	if (own_reload || !core_armed || core_sys != SYS_NEOGEO || cd_en || !neo_prearm) return;
+	begin_session(name, 1, 0);
+}
