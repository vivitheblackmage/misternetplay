+	make_rom((set + "/prom").c_str(), 1 + salt);
+	make_rom((set + "/m1rom").c_str(), 2);
+	make_rom((set + "/crom0").c_str(), 3 + (host ? 0 : 9));   // the sprites may differ: not part of the identity
+	make_rom((home + "/uni-bios.rom").c_str(), 4 + bsalt);
+	make_rom((home + "/sfix.sfix").c_str(), 5);
+	make_rom((home + "/000-lo.lo").c_str(), 6);
+	char game[] = "games/NeoGeo/game";
