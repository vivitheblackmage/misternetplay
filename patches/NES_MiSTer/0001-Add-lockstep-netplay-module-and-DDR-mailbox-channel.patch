diff --git a/rtl/netplay.sv b/rtl/netplay.sv
new file mode 100644
index 0000000..27a9660
--- /dev/null
+++ b/rtl/netplay.sv
@@ -0,0 +1,372 @@
+// netplay.sv
+//
+// Delay-based lockstep netplay for the NES core.
+//
+// The FPGA side never touches the network. It exchanges per-frame controller
+// input with Main_MiSTer through a mailbox in DDR3 (see SPEC.md, section 4):
+//
+//   - At the start of every frame it samples the local pad and posts LOCAL[k].
+//   - It posts a CRC of the previous frame's pixels and inputs as CRC[k-1].
+//   - It keeps a two-entry lookahead of INPUT[] read back from the mailbox.
+//     If INPUT[k+1] is not in hand when frame k starts, it requests the
+//     core's existing savestate pause, which engages in the VBlank that
+//     follows, at an instruction boundary, and is invisible to the emulated
+//     machine. The core only resumes on a whole video frame, so every stall
+//     costs one repeated frame on screen; the lookahead keeps them rare.
+//
+// Frame boundaries are taken from the *emulated* PPU scanline, which stands
+// still while the core is paused, so pausing never shifts the frame count.
+//
+// This program is GPL licensed. See COPYING for the full license.
+
+module netplay #(
+	parameter int          POLL_INTERVAL = 256,   // clocks between INPUT polls
+	parameter int          CTRL_INTERVAL = 4096,  // clocks between CTRL reads
+	parameter logic [27:0] BASE          = 28'h0C000000 // byte offset inside the 0x30000000 DDR window
+)
+(
+	input             clk,
+	input             reset,          // power-on only, never on ROM load
+	input             downloading,    // a ROM load is in progress
+
+	// emulated timing from rtl/nes.v
+	input       [8:0] scanline_emu,
+	input             ppu_ce_emu,
+	input       [5:0] color,
+	input       [8:0] vbl_line,
+	input             core_paused,
+
+	input       [7:0] local_joy,      // same bit order as nes_joy_A
+
+	output            active,
+	output            hold_reset,
+	output            pause_req,
+	output reg  [7:0] joy_p1,
+	output reg  [7:0] joy_p2,
+
+	// DDR3 channel (rtl/ddram.sv ch2)
+	output reg [27:1] ddr_addr,
+	output reg [63:0] ddr_din,
+	input      [63:0] ddr_dout,
+	output reg        ddr_req,
+	output reg        ddr_rnw,
+	output      [7:0] ddr_be,
+	input             ddr_ready,
+
+	// observation
+	output      [2:0] state_o,
+	output     [31:0] frame_o,
+	output      [7:0] error_o
+);
+
+// ---------------------------------------------------------------------------
+// Mailbox layout (byte offsets from BASE), SPEC.md section 4
+localparam logic [15:0] OFF_MAGIC  = 16'h0000;
+localparam logic [15:0] OFF_STATUS = 16'h0008;
+localparam logic [15:0] OFF_CTRL   = 16'h0010;
+localparam logic [15:0] OFF_LOCAL  = 16'h1000;
+localparam logic [15:0] OFF_CRC    = 16'h1800;
+localparam logic [15:0] OFF_INPUT  = 16'h2000;
+
+localparam logic [63:0] MAGIC = 64'h313030504E53454E; // "NESNP001"
+
+localparam logic [2:0] S_IDLE  = 3'd0;
+localparam logic [2:0] S_ARMED = 3'd1;
+localparam logic [2:0] S_PRIME = 3'd2;
+localparam logic [2:0] S_RUN   = 3'd3;
+localparam logic [2:0] S_ERROR = 3'd4;
+
+localparam int ERR_UNDERRUN  = 0;
+localparam int ERR_CTRL_DROP = 1;
+localparam int ERR_RELOAD    = 2;
+
+localparam logic [31:0] CRC_INIT = 32'hFFFFFFFF;
+
+function automatic logic [31:0] crc_byte(input logic [31:0] c, input logic [7:0] d);
+	logic [31:0] x;
+	x = c ^ {24'd0, d};
+	for (int i = 0; i < 8; i++)
+		x = x[0] ? ((x >> 1) ^ 32'hEDB88320) : (x >> 1);
+	return x;
+endfunction
+
+// Mailbox offsets are 8-byte aligned, so the channel's word address is simply
+// (BASE + off) >> 1.
+function automatic logic [27:1] waddr(input logic [15:3] off);
+	return BASE[27:1] + {12'd0, off, 2'b00};
+endfunction
+
+function automatic logic [15:3] ring(input logic [15:3] base, input logic [7:0] slot);
+	return base + {5'd0, slot};
+endfunction
+
+// ---------------------------------------------------------------------------
+// State
+
+logic [2:0]  state;
+logic [31:0] frame;
+logic [7:0]  error;
+logic [15:0] stalls;
+logic [7:0]  sess;
+
+// Lookahead: slot 0 holds INPUT[base], slot 1 INPUT[base+1], where base is
+// the first frame not started yet (0 in PRIME, frame+1 in RUN).
+logic        have0, have1;
+logic [7:0]  a_p1, a_p2;      // slot 0
+logic [7:0]  b_p1, b_p2;      // slot 1
+logic [31:0] crc;
+
+assign active     = (state != S_IDLE);
+assign hold_reset = (state == S_ARMED) || (state == S_PRIME);
+assign pause_req  = ((state == S_RUN) && !have0) || (state == S_ERROR);
+
+assign state_o = state;
+assign frame_o = frame;
+assign error_o = error;
+assign ddr_be  = 8'hFF;
+
+// Frame tick: emulated scanline enters the VBlank start line.
+logic [8:0] sl_prev;
+wire        tick = (scanline_emu == vbl_line) && (sl_prev != vbl_line);
+
+// Pending mailbox work
+logic        p_magic, p_status, p_local, p_crc;
+logic [15:0] local_frame;   // only the 16-bit tag is stored
+logic [7:0]  local_val;
+logic [15:0] crc_frame;
+logic [31:0] crc_val;
+
+// Poll timers
+logic [15:0] poll_cnt, ctrl_cnt;
+logic        poll_due, ctrl_due;
+
+// DDR sequencer
+localparam logic [2:0] OP_NONE   = 3'd0;
+localparam logic [2:0] OP_MAGIC  = 3'd1;
+localparam logic [2:0] OP_CRC    = 3'd2;
+localparam logic [2:0] OP_LOCAL  = 3'd3;
+localparam logic [2:0] OP_STATUS = 3'd4;
+localparam logic [2:0] OP_CTRL   = 3'd5;
+localparam logic [2:0] OP_INPUT  = 3'd6;
+
+logic [2:0]  op;
+logic [31:0] op_frame;   // INPUT frame being fetched
+
+wire  [31:0] base       = (state == S_PRIME) ? 32'd0 : frame + 32'd1;
+wire         fetching   = (state == S_PRIME) || (state == S_RUN);
+wire         need_input = fetching && !(have0 && have1);
+wire  [31:0] want_frame = have0 ? base + 32'd1 : base;
+
+wire  [63:0] status_word = {frame, 5'd0, state, error, stalls};
+
+// Tag check for INPUT entries: both halves must carry frame tag and session.
+wire  [31:0] in_hi = ddr_dout[63:32];
+wire  [31:0] in_lo = ddr_dout[31:0];
+wire         in_ok = (in_hi[31:16] == op_frame[15:0]) && (in_lo[31:16] == op_frame[15:0])
+                  && (in_hi[15:8]  == sess)           && (in_lo[15:8]  == sess);
+
+logic        paused_prev;
+
+always_ff @(posedge clk) begin
+	sl_prev     <= scanline_emu;
+	paused_prev <= core_paused;
+	ddr_req     <= 1'b0;
+
+	// timers
+	if (poll_cnt == POLL_INTERVAL[15:0] - 16'd1) begin poll_cnt <= 16'd0; poll_due <= 1'b1; end
+	else poll_cnt <= poll_cnt + 16'd1;
+	if (ctrl_cnt == CTRL_INTERVAL[15:0] - 16'd1) begin ctrl_cnt <= 16'd0; ctrl_due <= 1'b1; end
+	else ctrl_cnt <= ctrl_cnt + 16'd1;
+
+	// -----------------------------------------------------------------------
+	// Per-frame work in RUN
+	if (state == S_RUN) begin
+		if (core_paused && !paused_prev && stalls != 16'hFFFF) stalls <= stalls + 16'd1;
+
+		if (tick) begin
+			if (!have0) begin
+				error[ERR_UNDERRUN] <= 1'b1;
+				state    <= S_ERROR;
+				p_status <= 1'b1;
+			end
+			else begin
+				frame       <= frame + 32'd1;
+				joy_p1      <= a_p1;
+				joy_p2      <= a_p2;
+				// shift the lookahead
+				have0       <= have1;
+				a_p1        <= b_p1;
+				a_p2        <= b_p2;
+				have1       <= 1'b0;
+
+				crc_frame   <= frame[15:0];
+				crc_val     <= crc;
+				p_crc       <= 1'b1;
+
+				local_frame <= frame[15:0] + 16'd1;
+				local_val   <= local_joy;
+				p_local     <= 1'b1;
+
+				p_status    <= 1'b1;
+				crc         <= crc_byte(crc_byte(CRC_INIT, a_p1), a_p2);
+			end
+		end
+		else if (ppu_ce_emu) begin
+			crc <= crc_byte(crc, {2'b00, color});
+		end
+
+		if (downloading) begin
+			error[ERR_RELOAD] <= 1'b1;
+			state    <= S_ERROR;
+			p_status <= 1'b1;
+		end
+	end
+
+	if (state == S_PRIME && downloading) begin
+		error[ERR_RELOAD] <= 1'b1;
+		state    <= S_ERROR;
+		p_status <= 1'b1;
+	end
+
+	// PRIME -> RUN once INPUT[0] and INPUT[1] are in hand: release reset at
+	// frame 0. INPUT[1] is needed up front because no VBlank (and so no pause
+	// opportunity) comes between reset release and the first tick.
+	if (state == S_PRIME && have0 && have1 && !downloading) begin
+		state       <= S_RUN;
+		frame       <= 32'd0;
+		joy_p1      <= a_p1;
+		joy_p2      <= a_p2;
+		have0       <= 1'b1;
+		a_p1        <= b_p1;
+		a_p2        <= b_p2;
+		have1       <= 1'b0;
+		local_frame <= 16'd0;
+		local_val   <= local_joy;
+		p_local     <= 1'b1;
+		p_status    <= 1'b1;
+		crc         <= crc_byte(crc_byte(CRC_INIT, a_p1), a_p2);
+	end
+
+	// -----------------------------------------------------------------------
+	// DDR sequencer: one outstanding request at a time.
+	if (op == OP_NONE) begin
+		if (p_magic) begin
+			op <= OP_MAGIC;   ddr_addr <= waddr(OFF_MAGIC[15:3]);  ddr_din <= MAGIC;       ddr_rnw <= 1'b0; ddr_req <= 1'b1;
+		end
+		else if (p_crc) begin
+			op <= OP_CRC;     ddr_addr <= waddr(ring(OFF_CRC[15:3], crc_frame[7:0]));
+			ddr_din <= {crc_frame, crc_val[31:16], crc_frame, crc_val[15:0]};
+			ddr_rnw <= 1'b0; ddr_req <= 1'b1;
+		end
+		else if (p_local) begin
+			op <= OP_LOCAL;   ddr_addr <= waddr(ring(OFF_LOCAL[15:3], local_frame[7:0]));
+			ddr_din <= {local_frame, sess, local_val, local_frame, sess, local_val};
+			ddr_rnw <= 1'b0; ddr_req <= 1'b1;
+		end
+		else if (p_status) begin
+			op <= OP_STATUS;  ddr_addr <= waddr(OFF_STATUS[15:3]); ddr_din <= status_word; ddr_rnw <= 1'b0; ddr_req <= 1'b1;
+		end
+		else if (ctrl_due) begin
+			op <= OP_CTRL;    ddr_addr <= waddr(OFF_CTRL[15:3]);   ddr_rnw <= 1'b1; ddr_req <= 1'b1;
+		end
+		else if (poll_due && need_input) begin
+			op <= OP_INPUT;   ddr_addr <= waddr(ring(OFF_INPUT[15:3], want_frame[7:0]));
+			op_frame <= want_frame;
+			ddr_rnw <= 1'b1; ddr_req <= 1'b1;
+		end
+	end
+	else if (ddr_ready) begin
+		op <= OP_NONE;
+		case (op)
+			OP_MAGIC:  p_magic  <= 1'b0;
+			OP_CRC:    p_crc    <= 1'b0;
+			OP_LOCAL:  p_local  <= 1'b0;
+			OP_STATUS: p_status <= 1'b0;
+			OP_INPUT: begin
+				poll_due <= 1'b0;
+				// A tick in this very cycle shifts the lookahead; drop the word
+				// and let the next poll fetch it again rather than race the shift.
+				// A tick earlier in flight moves base, so match op_frame afresh.
+				if (in_ok && fetching && !(state == S_RUN && tick)) begin
+					if (!have0 && op_frame == base) begin
+						a_p1  <= in_lo[7:0];
+						a_p2  <= in_hi[7:0];
+						have0 <= 1'b1;
+					end
+					else if (have0 && !have1 && op_frame == base + 32'd1) begin
+						b_p1  <= in_lo[7:0];
+						b_p2  <= in_hi[7:0];
+						have1 <= 1'b1;
+					end
+				end
+			end
+			OP_CTRL: begin
+				ctrl_due <= 1'b0;
+				case (state)
+					S_IDLE: if (ddr_dout[0]) begin
+						state     <= S_ARMED;
+						sess      <= ddr_dout[15:8];
+						error     <= 8'd0;
+						stalls    <= 16'd0;
+						frame     <= 32'd0;
+						have0     <= 1'b0;
+						have1     <= 1'b0;
+						p_status  <= 1'b1;
+					end
+					S_ARMED: begin
+						if (!ddr_dout[0])     begin state <= S_IDLE;  p_status <= 1'b1; end
+						else if (ddr_dout[1]) begin state <= S_PRIME; p_status <= 1'b1; end
+					end
+					S_PRIME, S_ERROR: if (!ddr_dout[0]) begin
+						state    <= S_IDLE;
+						p_status <= 1'b1;
+					end
+					S_RUN: if (!ddr_dout[0]) begin
+						error[ERR_CTRL_DROP] <= 1'b1;
+						state    <= S_IDLE;
+						p_status <= 1'b1;
+					end
+					default: ;
+				endcase
+			end
+			default: ;
+		endcase
+	end
+
+	if (reset) begin
+		state     <= S_IDLE;
+		frame     <= 32'd0;
+		error     <= 8'd0;
+		stalls    <= 16'd0;
+		sess      <= 8'd0;
+		have0     <= 1'b0;
+		have1     <= 1'b0;
+		a_p1      <= 8'd0;
+		a_p2      <= 8'd0;
+		b_p1      <= 8'd0;
+		b_p2      <= 8'd0;
+		joy_p1    <= 8'd0;
+		joy_p2    <= 8'd0;
+		crc       <= CRC_INIT;
+		p_magic   <= 1'b1;
+		p_status  <= 1'b1;
+		p_local   <= 1'b0;
+		p_crc     <= 1'b0;
+		poll_cnt  <= 16'd0;
+		ctrl_cnt  <= 16'd0;
+		poll_due  <= 1'b0;
+		ctrl_due  <= 1'b1;
+		op        <= OP_NONE;
+		op_frame  <= 32'd0;
+		ddr_req   <= 1'b0;
+		ddr_rnw   <= 1'b1;
+		ddr_addr  <= '0;
+		ddr_din   <= '0;
+		local_frame <= 16'd0;
+		local_val   <= 8'd0;
+		crc_frame   <= 16'd0;
+		crc_val     <= 32'd0;
+	end
+end
+
+endmodule
