diff --git a/sim/Makefile b/sim/Makefile
new file mode 100644
index 0000000..c3ea6d6
--- /dev/null
+++ b/sim/Makefile
@@ -0,0 +1,40 @@
+# Simulation and lint for the netplay RTL (SPEC.md tests T1, T2).
+# Needs Verilator 5.x on PATH.
+#
+#   make lint        T1: lint netplay.sv and ddram.sv
+#   make test        T2: run every testbench scenario, prints PASS/FAIL
+#   make test SCENARIO=lockstep   run one scenario
+
+RTL        := ../rtl/netplay.sv ../rtl/ddram.sv
+TB         := np_machine.sv tb_netplay.sv
+SCENARIOS  := lockstep smooth soak underrun ctrldrop reload badsess
+OBJ        := obj_dir
+VERILATOR  ?= verilator
+
+.PHONY: lint test build clean
+
+lint:
+	$(VERILATOR) --lint-only -Wall -Wno-DECLFILENAME --top-module netplay ../rtl/netplay.sv
+	$(VERILATOR) --lint-only -Wall -Wno-DECLFILENAME -Wno-UNUSEDSIGNAL -Wno-PROCASSINIT --top-module ddram ../rtl/ddram.sv
+	@echo "LINT OK"
+
+$(OBJ)/Vtb_netplay: $(RTL) $(TB)
+	$(VERILATOR) --binary --timing --timescale 1ns/1ps -j 2 -Wno-IMPLICITSTATIC -Wno-fatal -Wno-WIDTH -Wno-DECLFILENAME \
+	  --top-module tb_netplay -o Vtb_netplay $(RTL) $(TB)
+
+build: $(OBJ)/Vtb_netplay
+
+ifdef SCENARIO
+test: build
+	./$(OBJ)/Vtb_netplay +scenario=$(SCENARIO)
+else
+test: build
+	@for s in $(SCENARIOS); do \
+	  ./$(OBJ)/Vtb_netplay +scenario=$$s > $(OBJ)/$$s.log 2>&1 || { cat $(OBJ)/$$s.log; echo "FAIL $$s"; exit 1; }; \
+	  grep -E "^(PASS|compared|frames)" $(OBJ)/$$s.log; \
+	done
+	@echo "ALL SCENARIOS PASS"
+endif
+
+clean:
+	rm -rf $(OBJ)
diff --git a/sim/np_machine.sv b/sim/np_machine.sv
new file mode 100644
index 0000000..b150a0c
--- /dev/null
+++ b/sim/np_machine.sv
@@ -0,0 +1,239 @@
+// np_machine.sv — one simulated MiSTer for the netplay testbench.
+//
+// Contains the real rtl/netplay.sv and rtl/ddram.sv, a behavioural DDR3 port
+// with random busy/latency, and a tiny fake NES whose emulated time stops
+// while paused or held in reset, like rtl/nes.v.
+//
+// The fake game reads the controller at a fixed emulated point each frame and
+// folds what it read into its own state, which drives the pixel colours. Two
+// machines that read different inputs therefore produce different CRCs.
+
+module np_machine #(
+	parameter int SEED        = 1,
+	parameter int LINES       = 30,   // scanlines per fake frame
+	parameter int DOTS        = 16,   // dots per fake scanline
+	parameter int VBL_LINE    = 20,
+	parameter int VBL_END     = 27,   // last vblank line (pause window)
+	parameter int MAX_FRAMES  = 32768
+)
+(
+	input            clk,
+	input            por,             // power-on reset
+	input            downloading,
+	input      [7:0] local_joy,
+	input            ignore_pause,    // fault injection: core never pauses
+
+	output     [2:0] state,
+	output    [31:0] frame,
+	output     [7:0] error,
+	output reg [31:0] game_frames,
+	output reg       paused
+);
+
+// ---------------------------------------------------------------------------
+// Behavioural DDR3: 0x4000-byte window is all the mailbox needs.
+localparam int WORDS = 2048;
+logic [63:0] mem [WORDS];
+
+logic [28:0] DDRAM_ADDR;
+logic  [7:0] DDRAM_BURSTCNT, DDRAM_BE;
+logic [63:0] DDRAM_DIN, DDRAM_DOUT;
+logic        DDRAM_RD, DDRAM_WE, DDRAM_DOUT_READY, DDRAM_BUSY;
+
+// byte address inside the window: DDRAM_ADDR counts 64-bit words from 0
+wire [31:0] byte_addr = {DDRAM_ADDR, 3'b000};
+wire [31:0] win_off   = byte_addr - 32'h3C000000;
+wire [10:0] widx      = win_off[13:3];
+
+int  rd_wait;
+bit  rd_pend;
+logic [10:0] rd_idx;
+int unsigned rng;
+
+
+initial begin
+	rng = SEED;
+	foreach (mem[i]) mem[i] = 64'h0;
+	DDRAM_BUSY = 0;
+	DDRAM_DOUT_READY = 0;
+	rd_pend = 0;
+end
+
+always @(posedge clk) begin
+	rng <= rng * 32'd1664525 + 32'd1013904223;
+	DDRAM_DOUT_READY <= 0;
+	DDRAM_BUSY <= (rng[15:8] % 8'd5) == 0;
+
+	if (!DDRAM_BUSY) begin
+		if (DDRAM_WE) begin
+			assert (win_off < 32'h4000) else $fatal(1, "DDR write outside mailbox: %h", byte_addr);
+			for (int b = 0; b < 8; b++)
+				if (DDRAM_BE[b]) mem[widx][b*8 +: 8] <= DDRAM_DIN[b*8 +: 8];
+		end
+		if (DDRAM_RD) begin
+			assert (win_off < 32'h4000) else $fatal(1, "DDR read outside mailbox: %h", byte_addr);
+			assert (!rd_pend) else $fatal(1, "overlapping DDR reads");
+			rd_pend <= 1;
+			rd_idx  <= widx;
+			rd_wait <= 2 + int'(rng[23:16] % 8'd20);
+		end
+	end
+
+	if (rd_pend) begin
+		if (rd_wait == 0) begin
+			DDRAM_DOUT       <= mem[rd_idx];
+			DDRAM_DOUT_READY <= 1;
+			rd_pend          <= 0;
+		end
+		else rd_wait <= rd_wait - 1;
+	end
+end
+
+// ---------------------------------------------------------------------------
+// DUT: real arbiter + real netplay module
+
+logic [27:1] ch2_addr;
+logic [63:0] ch2_din, ch2_dout;
+logic        ch2_req, ch2_rnw, ch2_ready;
+logic  [7:0] ch2_be;
+
+ddram ddram
+(
+	.DDRAM_CLK        (clk),
+	.DDRAM_BUSY       (DDRAM_BUSY),
+	.DDRAM_BURSTCNT   (DDRAM_BURSTCNT),
+	.DDRAM_ADDR       (DDRAM_ADDR),
+	.DDRAM_DOUT       (DDRAM_DOUT),
+	.DDRAM_DOUT_READY (DDRAM_DOUT_READY),
+	.DDRAM_RD         (DDRAM_RD),
+	.DDRAM_DIN        (DDRAM_DIN),
+	.DDRAM_BE         (DDRAM_BE),
+	.DDRAM_WE         (DDRAM_WE),
+
+	.ch1_addr  ('0),
+	.ch1_dout  (),
+	.ch1_din   ('0),
+	.ch1_req   (1'b0),
+	.ch1_rnw   (1'b1),
+	.ch1_be    ('0),
+	.ch1_ready (),
+
+	.ch2_addr  (ch2_addr),
+	.ch2_dout  (ch2_dout),
+	.ch2_din   (ch2_din),
+	.ch2_req   (ch2_req),
+	.ch2_rnw   (ch2_rnw),
+	.ch2_be    (ch2_be),
+	.ch2_ready (ch2_ready)
+);
+
+logic [8:0] scanline_emu;
+logic       ppu_ce_emu;
+logic [5:0] color;
+logic       active, hold_reset, pause_req;
+logic [7:0] joy_p1, joy_p2;
+
+netplay #(.POLL_INTERVAL(64), .CTRL_INTERVAL(512)) dut
+(
+	.clk          (clk),
+	.reset        (por),
+	.downloading  (downloading),
+	.scanline_emu (scanline_emu),
+	.ppu_ce_emu   (ppu_ce_emu),
+	.color        (color),
+	.vbl_line     (9'(VBL_LINE)),
+	.core_paused  (paused),
+	.local_joy    (local_joy),
+	.active       (active),
+	.hold_reset   (hold_reset),
+	.pause_req    (pause_req),
+	.joy_p1       (joy_p1),
+	.joy_p2       (joy_p2),
+	.ddr_addr     (ch2_addr),
+	.ddr_din      (ch2_din),
+	.ddr_dout     (ch2_dout),
+	.ddr_req      (ch2_req),
+	.ddr_rnw      (ch2_rnw),
+	.ddr_be       (ch2_be),
+	.ddr_ready    (ch2_ready),
+	.state_o      (state),
+	.frame_o      (frame),
+	.error_o      (error)
+);
+
+// ---------------------------------------------------------------------------
+// Fake NES. Emulated time = dot/line counters, advanced only on ppu_ce_emu.
+
+logic [1:0]  div;
+logic [4:0]  dot;
+logic [8:0]  line;
+logic [31:0] acc;          // game state, depends on everything it has read
+int          pause_clks;   // clocks since the pause engaged
+localparam int FRAME_CLKS = LINES * DOTS * 4;
+logic [15:0] plfsr;        // models the variable distance to the next instruction boundary
+
+assign scanline_emu = line;
+assign color        = acc[5:0] ^ {1'b0, dot} ^ line[5:0];
+
+// The game log: what the game saw for each of its frames.
+logic [7:0] seen_p1 [MAX_FRAMES];
+logic [7:0] seen_p2 [MAX_FRAMES];
+
+wire in_vblank = (line >= 9'(VBL_LINE)) && (line <= 9'(VBL_END));
+wire core_reset = por || hold_reset;
+
+always @(posedge clk) begin
+	ppu_ce_emu <= 0;
+	plfsr <= {plfsr[14:0], plfsr[15] ^ plfsr[13] ^ plfsr[12] ^ plfsr[10]};
+
+	if (core_reset) begin
+		div         <= 0;
+		dot         <= 0;
+		line        <= 0;
+		acc         <= 32'h12345678;
+		paused      <= 0;
+		game_frames <= 0;
+		pause_clks  <= 0;
+		plfsr       <= 16'(SEED) | 16'h1;
+	end
+	else begin
+		// pause entry: only inside vblank, at a random "instruction boundary"
+		if (!paused && pause_req && !ignore_pause && in_vblank && plfsr[2:0] == 3'd0)
+			paused <= 1;
+		// Like rtl/nes.v, the core only resumes when the free-running video
+		// copy of the PPU has come round to the frozen position again, i.e. on
+		// whole frames: every stall costs at least one full frame.
+		if (paused) begin
+			pause_clks <= pause_clks + 1;
+			if (!pause_req && pause_clks > 0 && (pause_clks % FRAME_CLKS) == 0) begin
+				paused     <= 0;
+				pause_clks <= 0;
+			end
+		end
+
+		if (!paused) begin
+			div <= div + 1'd1;
+			if (div == 2'd3) begin
+				ppu_ce_emu <= 1;
+				if (dot == 5'(DOTS - 1)) begin
+					dot  <= 0;
+					line <= (line == 9'(LINES - 1)) ? 9'd0 : line + 1'd1;
+					// game counts frames on entering vblank, like an NMI
+					if (line + 1 == VBL_LINE) game_frames <= game_frames + 1;
+				end
+				else dot <= dot + 1'd1;
+
+				// the game's NMI reads the pads two lines into vblank
+				if (line == 9'(VBL_LINE + 2) && dot == 0) begin
+					if (game_frames < MAX_FRAMES) begin
+						seen_p1[game_frames] <= joy_p1;
+						seen_p2[game_frames] <= joy_p2;
+					end
+					acc <= (acc * 32'd31) ^ {16'd0, joy_p2, joy_p1};
+				end
+			end
+		end
+	end
+end
+
+endmodule
diff --git a/sim/tb_netplay.sv b/sim/tb_netplay.sv
new file mode 100644
index 0000000..a8b5c55
--- /dev/null
+++ b/sim/tb_netplay.sv
@@ -0,0 +1,386 @@
+// tb_netplay.sv — testbench for rtl/netplay.sv (SPEC.md test T2)
+//
+// Two simulated MiSTers (np_machine) run the same fake game. A behavioural
+// "HPS + network" in this file plays the part of Main_MiSTer on both sides:
+// it reads LOCAL[k] from each mailbox and writes INPUT[k+D] back into both,
+// with independent random latency and torn (half-then-half) 64-bit writes.
+//
+// Scenarios (+scenario=<name>):
+//   lockstep  both machines must see identical input every frame, equal to
+//             what the protocol says, and post identical CRCs (jittery link)
+//   smooth    a link well inside the delay budget must never stall
+//   soak      lockstep for 20000 frames, so that rare same-cycle races happen
+//   underrun  a core that ignores pause must be caught with UNDERRUN
+//   ctrldrop  dropping enable in RUN returns to IDLE with CTRL_DROP
+//   reload    a ROM load during RUN gives RELOAD
+//   badsess   INPUT entries with the wrong session id are never accepted
+//
+// Prints PASS or FAIL and exits non-zero on failure.
+
+
+
+module tb_netplay;
+
+localparam int D          = 2;        // input delay in frames
+localparam int MAX_FRAMES = 32768;
+int            FRAMES     = 400;      // frames to run in lockstep (+frames=N)
+localparam logic [7:0] SESS = 8'h5A;
+
+localparam int OFF_MAGIC  = 'h0000;
+localparam int OFF_STATUS = 'h0008;
+localparam int OFF_CTRL   = 'h0010;
+localparam int OFF_LOCAL  = 'h1000;
+localparam int OFF_CRC    = 'h1800;
+localparam int OFF_INPUT  = 'h2000;
+
+localparam logic [2:0] S_IDLE = 0, S_ARMED = 1, S_PRIME = 2, S_RUN = 3, S_ERROR = 4;
+
+string scenario;
+
+logic clk = 0;
+always #5 clk = ~clk;
+
+logic       por = 1;
+logic [1:0] dl;
+logic [7:0] ljoy [2];
+logic [1:0] ign_pause;
+
+logic [2:0]  st   [2];
+logic [31:0] fr   [2];
+logic [7:0]  er   [2];
+logic [31:0] gfr  [2];
+logic [1:0]  pz;
+
+np_machine #(.SEED(11), .MAX_FRAMES(MAX_FRAMES)) mA (
+	.clk(clk), .por(por), .downloading(dl[0]), .local_joy(ljoy[0]), .ignore_pause(ign_pause[0]),
+	.state(st[0]), .frame(fr[0]), .error(er[0]), .game_frames(gfr[0]), .paused(pz[0]));
+
+np_machine #(.SEED(97), .MAX_FRAMES(MAX_FRAMES)) mB (
+	.clk(clk), .por(por), .downloading(dl[1]), .local_joy(ljoy[1]), .ignore_pause(ign_pause[1]),
+	.state(st[1]), .frame(fr[1]), .error(er[1]), .game_frames(gfr[1]), .paused(pz[1]));
+
+// ---------------------------------------------------------------------------
+// Mailbox access, as the ARM would do it (64-bit words, may tear)
+
+function automatic logic [63:0] mb_rd(int m, int off);
+	return (m == 0) ? mA.mem[off >> 3] : mB.mem[off >> 3];
+endfunction
+
+task automatic mb_wr(int m, int off, logic [63:0] v);
+	if (m == 0) mA.mem[off >> 3] = v; else mB.mem[off >> 3] = v;
+endtask
+
+task automatic mb_wr_lo(int m, int off, logic [31:0] v);
+	if (m == 0) mA.mem[off >> 3][31:0] = v; else mB.mem[off >> 3][31:0] = v;
+endtask
+
+task automatic mb_wr_hi(int m, int off, logic [31:0] v);
+	if (m == 0) mA.mem[off >> 3][63:32] = v; else mB.mem[off >> 3][63:32] = v;
+endtask
+
+function automatic logic [63:0] input_word(int f, logic [7:0] p1, logic [7:0] p2, logic [7:0] s);
+	return {f[15:0], s, p2, f[15:0], s, p1};
+endfunction
+
+// ---------------------------------------------------------------------------
+// Bookkeeping
+
+int          errors = 0;
+logic [7:0]  local_seen [2][MAX_FRAMES];
+bit          local_have [2][MAX_FRAMES];
+logic [31:0] crc_seen   [2][MAX_FRAMES];
+bit          crc_have   [2][MAX_FRAMES];
+logic [7:0]  input_p1   [MAX_FRAMES];
+logic [7:0]  input_p2   [MAX_FRAMES];
+int          next_local [2];
+int          next_crc   [2];
+int          next_input;                  // next INPUT frame to schedule
+
+// pending INPUT writes per machine: frame, due cycle, torn half
+typedef struct { int f; longint due; bit hi_done; bit lo_done; longint hi_due; } wr_t;
+wr_t         q [2][$];
+
+longint      cyc = 0;
+int unsigned hrng = 32'hC0FFEE;
+int          max_lat [2];
+logic [7:0]  sess_used = SESS;
+
+function automatic int unsigned hr();
+	hrng = hrng * 32'd1103515245 + 32'd12345;
+	return hrng >> 8;
+endfunction
+
+task automatic fail(string msg);
+	errors++;
+	if (errors <= 20) $display("FAIL: %s", msg);
+endtask
+
+task automatic clear_rings(int m);
+	for (int i = 0; i < 256; i++) begin
+		mb_wr(m, OFF_LOCAL + i*8, 64'h0);
+		mb_wr(m, OFF_CRC   + i*8, 64'h0);
+		// deliberately mismatched tags: never valid
+		mb_wr(m, OFF_INPUT + i*8, 64'hFFFF_0000_0000_0000);
+	end
+endtask
+
+task automatic wait_state(int m, logic [2:0] s, int timeout);
+	int t = 0;
+	while (st[m] != s && t < timeout) begin @(posedge clk); t++; end
+	if (st[m] != s) fail($sformatf("machine %0d: waited for state %0d, still %0d", m, s, st[m]));
+endtask
+
+// Collect LOCAL / CRC posts and schedule INPUT writes every cycle.
+task automatic hps_step();
+	cyc++;
+	for (int m = 0; m < 2; m++) begin
+		logic [63:0] w;
+		// LOCAL
+		w = mb_rd(m, OFF_LOCAL + (next_local[m] & 255) * 8);
+		if (w[63:48] == 16'(next_local[m]) && w[31:16] == 16'(next_local[m]) && w[47:40] == SESS && w[15:8] == SESS) begin
+			if (w[39:32] != w[7:0]) fail("LOCAL halves disagree");
+			local_seen[m][next_local[m]] = w[7:0];
+			local_have[m][next_local[m]] = 1;
+			next_local[m]++;
+		end
+		// CRC
+		w = mb_rd(m, OFF_CRC + (next_crc[m] & 255) * 8);
+		if (w[63:48] == 16'(next_crc[m]) && w[31:16] == 16'(next_crc[m]) && (next_crc[m] != 0 || w != 64'h0)) begin
+			crc_seen[m][next_crc[m]] = {w[47:32], w[15:0]};
+			crc_have[m][next_crc[m]] = 1;
+			next_crc[m]++;
+		end
+	end
+
+	// INPUT[k+D] = {p1: A's LOCAL[k], p2: B's LOCAL[k]}
+	while (next_input - D >= 0 && next_input < MAX_FRAMES
+	       && local_have[0][next_input - D] && local_have[1][next_input - D]) begin
+		input_p1[next_input] = local_seen[0][next_input - D];
+		input_p2[next_input] = local_seen[1][next_input - D];
+		for (int m = 0; m < 2; m++) begin
+			wr_t e;
+			e.f = next_input;
+			e.due = cyc + (hr() % (max_lat[m] + 1));
+			e.lo_done = 0; e.hi_done = 0;
+			e.hi_due = e.due + 1 + (hr() % 40);   // torn: lo lands first, hi later
+			q[m].push_back(e);
+		end
+		next_input++;
+	end
+
+	for (int m = 0; m < 2; m++) begin
+		for (int i = 0; i < q[m].size(); i++) begin
+			logic [63:0] v = input_word(q[m][i].f, input_p1[q[m][i].f], input_p2[q[m][i].f], sess_used);
+			int off = OFF_INPUT + (q[m][i].f & 255) * 8;
+			if (!q[m][i].lo_done && cyc >= q[m][i].due)    begin mb_wr_lo(m, off, v[31:0]);  q[m][i].lo_done = 1; end
+			if (!q[m][i].hi_done && cyc >= q[m][i].hi_due) begin mb_wr_hi(m, off, v[63:32]); q[m][i].hi_done = 1; end
+		end
+		while (q[m].size() > 0 && q[m][0].lo_done && q[m][0].hi_done) void'(q[m].pop_front());
+	end
+endtask
+
+// Bring both machines from power-on to RUN following SPEC.md "Sessionsstart".
+task automatic start_session(int lat_a, int lat_b);
+	max_lat[0] = lat_a; max_lat[1] = lat_b;
+	for (int m = 0; m < 2; m++) begin
+		if (mb_rd(m, OFF_MAGIC) != 64'h313030504E53454E) fail($sformatf("machine %0d: MAGIC missing", m));
+		clear_rings(m);
+		mb_wr(m, OFF_CTRL, {48'd0, SESS, 8'h01});          // enable
+	end
+	wait_state(0, S_ARMED, 5000);
+	wait_state(1, S_ARMED, 5000);
+
+	// ROM reload while ARMED must be harmless
+	dl = 2'b11;
+	repeat (300) @(posedge clk);
+	dl = 2'b00;
+	repeat (50) @(posedge clk);
+	if (st[0] != S_ARMED || st[1] != S_ARMED) fail("ROM load in ARMED changed state");
+
+	for (int f = 0; f < D; f++) begin
+		input_p1[f] = 0; input_p2[f] = 0;
+		for (int m = 0; m < 2; m++) mb_wr(m, OFF_INPUT + f*8, input_word(f, 0, 0, sess_used));
+	end
+	next_input = D;
+	for (int m = 0; m < 2; m++) begin
+		mb_wr(m, OFF_CTRL, {48'd0, SESS, 8'h03});          // enable + run
+	end
+	inv_on = (sess_used == SESS);
+endtask
+
+// Invariant, checked every cycle on both machines: whatever sits in the
+// lookahead must be exactly INPUT[base] / INPUT[base+1], and what the game
+// currently sees must be INPUT[frame].
+logic        inv_on = 0;
+int          inv_events = 0;
+always @(posedge clk) if (inv_on) begin
+	if (st[0] == S_RUN) check_inv(0);
+	if (st[1] == S_RUN) check_inv(1);
+end
+
+task automatic check_inv(int m);
+	logic h0, h1; logic [7:0] ap1, ap2, bp1, bp2, j1, j2; int f;
+	if (m == 0) begin h0 = mA.dut.have0; h1 = mA.dut.have1; ap1 = mA.dut.a_p1; ap2 = mA.dut.a_p2;
+	                  bp1 = mA.dut.b_p1; bp2 = mA.dut.b_p2; j1 = mA.dut.joy_p1; j2 = mA.dut.joy_p2; f = fr[0]; end
+	else        begin h0 = mB.dut.have0; h1 = mB.dut.have1; ap1 = mB.dut.a_p1; ap2 = mB.dut.a_p2;
+	                  bp1 = mB.dut.b_p1; bp2 = mB.dut.b_p2; j1 = mB.dut.joy_p1; j2 = mB.dut.joy_p2; f = fr[1]; end
+	if (f + 2 >= MAX_FRAMES) return;
+	if (j1 !== input_p1[f] || j2 !== input_p2[f]) fail($sformatf("m%0d frame %0d: joy %h/%h != INPUT %h/%h", m, f, j1, j2, input_p1[f], input_p2[f]));
+	if (h0 && (ap1 !== input_p1[f+1] || ap2 !== input_p2[f+1])) fail($sformatf("m%0d frame %0d: slot0 holds wrong frame", m, f));
+	if (h1 && (bp1 !== input_p1[f+2] || bp2 !== input_p2[f+2])) fail($sformatf("m%0d frame %0d: slot1 holds wrong frame", m, f));
+	if (h1 && !h0) fail($sformatf("m%0d: slot1 valid without slot0", m));
+endtask
+
+// Count the race the soak scenario is after: a tick on the same cycle as a
+// valid INPUT read for slot 1.
+always @(posedge clk) begin
+	if (mA.dut.state == S_RUN && mA.dut.tick && mA.dut.ddr_ready && mA.dut.op == 3'd6 && mA.dut.in_ok) inv_events++;
+	if (mB.dut.state == S_RUN && mB.dut.tick && mB.dut.ddr_ready && mB.dut.op == 3'd6 && mB.dut.in_ok) inv_events++;
+end
+
+// Real-time pad changes, independent per machine
+always @(posedge clk) begin
+	if ((hr() % 97) == 0) ljoy[0] <= 8'(hr());
+	if ((hr() % 131) == 0) ljoy[1] <= 8'(hr());
+end
+
+// ---------------------------------------------------------------------------
+
+initial begin
+	if (!$value$plusargs("scenario=%s", scenario)) scenario = "lockstep";
+	$display("scenario: %s", scenario);
+
+	dl = 0; ign_pause = 0; ljoy[0] = 0; ljoy[1] = 0;
+	next_local = '{0, 0}; next_crc = '{0, 0}; next_input = 0;
+	foreach (local_have[m, f]) local_have[m][f] = 0;
+	foreach (crc_have[m, f])   crc_have[m][f] = 0;
+
+	repeat (10) @(posedge clk);
+	por = 0;
+	repeat (2000) @(posedge clk);
+
+	case (scenario)
+
+	"lockstep", "smooth", "soak": begin
+		int stalls_a, stalls_b;
+		// lockstep: A has a fast "network", B a slow, jittery one (~1.5 frames
+		// worst case, so it sometimes misses the 1-frame budget of D=2).
+		// smooth: both comfortably inside the budget.
+		if (scenario == "soak") FRAMES = 20000;
+		if (scenario != "smooth") start_session(200, 2800);
+		else                        start_session(300, 1200);
+		fork
+			while (gfr[0] < FRAMES || gfr[1] < FRAMES) begin @(posedge clk); hps_step(); end
+			begin repeat (FRAMES * 4000) @(posedge clk); fail("lockstep timed out"); end
+		join_any
+		disable fork;
+
+		for (int m = 0; m < 2; m++)
+			if (st[m] != S_RUN) fail($sformatf("machine %0d left RUN: state %0d error %b", m, st[m], er[m]));
+
+		// what each game saw must equal the protocol's INPUT[k], and each other
+		for (int f = 1; f < FRAMES; f++) begin
+			if (mA.seen_p1[f] !== input_p1[f] || mA.seen_p2[f] !== input_p2[f])
+				fail($sformatf("A frame %0d saw %h/%h, expected %h/%h", f, mA.seen_p1[f], mA.seen_p2[f], input_p1[f], input_p2[f]));
+			if (mB.seen_p1[f] !== mA.seen_p1[f] || mB.seen_p2[f] !== mA.seen_p2[f])
+				fail($sformatf("frame %0d: A saw %h/%h, B saw %h/%h", f, mA.seen_p1[f], mA.seen_p2[f], mB.seen_p1[f], mB.seen_p2[f]));
+		end
+
+		// the inputs must actually vary, or the test proves nothing
+		begin
+			int changes = 0;
+			for (int f = D + 1; f < FRAMES; f++) if (input_p1[f] != input_p1[f-1]) changes++;
+			if (changes < 20) fail($sformatf("only %0d input changes, test too weak", changes));
+		end
+
+		// CRCs must agree frame by frame
+		begin
+			int compared = 0;
+			for (int f = 0; f < FRAMES - 2; f++) begin
+				if (!crc_have[0][f] || !crc_have[1][f]) begin fail($sformatf("CRC %0d missing", f)); break; end
+				if (crc_seen[0][f] != crc_seen[1][f]) fail($sformatf("CRC mismatch at frame %0d", f));
+				compared++;
+			end
+			$display("compared %0d CRCs", compared);
+		end
+
+		stalls_a = mA.dut.stalls;
+		stalls_b = mB.dut.stalls;
+		$display("frames A=%0d B=%0d, stalls A=%0d B=%0d, same-cycle races %0d", fr[0], fr[1], stalls_a, stalls_b, inv_events);
+		if (scenario == "soak" && inv_events == 0) fail("soak never hit the tick/read race");
+		if (scenario != "smooth") begin
+			if (stalls_a + stalls_b == 0) fail("no stalls: pause path not exercised");
+			if (stalls_a > FRAMES / 3 || stalls_b > FRAMES / 3) fail("stalling far more often than the link requires");
+		end
+		else if (stalls_a + stalls_b != 0) fail("stalls on a link inside the budget");
+
+		// a deliberate input difference must show up as a CRC difference:
+		// covered by the 'badsess'-free design; here check CRC depends on input
+		begin
+			bit any_diff = 0;
+			for (int f = 1; f < FRAMES - 2; f++) if (crc_seen[0][f] != crc_seen[0][f-1]) any_diff = 1;
+			if (!any_diff) fail("CRC never changes");
+		end
+	end
+
+	"underrun": begin
+		ign_pause = 2'b01;                // machine A's core ignores pause
+		start_session(200, 200);
+		// stop feeding after a while: A must notice it ran past a missing input
+		fork
+			while (gfr[0] < 30) begin @(posedge clk); hps_step(); end
+			begin repeat (200000) @(posedge clk); fail("never reached frame 30"); end
+		join_any
+		disable fork;
+		repeat (20000) @(posedge clk);    // no hps_step: inputs dry up
+		if (st[0] != S_ERROR || !er[0][0]) fail($sformatf("A: expected ERROR/UNDERRUN, got state %0d error %b", st[0], er[0]));
+		if (st[1] != S_RUN) fail($sformatf("B (honours pause) should still wait in RUN, got %0d", st[1]));
+		if (!pz[1]) fail("B should be paused while waiting");
+	end
+
+	"ctrldrop": begin
+		start_session(200, 200);
+		fork
+			while (gfr[0] < 20) begin @(posedge clk); hps_step(); end
+			begin repeat (200000) @(posedge clk); fail("never reached frame 20"); end
+		join_any
+		disable fork;
+		mb_wr(0, OFF_CTRL, 64'h0);
+		repeat (2000) @(posedge clk);
+		if (st[0] != S_IDLE || !er[0][1]) fail($sformatf("A: expected IDLE/CTRL_DROP, got %0d %b", st[0], er[0]));
+		if (mA.dut.pause_req || mA.dut.hold_reset) fail("A still pausing/holding after drop");
+	end
+
+	"reload": begin
+		start_session(200, 200);
+		fork
+			while (gfr[1] < 20) begin @(posedge clk); hps_step(); end
+			begin repeat (200000) @(posedge clk); fail("never reached frame 20"); end
+		join_any
+		disable fork;
+		dl = 2'b10;
+		repeat (20) @(posedge clk);
+		dl = 2'b00;
+		repeat (100) @(posedge clk);
+		if (st[1] != S_ERROR || !er[1][2]) fail($sformatf("B: expected ERROR/RELOAD, got %0d %b", st[1], er[1]));
+	end
+
+	"badsess": begin
+		sess_used = SESS ^ 8'hFF;         // HPS writes the wrong session id
+		start_session(100, 100);
+		repeat (60000) begin @(posedge clk); hps_step(); end
+		// INPUT[0] was prefilled with the wrong session too: never leaves PRIME
+		if (st[0] != S_PRIME || st[1] != S_PRIME) fail($sformatf("expected PRIME, got %0d/%0d", st[0], st[1]));
+	end
+
+	default: fail({"unknown scenario ", scenario});
+	endcase
+
+	if (errors == 0) begin
+		$display("PASS %s", scenario);
+		$finish;
+	end
+	else $fatal(1, "FAIL %s (%0d errors)", scenario, errors);
+end
+
+endmodule
-- 
