From b1345fa2d939b6225a56f1032727f3fafe5337dc Mon Sep 17 00:00:00 2001
From: netplay <netplay@localhost>
Date: Thu, 12 Nov 2026 17:53:05 +0100
Subject: [PATCH 11/12] gba_rfu: answer and event data words carry {seq,
 index}, read again until they have landed (Pokemon communication error);
 npsim sertb: serial port + gba_rfu against Pokemon's librfu handlers, HPS
 writes late and out of order
---
 npsim/Makefile                  |    16 +-
 npsim/sertb/.gitignore          |     3 +
 npsim/sertb/README.md           |     7 +
 npsim/sertb/serial_wrap.vhd     |    58 +
 npsim/sertb/serial_wrap_fixed.v | 13338 ++++++++++++++++++++++++++++++
 npsim/sertb/sertb.cpp           |   457 +
 npsim/sertb/sertb_top.sv        |    66 +
 rtl/gba_rfu.sv                  |    35 +-
 8 files changed, 13970 insertions(+), 10 deletions(-)
 create mode 100644 npsim/sertb/.gitignore
 create mode 100644 npsim/sertb/README.md
 create mode 100644 npsim/sertb/serial_wrap.vhd
 create mode 100644 npsim/sertb/serial_wrap_fixed.v
 create mode 100644 npsim/sertb/sertb.cpp
 create mode 100644 npsim/sertb/sertb_top.sv

diff --git a/npsim/Makefile b/npsim/Makefile
index 23bda86..2662ffe 100644
--- a/npsim/Makefile
+++ b/npsim/Makefile
@@ -46,7 +46,21 @@ t2w: obj/gba_sim $(BUILD)/rfutest.gba
 clean:
 	rm -rf $(BUILD) obj
 
-.PHONY: all clean t2w
+# T2w unit bench (sertb/): gba_serial (GHDL synth, bus wired by hand) and
+# gba_rfu with Main's rfu.cpp/rfu_mailbox.cpp; the CPU plays Pokemon's librfu
+# (master and slave handlers), the HPS's writes late and out of order
+sertb/obj/sertb: sertb/sertb_top.sv sertb/sertb.cpp sertb/serial_wrap_fixed.v ../rtl/gba_rfu.sv $(RFU_SRC)
+	cd sertb && verilator --cc --exe --build -j 0 -O2 $(filter-out -O3 --top-module sim_top,$(VFLAGS)) --top-module sertb_top \
+	  -CFLAGS "-I$(abspath $(MAIN_NP)) -std=c++17" -Mdir obj -o sertb sertb_top.sv ../../rtl/gba_rfu.sv serial_wrap_fixed.v sertb.cpp $(RFU_SRC)
+
+sertb: sertb/obj/sertb
+	sertb/obj/sertb
+	sertb/obj/sertb --hpsdelay 2000
+	sertb/obj/sertb --hpsdelay 5000 --hpsreorder
+	sertb/obj/sertb --hpsdelay 50000 --hpsreorder --net 60
+	sertb/obj/sertb --hpsdelay 3000 --hpsreorder --wait 50
+
+.PHONY: all clean t2w sertb
 
 # obj_trace/gba_sim: the same with a VCD of 600 clocks from the first GBA_DBGREAD read (trace.vcd)
 obj_trace/gba_sim: $(BUILD)/vlog/gba_top_fixed.v sim_top.sv ../rtl/gba_rfu.sv gba_sim.cpp $(RFU_SRC)
