new file mode 100644
index 0000000..22819f4
--- /dev/null
+++ b/npsim/sertb/sertb_top.sv
@@ -0,0 +1,66 @@
+// sertb_top: the serial port (gba_serial, through serial_wrap) and the adapter
+// (gba_rfu) with its mailbox in C++ (DPI). The C++ side plays the GBA's CPU
+// (register writes as Pokemon's librfu does them) and the HPS (Main's rfu.cpp).
+// Simulation only (netplay SPEC 13.6, T2w unit bench).
+
+import "DPI-C" function longint mb_read (input int widx);
+import "DPI-C" function void    mb_write(input int widx, input longint data);
+
+module sertb_top(
+    input         clk,
+    input  [27:0] adr,
+    input  [31:0] din,
+    input   [3:0] bena,
+    input         rnw,
+    input         ena,
+    output [31:0] dout,
+    input         new_cycles_valid,
+    output        irq,
+    output        ext_ready,
+    output        sd_reset
+);
+
+wire        req, done;
+wire [31:0] word, answer;
+wire [27:3] maddr;
+wire [63:0] mdin;
+wire        mwe, mreq;
+reg  [63:0] mdout = 0;
+reg         mready = 0;
+reg   [2:0] mwait = 0;
+reg         mbusy = 0;
+
+serial_wrap ser(
+    .clk(clk), .adr(adr), .din(din), .bena(bena), .rnw(rnw), .ena(ena), .dout(dout),
+    .new_cycles_valid(new_cycles_valid), .irq(irq),
+    .rfu_xfer_req(req), .rfu_xfer_word(word), .rfu_xfer_done(done), .rfu_xfer_answer(answer),
+    .rfu_ext_ready(ext_ready), .rfu_reset(sd_reset)
+);
+
+gba_rfu rfu(
+    .clk(clk), .reset(1'b0), .enable(1'b1),
+    .xfer_req(req), .xfer_word(word), .xfer_done(done), .xfer_answer(answer),
+    .ext_ready(ext_ready), .sd_reset(sd_reset),
+    .mem_addr(maddr), .mem_din(mdin), .mem_we(mwe), .mem_req(mreq),
+    .mem_dout(mdout), .mem_ready(mready)
+);
+
+// DDR3: a few clocks per access
+always @(posedge clk) begin
+    mready <= 0;
+    if (mreq && !mbusy && !mready) begin
+        mbusy <= 1;
+        mwait <= 3'd5;
+    end
+    else if (mbusy) begin
+        if (mwait != 0) mwait <= mwait - 1'd1;
+        else begin
+            if (mwe) mb_write({7'd0, maddr}, mdin);
+            else mdout <= mb_read({7'd0, maddr});
+            mready <= 1;
+            mbusy  <= 0;
+        end
+    end
+end
+
+endmodule
