+module serial_wrap
+  (input  clk,
+   input  [27:0] adr,
+   input  [31:0] din,
+   input  [3:0] bena,
+   input  rnw,
+   input  ena,
+   output [31:0] dout,
+   input  new_cycles_valid,
+   output irq,
+   output rfu_xfer_req,
+   output [31:0] rfu_xfer_word,
+   input  rfu_xfer_done,
+   input  [31:0] rfu_xfer_answer,
+   output rfu_ext_ready,
+   output rfu_reset);
+  // hand wiring (sertb): the bus fields the CPU drives are plain inputs; Dout
+  // and done are resolved inside gba_serial (its registers drive them)
+  wire [31:0] bus_din = din;
+  wire [27:0] bus_adr = adr;
+  wire bus_rnw = rnw, bus_ena = ena, bus_rst = 1'b0;
+  wire [1:0] bus_acc = 2'b10;
+  wire [3:0] bus_bena = bena;
+  wire [31:0] bus_dout;
+  wire bus_done;
+  assign dout = bus_dout;
+  gba_serial_Barch iser (
+    .clk100(clk),
+    .\gb_bus[din] (bus_din),
+    .\gb_bus[dout] (bus_dout),
+    .\gb_bus[adr] (bus_adr),
+    .\gb_bus[rnw] (bus_rnw),
+    .\gb_bus[ena] (bus_ena),
+    .\gb_bus[done] (bus_done),
+    .\gb_bus[acc] (bus_acc),
+    .\gb_bus[bena] (bus_bena),
+    .\gb_bus[rst] (bus_rst),
+    .new_cycles(8'b00000001),
+    .new_cycles_valid(new_cycles_valid),
+    .rfu_enable(1'b1),
+    .rfu_xfer_done(rfu_xfer_done),
+    .rfu_xfer_answer(rfu_xfer_answer),
+    .irp_serial(irq),
+    .rfu_xfer_req(rfu_xfer_req),
+    .rfu_xfer_word(rfu_xfer_word),
+    .rfu_ext_ready(rfu_ext_ready),
+    .rfu_reset(rfu_reset));
+endmodule
