diff --git a/npsim/sertb/README.md b/npsim/sertb/README.md
new file mode 100644
index 0000000..3e4642e
--- /dev/null
+++ b/npsim/sertb/README.md
@@ -0,0 +1,7 @@
+# sertb: the adapter's word level against Pokemon's driver
+
+`make -C npsim sertb`. `serial_wrap_fixed.v` is `gba_serial` from `ghdl synth`
+of `serial_wrap.vhd` (analysed into `build/ghdl` with the core's files), with
+the `serial_wrap` module replaced by hand wiring of the register bus
+(`serial_wrap_hand.v`, then `fix_inout.py`). Regenerate it after a change to
+`rtl/gba_serial.vhd`.
diff --git a/npsim/sertb/serial_wrap.vhd b/npsim/sertb/serial_wrap.vhd
new file mode 100644
index 0000000..e5387ea
--- /dev/null
+++ b/npsim/sertb/serial_wrap.vhd
@@ -0,0 +1,58 @@
+-- serial_wrap: gba_serial with a plain register port, for the serial/adapter
+-- unit bench (sertb/). Simulation only.
+library IEEE;
+use IEEE.std_logic_1164.all;
+use IEEE.numeric_std.all;
+library work;
+use work.pProc_bus_gba.all;
+
+entity serial_wrap is
+   port
+   (
+      clk              : in  std_logic;
+      adr              : in  std_logic_vector(27 downto 0);
+      din              : in  std_logic_vector(31 downto 0);
+      bena             : in  std_logic_vector(3 downto 0);
+      rnw              : in  std_logic;
+      ena              : in  std_logic;
+      dout             : out std_logic_vector(31 downto 0);
+      new_cycles_valid : in  std_logic;
+      irq              : out std_logic;
+      rfu_xfer_req     : out std_logic;
+      rfu_xfer_word    : out std_logic_vector(31 downto 0);
+      rfu_xfer_done    : in  std_logic;
+      rfu_xfer_answer  : in  std_logic_vector(31 downto 0);
+      rfu_ext_ready    : out std_logic;
+      rfu_reset        : out std_logic
+   );
+end entity;
+
+architecture arch of serial_wrap is
+   signal gb_bus : proc_bus_gb_type;
+begin
+   gb_bus.Adr  <= adr;
+   gb_bus.Din  <= din;
+   gb_bus.rnw  <= rnw;
+   gb_bus.ena  <= ena;
+   gb_bus.bEna <= bena;
+   gb_bus.acc  <= "10";
+   gb_bus.rst  <= '0';
+   dout <= gb_bus.Dout;
+
+   iser : entity work.gba_serial
+   port map
+   (
+      clk100           => clk,
+      gb_bus           => gb_bus,
+      new_cycles       => x"01",
+      new_cycles_valid => new_cycles_valid,
+      IRP_Serial       => irq,
+      rfu_enable       => '1',
+      rfu_xfer_req     => rfu_xfer_req,
+      rfu_xfer_word    => rfu_xfer_word,
+      rfu_xfer_done    => rfu_xfer_done,
+      rfu_xfer_answer  => rfu_xfer_answer,
+      rfu_ext_ready    => rfu_ext_ready,
+      rfu_reset        => rfu_reset
+   );
+end architecture;
