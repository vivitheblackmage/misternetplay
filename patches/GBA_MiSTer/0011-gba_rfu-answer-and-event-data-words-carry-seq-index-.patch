+// sertb.cpp: unit bench for the wireless adapter's word level (netplay SPEC 13.6).
+// The serial port (gba_serial) and gba_rfu in Verilator; the GBA's CPU is played
+// by this file, doing exactly what Pokemon FireRed's librfu does with the
+// registers (pret/pokefirered src/librfu_stwi.c, src/librfu_intr.c: the master
+// and slave interrupt handlers, their SI/SO handshakes and their timers); the
+// HPS is Main's own rfu.cpp and rfu_mailbox.cpp. A second Rfu is the peer
+// adapter, with network delay.
+//
+// Scenario (Pokemon's Union Room, our GBA joins): the peer hosts, our GBA
+// searches, connects, sends Wait (MS change); the peer's data arrives later;
+// the adapter pushes 0x99660028 and 0x80000000; the GBA takes them in its slave
+// handler and goes back to master; ReceiveData gets the byte.
+//
+//   sertb [--net MS] [--wait MS]     PASS sertb / FAIL ... (where it got stuck)
+
+#include "Vsertb_top.h"
+#include "verilated.h"
+#include "rfu.h"
+#include "rfu_mailbox.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <deque>
+#include <vector>
+
+static Vsertb_top *top;
+static uint64_t clk_n = 0;
+static const uint64_t CLK_PER_MS = 100000;   // 100 MHz
+static uint64_t now_ms() { return clk_n / CLK_PER_MS; }
+
+// ---- mailbox (DDR3) ----
+static const uint32_t MB_WIDX = 0xC000000u >> 3;
+static uint64_t mbox[RfuMailbox::SIZE / 8];
+extern "C" long long mb_read(int widx)
+{
+	uint32_t i = (uint32_t)widx - MB_WIDX;
+	return i < RfuMailbox::SIZE / 8 ? (long long)mbox[i] : 0;
+}
+extern "C" void mb_write(int widx, long long data)
+{
+	uint32_t i = (uint32_t)widx - MB_WIDX;
+	if (i < RfuMailbox::SIZE / 8) mbox[i] = (uint64_t)data;
+}
+
+// --hpsdelay N: the HPS's mailbox writes reach the FPGA's side N clocks late,
+// in order (posted writes through the interconnect); --hpsreorder: each
+// write late by a random 0..N clocks (any order)
+static uint64_t hps_delay = 0;
+static bool hps_reorder = false;
+static uint64_t clk_now = 0;
+struct PendW { uint64_t at; uint32_t i; uint64_t v; };
+static std::deque<PendW> pend_w;
+static uint64_t mbox_hps[RfuMailbox::SIZE / 8];   // what the HPS sees (its own writes at once)
+static uint32_t xs32 = 12345;
+static void hps_flush()
+{
+	for (size_t k = 0; k < pend_w.size();)
+		if (pend_w[k].at <= clk_now) { mbox[pend_w[k].i] = pend_w[k].v; pend_w.erase(pend_w.begin() + k); }
+		else if (!hps_reorder) break;
+		else k++;
+}
+
+// ---- the two adapters and the network between them ----
+struct Pkt { uint64_t at; int to; std::vector<uint8_t> d; };
+static std::deque<Pkt> net;
+static uint64_t net_ms = 20;
+static Rfu rfu_gba([](int, const uint8_t *b, size_t n) { net.push_back({now_ms() + net_ms, 1, std::vector<uint8_t>(b, b + n)}); }, 101);
+static Rfu rfu_peer([](int, const uint8_t *b, size_t n) { net.push_back({now_ms() + net_ms, 0, std::vector<uint8_t>(b, b + n)}); }, 202);
+static RfuMailbox mb((volatile uint64_t *)mbox_hps);
+static uint64_t mbox_seen[RfuMailbox::SIZE / 8];   // the FPGA side as the HPS last left it
+static void hps_poll(uint32_t ms)
+{
+	// FPGA writes (mbox changed by the FPGA) are visible to the HPS at once
+	for (uint32_t i = 0; i < RfuMailbox::SIZE / 8; i++)
+		if (mbox[i] != mbox_seen[i]) { mbox_hps[i] = mbox[i]; mbox_seen[i] = mbox[i]; }
+	uint64_t before[RfuMailbox::SIZE / 8];
+	memcpy(before, mbox_hps, sizeof(before));
+	mb.poll(ms, rfu_gba);
+	for (uint32_t i = 0; i < RfuMailbox::SIZE / 8; i++)
+		if (mbox_hps[i] != before[i])
+		{
+			xs32 ^= xs32 << 13; xs32 ^= xs32 >> 17; xs32 ^= xs32 << 5;
+			uint64_t d = hps_reorder ? (hps_delay ? xs32 % (hps_delay + 1) : 0) : hps_delay;
+			pend_w.push_back({clk_now + d, i, mbox_hps[i]});
+			mbox_seen[i] = mbox_hps[i];
+		}
+	hps_flush();
+}
+
+static void deliver()
+{
+	for (size_t i = 0; i < net.size();)
+	{
+		if (net[i].at <= now_ms())
+		{
+			Pkt p = net[i];
+			net.erase(net.begin() + i);
+			(p.to == 0 ? rfu_gba : rfu_peer).receive(0, p.d.data(), p.d.size());
+		}
+		else i++;
+	}
+}
+
+// the peer: hosts; from peer_send_at on, sends host data (header 1, no word,
+// as Pokemon's parent) every 16 frames
+static uint64_t peer_send_at = ~0ull, last_frame = 0, peer_sent = 0;
+static void peer_frame()
+{
+	if (now_ms() >= peer_send_at && (peer_sent == 0 || now_ms() - peer_sent >= 268))
+	{
+		uint32_t out[Rfu::MAX_WORDS], d[1] = { 1 };
+		rfu_peer.command(0x24, d, 1, out);
+		peer_sent = now_ms();
+	}
+}
+
+static bool irq_pending = false;
+static void tick(int n = 1)
+{
+	while (n--)
+	{
+		top->clk = 0; top->eval();
+		top->clk = 1; top->eval();
+		clk_n++;
+		top->new_cycles_valid = !top->new_cycles_valid;
+		if (top->irq) irq_pending = true;
+		clk_now = clk_n;
+		if (!pend_w.empty()) hps_flush();
+		if (clk_n % 10000 == 0)   // the HPS: every 100 us
+		{
+			hps_poll((uint32_t)now_ms());
+			deliver();
+		}
+		if (clk_n - last_frame >= 1674300)   // a GBA frame
+		{
+			last_frame = clk_n;
+			rfu_gba.frame();
+			rfu_peer.frame();
+			peer_frame();
+		}
+	}
+}
+
+// ---- CPU: register access (a few CPU cycles each) ----
+enum { SIODATA32 = 0x120, SIOCNT = 0x128, RCNT = 0x134 };
+static void wr(uint32_t a, uint32_t v)
+{
+	top->adr = a; top->din = v; top->bena = a == SIODATA32 ? 0xF : 0x3; top->rnw = 0; top->ena = 1;
+	tick(1);
+	top->ena = 0; top->rnw = 1;
+	tick(5);
+}
+static uint32_t rd(uint32_t a)
+{
+	top->adr = a; top->rnw = 1; top->ena = 0;
+	top->eval();
+	uint32_t v = top->dout;
+	tick(5);
+	return a == SIODATA32 ? v : (v & 0xFFFF);
+}
+
+static void fail(const char *what)
+{
+	printf("FAIL sertb: %s (at %llu ms)\n", what, (unsigned long long)now_ms());
+	exit(1);
+}
+
+// ---- librfu (STWI) ----
+static struct {
+	bool master = true;
+	int state = 0;
+	uint32_t tx[32]; int reqLength = 0, reqNext = 0;
+	uint32_t rx[64]; int ackLength = 0, ackNext = 0;
+	uint8_t reqActive = 0, ackActive = 0;
+	uint64_t timer_at = 0; int timer = 0;   // 0: off, else its count (50/80/100/130 ms)
+	bool sending = false;
+	int error = 0;
+	uint32_t slave_cmd = 0;                 // what the adapter told us while it was master
+} st;
+
+static void set_timer(int count) { st.timer = count; st.timer_at = clk_n + (uint64_t)count * CLK_PER_MS; }
+static void stop_timer() { st.timer = 0; }
+static void check_timer(const char *where)
+{
+	if (st.timer && clk_n >= st.timer_at)
+	{
+		char m[160];
+		snprintf(m, sizeof(m), "librfu timer %d ms ran out (%s, %s state %d)", st.timer, where, st.master ? "master" : "slave", st.state);
+		fail(m);
+	}
+}
+static bool handshake_wait(int slot, const char *where)
+{
+	uint64_t end = clk_n + 200 * CLK_PER_MS;
+	while (((rd(SIOCNT) >> 2) & 1) != (uint32_t)slot)
+	{
+		check_timer(where);
+		if (clk_n > end) { char m[120]; snprintf(m, sizeof(m), "SI never went %d (%s, SIOCNT %04x)", slot, where, rd(SIOCNT)); fail(m); }
+	}
+	return false;
+}
+
+static void start_command(uint8_t cmd, const uint32_t *data, int len)
+{
+	wr(RCNT, 0x100);
+	wr(SIOCNT, 0x5003);
+	st.reqActive = cmd;
+	st.reqLength = len;
+	st.tx[0] = 0x99660000 | (uint32_t)len << 8 | cmd;
+	for (int i = 0; i < len; i++) st.tx[1 + i] = data[i];
+	st.state = 0; st.reqNext = 1; st.ackLength = st.ackNext = 0; st.error = 0; st.sending = true;
+	wr(SIODATA32, st.tx[0]);
+	wr(SIOCNT, 0x5083);
+}
+
+static void master_isr()
+{
+	set_timer(80);
+	uint32_t d = rd(SIODATA32);
+	if (st.state == 0)
+	{
+		if (d != 0x80000000) fail("master: adapter did not answer 0x80000000 while the GBA sent");
+		if (st.reqNext <= st.reqLength) wr(SIODATA32, st.tx[st.reqNext++]);
+		else { st.state = 1; wr(SIODATA32, 0x80000000); }
+	}
+	else if (st.state == 1)
+	{
+		if ((d & 0xFFFF0000) != 0x99660000) { char m[80]; snprintf(m, sizeof(m), "master: no ack (%08x)", d); fail(m); }
+		st.rx[0] = d; st.ackNext = 1; st.ackActive = (uint8_t)d; st.ackLength = (d >> 8) & 0xFF;
+		if (st.ackLength >= st.ackNext) { st.state = 2; wr(SIODATA32, 0x80000000); }
+		else st.state = 3;
+	}
+	else if (st.state == 2)
+	{
+		st.rx[st.ackNext++] = d;
+		if (st.ackLength < st.ackNext) st.state = 3;
+		else wr(SIODATA32, 0x80000000);
+	}
+	handshake_wait(1, "master after word");
+	wr(SIOCNT, 0x500B);
+	handshake_wait(0, "master SO high");
+	stop_timer();
+	if (st.state == 3)
+	{
+		uint8_t a = st.ackActive;
+		if (a == 0xA7 || a == 0xA5 || a == 0xB5 || a == 0xB7)
+		{
+			st.master = false;
+			wr(SIODATA32, 0x80000000);
+			wr(SIOCNT, 0x5002);
+			wr(SIOCNT, 0x5082);
+			st.state = 5;
+		}
+		else
+		{
+			wr(SIOCNT, 0x5003);
+			st.state = 4;
+			if (a == 0xEE) st.error = 1;
+		}
+		st.sending = false;
+	}
+	else
+	{
+		wr(SIOCNT, 0x5003);
+		wr(SIOCNT, 0x5083);
+	}
+}
+
+static void slave_isr()
+{
+	set_timer(100);
+	handshake_wait(0, "slave entry");
+	wr(SIOCNT, 0x500A);
+	uint32_t d = rd(SIODATA32);
+	if (st.state == 5)
+	{
+		st.rx[0] = d; st.reqNext = 1;
+		if ((d >> 16) != 0x9966) { stop_timer(); set_timer(100); char m[80]; snprintf(m, sizeof(m), "slave: first word %08x is no command (librfu waits again)", d); printf("note: %s\n", m); return; }
+		st.reqLength = (d >> 8) & 0xFF;
+		st.reqActive = (uint8_t)d;
+		st.slave_cmd = d;
+		if (st.reqLength == 0)
+		{
+			uint8_t c = st.reqActive;
+			if (c == 0x27 || c == 0x28 || c == 0x29 || c == 0x36) { st.ackActive = c + 0x80; st.tx[0] = 0x99660000 + st.ackActive; st.ackLength = 0; }
+			else { st.tx[0] = 0x996601EE; st.tx[1] = 1; st.ackLength = 1; st.error = 1; }
+			wr(SIODATA32, st.tx[0]);
+			st.ackNext = 1;
+			st.state = 7;
+		}
+		else { wr(SIODATA32, 0x80000000); st.reqNext = 1; st.state = 6; }
+	}
+	else if (st.state == 6)
+	{
+		st.rx[st.reqNext++] = d;
+		if (st.reqLength < st.reqNext)
+		{
+			uint8_t c = st.reqActive;
+			if (c == 0x28 || c == 0x29 || c == 0x36) { st.ackActive = c + 0x80; st.tx[0] = 0x99660000 | st.ackActive; st.ackLength = 0; }
+			else { st.tx[0] = 0x996601EE; st.tx[1] = 1; st.ackLength = 1; st.error = 1; }
+			wr(SIODATA32, st.tx[0]);
+			st.ackNext = 1;
+			st.state = 7;
+		}
+		else wr(SIODATA32, 0x80000000);
+	}
+	else if (st.state == 7)
+	{
+		if (d == 0x80000000)
+		{
+			if (st.ackLength < st.ackNext) st.state = 8;
+			else wr(SIODATA32, st.tx[st.ackNext++]);
+		}
+		else
+		{
+			stop_timer(); set_timer(100);
+			char m[80]; snprintf(m, sizeof(m), "slave: expected 0x80000000 after the ack, got %08x (librfu waits)", d);
+			printf("note: %s\n", m);
+			return;
+		}
+	}
+	handshake_wait(1, "slave SO high");
+	if (st.state == 8)
+	{
+		wr(SIOCNT, 0x5002);
+		stop_timer();
+		if (st.error) fail("slave: the adapter's command was refused");
+		wr(SIODATA32, 0);
+		wr(SIOCNT, 0);
+		wr(SIOCNT, 0x5003);
+		st.master = true;
+		st.state = 0;
+	}
+	else
+	{
+		wr(SIOCNT, 0x5002);
+		wr(SIOCNT, 0x5082);
+	}
+}
+
+// the CPU's main loop: run, take serial IRQs (the handler runs with IRQs off;
+// one raised meanwhile is taken after it, as Pokemon's intr_main does)
+static void run_until(bool (*done)(), const char *what, uint64_t max_ms)
+{
+	uint64_t end = clk_n + max_ms * CLK_PER_MS;
+	while (!done())
+	{
+		tick(4);
+		check_timer(what);
+		if (irq_pending)
+		{
+			irq_pending = false;
+			tick(30);   // IRQ entry (BIOS, intr_main)
+			if (st.master) master_isr(); else slave_isr();
+		}
+		if (clk_n > end) { char m[120]; snprintf(m, sizeof(m), "%s: no progress in %llu ms (%s state %d)", what, (unsigned long long)max_ms, st.master ? "master" : "slave", st.state); fail(m); }
+	}
+}
+
+static bool cmd_done() { return !st.sending; }
+static int command(uint8_t c, std::vector<uint32_t> d = {})
+{
+	start_command(c, d.data(), (int)d.size());
+	char m[32]; snprintf(m, sizeof(m), "command %02x", c);
+	run_until(cmd_done, m, 200);
+	if (st.state == 4 && st.error) { snprintf(m, sizeof(m), "command %02x refused", c); fail(m); }
+	return st.ackLength;
+}
+
+static uint32_t raw_xfer(uint32_t w)
+{
+	wr(SIODATA32, w);
+	wr(SIOCNT, 0x5003);
+	wr(SIOCNT, 0x5083);
+	uint64_t end = clk_n + 50 * CLK_PER_MS;
+	while (rd(SIOCNT) & 0x80) { tick(4); if (clk_n > end) { char m[80]; snprintf(m, sizeof(m), "handshake transfer of %08x never ended", w); fail(m); } }
+	irq_pending = false;
+	handshake_wait(1, "handshake");
+	wr(SIOCNT, 0x500B);
+	handshake_wait(0, "handshake");
+	wr(SIOCNT, 0x5003);
+	return rd(SIODATA32);
+}
+
+int main(int argc, char **argv)
+{
+	Verilated::commandArgs(argc, argv);
+	setvbuf(stdout, nullptr, _IONBF, 0);
+	uint64_t wait_ms = 275;
+	for (int i = 1; i < argc; i++)
+	{
+		if (!strcmp(argv[i], "--net") && i + 1 < argc) net_ms = strtoull(argv[++i], nullptr, 0);
+		else if (!strcmp(argv[i], "--wait") && i + 1 < argc) wait_ms = strtoull(argv[++i], nullptr, 0);
+		else if (!strcmp(argv[i], "--hpsdelay") && i + 1 < argc) hps_delay = strtoull(argv[++i], nullptr, 0);
+		else if (!strcmp(argv[i], "--hpsreorder")) hps_reorder = true;
+	}
+	top = new Vsertb_top;
+	top->rnw = 1;
+	tick(1000);
+
+	// the peer hosts
+	uint32_t out[Rfu::MAX_WORDS], bd[6] = { 0x10020002, 0x3440, 0, 0x5d000001, 0xd9d9e6c5, 0x00ffd9e7 };
+	rfu_peer.command(0x10, nullptr, 0, out);
+	rfu_peer.command(0x16, bd, 6, out);
+	rfu_peer.command(0x19, nullptr, 0, out);
+
+	// adapter reset (SD) and the NINTENDO handshake
+	wr(RCNT, 0x8020); wr(RCNT, 0x8022); wr(RCNT, 0x8020); wr(RCNT, 0);
+	tick(20000);
+	static const uint32_t hs[] = { 0x7FFF494E, 0xFFFF494E, 0xB6B1494E, 0xB6B1544E, 0xABB1544E,
+	                               0xABB14E45, 0xB1BA4E45, 0xB1BA4F44, 0xB0BB4F44, 0xB0BB8001 };
+	uint32_t r = 0;
+	for (uint32_t w : hs) r = raw_xfer(w);
+	printf("handshake done (at %llu ms)\n", (unsigned long long)now_ms());
+	if (r != 0x8001B0BB) { char m[64]; snprintf(m, sizeof(m), "handshake ended with %08x", r); fail(m); }
+
+	// Pokemon's client: Hello, Setup, search, connect
+	command(0x10);
+	command(0x17, { 0x003F0420 });
+	command(0x1C);
+	uint16_t host = 0;
+	for (int i = 0; i < 200 && !host; i++)
+	{
+		if (command(0x1D) >= 7) host = st.rx[1] & 0xFFFF;
+		tick(1674300 / 4);
+	}
+	if (!host) fail("the peer's broadcast never showed");
+	command(0x1E);
+	command(0x1F, { host });
+	bool connected = false;
+	for (int i = 0; i < 100 && !connected; i++)
+	{
+		command(0x20);
+		connected = (st.rx[1] >> 24) == 0;
+		tick(1674300);
+	}
+	if (!connected) fail("connect");
+	command(0x21);
+	printf("connected as client of %04x (at %llu ms)\n", host, (unsigned long long)now_ms());
+
+	// Wait: the peer's data comes wait_ms later
+	peer_send_at = now_ms() + wait_ms;
+	command(0x27);
+	if (st.master) fail("Wait did not make the adapter clock master");
+	printf("waiting as clock slave (at %llu ms)\n", (unsigned long long)now_ms());
+	run_until([] { return st.master; }, "Wait event", wait_ms + 2000);
+	printf("event %08x taken, master again (at %llu ms)\n", st.slave_cmd, (unsigned long long)now_ms());
+	if (st.slave_cmd != 0x99660028) fail("the event is not 0x99660028");
+
+	int n = command(0x26);
+	printf("ReceiveData: %d words, %08x %08x\n", n, st.rx[1], st.rx[2]);
+	if (n < 2 || st.rx[1] != 1) fail("ReceiveData did not return the host's byte");
+
+	printf("PASS sertb (%llu ms simulated)\n", (unsigned long long)now_ms());
+	delete top;
+	return 0;
+}
