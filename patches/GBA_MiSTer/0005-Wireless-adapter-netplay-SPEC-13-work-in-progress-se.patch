-      GBA_lockspeed         : in     std_logic;  -- 1 = 100% speed, 0 = max speed
-      GBA_cputurbo          : in     std_logic;  -- 1 = cpu free running, all other 16 mhz
-      GBA_flash_1m          : in     std_logic;  -- 1 when string "FLASH1M_V" is anywhere in gamepak
