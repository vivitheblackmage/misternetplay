diff --git a/rtl/gba_rfu.sv b/rtl/gba_rfu.sv
new file mode 100644
index 0000000..3b5a3b9
--- /dev/null
+++ b/rtl/gba_rfu.sv
@@ -0,0 +1,327 @@
+// gba_rfu.sv - the GBA Wireless Adapter on the link port, FPGA side
+// (netplay SPEC.md 13.1-13.3). The word level of gpSP's rfu_transfer(): the
+// NINTENDO handshake is answered here; a command (0x9966LLCC + LL words) is
+// collected and handed to the HPS through a mailbox in DDR3; its answer (ack +
+// data, or error) is streamed back word by word; events the HPS posts while the
+// adapter is clock master (after Wait, SendDataWait, RetransmitAndWait) are
+// pushed when the GBA has armed an external-clock transfer.
+//
+// Mailbox at MB_BASE (byte offsets; every header carries its tag in both
+// 32-bit halves, as all netplay mailboxes, SPEC.md 7):
+//   0x000 magic "GBARFU01"                         FPGA
+//   0x008 status {resets16, 16'h0} x2              FPGA (resets: SD pulses)
+//   0x010 command {seq16, cmd8, len8} x2           FPGA, after the data
+//   0x018 command data[0..31] {0, word}            FPGA
+//   0x200 answer {seq16, flags8, len8} x2          HPS, after the data (flags bit 0: error, data[0] = code)
+//   0x208 answer data[0..63] {0, word}             HPS
+//   0x500 events {seq16, 8'h0, n8} x2              HPS, after the data
+//   0x508 event data[0..3] {0, word}               HPS
+
+module gba_rfu #(parameter [27:0] MB_BASE = 28'hC000000)   // 0x3C000000 - 0x30000000 (ddram.sv window)
+(
+	input             clk,
+	input             reset,          // core reset
+	input             enable,         // OSD: wireless adapter on the link port
+
+	// gba_serial
+	input             xfer_req,       // internal clock transfer started
+	input      [31:0] xfer_word,      // the GBA's SIODATA32
+	output reg        xfer_done,
+	output reg [31:0] xfer_answer,
+	input             ext_ready,      // external clock armed, SI = SO = 0
+	input             sd_reset,       // RCNT: SD driven high
+
+	// DDR3 (ddram.sv channel, 64-bit words)
+	output reg [27:3] mem_addr,
+	output reg [63:0] mem_din,
+	output reg        mem_we,
+	output reg        mem_req,
+	input      [63:0] mem_dout,
+	input             mem_ready
+);
+
+localparam [63:0] MAGIC = "GBARFU01";
+
+// adapter word states (gpSP's rfu_comstate)
+localparam S_RESET = 0, S_HANDSHAKE = 1, S_WAITCMD = 2, S_WAITDAT = 3, S_ASK = 4,
+           S_RESPCMD = 5, S_RESPDAT = 6, S_RESPERR = 7, S_RESPERR2 = 8, S_WAITEVENT = 9;
+reg  [3:0] st;
+
+reg [31:0] prev;                // the GBA's previous word (handshake)
+reg  [7:0] cmd, plen, cnt;
+reg [15:0] seq, eseq, resets;
+reg  [7:0] alen, aflags;
+reg [31:0] aerr;
+reg [31:0] cbuf[0:31];          // command data
+reg  [2:0] en_sync;
+
+// pending GBA transfer waiting for the HPS (or for a mailbox read)
+reg        pend;
+reg [31:0] pend_word;
+
+// memory sequencer
+localparam M_IDLE = 0, M_MAGIC = 1, M_STATUS = 2, M_CDATA = 3, M_CHDR = 4,
+           M_AHDR = 5, M_ADATA = 6, M_EHDR = 7, M_EDATA = 8, M_WAIT = 9;
+reg  [3:0] ms, mret;
+reg  [7:0] mi;                  // word index
+reg        cmd_sent, ans_ok, need_magic, need_status;
+reg [11:0] poll;                // pause between polls of the HPS's headers
+reg  [2:0] en_n;                // events to push
+reg  [2:0] ei;
+reg [31:0] ebuf[0:3];
+reg        have_word;           // mem returned the word asked for (answer data)
+reg [31:0] mword;
+
+wire on = en_sync[2];
+
+function automatic [31:0] ack_word(input [7:0] c, input [7:0] n);
+	ack_word = 32'h99660080 | {16'h0, n, 8'h0} | {24'h0, c};
+endfunction
+
+function automatic is_wait(input [7:0] c);
+	is_wait = c == 8'h27 || c == 8'h25 || c == 8'h37;
+endfunction
+
+always @(posedge clk) begin
+	en_sync <= {en_sync[1:0], enable};
+	xfer_done <= 0;
+
+	if (reset || !on || sd_reset) begin
+		st       <= S_RESET;
+		prev     <= 0;
+		pend     <= 0;
+		cmd_sent <= 0;
+		ans_ok   <= 0;
+		en_n     <= 0;
+		ei       <= 0;
+		if (sd_reset) begin
+			resets      <= resets + 1'd1;
+			need_status <= 1;
+		end
+		if (reset || !on) begin
+			need_magic  <= 1;
+			need_status <= 1;
+		end
+	end
+	else begin
+		// a transfer from the GBA (internal clock)
+		if (xfer_req) begin
+			pend      <= 1;
+			pend_word <= xfer_word;
+		end
+
+		if (pend && !xfer_req) begin
+			case (st)
+			S_RESET: begin
+				xfer_answer <= 0;
+				xfer_done   <= 1;
+				pend        <= 0;
+				prev        <= pend_word;
+				if (pend_word[15:0] == 16'h494E) st <= S_HANDSHAKE;
+			end
+			S_HANDSHAKE: begin
+				xfer_answer <= {pend_word[15:0], ~prev[15:0]};
+				xfer_done   <= 1;
+				pend        <= 0;
+				prev        <= pend_word;
+				if (pend_word == 32'hB0BB8001) st <= S_WAITCMD;
+			end
+			S_WAITCMD: begin
+				xfer_answer <= 32'h80000000;
+				xfer_done   <= 1;
+				pend        <= 0;
+				prev        <= pend_word;
+				if (pend_word[31:16] == 16'h9966) begin
+					cmd  <= pend_word[7:0];
+					plen <= pend_word[15:8] > 8'd32 ? 8'd32 : pend_word[15:8];
+					cnt  <= 0;
+					if (pend_word[15:8] == 0) begin
+						st       <= S_ASK;
+						seq      <= seq + 1'd1;
+						cmd_sent <= 0;
+						ans_ok   <= 0;
+					end
+					else st <= S_WAITDAT;
+				end
+			end
+			S_WAITDAT: begin
+				xfer_answer   <= 32'h80000000;
+				xfer_done     <= 1;
+				pend          <= 0;
+				cbuf[cnt[4:0]] <= pend_word;
+				cnt           <= cnt + 1'd1;
+				if (cnt + 1'd1 >= plen) begin
+					st       <= S_ASK;
+					seq      <= seq + 1'd1;
+					cmd_sent <= 0;
+					ans_ok   <= 0;
+				end
+			end
+			S_ASK: if (ans_ok) begin
+				// the GBA clocks the ack out
+				xfer_done <= 1;
+				pend      <= 0;
+				cnt       <= 0;
+				if (aflags[0]) begin
+					xfer_answer <= 32'h996601ee;
+					st          <= S_RESPERR2;
+				end
+				else begin
+					xfer_answer <= ack_word(cmd, is_wait(cmd) ? 8'd0 : alen);
+					st          <= is_wait(cmd) ? S_WAITEVENT : alen != 0 ? S_RESPDAT : S_WAITCMD;
+				end
+			end
+			S_RESPDAT: if (have_word) begin
+				xfer_answer <= mword;
+				xfer_done   <= 1;
+				pend        <= 0;
+				have_word   <= 0;
+				cnt         <= cnt + 1'd1;
+				if (cnt + 1'd1 >= alen) st <= S_WAITCMD;
+			end
+			S_RESPERR2: begin
+				xfer_answer <= aerr;
+				xfer_done   <= 1;
+				pend        <= 0;
+				st          <= S_WAITCMD;
+			end
+			default: begin   // S_WAITEVENT: the GBA should not clock now
+				xfer_answer <= 32'h80000000;
+				xfer_done   <= 1;
+				pend        <= 0;
+			end
+			endcase
+		end
+
+		// adapter is clock master: push the posted event words
+		if (st == S_WAITEVENT && en_n != 0 && ext_ready && !xfer_done) begin
+			xfer_answer <= ebuf[ei[1:0]];
+			xfer_done   <= 1;
+			ei          <= ei + 1'd1;
+			if (ei + 1'd1 >= en_n) begin
+				en_n <= 0;
+				ei   <= 0;
+				st   <= S_WAITCMD;
+			end
+		end
+	end
+
+	// ---- memory sequencer (one ddram request at a time) ----
+	if (mem_req && mem_ready) mem_req <= 0;
+	if (ms == M_WAIT) begin
+		if (mem_ready) ms <= mret;
+	end
+	else if (!mem_req) begin
+		case (ms)
+		M_IDLE: begin
+			if (poll != 0) poll <= poll - 1'd1;
+			if (need_magic) begin
+				mem_addr <= (MB_BASE + 28'h000) >> 3; mem_din <= MAGIC; mem_we <= 1; mem_req <= 1;
+				need_magic <= 0; ms <= M_WAIT; mret <= M_IDLE;
+			end
+			else if (need_status) begin
+				mem_addr <= (MB_BASE + 28'h008) >> 3; mem_din <= {resets, 16'h0, resets, 16'h0}; mem_we <= 1; mem_req <= 1;
+				need_status <= 0; ms <= M_WAIT; mret <= M_IDLE;
+			end
+			else if (on && st == S_ASK && !cmd_sent) begin
+				mi <= 0;
+				ms <= M_CDATA;
+			end
+			else if (on && st == S_ASK && cmd_sent && !ans_ok && poll == 0) begin
+				mem_addr <= (MB_BASE + 28'h200) >> 3; mem_we <= 0; mem_req <= 1;
+				ms <= M_WAIT; mret <= M_AHDR;
+			end
+			else if (on && st == S_RESPDAT && pend && !have_word) begin
+				mem_addr <= (MB_BASE + 28'h208 + {cnt, 3'b000}) >> 3; mem_we <= 0; mem_req <= 1;
+				ms <= M_WAIT; mret <= M_ADATA;
+			end
+			else if (on && st == S_WAITEVENT && en_n == 0 && poll == 0) begin
+				mem_addr <= (MB_BASE + 28'h500) >> 3; mem_we <= 0; mem_req <= 1;
+				ms <= M_WAIT; mret <= M_EHDR;
+			end
+		end
+		M_CDATA: begin
+			if (mi < plen) begin
+				mem_addr <= (MB_BASE + 28'h018 + {mi, 3'b000}) >> 3; mem_din <= {32'h0, cbuf[mi[4:0]]}; mem_we <= 1; mem_req <= 1;
+				mi <= mi + 1'd1;
+				ms <= M_WAIT; mret <= M_CDATA;
+			end
+			else begin
+				mem_addr <= (MB_BASE + 28'h010) >> 3; mem_din <= {seq, cmd, plen, seq, cmd, plen}; mem_we <= 1; mem_req <= 1;
+				cmd_sent <= 1;
+				ms <= M_WAIT; mret <= M_IDLE;
+			end
+		end
+		M_AHDR: begin
+			// answer for this command: both halves alike, the right sequence number
+			if (mem_dout[63:32] == mem_dout[31:0] && mem_dout[31:16] == seq && st == S_ASK) begin
+				aflags <= mem_dout[15:8];
+				alen   <= mem_dout[7:0] > 8'd64 ? 8'd64 : mem_dout[7:0];
+				if (mem_dout[8]) begin   // error: its code is data[0]
+					mem_addr <= (MB_BASE + 28'h208) >> 3; mem_we <= 0; mem_req <= 1;
+					ms <= M_WAIT; mret <= M_EDATA;   // reused: reads the error code
+					mi <= 8'hff;
+				end
+				else begin
+					ans_ok <= 1;
+					ms     <= M_IDLE;
+				end
+			end
+			else begin
+				poll <= 12'd100;   // ~1 us at 100 MHz
+				ms   <= M_IDLE;
+			end
+		end
+		M_ADATA: begin
+			mword     <= mem_dout[31:0];
+			have_word <= 1;
+			ms        <= M_IDLE;
+		end
+		M_EHDR: begin
+			if (mem_dout[63:32] == mem_dout[31:0] && mem_dout[31:16] != eseq && mem_dout[2:0] != 0 && st == S_WAITEVENT) begin
+				eseq <= mem_dout[31:16];
+				en_n <= 0;
+				mi   <= 0;
+				mword <= {29'd0, mem_dout[2:0] > 3'd4 ? 3'd4 : mem_dout[2:0]};   // count to read
+				mem_addr <= (MB_BASE + 28'h508) >> 3; mem_we <= 0; mem_req <= 1;
+				ms <= M_WAIT; mret <= M_EDATA;
+			end
+			else begin
+				poll <= 12'd100;
+				ms   <= M_IDLE;
+			end
+		end
+		M_EDATA: begin
+			if (mi == 8'hff) begin           // the error code of an answer
+				aerr   <= mem_dout[31:0];
+				ans_ok <= 1;
+				ms     <= M_IDLE;
+			end
+			else begin
+				ebuf[mi[1:0]] <= mem_dout[31:0];
+				if (mi + 1'd1 >= mword[7:0]) begin
+					en_n <= mword[2:0];
+					ei   <= 0;
+					ms   <= M_IDLE;
+				end
+				else begin
+					mi <= mi + 1'd1;
+					mem_addr <= (MB_BASE + 28'h508 + {mi + 1'd1, 3'b000}) >> 3; mem_we <= 0; mem_req <= 1;
+					ms <= M_WAIT; mret <= M_EDATA;
+				end
+			end
+		end
+		default: ms <= M_IDLE;
+		endcase
+	end
+
+	if (reset) begin
+		ms       <= M_IDLE;
+		mem_req  <= 0;
+		poll     <= 0;
+		have_word <= 0;
+		resets   <= 0;
+	end
+end
+
+endmodule
