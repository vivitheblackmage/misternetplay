+// ---- wireless adapter (T2w, --rfu): the mailbox, the HPS side and a peer adapter ----
+static const uint32_t MB_WIDX = 0xC000000u >> 3;          // gba_rfu MB_BASE in 64-bit words
+static uint64_t mbox[RfuMailbox::SIZE / 8];
+extern "C" long long mb_read(int widx)
+{
+	uint32_t i = (uint32_t)widx - MB_WIDX;
+	return i < RfuMailbox::SIZE / 8 ? (long long)mbox[i] : 0;
+}
+extern "C" void mb_write(int widx, long long data)
+{
+	uint32_t i = (uint32_t)widx - MB_WIDX;
+	if (i < RfuMailbox::SIZE / 8) mbox[i] = (uint64_t)data;
+}
+struct RfuPkt { int to; std::vector<uint8_t> d; };
+static std::deque<RfuPkt> rfu_wire;
+static Rfu rfu_gba([](int, const uint8_t *b, size_t n) { rfu_wire.push_back({1, std::vector<uint8_t>(b, b + n)}); }, 101);
+static Rfu rfu_peer([](int, const uint8_t *b, size_t n) { rfu_wire.push_back({0, std::vector<uint8_t>(b, b + n)}); }, 202);
+static void rfu_deliver()
+{
+	while (!rfu_wire.empty())
+	{
+		RfuPkt p = rfu_wire.front();
+		rfu_wire.pop_front();
+		(p.to == 0 ? rfu_gba : rfu_peer).receive(0, p.d.data(), p.d.size());
+	}
+}
+// the peer joins the GBA's room as client 0 and sends 0xc0ffee11, then waits for the host's data
+static int peer_step = 0;
+static uint32_t peer_got = 0;
+static void peer_frame()
+{
+	uint32_t out[Rfu::MAX_WORDS], d[2];
+	switch (peer_step)
+	{
+	case 0:
+		rfu_peer.command(0x10, nullptr, 0, out);
+		rfu_peer.command(0x1c, nullptr, 0, out);
+		peer_step = 1;
+		break;
+	case 1:
+		if (rfu_peer.command(0x1d, nullptr, 0, out) >= 7)
+		{
+			d[0] = out[0];
+			rfu_peer.command(0x1e, nullptr, 0, out);
+			rfu_peer.command(0x1f, d, 1, out);
+			rfu_deliver();
+			if (rfu_peer.state() == Rfu::CLIENT)
+			{
+				d[0] = 4u << 8;
+				d[1] = 0xc0ffee11;
+				rfu_peer.command(0x24, d, 2, out);
+				fprintf(stderr, "peer: connected, sent c0ffee11\n");
+				peer_step = 2;
+			}
+		}
+		break;
+	case 2:
+		if (rfu_peer.command(0x26, nullptr, 0, out) >= 2 && out[0] == 4)
+		{
+			peer_got = out[1];
+			fprintf(stderr, "peer: got %08x from the host\n", peer_got);
+			peer_step = 3;
+		}
+		break;
+	}
+	rfu_deliver();
+}
