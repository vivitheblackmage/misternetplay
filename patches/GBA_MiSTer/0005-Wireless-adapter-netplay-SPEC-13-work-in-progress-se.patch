diff --git a/npsim/rfutest.s b/npsim/rfutest.s
new file mode 100644
index 0000000..1bf8240
--- /dev/null
+++ b/npsim/rfutest.s
@@ -0,0 +1,285 @@
+@ rfutest.s - T2w (netplay SPEC.md 13.6): talks to the wireless adapter on the
+@ link port as LinkRawWireless does, and writes what it got to EWRAM:
+@   0x02000000 + 4*i  result words (see below), 0x02000100 = 1 when done.
+@ The screen turns green when every check passed, red otherwise.
+@ Built by npsim/Makefile (binutils-arm-none-eabi in Docker) with the header of
+@ any GBA ROM in front (the BIOS checks the logo).
+@
+@ results: [0] handshake last answer   [1] Hello ack          [2] VersionStatus ack
+@          [3] VersionStatus data      [4] Setup ack          [5] Broadcast ack
+@          [6] StartHost ack           [7] SystemStatus data  [8] Connect-as-host error ack
+@          [9] its error code          [10] PollConnections ack (1 client)
+@          [11] Wait ack               [12] pushed word 0     [13] pushed word 1
+@          [14] ReceiveData ack        [15] ReceiveData header [16] ReceiveData word
+@          [17] SendData ack           [18] checks failed
+
+    .arm
+    .equ SIODATA32, 0x04000120
+    .equ SIOCNT,    0x04000128
+    .equ RCNT,      0x04000134
+
+start:
+    mov   r11, #0x02000000          @ results
+    mov   r10, #0                   @ failed checks
+
+    @ reset the adapter: RCNT general purpose, SD output high, then low, then SIO
+    ldr   r1, =RCNT
+    ldr   r2, =0x8020
+    strh  r2, [r1]
+    ldr   r2, =0x8022
+    strh  r2, [r1]
+    ldr   r2, =0x8020
+    strh  r2, [r1]
+    mov   r2, #0
+    strh  r2, [r1]
+
+    @ NINTENDO handshake (afska's table)
+    adr   r9, hs
+    mov   r8, #10
+1:  ldr   r0, [r9], #4
+    bl    xfer
+    subs  r8, r8, #1
+    bne   1b
+    str   r0, [r11, #0]
+    ldr   r1, =0x8001B0BB
+    cmp   r0, r1
+    addne r10, r10, #1
+
+    @ Hello
+    mov   r0, #0x10
+    mov   r1, #0
+    bl    command
+    str   r0, [r11, #4]
+    ldr   r1, =0x99660090
+    cmp   r0, r1
+    addne r10, r10, #1
+
+    @ VersionStatus: one word 0x00830117
+    mov   r0, #0x12
+    mov   r1, #0
+    bl    command
+    str   r0, [r11, #8]
+    ldr   r1, =0x99660192
+    cmp   r0, r1
+    addne r10, r10, #1
+    bl    readword
+    str   r0, [r11, #12]
+    ldr   r1, =0x00830117
+    cmp   r0, r1
+    addne r10, r10, #1
+
+    @ Setup 0x003C0420
+    ldr   r2, =0x003C0420
+    str   r2, [r11, #0x80]
+    mov   r0, #0x17
+    mov   r1, #1
+    bl    command
+    str   r0, [r11, #16]
+    ldr   r1, =0x99660097
+    cmp   r0, r1
+    addne r10, r10, #1
+
+    @ Broadcast: six words 0x11..0x66
+    adr   r9, bcst
+    ldmia r9, {r2-r7}
+    add   r9, r11, #0x80
+    stmia r9, {r2-r7}
+    mov   r0, #0x16
+    mov   r1, #6
+    bl    command
+    str   r0, [r11, #20]
+    ldr   r1, =0x99660096
+    cmp   r0, r1
+    addne r10, r10, #1
+
+    @ StartHost
+    mov   r0, #0x19
+    mov   r1, #0
+    bl    command
+    str   r0, [r11, #24]
+    ldr   r1, =0x99660099
+    cmp   r0, r1
+    addne r10, r10, #1
+
+    @ SystemStatus: state 1 (host) in the top byte
+    mov   r0, #0x13
+    mov   r1, #0
+    bl    command
+    bl    readword
+    str   r0, [r11, #28]
+    mov   r1, r0, lsr #24
+    cmp   r1, #1
+    addne r10, r10, #1
+
+    @ Connect while hosting: error 0x996601ee, code 1
+    mov   r2, #0x1234
+    str   r2, [r11, #0x80]
+    mov   r0, #0x1f
+    mov   r1, #1
+    bl    command
+    str   r0, [r11, #32]
+    ldr   r1, =0x996601ee
+    cmp   r0, r1
+    addne r10, r10, #1
+    bl    readword
+    str   r0, [r11, #36]
+    cmp   r0, #1
+    addne r10, r10, #1
+
+    @ PollConnections until the peer (the bench's second adapter) is in
+    mov   r8, #0
+3:  mov   r0, #0x1a
+    mov   r1, #0
+    bl    command
+    mov   r9, r0
+    and   r1, r0, #0xff00
+    cmp   r1, #0
+    beq   4f
+    bl    readword                  @ the client's id and slot
+    b     5f
+4:  add   r8, r8, #1
+    ldr   r1, =200000
+    cmp   r8, r1
+    blt   3b
+5:  str   r9, [r11, #40]
+    ldr   r1, =0x9966019a
+    cmp   r9, r1
+    addne r10, r10, #1
+
+    @ Wait: the adapter becomes clock master and pushes "data" (the peer sent some)
+    mov   r0, #0x27
+    mov   r1, #0
+    bl    command
+    str   r0, [r11, #44]
+    ldr   r1, =0x996600a7
+    cmp   r0, r1
+    addne r10, r10, #1
+    ldr   r0, =0x996600a8           @ what the GBA answers while receiving
+    bl    xfer_ext
+    str   r0, [r11, #48]
+    ldr   r1, =0x99660028
+    cmp   r0, r1
+    addne r10, r10, #1
+    ldr   r0, =0x80000000
+    bl    xfer_ext
+    str   r0, [r11, #52]
+    cmp   r0, #0x80000000
+    addne r10, r10, #1
+
+    @ ReceiveData: header (client 0, 4 bytes) and the word
+    mov   r0, #0x26
+    mov   r1, #0
+    bl    command
+    str   r0, [r11, #56]
+    ldr   r1, =0x996602a6
+    cmp   r0, r1
+    addne r10, r10, #1
+    bl    readword
+    str   r0, [r11, #60]
+    cmp   r0, #0x400
+    addne r10, r10, #1
+    bl    readword
+    str   r0, [r11, #64]
+    ldr   r1, =0xc0ffee11
+    cmp   r0, r1
+    addne r10, r10, #1
+
+    @ SendData to the client: 4 bytes 0x12345678 (the bench checks the peer got them)
+    mov   r2, #4
+    ldr   r3, =0x12345678
+    add   r9, r11, #0x80
+    stmia r9, {r2, r3}
+    mov   r0, #0x24
+    mov   r1, #2
+    bl    command
+    str   r0, [r11, #68]
+    ldr   r1, =0x996600a4
+    cmp   r0, r1
+    addne r10, r10, #1
+
+    str   r10, [r11, #72]
+    mov   r0, #1
+    str   r0, [r11, #0x100]
+
+    @ screen: mode 3, BG2; green when nothing failed
+    cmp   r10, #0
+    ldreq r2, =0x03e003e0
+    ldrne r2, =0x001f001f
+    mov   r0, #0x04000000
+    ldr   r1, =0x0403
+    str   r1, [r0]
+    mov   r0, #0x06000000
+    mov   r1, #0x12c00
+6:  str   r2, [r0], #4
+    subs  r1, r1, #4
+    bgt   6b
+7:  b     7b
+
+@ command: r0 = command, r1 = word count, the words at r11+0x80; returns the ack
+command:
+    stmfd sp!, {r4-r6, lr}
+    mov   r4, r1
+    add   r5, r11, #0x80
+    orr   r0, r0, r1, lsl #8
+    ldr   r1, =0x99660000
+    orr   r0, r0, r1
+    bl    xfer
+6:  cmp   r4, #0
+    beq   7f
+    ldr   r0, [r5], #4
+    bl    xfer
+    sub   r4, r4, #1
+    b     6b
+7:  ldr   r0, =0x80000000           @ clocks the ack out
+    bl    xfer
+    ldmfd sp!, {r4-r6, pc}
+
+readword:
+    ldr   r0, =0x80000000
+    b     xfer
+
+@ xfer: r0 = word to send (internal clock, 2 MHz, 32 bit), returns the adapter's word
+xfer:
+    ldr   r1, =SIODATA32
+    str   r0, [r1]
+    ldr   r1, =SIOCNT
+    ldr   r2, =0x1003               @ 32 bit, 2 MHz, internal clock, SO low
+    strh  r2, [r1]
+    orr   r2, r2, #0x80             @ start
+    strh  r2, [r1]
+1:  ldrh  r3, [r1]
+    tst   r3, #0x80
+    bne   1b
+    ldr   r2, =0x100b               @ SO high
+    strh  r2, [r1]
+2:  ldrh  r3, [r1]
+    tst   r3, #0x04                 @ adapter ready: SI low
+    bne   2b
+    ldr   r2, =0x1003               @ SO low
+    strh  r2, [r1]
+    ldr   r1, =SIODATA32
+    ldr   r0, [r1]
+    bx    lr
+
+@ xfer_ext: the adapter is clock master; r0 = the GBA's word, returns the pushed one
+xfer_ext:
+    ldr   r1, =SIODATA32
+    str   r0, [r1]
+    ldr   r1, =SIOCNT
+    ldr   r2, =0x1000               @ 32 bit, external clock, SO low
+    strh  r2, [r1]
+    orr   r2, r2, #0x80
+    strh  r2, [r1]
+1:  ldrh  r3, [r1]
+    tst   r3, #0x80
+    bne   1b
+    ldr   r1, =SIODATA32
+    ldr   r0, [r1]
+    bx    lr
+
+hs:
+    .word 0x7FFF494E, 0xFFFF494E, 0xB6B1494E, 0xB6B1544E, 0xABB1544E
+    .word 0xABB14E45, 0xB1BA4E45, 0xB1BA4F44, 0xB0BB4F44, 0xB0BB8001
+bcst:
+    .word 0x11, 0x22, 0x33, 0x44, 0x55, 0x66
+    .pool
