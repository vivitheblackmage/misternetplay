+    .matrix_mapper      ( 1'b0          ),
+    .increaseSSHeaderCount( 1'b0        ),
+    .save_state         ( 1'b0          ),
+    .load_state         ( 1'b0          ),
+    .interframe_blend   ( 2'd0          ),
+    .maxpixels          ( 1'b0          ),
+    .shade_mode         ( 3'd0          ),
+    .hdmode2x_bg        ( 1'b0          ),
+    .hdmode2x_obj       ( 1'b0          ),
+    .specialmodule      ( 1'b0          ),
+    .solar_in           ( 3'd0          ),
+    .tilt               ( 1'b0          ),
+    .rewind_on          ( 1'b0          ),
+    .rewind_active      ( 1'b0          ),
+    .savestate_number   ( 32'd0         ),
+    .RTC_timestampNew   ( 1'b0          ),
+    .RTC_timestampIn    ( 32'd0         ),
+    .RTC_timestampSaved ( 32'd0         ),
+    .RTC_savedtimeIn    ( 42'd0         ),
+    .RTC_saveLoaded     ( 1'b0          ),
+    .RTC_timestampOut   (               ),
+    .RTC_savedtimeOut   (               ),
+    .RTC_inuse          (               ),
+    .cheat_clear        ( 1'b0          ),
+    .cheats_enabled     ( 1'b0          ),
+    .cheat_on           ( 1'b0          ),
+    .cheat_in           ( 128'd0        ),
+    .cheats_active      (               ),
+    .sdram_read_ena     ( rom_req       ),
+    .sdram_read_done    ( rom_done      ),
+    .sdram_read_addr    ( rom_addr      ),
+    .sdram_read_data    ( rom_d1        ),
+    .sdram_second_dword ( rom_d2        ),
+    .bus_out_Din        ( bus_din       ),
+    .bus_out_Dout       ( bus_dout      ),
+    .bus_out_Adr        ( bus_adr       ),
+    .bus_out_rnw        ( bus_rnw       ),
+    .bus_out_ena        ( bus_ena       ),
+    .bus_out_done       ( bus_done      ),
+    .SAVE_out_Din       (               ),
+    .SAVE_out_Dout      ( 64'd0         ),
+    .SAVE_out_Adr       (               ),
+    .SAVE_out_rnw       (               ),
+    .SAVE_out_ena       ( save_ena      ),
+    .SAVE_out_active    (               ),
+    .SAVE_out_be        (               ),
+    .SAVE_out_done      ( save_done     ),
+    .bios_wraddr        ( 12'd0         ),
+    .bios_wrdata        ( 32'd0         ),
+    .bios_wr            ( 1'b0          ),
