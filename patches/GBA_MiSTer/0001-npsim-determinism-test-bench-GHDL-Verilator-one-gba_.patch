@@ -0,0 +1,13 @@
+#!/usr/bin/env bash
+# ghdl synth of gba_top (generics as in GBA.sv) -> build/vlog/gba_top.v
+set -u
+cd "$(dirname "$0")"
+mkdir -p build/vlog
+docker run --rm -u $(id -u):$(id -g) -v $PWD/build/vhdl:/out -v $PWD/build/ghdl:/work -w /out hdlc/ghdl:yosys \
+  ghdl synth --std=08 -frelaxed -fsynopsys --latches --workdir=/work -P/work \
+  -gSoftmap_GBA_FLASH_ADDR=0 -gSoftmap_GBA_EEPROM_ADDR=0 -gSoftmap_GBA_WRam_ADDR=131072 \
+  -gSoftmap_GBA_Gamerom_ADDR=196608 -gSoftmap_SaveState_ADDR=58720256 -gSoftmap_Rewind_ADDR=33554432 \
+  "-gturbosound='1'" --out=verilog gba_top > build/vlog/gba_top.v 2> build/vlog/gba_top.log
+rc=$?
+grep error build/vlog/gba_top.log | sort -u | head -20
+exit $rc
