diff --git a/npsim/vcd_view.py b/npsim/vcd_view.py
new file mode 100644
index 0000000..6011bd6
--- /dev/null
+++ b/npsim/vcd_view.py
@@ -0,0 +1,58 @@
+#!/usr/bin/env python3
+"""Prints chosen signals of a Verilator VCD (trace.vcd) as a table, one row per
+clock (gba_sim.cpp dumps once per clock), hex values, only rows where one changed.
+usage: vcd_view.py trace.vcd scope.signal [scope.signal ...]   (path below TOP,
+e.g. sim_top.u_gba.igba_cpu.PC). --list scope: list the signals of a scope."""
+import sys
+
+def parse(path, want):
+    ids, scope, names = {}, [], {}
+    with open(path, errors="replace") as f:
+        for line in f:
+            l = line.split()
+            if not l: continue
+            if l[0] == "$enddefinitions": break
+            if l[0] == "$scope": scope.append(l[2])
+            elif l[0] == "$upscope": scope.pop()
+            elif l[0] == "$var":
+                full = ".".join(scope[1:] + [l[4]])
+                names.setdefault(".".join(scope[1:]), []).append(l[4])
+                if want is not None and full in want: ids.setdefault(l[3], []).append(full)
+        if want is None: return names
+        cur = {w: "x" for w in want}
+        rows, t, clk_id = [], 0, None
+        for k, v in ids.items():
+            if "sim_top.clk" in v: clk_id = k
+        last = None
+        def flush():
+            nonlocal last
+            row = tuple(cur[w] for w in want)
+            if row != last: rows.append((t, row)); last = row
+        started = False
+        for line in f:
+            line = line.strip()
+            if not line: continue
+            if line[0] == "#":
+                if started: flush()                 # one dump per clock (gba_sim.cpp)
+                started = True
+                t = int(line[1:]); continue
+            if line[0] == "b":
+                val, k = line[1:].split()
+            else:
+                val, k = line[0], line[1:]
+            if k in ids:
+                for n in ids[k]:
+                    cur[n] = val
+        flush()
+        return rows
+
+if sys.argv[2] == "--list":
+    for n in sorted(parse(sys.argv[1], None).get(sys.argv[3], [])): print(n)
+    sys.exit()
+want = sys.argv[2:]
+if "sim_top.clk" not in want: want = ["sim_top.clk"] + want
+def hx(v):
+    try: return "%x" % int(v, 2)
+    except ValueError: return v
+for t, row in parse(sys.argv[1], want):
+    print("%8d " % (t // 2) + " ".join("%s=%s" % (w.split(".")[-1], hx(v)) for w, v in zip(want[1:], row[1:])))
